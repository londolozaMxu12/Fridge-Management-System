@page
@model RegisterEmployeeModel

@{
    ViewData["Title"] = "Register Employee";
    Layout = "_AdminLayout";
}
@* <h2>@ViewData["Title"]</h2> *@
<h2 class="text-center mb-3">Register New Employee</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="row">
    @* <h2 class="text-center mb-3">Register Employee</h2> *@

    <div class="col-lg-8 mx-auto rounded border p-5">
        <h2 class="text-center mb-3">Account Details:</h2>
        <hr />

        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

        <form method="post">
            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Full Name*</label>
                <div class="col-sm-8">
                    <input class="form-control" asp-for="Input.FullName">
                    <span asp-validation-for="Input.FullName" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Email*</label>
                <div class="col-sm-8">
                    <input class="form-control" asp-for="Input.Email">
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Password*</label>
                <div class="col-sm-8">
                    <input class="form-control" type="password" asp-for="Input.Password">
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Confirm Password*</label>
                <div class="col-sm-8">
                    <input class="form-control" type="password" asp-for="Input.ConfirmPassword">
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>
            </div>

            <h2 class="text-center mb-3">Contact Details:</h2>
            <hr />

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Contact No*</label>
                <div class="col-sm-8">
                    
                    <input type="tel" class="form-control" asp-for="Input.ContactNo">
                    <span asp-validation-for="Input.ContactNo" class="text-danger"></span>
                </div>
            </div>

            @* <div class="row mb-3">
                <label for="SelectedRole" class="col-sm-4 col-form-label">Role*</label>
                <div class="col-sm-8">
                    @Html.DropDownListFor(model => model.Input.SelectedRole, (IEnumerable<SelectListItem>)ViewBag.Roles, "-->Select a Role<--", new { @class = "form-control" })
                    <span asp-validation-for="Input.SelectedRole" class="text-danger"></span>
                </div>
            </div> *@

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Address*</label>
                <div class="col-sm-8">
                    <input class="form-control" asp-for="Input.Address">
                    <span asp-validation-for="Input.Address" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">City*</label>
                <div class="col-sm-8">
                    <input class="form-control" asp-for="Input.City">
                    <span asp-validation-for="Input.City" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Suburb*</label>
                <div class="col-sm-8">
                    <input class="form-control" asp-for="Input.Suburb">
                    <span asp-validation-for="Input.Suburb" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Postal Code*</label>
                <div class="col-sm-8">
                    <input class="form-control" asp-for="Input.PostalCode">
                    <span asp-validation-for="Input.PostalCode" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <label asp-for="Input.SelectedRole" class="col-sm-4 col-form-label">Role*</label>
                <div class="col-sm-8">
                    @* <label asp-for="Input.SelectedRole"></label> *@
                    <select asp-for="Input.SelectedRole" asp-items="Model.Roles" class="form-control">
                        <option value="Role">-->Select Role<--</option>
                    </select>
                    <span asp-validation-for="Input.SelectedRole" class="text-danger"></span>
                </div>
            </div>
            @* <div class="form-group">
                <label asp-for="Input.SelectedRole"></label>
                <select asp-for="Input.SelectedRole" asp-items="Model.Roles" class="form-control">
                    <option value="">Select Role</option>
                </select>
                <span asp-validation-for="Input.SelectedRole" class="text-danger"></span>
            </div> *@

            <div class="row mb-3">
                <div class="offset-sm-4 col-sm-4 d-grid">
                    <button type="submit" class="btn btn-primary">Register Employee</button>
                    @* <form action="/Account/Index" method="POST">
                        <button type="submit" class="btn btn-primary">Register</button>
                    </form>
                    <button type="submit" class="btn btn-primary" onclick="window.location.href='/Account/Index'">Register</button> *@

                </div>
                <div class="col-sm-4 d-grid">
                    <a class="btn btn-outline-secondary" asp-controller="Account" asp-action="Index" role="button">
                        Back to List
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

