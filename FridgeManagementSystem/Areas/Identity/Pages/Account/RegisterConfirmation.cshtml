@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Registration Confirmation";
    
}
<!DOCTYPE html>
<head>
    <style>
        body {
            background-color: deepskyblue;
        }

        a {
            color: darkgreen;
        }
    </style>
</head>
<body>
    
    <h1 class="alert alert-success">@ViewData["Title"]</h1>

    <div class="alert alert-success" role="alert">
        <h4 class="alert-heading">Thank you for joining us, @Model.FullName!</h4>
        <p>
            Your registration was successful. Here are your login details:
        </p>
        <hr>
        <p><strong>Email:</strong> @Model.Email</p>

        <p>
            <strong>Status:</strong>
            @if (Model.DisplayLoginLink)
            {
                <span class="badge bg-success">Approved - You can login now</span>
            }
            else
            {
                <span class="badge bg-warning">Pending Approval</span>
                <br>

                <small>Your account is pending approval. You will receive a notification once approved, if not try to login after 24 hours.</small>
            }
        </p>
    </div>

    @if (Model.DisplayLoginLink)
    {
        <div class="mt-3">
            <a class="btn btn-primary" id="login-link" asp-area="Identity" asp-page="/Account/Login">Login to Your Account</a>
        </div>
    }
    else
    {
        <div class="mt-3">
            <p>You will be able to login once your account is approved by our team.</p>
            <a class="btn btn-secondary" href="/">Return to Home</a>
        </div>
    }

</body>
</html>


