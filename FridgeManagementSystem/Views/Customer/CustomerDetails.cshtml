@model FridgeManagementSystem.Models.Customer
@{
    // Use ViewBag set in controller to determine layout
    if (ViewBag.IsCustomerLiaison)
    {
        Layout = "_CustomerLiaisonLayout";
        ViewData["Title"] = "Customer Details - Liaison View";
    }
    else
    {
        Layout = "_AdminLayout";
        ViewData["Title"] = "Customer Details - Admin View";
    }
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-user"></i> Customer Details</h1>
    <div>
        <a asp-action="CustomerManagement" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to List
        </a>
        <!-- Show Edit button for both Admin and Customer Liaison -->
        @if (User.IsInRole("Admin") || ViewBag.IsCustomerLiaison)
        {
            <a asp-action="EditCustomer" asp-route-id="@Model.Id" class="btn btn-warning">
                <i class="fas fa-edit"></i> Edit Customer
            </a>
        }
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="fas fa-info-circle"></i> Contact Information</h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-sm-4 fw-bold">Full Name:</div>
                    <div class="col-sm-8">@(Model.User?.FullName ?? "N/A")</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 fw-bold">Email:</div>
                    <div class="col-sm-8">@(Model.User?.Email ?? "N/A")</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 fw-bold">Contact Number:</div>
                    <div class="col-sm-8">@(Model.User?.ContactNo ?? "N/A")</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 fw-bold">Business Name:</div>
                    <div class="col-sm-8">@Model.BusinessName</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 fw-bold">Customer Type:</div>
                    <div class="col-sm-8">
                        <span class="badge @GetCustomerTypeBadgeClass(Model.CustomerType)">@Model.CustomerType</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0"><i class="fas fa-map-marker-alt"></i> Address Information</h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-sm-4 fw-bold">Address:</div>
                    <div class="col-sm-8">@(Model.User?.Address ?? "N/A")</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 fw-bold">City:</div>
                    <div class="col-sm-8">@(Model.User?.City ?? "N/A")</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 fw-bold">Suburb:</div>
                    <div class="col-sm-8">@(Model.User?.Suburb ?? "N/A")</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 fw-bold">Postal Code:</div>
                    <div class="col-sm-8">@(Model.User?.PostalCode ?? "N/A")</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="fas fa-chart-bar"></i> Status Information</h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-sm-4 fw-bold">Status:</div>
                    <div class="col-sm-8">
                        <span class="badge @(Model.IsActive && Model.User?.IsActive == true ? "bg-success" : "bg-danger")">
                            @((Model.IsActive && Model.User?.IsActive == true) ? "Active" : "Inactive")
                        </span>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 fw-bold">Approval Status:</div>
                    <div class="col-sm-8">
                        <span class="badge @(Model.User?.ApprovalStatus == "Approved" ? "bg-success" : Model.User?.ApprovalStatus == "Rejected" ? "bg-danger" : "bg-warning")">
                            @(Model.User?.ApprovalStatus ?? "N/A")
                        </span>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 fw-bold">Created Date:</div>
                    <div class="col-sm-8">@Model.CreatedAt.ToString("MM/dd/yyyy")</div>
                </div>
                @if (!string.IsNullOrEmpty(Model.User?.ApprovedById))
                {
                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Approved By:</div>
                        <div class="col-sm-8">@(Model.User?.ApprovedBy?.FullName ?? "N/A")</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Approved Date:</div>
                        <div class="col-sm-8">@(Model.User?.ApprovedAt?.ToString("MM/dd/yyyy") ?? "N/A")</div>
                    </div>
                }
                @if (Model.CreatedBy != null)
                {
                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Created By:</div>
                        <div class="col-sm-8">@Model.CreatedByFullName</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header bg-warning text-white">
                <h5 class="mb-0"><i class="fas fa-chart-pie"></i> Statistics</h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-sm-6 fw-bold">Total Fridges:</div>
                    <div class="col-sm-6">
                        <span class="badge @(ViewBag.FridgeCount > 0 ? "bg-primary" : "bg-secondary")">
                            @(ViewBag.FridgeCount ?? 0)
                        </span>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-6 fw-bold">Active Orders:</div>
                    <div class="col-sm-6">
                        @if (ViewBag.ActiveOrdersCount > 0)
                        {
                            <span class="badge bg-warning text-light">@ViewBag.ActiveOrdersCount active order(s)</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">No active orders</span>
                        }
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-6 fw-bold">Total Orders:</div>
                    <div class="col-sm-6">
                        <span class="badge @(ViewBag.TotalOrdersCount > 0 ? "bg-info" : "bg-secondary")">
                            @(ViewBag.TotalOrdersCount ?? 0)
                        </span>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-6 fw-bold">Reported Faults:</div>
                    <div class="col-sm-6">
                        <span class="badge @(ViewBag.FaultCount > 0 ? "bg-danger" : "bg-secondary")">
                            @(ViewBag.FaultCount ?? 0)
                        </span>
                    </div>
                </div>
                
                <div class="row mb-3">
                    <div class="col-sm-6 fw-bold">Allocations:</div>
                    <div class="col-sm-6">
                        <span class="badge @(ViewBag.AllocationCount > 0 ? "bg-success" : "bg-secondary")">
                            @(ViewBag.AllocationCount ?? 0)
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Additional Sections for Detailed Information -->
<div class="row">
    <!-- Fridges Section -->
    <div class="col-12">
        <div class="card mb-4">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fas fa-refrigerator"></i> Assigned Fridges</h5>
                <span class="badge bg-light text-dark">@(Model.Fridges?.Count() ?? 0) fridges</span>
            </div>
            <div class="card-body">
                @if (Model.Fridges?.Any() == true)
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Serial Number</th>
                                    <th>Type</th>
                                    <th>Status</th>
                                    <th>Acquisition Date</th>
                                    <th>Allocation Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var fridge in Model.Fridges)
                                {
                                    <tr>
                                        <td>@fridge.SerialNumber</td>
                                        <td>@(fridge.FridgeType?.Name ?? "N/A")</td>
                                        <td>
                                            <span class="badge @(fridge.Status == "Allocated" ? "bg-success" : fridge.Status == "Reserved" ? "bg-warning" : "bg-secondary")">
                                                @fridge.Status
                                            </span>
                                        </td>
                                        <td>@fridge.AcquisitionDate.ToString("MM/dd/yyyy")</td>
                                        <td>@(fridge.AllocationDate?.ToString("MM/dd/yyyy") ?? "Not allocated")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-3">
                        <i class="fas fa-refrigerator fa-2x text-muted mb-2"></i>
                        <p class="text-muted">No fridges allocated to this customer.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@functions {
    string GetCustomerTypeBadgeClass(string customerType)
    {
        return customerType?.ToLower() switch
        {
            "spazashop" or "spazashop" => "bg-primary",
            "liquor" => "bg-success",
            "other" => "bg-info",
            _ => "bg-secondary"
        };
    }
}