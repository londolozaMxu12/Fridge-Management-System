@* <!-- Views/Customer/MyFridges.cshtml -->
@model IEnumerable<FridgeManagementSystem.Models.Fridge>
@{
    ViewData["Title"] = "My Fridges";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-refrigerator"></i> @ViewData["Title"]</h1>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <h4><i class="fas fa-info-circle"></i> No Fridges Allocated</h4>
        <p>You don't have any fridges allocated to your account yet. Please contact our customer service for assistance.</p>
    </div>
}
else
{
    <div class="row">
        @foreach (var fridge in Model)
        {
            <div class="col-md-6 mb-4">
                <div class="card">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0"><i class="fas fa-refrigerator"></i> @fridge.Model</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-6">
                                <strong>Serial Number:</strong>
                            </div>
                            <div class="col-6">
                                @fridge.SerialNumber
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6">
                                <strong>Capacity:</strong>
                            </div>
                            <div class="col-6">
                                @fridge.Capacity liters
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6">
                                <strong>Status:</strong>
                            </div>
                            <div class="col-6">
                                <span class="badge bg-success">@fridge.Status</span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6">
                                <strong>Last Service:</strong>
                            </div>
                            <div class="col-6">
                                @(fridge.LastServiceDate?.ToString("yyyy-MM-dd") ?? "Never")
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6">
                                <strong>Next Service:</strong>
                            </div>
                            <div class="col-6">
                                @(fridge.NextServiceDate?.ToString("yyyy-MM-dd") ?? "Not scheduled")
                            </div>
                        </div>
                    </div>
                    <div class="card-footer">
                        <small class="text-muted">Allocated on: @fridge.AllocationDate?.ToString("yyyy-MM-dd")</small>
                    </div>
                </div>
            </div>
        }
    </div>
} *@