@section scripts{
    <script>
        // alert("Hello");
        async function add(fridgeId){
            try{
                var response = await fetch(`/Cart/AddItem?fridgeId=${fridgeId}`);
                if (response.status==200){
                var result = await response.json();
                var cartCountEl = document.getElementById("cartCount");
                cartCountEl.innerHTML = result;
                }
            }
            catch(err){
                console.log(err);
            }
        }
    </script>
}
