@using FridgeManagementSystem.ViewModels
@model CustomerManagementViewModel
@{
    // Use ViewBag set in controller to determine layout
    if (ViewBag.IsCustomerLiaison)
    {
        Layout = "_CustomerLiaisonLayout";
        ViewData["Title"] = "Customer Management - Liaison View";
    }
    else
    {
        Layout = "_AdminLayout";
        ViewData["Title"] = "Customer Management - Admin View";
    }

    // Calculate pagination variables
    var totalPages = (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize);
    var prevDisabled = Model.PageNumber <= 1 ? "disabled" : "";
    var nextDisabled = Model.PageNumber >= totalPages ? "disabled" : "";

    string GetCustomerTypeBadgeClass(string customerType)
    {
        return customerType?.ToLower() switch
        {
            "spazashop" => "bg-primary",
            "liquor" => "bg-success",
            "other" => "bg-info",
            _ => "bg-secondary"
        };
    }

    string GetStatusDisplay(bool isActive)
    {
        return isActive ? "Active" : "Inactive";
    }
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-users"></i> @ViewData["Title"]</h1>
    @if (ViewBag.IsCustomerLiaison)
    {
        <span class="badge bg-info fs-6">Customer Liaison</span>
    }
    else
    {
        <span class="badge bg-primary fs-6">Administrator</span>
    }
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Filter Section -->
<div class="card mb-4">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="fas fa-filter"></i> Filters & Search</h5>
    </div>
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-3">
                <label for="SearchString" class="form-label">Search</label>
                <input type="text" class="form-control" id="SearchString" name="searchString"
                       value="@Model.SearchString" placeholder="Search by name, business, email...">
            </div>
            <div class="col-md-2">
                <label for="CustomerTypeFilter" class="form-label">Customer Type</label>
                <select class="form-select" id="CustomerTypeFilter" name="customerTypeFilter">
                    <option value="">All Types</option>
                    @if (ViewBag.CustomerTypes != null)
                    {
                        @foreach (var type in ViewBag.CustomerTypes)
                        {
                            <option value="@type" selected="@(Model.CustomerTypeFilter == type)">@type</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label for="StatusFilter" class="form-label">Status</label>
                <select class="form-select" id="StatusFilter" name="statusFilter">
                    <option value="active" selected="@(Model.StatusFilter == "active")">Active</option>
                    <option value="inactive" selected="@(Model.StatusFilter == "inactive")">Inactive</option>
                    <option value="all" selected="@(Model.StatusFilter == "all")">All</option>
                </select>
            </div>
            <div class="col-md-2">
                <label for="ApprovalFilter" class="form-label">Approval Status</label>
                <select class="form-select" id="ApprovalFilter" name="approvalFilter">
                    <option value="">All Approval</option>
                    @if (ViewBag.ApprovalStatuses != null)
                    {
                        @foreach (var status in ViewBag.ApprovalStatuses)
                        {
                            <option value="@status" selected="@(Model.ApprovalFilter == status)">@status</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-primary me-2">
                    <i class="fas fa-search"></i> Search
                </button>
                <a asp-action="CustomerManagement" class="btn btn-outline-secondary">Clear</a>
            </div>
            <div class="mb-3">
                <a asp-action="ExportAllCustomers" class="btn btn-primary">Export All Customers</a>
                <a asp-action="ExportActiveCustomers" class="btn btn-success">Export Active Customers</a>
                <a asp-action="ExportInactiveCustomers" class="btn btn-danger">Export Inactive Customers</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="fas fa-building m-1"></i>All Customers</h5>
        <span class="badge bg-light text-dark">Total: @Model.TotalCount</span>
    </div>
    <div class="card-body">
        @if (!Model.Customers.Any())
        {
            <div class="text-center py-4">
                <i class="fas fa-users fa-3x text-muted mb-3"></i>
                <h5>No customers found</h5>
                <p class="text-muted">No customers match your current filters.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-primary">
                        <tr>
                            <th>
                                <a asp-action="CustomerManagement"
                                   asp-route-sortBy="FullName"
                                   asp-route-sortOrder="@(Model.SortBy == "FullName" && Model.SortOrder == "asc" ? "desc" : "asc")"
                                   asp-route-searchString="@Model.SearchString"
                                   asp-route-customerTypeFilter="@Model.CustomerTypeFilter"
                                   asp-route-statusFilter="@Model.StatusFilter"
                                   asp-route-approvalFilter="@Model.ApprovalFilter"
                                   class="text-decoration-none text-dark">
                                    Full Name
                                    @if (Model.SortBy == "FullName")
                                    {
                                        <i class="fas fa-sort-@(Model.SortOrder == "asc" ? "up" : "down")"></i>
                                    }
                                    else
                                    {
                                        <i class="fas fa-sort"></i>
                                    }
                                </a>
                            </th>
                            <th>
                                <a asp-action="CustomerManagement"
                                   asp-route-sortBy="BusinessName"
                                   asp-route-sortOrder="@(Model.SortBy == "BusinessName" && Model.SortOrder == "asc" ? "desc" : "asc")"
                                   asp-route-searchString="@Model.SearchString"
                                   asp-route-customerTypeFilter="@Model.CustomerTypeFilter"
                                   asp-route-statusFilter="@Model.StatusFilter"
                                   asp-route-approvalFilter="@Model.ApprovalFilter"
                                   class="text-decoration-none text-dark">
                                    Business Name
                                    @if (Model.SortBy == "BusinessName")
                                    {
                                        <i class="fas fa-sort-@(Model.SortOrder == "asc" ? "up" : "down")"></i>
                                    }
                                    else
                                    {
                                        <i class="fas fa-sort"></i>
                                    }
                                </a>
                            </th>
                            <th>
                                <a asp-action="CustomerManagement"
                                   asp-route-sortBy="CustomerType"
                                   asp-route-sortOrder="@(Model.SortBy == "CustomerType" && Model.SortOrder == "asc" ? "desc" : "asc")"
                                   asp-route-searchString="@Model.SearchString"
                                   asp-route-customerTypeFilter="@Model.CustomerTypeFilter"
                                   asp-route-statusFilter="@Model.StatusFilter"
                                   asp-route-approvalFilter="@Model.ApprovalFilter"
                                   class="text-decoration-none text-dark">
                                    Customer Type
                                    @if (Model.SortBy == "CustomerType")
                                    {
                                        <i class="fas fa-sort-@(Model.SortOrder == "asc" ? "up" : "down")"></i>
                                    }
                                    else
                                    {
                                        <i class="fas fa-sort"></i>
                                    }
                                </a>
                            </th>
                            <th>Contact No</th>
                            <th>Status</th>
                            <th>Approval</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var customer in Model.Customers)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle bg-primary text-white rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                            @if (!string.IsNullOrEmpty(customer.FullName))
                                            {
                                                var nameParts = customer.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                                                if (nameParts.Length >= 2)
                                                {
                                                    <text>@(nameParts[0][0].ToString().ToUpper() + nameParts[1][0].ToString().ToUpper())</text>
                                                }
                                                else if (nameParts.Length == 1 && nameParts[0].Length > 0)
                                                {
                                                    <text>@(nameParts[0][0].ToString().ToUpper())</text>
                                                }
                                                else
                                                {
                                                    <i class="fas fa-user"></i>
                                                }
                                            }
                                            else
                                            {
                                                <i class="fas fa-user"></i>
                                            }
                                        </div>
                                        <div>
                                            <strong>@customer.FullName</strong>
                                            @if (!string.IsNullOrEmpty(customer.City))
                                            {
                                                <br />
                                                <small class="text-muted">@customer.City, @customer.Suburb</small>
                                            }
                                            <br />
                                            <small class="text-muted">@customer.Email</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <strong>@customer.BusinessName</strong>
                                </td>
                                <td>
                                    <span class="badge @GetCustomerTypeBadgeClass(customer.CustomerType)">@customer.CustomerType</span>
                                </td>
                                <td>@customer.ContactNo</td>
                                <td>
                                    <span class="badge @(customer.IsActive ? "bg-success" : "bg-danger")">
                                        @GetStatusDisplay(customer.IsActive)
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(customer.ApprovalStatus == "Approved" ? "bg-success" : customer.ApprovalStatus == "Rejected" ? "bg-danger" : "bg-warning")">
                                        @customer.ApprovalStatus
                                    </span>
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="CustomerDetails" asp-route-id="@customer.Id" class="btn btn-info" title="View Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="EditCustomer" asp-route-id="@customer.Id" class="btn btn-warning" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        @if (customer.IsActive)
                                        {
                                            <form asp-action="DeactivateCustomer" asp-route-id="@customer.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-danger" title="Deactivate"
                                                        onclick="return confirm('Are you sure you want to deactivate @customer.FullName?')">
                                                    <i class="fas fa-user-slash"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="ActivateCustomer" asp-route-id="@customer.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-success" title="Activate"
                                                        onclick="return confirm('Are you sure you want to activate @customer.FullName?')">
                                                    <i class="fas fa-user-check"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (totalPages > 1)
            {
                <nav aria-label="Customer pagination">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @prevDisabled">
                            <a class="page-link"
                               asp-action="CustomerManagement"
                               asp-route-pageNumber="@(Model.PageNumber - 1)"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-sortBy="@Model.SortBy"
                               asp-route-sortOrder="@Model.SortOrder"
                               asp-route-searchString="@Model.SearchString"
                               asp-route-customerTypeFilter="@Model.CustomerTypeFilter"
                               asp-route-statusFilter="@Model.StatusFilter"
                               asp-route-approvalFilter="@Model.ApprovalFilter">
                                Previous
                            </a>
                        </li>

                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                <a class="page-link"
                                   asp-action="CustomerManagement"
                                   asp-route-pageNumber="@i"
                                   asp-route-pageSize="@Model.PageSize"
                                   asp-route-sortBy="@Model.SortBy"
                                   asp-route-sortOrder="@Model.SortOrder"
                                   asp-route-searchString="@Model.SearchString"
                                   asp-route-customerTypeFilter="@Model.CustomerTypeFilter"
                                   asp-route-statusFilter="@Model.StatusFilter"
                                   asp-route-approvalFilter="@Model.ApprovalFilter">
                                    @i
                                </a>
                            </li>
                        }

                        <li class="page-item @nextDisabled">
                            <a class="page-link"
                               asp-action="CustomerManagement"
                               asp-route-pageNumber="@(Model.PageNumber + 1)"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-sortBy="@Model.SortBy"
                               asp-route-sortOrder="@Model.SortOrder"
                               asp-route-searchString="@Model.SearchString"
                               asp-route-customerTypeFilter="@Model.CustomerTypeFilter"
                               asp-route-statusFilter="@Model.StatusFilter"
                               asp-route-approvalFilter="@Model.ApprovalFilter">
                                Next
                            </a>
                        </li>
                    </ul>
                </nav>
            }

            <div class="row align-items-center mt-3">
                <div class="col-md-6">
                    <span class="text-muted">
                        Showing @((Model.PageNumber - 1) * Model.PageSize + 1) to
                        @Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount) of @Model.TotalCount entries
                    </span>
                </div>
                <div class="col-md-6 text-end">
                    <div class="btn-group">
                        <span class="me-2">Page size:</span>
                        @foreach (var size in new[] { 5, 10, 20, 50 })
                        {
                            <a class="btn btn-outline-secondary btn-sm @(Model.PageSize == size ? "active" : "")"
                               asp-action="CustomerManagement"
                               asp-route-pageNumber="1"
                               asp-route-pageSize="@size"
                               asp-route-sortBy="@Model.SortBy"
                               asp-route-sortOrder="@Model.SortOrder"
                               asp-route-searchString="@Model.SearchString"
                               asp-route-customerTypeFilter="@Model.CustomerTypeFilter"
                               asp-route-statusFilter="@Model.StatusFilter"
                               asp-route-approvalFilter="@Model.ApprovalFilter">
                                @size
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <style>
        .avatar-circle {
            font-weight: bold;
            font-size: 14px;
        }

        .table-hover tbody tr:hover {
            background-color: rgba(0, 0, 0, 0.075);
        }

        .page-item.active .page-link {
            background-color: #0d6efd;
            border-color: #0d6efd;
        }
    </style>
}