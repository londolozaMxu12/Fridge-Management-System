@model IEnumerable<Fridge>
@{
    ViewData["Title"] = "My Fridges";
    Layout = "_CustomerLayout";
}

<div class="container-fluid text-light">
    <div class="text-center d-flex justify-content-between align-items-center mb-4">
        <h3 class=" text-center text-light">
            <i class="bi bi-refrigerator me-2"></i>My Fridges
        </h3>
        <div class="badge bg-secondary fs-6">
            @Model.Count() Fridge(s)
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div class="text-black mb-4">
                <i class="bi bi-refrigerator text-black" style="font-size: 4rem;"></i>
            </div>
            <h4 class="text-light mb-3">No Fridges Allocated</h4>
            <p class="text-light mb-4">You don't have any allocated fridges at the moment.</p>
            <a asp-controller="Store" asp-action="Index" class="btn btn-primary btn-lg">
                <i class="bi bi-cart-plus me-2"></i>Browse Store
            </a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var fridge in Model)
            {
                <div class="col-xl-4 col-lg-6 col-md-6 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-header bg-light">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="card-title mb-0 text-dark">@fridge.FridgeType?.Name</h5>

                            </div>
                        </div>

                        <div class="card-body">
                            <!-- Fridge Image -->
                            <div class="text-center mb-3">
                                @if (!string.IsNullOrEmpty(fridge.ImageFileName))
                                {
                                    <img src="@Url.Content($"~/Images/Fridges/{fridge.ImageFileName}")"
                                         class="img-fluid rounded"
                                         alt="@fridge.FridgeType?.Name"
                                         style="max-height: 200px; object-fit: cover;"
                                         onerror="this.onerror=null; this.src='@Url.Content("~/Images/default-fridge.jpg")'">
                                }
                                else
                                {
                                    <img src="@Url.Content("~/Images/default-fridge.jpg")"
                                         class="img-fluid rounded"
                                         alt="Default Fridge Image"
                                         style="max-height: 200px; object-fit: cover;">
                                }
                            </div>

                            <!-- Fridge Details -->
                            <div class="mb-3">
                                <div class="row small">
                                    <div class="col-6">
                                        <strong>Brand:</strong><br>
                                        @fridge.FridgeType?.Brand
                                    </div>
                                    <div class="col-6">
                                        <strong>Model:</strong><br>
                                        @fridge.FridgeType?.Model
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="row small">
                                    <div class="col-6">
                                        <strong>Serial No:</strong><br>
                                        <span class="text-dark">@fridge.SerialNumber</span>
                                    </div>
                                    <div class="col-6">
                                        <strong>Allocated On:</strong><br>
                                        <span class="text-dark">@fridge.AllocationDate?.ToString("dd/MM/yyyy")</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Status Information -->
                            @if (fridge.Status == "Allocated")
                            {
                                <div class="alert alert-success py-2 mb-3">
                                    <small>
                                        <i class="bi bi-check-circle me-1"></i>
                                        <strong>Ready for Use</strong><br>

                                    </small>
                                </div>
                            }
                        </div>

                        <div class="card-footer bg-transparent">
                            <div class="d-grid gap-2">
                                <a asp-action="Details" asp-route-id="@fridge.FridgeId"
                                   class="btn btn-primary btn-sm">
                                    <i class="bi bi-info-circle me-1"></i>View Details
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Allocation History Section -->
        @if (ViewBag.AllocationHistory != null)
        {
            <div class="mt-5">
                <h5 class="text-light mb-3">
                    <i class="bi bi-clock-history me-2"></i>Allocation History
                </h5>
                <div class="card">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-sm table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Fridge</th>
                                        <th>Serial Number</th>
                                        <th>Allocated Date</th>
                                        <th>Order #</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var allocation in ViewBag.AllocationHistory)
                                    {
                                        <tr>
                                            <td>@allocation.Fridge.FridgeType.Name</td>
                                            <td>@allocation.Fridge.SerialNumber</td>
                                            <td>@allocation.AllocationDate.ToString("dd/MM/yyyy")</td>
                                            <td>#@allocation.OrderId</td>
                                            <td>
                                                <span class="badge bg-success">Allocated</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>