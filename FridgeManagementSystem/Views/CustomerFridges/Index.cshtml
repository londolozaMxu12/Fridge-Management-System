@model IEnumerable<FridgeManagementSystem.Models.Fridge>
@{
    ViewData["Title"] = "My Fridges";
    Layout = "_CustomerLayout";
}

<div class="container-fluid text-light">
    <div class="text-center d-flex justify-content-between align-items-center mb-4">
        <h3 class="text-center text-light">
            <i class="bi bi-refrigerator me-2"></i>My Fridges
        </h3>
        <div class="badge bg-secondary fs-6">
            @Model.Count() Fridge(s)
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div class="text-black mb-4">
                <i class="bi bi-refrigerator text-black" style="font-size: 4rem;"></i>
            </div>
            <h4 class="text-light mb-3">No Fridges Allocated</h4>
            <p class="text-light mb-4">You don't have any allocated fridges at the moment.</p>
            <a asp-controller="Store" asp-action="Index" class="btn btn-primary btn-lg">
                <i class="bi bi-cart-plus me-2"></i>Browse Store
            </a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var fridge in Model)
            {
                <div class="col-xl-4 col-lg-6 col-md-6 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-header bg-light">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="card-title mb-0 text-dark">@fridge.FridgeType?.Name</h5>
                                <span class="badge bg-success">@fridge.Status</span>
                            </div>
                        </div>

                        <div class="card-body">
                            <!-- Fridge Image -->
                            <div class="text-center mb-3">
                                @if (!string.IsNullOrEmpty(fridge.ImageFileName))
                                {
                                    <img src="@Url.Content($"~/Images/Fridges/{fridge.ImageFileName}")"
                                         class="img-fluid rounded"
                                         alt="@fridge.FridgeType?.Name"
                                         style="max-height: 200px; object-fit: cover;"
                                         onerror="this.onerror=null; this.src='@Url.Content("~/Images/default-fridge.jpg")'">
                                }
                                else
                                {
                                    <img src="@Url.Content("~/Images/default-fridge.jpg")"
                                         class="img-fluid rounded"
                                         alt="Default Fridge Image"
                                         style="max-height: 200px; object-fit: cover;">
                                }
                            </div>

                            <!-- Fridge Details -->
                            <div class="mb-3">
                                <div class="row small">
                                    <div class="col-6">
                                        <strong class="text-dark">Brand:</strong><br>
                                        <span class="text-dark">@fridge.FridgeType?.Brand</span>
                                    </div>
                                    <div class="col-6">
                                        <strong class="text-dark">Model:</strong><br>
                                        <span class="text-dark">@fridge.FridgeType?.Model</span>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="row small">
                                    <div class="col-6">
                                        <strong class="text-dark">Serial No:</strong><br>
                                        <span class="text-dark">@fridge.SerialNumber</span>
                                    </div>
                                    <div class="col-6">
                                        <strong class="text-dark">Allocated On:</strong><br>
                                        <span class="text-dark">@fridge.AllocationDate?.ToString("MM/dd/yyyy")</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Next Service Information -->
                            @if (fridge.NextServiceDate.HasValue)
                            {
                                var daysUntilService = (fridge.NextServiceDate.Value - DateTime.Now).Days;
                                var alertClass = daysUntilService <= 7 ? "alert-warning" : "alert-info";

                                <div class="alert @alertClass py-2 mb-3">
                                    <small>
                                        <i class="bi bi-tools me-1"></i>
                                        <strong>Next Service:</strong> @fridge.NextServiceDate?.ToString("MM/dd/yyyy")<br>
                                        <em>@daysUntilService days from now</em>
                                    </small>
                                </div>
                            }

                            <!-- Status Information -->
                            @if (fridge.Status == "Allocated")
                            {
                                <div class="alert alert-success py-2 mb-3">
                                    <small>
                                        <i class="bi bi-check-circle me-1"></i>
                                        <strong>Ready for Use</strong><br>
                                        Your fridge is allocated and ready to use
                                    </small>
                                </div>
                            }
                            else if (fridge.Status == "Under-Maintenance")
                            {
                                <div class="alert alert-warning py-2 mb-3">
                                    <small>
                                        <i class="bi bi-tools me-1"></i>
                                        <strong>Under Maintenance</strong><br>
                                        Your fridge is currently being serviced
                                    </small>
                                </div>
                            }
                        </div>

                        <div class="card-footer bg-transparent">
                            <div class="d-grid gap-2">
                                <a asp-action="Details" asp-route-id="@fridge.FridgeId"
                                   class="btn btn-primary btn-sm">
                                    <i class="bi bi-info-circle me-1"></i>View Details
                                </a>

                                @if (fridge.Status == "Allocated")
                                {
                                    <div class="btn-group w-100" role="group">
                                        <a asp-action="RequestMaintenance" asp-route-id="@fridge.FridgeId"
                                           class="btn btn-outline-warning btn-sm">
                                            <i class="bi bi-tools me-1"></i>Maintenance
                                        </a>
                                        <a asp-action="Create" asp-controller="CustomerFault" asp-route-id="@fridge.FridgeId"
                                           class="btn btn-outline-danger btn-sm">
                                            <i class="bi bi-exclamation-triangle me-1"></i>Report Fault
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Allocation History Section -->
        @if (ViewBag.AllocationHistory != null && ((IEnumerable<dynamic>)ViewBag.AllocationHistory).Any())
        {
            <div class="mt-5">
                <h5 class="text-light mb-3">
                    <i class="bi bi-clock-history me-2"></i>Allocation History
                </h5>
                <div class="card">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-sm table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Fridge</th>
                                        <th>Serial Number</th>
                                        <th>Allocated Date</th>
                                        <th>Order #</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var allocation in (IEnumerable<Allocation>)ViewBag.AllocationHistory)
                                    {
                                        <tr>
                                            <td>@(allocation.Fridge?.FridgeType?.Name ?? "N/A")</td>
                                            <td>@(allocation.Fridge?.SerialNumber ?? "N/A")</td>
                                            <td>@allocation.AllocationDate.ToString("MM/dd/yyyy")</td>
                                            <td>#@(allocation.OrderId?.ToString() ?? "N/A")</td>
                                            <td>
                                                <span class="badge bg-@(allocation.IsActive ? "success" : "secondary")">
                                                    @(allocation.IsActive ? "Active" : "Inactive")
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

<!-- Quick Actions Section -->
@if (Model.Any())
{
    <div class="container-fluid mt-4">
        <div class="row">
            <div class="col-md-4 mb-3">
                <div class="card bg-primary text-white">
                    <div class="card-body text-center">
                        <i class="bi bi-tools" style="font-size: 2rem;"></i>
                        <h5>Maintenance</h5>
                        <p class="small">Schedule maintenance for your fridges</p>
                        <a href="#" class="btn btn-light btn-sm">Learn More</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="card bg-warning text-dark">
                    <div class="card-body text-center">
                        <i class="bi bi-exclamation-triangle" style="font-size: 2rem;"></i>
                        <h5>Report Faults</h5>
                        <p class="small">Report any problems with your fridges</p>
                        <a asp-controller="CustomerFault" asp-action="Create" class="btn btn-dark btn-sm">Report Now</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="card bg-success text-white">
                    <div class="card-body text-center">
                        <i class="bi bi-telephone" style="font-size: 2rem;"></i>
                        <h5>Support</h5>
                        <p class="small">24/7 customer support available</p>
                        <a href="#" class="btn btn-light btn-sm">Contact Us</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Add hover effects to cards
            const cards = document.querySelectorAll('.card');
            cards.forEach(card => {
                card.addEventListener('mouseenter', function() {
                    this.style.transform = 'translateY(-5px)';
                    this.style.transition = 'transform 0.3s ease';
                });

                card.addEventListener('mouseleave', function() {
                    this.style.transform = 'translateY(0)';
                });
            });

            // Auto-dismiss alerts after 5 seconds
            setTimeout(function() {
                const alerts = document.querySelectorAll('.alert');
                alerts.forEach(alert => {
                    const bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                });
            }, 5000);
        });
    </script>
}