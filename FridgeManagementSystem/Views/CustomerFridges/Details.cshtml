@model FridgeManagementSystem.Models.Fridge
@{
    ViewData["Title"] = "Fridge Details";
    Layout = "_CustomerLayout";
}

<div class="container-fluid">
    <!-- Success/Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="text-light">
            <i class="bi bi-refrigerator me-2"></i>Fridge Details
        </h3>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back to My Fridges
        </a>
    </div>

    <div class="row">
        <!-- Fridge Image and Basic Info -->
        <div class="col-lg-4 col-md-5 mb-4">
            <div class="card">
                <div class="card-body text-center">
                    @if (!string.IsNullOrEmpty(Model.ImageFileName))
                    {
                        <img src="@Url.Content($"~/Images/Fridges/{Model.ImageFileName}")"
                             class="img-fluid rounded mb-3"
                             alt="@Model.FridgeType?.Name"
                             style="max-height: 300px; object-fit: cover;"
                             onerror="this.onerror=null; this.src='@Url.Content("~/Images/default-fridge.jpg")'">
                    }
                    else
                    {
                        <div class="bg-light rounded d-flex align-items-center justify-content-center mb-3"
                             style="height: 300px;">
                            <i class="bi bi-refrigerator text-muted" style="font-size: 4rem;"></i>
                        </div>
                    }

                    <h4 class="text-dark">@(Model.FridgeType?.Name ?? "N/A")</h4>
                    <p class="text-muted">@(Model.FridgeType?.Brand ?? "N/A") @(Model.FridgeType?.Model ?? "N/A")</p>

                    <div class="d-grid gap-2">
                        @{
                            var statusBadgeClass = Model.Status?.ToLower() switch
                            {
                                "allocated" => "bg-success",
                                "underrepair" => "bg-warning",
                                "reserved" => "bg-info",
                                "available" => "bg-secondary",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge @statusBadgeClass fs-6">@Model.Status</span>
                    </div>
                </div>
            </div>

            <!-- Quick Stats -->
            <div class="card mt-3">
                <div class="card-header bg-light">
                    <h6 class="card-title mb-0 text-dark">
                        <i class="bi bi-graph-up me-2"></i>Quick Stats
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-6">
                            <h5 class="text-primary">@(Model.MaintenanceRecords?.Count ?? 0)</h5>
                            <small class="text-muted">Services</small>
                        </div>
                        <div class="col-6">
                            <h5 class="text-warning">@(Model.ReportedFaults?.Count ?? 0)</h5>
                            <small class="text-muted">Faults</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Fridge Details -->
        <div class="col-lg-8 col-md-7">
            <div class="card">
                <div class="card-header bg-info">
                    <h5 class="card-title mb-0 text-light">
                        <i class="bi bi-info-circle me-2"></i>Fridge Information
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <table class="table table-borderless">
                                <tr>
                                    <td><strong>Serial No:</strong></td>
                                    <td>@Model.SerialNumber</td>
                                </tr>
                                <tr>
                                    <td><strong>Brand:</strong></td>
                                    <td>@(Model.FridgeType?.Brand ?? "N/A")</td>
                                </tr>
                                <tr>
                                    <td><strong>Model:</strong></td>
                                    <td>@(Model.FridgeType?.Model ?? "N/A")</td>
                                </tr>
                                <tr>
                                    <td><strong>Category:</strong></td>
                                    <td>@(Model.FridgeType?.Name ?? "N/A")</td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <table class="table table-borderless">
                                <tr>
                                    <td><strong>Allocation Date:</strong></td>
                                    <td>@(Model.AllocationDate?.ToString("MM/dd/yyyy") ?? "N/A")</td>
                                </tr>
                                <tr>
                                    <td><strong>Status:</strong></td>
                                    <td>
                                        @{
                                            var badgeClass = Model.Status?.ToLower() switch
                                            {
                                                "allocated" => "bg-success",
                                                "underrepair" => "bg-warning",
                                                "reserved" => "bg-info",
                                                "available" => "bg-secondary",
                                                _ => "bg-secondary"
                                            };
                                        }
                                        <span class="badge @badgeClass">@Model.Status</span>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Next Service:</strong></td>
                                    <td>
                                        @if (Model.NextServiceDate.HasValue)
                                        {
                                            var daysUntilService = (Model.NextServiceDate.Value - DateTime.Now).Days;
                                            var serviceClass = daysUntilService <= 7 ? "text-warning" : "text-success";
                                            <span class="@serviceClass">
                                                @Model.NextServiceDate?.ToString("MM/dd/yyyy")
                                                <small class="text-muted">(@daysUntilService days)</small>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not scheduled</span>
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Acquisition Date:</strong></td>
                                    <td>@Model.AcquisitionDate.ToString("MM/dd/yyyy")</td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <!-- Description -->
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <div class="mt-3">
                            <strong>Description:</strong>
                            <p class="text-muted mb-0">@Model.Description</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Maintenance Information -->
            @* @if (Model.MaintenanceRecords != null && Model.MaintenanceRecords.Any())
            {
                <div class="card mt-4">
                    <div class="card-header bg-light">
                        <h5 class="card-title mb-0 text-dark">
                            <i class="bi bi-calendar-check me-2"></i>Maintenance History
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead class="table-light">
                                    <tr>
                                        <th>Service Date</th>
                                        <th>Description</th>
                                        <th>Technician</th>
                                        <th>Next Service</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var record in Model.MaintenanceRecords.OrderByDescending(m => m.ServiceDate).Take(5))
                                    {
                                        <tr>
                                            <td>@record.ServiceDate.ToString("MM/dd/yyyy")</td>
                                            <td>@record.Description</td>
                                            <td>@(record.MaintenanceTechnician?.User?.FullName ?? "N/A")</td>
                                            <td>@(record.NextServiceDate?.ToString("MM/dd/yyyy") ?? "Not set")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        @if (Model.MaintenanceRecords.Count > 5)
                        {
                            <div class="text-center mt-2">
                                <a asp-action="MaintenanceHistory" asp-route-id="@Model.FridgeId" class="btn btn-outline-primary btn-sm">
                                    View All Maintenance Records
                                </a>
                            </div>
                        }
                    </div>
                </div>
            } *@

            <!-- Quick Actions -->
            <div class="card mt-4">
                <div class="card-header bg-primary">
                    <h5 class="card-title mb-0 text-light">
                        <i class="bi bg-info me-2"></i>Quick Actions
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-center">
                        <div class="col-md-4">
                            <a asp-controller="CustomerFault" asp-action="Create" asp-route-id="@Model.FridgeId"
                               class="btn btn-outline-danger w-100">
                                <i class="bi bi-exclamation-triangle me-1"></i>Report Fault
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent Faults -->
            @if (Model.ReportedFaults != null && Model.ReportedFaults.Any())
            {
                <div class="card mt-4">
                    <div class="card-header bg-warning">
                        <h5 class="card-title mb-0 text-dark">
                            <i class="bi bi-exclamation-triangle me-2"></i>Recent Fault Reports
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead class="table-light">
                                    <tr>
                                        <th>Reported Date</th>
                                        <th>Title</th>
                                        <th>Status</th>
                                        <th>Priority</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var fault in Model.ReportedFaults.OrderByDescending(f => f.ReportedDate).Take(5))
                                    {
                                        <tr>
                                            <td>@fault.ReportedDate.ToString("MM/dd/yyyy")</td>
                                            <td>@fault.Title</td>
                                            <td>
                                                <span class="badge bg-@(fault.Status == FaultStatus.Completed ? "success" : fault.Status == FaultStatus.Scheduled ? "info": "warning")">
                                                    @fault.Status
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge bg-@(fault.Priority == FaultPriority.High ? "danger" : fault.Priority == FaultPriority.Medium ? "warning" : "info")">
                                                    @fault.Priority
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Auto-dismiss alerts after 5 seconds
            setTimeout(function() {
                const alerts = document.querySelectorAll('.alert');
                alerts.forEach(alert => {
                    const bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                });
            }, 5000);

            // Add confirmation for critical actions
            const reportButtons = document.querySelectorAll('a[href*="Create"], a[href*="RequestMaintenance"]');
            reportButtons.forEach(button => {
                button.addEventListener('click', function(e) {
                    if (!confirm('Are you sure you want to proceed with this action?')) {
                        e.preventDefault();
                    }
                });
            });
        });
    </script>
}