@model Fridge
@{
    ViewData["Title"] = "Fridge Details";
    Layout = "_CustomerLayout";
}

<div class="container-fluid ">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="text-light">
            <i class="bi bi-refrigerator me-2"></i>Fridge Details
        </h3>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back to My Fridges
        </a>
    </div>

    <div class="row">
        <!-- Fridge Image and Basic Info -->
        <div class="col-lg-4 col-md-5 mb-4">
            <div class="card">
                <div class="card-body text-center">
                    @if (!string.IsNullOrEmpty(Model.ImageFileName))
                    {
                        <img src="/Images/Fridges/@Model.ImageFileName"
                             class="img-fluid rounded mb-3"
                             alt="@Model.FridgeType.Name"
                             style="max-height: 300px; object-fit: cover;">
                    }
                    else
                    {
                        <div class="bg-light rounded d-flex align-items-center justify-content-center mb-3"
                             style="height: 300px;">
                            <i class="bi bi-refrigerator text-muted" style="font-size: 4rem;"></i>
                        </div>
                    }

                    <h4 class="text-dark">@Model.FridgeType.Name</h4>
                    <p class="text-muted">@Model.FridgeType.Brand @Model.FridgeType.Model</p>

                    <div class="d-grid gap-2">
                        <span class="badge bg-success fs-6">Allocated</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Fridge Details -->
        <div class="col-lg-8 col-md-7">
            <div class="card">
                <div class="card-header bg-info">
                    <h5 class="card-title mb-0 text-light">
                        <i class="bi bi-info-circle me-2"></i>Fridge Information
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <table class="table table-borderless">
                                <tr>
                                    <td><strong>Serial No:</strong></td>
                                    <td>@Model.SerialNumber</td>
                                </tr>
                                <tr>
                                    <td><strong>Brand:</strong></td>
                                    <td>@Model.FridgeType.Brand</td>
                                </tr>
                                <tr>
                                    <td><strong>Model:</strong></td>
                                    <td>@Model.FridgeType.Model</td>
                                </tr>
                                
                            </table>
                        </div>
                        <div class="col-md-6">
                            <table class="table table-borderless">
                                <tr>
                                    <td><strong>Allocation Date:</strong></td>
                                    <td>@Model.AllocationDate?.ToString("dd/MM/yyyy")</td>
                                </tr>
                                <tr>
                                    <td><strong>Status:</strong></td>
                                    <td><span class="badge bg-success">@Model.Status</span></td>
                                </tr>
                                
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            @* <!-- Maintenance Information -->
            @if (ViewBag.MaintenanceSchedule != null && ((IEnumerable<dynamic>)ViewBag.MaintenanceSchedule).Any())
            {
                <div class="card mt-4">
                    <div class="card-header bg-light">
                        <h5 class="card-title mb-0 text-dark">
                            <i class="bi bi-calendar-check me-2"></i>Upcoming Maintenance
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead class="table-light">
                                    <tr>
                                        <th>Scheduled Date</th>
                                        <th>Service Type</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var schedule in ViewBag.MaintenanceSchedule)
                                    {
                                        <tr>
                                            <td>@schedule.ScheduledDate.ToString("dd/MM/yyyy")</td>
                                            <td>@schedule.MaintenanceRecord?.ServiceType</td>
                                            <td>
                                                <span class="badge bg-warning">Scheduled</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            } *@

            <!-- Quick Actions -->
            <div class="card mt-4">
                <div class="card-header bg-primary">
                    <h5 class="card-title mb-0 text-light">
                        <i class="bi bi-lightning me-2"></i>Quick Actions
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-md-4">
                            <a asp-controller="CustomerFault" asp-action="Create" asp-route-fridgeId="@Model.FridgeId"
                               class="btn btn-outline-warning w-100">
                                <i class="bi bi-exclamation-triangle me-1"></i>Report Fault
                            </a>
                        </div>
                        <div class="col-md-4">
                            <a asp-controller="##" asp-action="#" asp-route-fridgeId="@Model.FridgeId"
                               class="btn btn-outline-info w-100">
                                <i class="bi bi-tools me-1"></i>Request Service
                            </a>
                        </div>
                        
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>