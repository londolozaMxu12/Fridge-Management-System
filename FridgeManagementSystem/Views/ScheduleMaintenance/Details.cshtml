@model FridgeManagementSystem.Models.ScheduleMaintenance

@{
    ViewBag.Title = "Maintenance Schedule Details";
}

<h2>Maintenance Schedule Details</h2>
<hr />

<dl class="dl-horizontal">


    <dt>Scheduled Date</dt>
    <dd>@Model.ScheduledDate</dd>

    <dt>Description</dt>
    <dd>@Model.Description</dd>

    <dt>Technician</dt>
    <dd>@Model.MaintenanceTechnician.EmployeeNo</dd>

    <dt>Customer</dt>
    <dd>@Model.Customer?.User.FullName</dd>

    <dt>Customer Email</dt>
    <dd>@Model.Customer?.User.Email</dd>

    <dt>Customer Address</dt>
    <dd>@Model.Customer?.User.Address</dd>
</dl>

<p>
    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-default" })
</p>