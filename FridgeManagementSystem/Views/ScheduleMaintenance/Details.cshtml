 @model FridgeManagementSystem.Models.ScheduleMaintenance

@{
    ViewData["Title"] = "Schedule Details";
}
<!DOCTYPE html>
<html>
    <head>
        <style>
            body{
                color:black;
            }
        </style>
    </head>
    <body>
    <h2>Schedule Details</h2>

    <div class="card p-3 shadow-sm rounded-3 mt-3">
        <dl class="row">
            <dt class="col-sm-3">Customer Name</dt>
            <dd class="col-sm-9">@Model.Customer?.BusinessName</dd>

            <dt class="col-sm-3">Technician</dt>
            <dd class="col-sm-9">@Model.MaintenanceTechnician?.EmployeeNo</dd>

            <dt class="col-sm-3">Scheduled Date</dt>
            <dd class="col-sm-9">@Model.ScheduledDate.ToString("f")</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@Model.Description</dd>
        </dl>

        <div class="mt-3">
            <a asp-action="Edit" asp-route-id="@Model.scheduleMaintenanceId" class="btn btn-warning">Edit</a>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </div>
    </body>
</html>
