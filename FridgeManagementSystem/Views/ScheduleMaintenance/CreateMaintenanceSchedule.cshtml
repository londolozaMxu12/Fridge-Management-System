@model FridgeManagementSystem.Models.ScheduleMaintenance

<!DOCTYPE html>
    <head>
        <style>
        body {
            background-image: url('images/broken-fridge-repair-by-african-260nw-2299218251.jpg');
            margin: 0; /* remove default spacing */
            padding: 0;
            height: 100vh;
            background-size: cover;
            color: black;
        }

            body::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-color: rgba(0, 123, 255, 0.5); /* dark overlay */

                z-index: -2;
            }

        </style>
    </head>
    <body>
        <div class="btn">
       @*  <a onclick="location.href='@Url.Action("MaintenanceManagement", "CustomerList")'" style="float: left   " class="btn btn-primary">BACK</a> *@
        <a class="btn btn-primary" asp-action="CustomerList" asp-controller="MaintenanceManagement">BACK</a>
        </div>
    <h2>Create Appointment</h2>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-horizontal">
            <div class="form-group">
                @Html.LabelFor(model => model.ScheduledDate, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-10">
                    @Html.TextBoxFor(model => model.ScheduledDate, new { @class = "form-control", type = "date" })
                    @Html.ValidationMessageFor(model => model.ScheduledDate, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-offset-2 col-md-10">
                    <input type="submit" value="Create" class="btn btn-primary" />
                </div>
            </div>
        </div>
    }
    </body>
</html>
