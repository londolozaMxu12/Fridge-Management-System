
@model FridgeManagementSystem.Models.ScheduleMaintenance
@using FridgeManagementSystem.Controllers
<!DOCTYPE html>
<html>
    <head>
        <style>
        body {
            background-image: url('images/broken-fridge-repair-by-african-260nw-2299218251.jpg');
            margin: 0; /* remove default spacing */
            padding: 0;
            height: 100vh;
            background-size: cover;
            color: black;
        }

            body::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-color: rgba(0, 123, 255, 0.5); /* dark overlay */

                z-index: -2;
            }

        </style>
    </head>
    <body>
        <div class="btn">
       @*  <a onclick="location.href='@Url.Action("MaintenanceManagement", "CustomerList")'" style="float: left   " class="btn btn-primary">BACK</a> *@
        <a class="btn btn-primary" asp-action="CustomerList" asp-controller="MaintenanceManagement">BACK</a>
        </div>
    <h2>Create Appointment</h2>
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <div class="form-horizontal">
            <div class="form-group">
                @Html.LabelFor(m => m.Description, htmlAttributes: new { @class = "control-label" })
                @Html.TextBoxFor(m => m.Description, new { @class = "form-control", @placeholder = " " })
                @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
                </div>
            
            <div class="form-group">
                @Html.LabelFor(m => m.ScheduledDate, new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    @Html.TextBoxFor(m => m.ScheduledDate, new { @class = "form-control", @id = "datepicker", @autocomplete = "off" })
                    @Html.ValidationMessageFor(m => m.ScheduledDate, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-offset-2 col-md-10">
                    <input type="submit" value="Save" class="btn btn-primary" />
                </div>
            </div>
        </div>
    }
    
    </body>
</html>
@section Scripts {
    <link rel="stylesheet"
          href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css" />
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>

    <script>
        $(function () {
            $("#datepicker").datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true
            });
        });
    </script>
}
