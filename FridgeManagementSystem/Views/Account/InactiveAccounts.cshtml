@using FridgeManagementSystem.ViewModels
@model IEnumerable<EmployeeViewModel>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Inactive Employees";
}

<div class="container">
    <h2>Inactive Employees</h2>

    <div class="d-flex justify-content-between mb-3">
        <a asp-action="Index" class="btn btn-outline-secondary">Back to Active Employees</a>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Full Name</th>
                <th>Email</th>
                <th>Contact No</th>
                <th>Role</th>
                <th>Status</th>
                <th>Created</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.FullName</td>
                    <td>@item.Email</td>
                    <td>@item.ContactNo</td>
                    <td>@string.Join(", ", item.Roles)</td>
                    <td>
                        <span class="badge @(item.IsActive ? "bg-success" : "bg-danger")">
                            @(item.IsActive ? "Active" : "Inactive")
                        </span>
                    </td>
                    <td>@(item.CreatedAt.ToString("yyyy-MM-dd") ?? "Not set")</td>
                    <td>
                        @* <form asp-action="ReactivateEmployeeAccount" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-sm btn-success">Reactivate Employee</button>
                        </form> *@
                        <a class="btn btn-sm btn-success" asp-controller="Account" asp-action="ReactivateEmployeeAccount"
                           asp-route-id="@item.Id" onclick="return confirm('Are you sure you want to reactivate this employee account?')">Reactivate Employee</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
