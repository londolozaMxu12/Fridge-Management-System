@model EmployeeViewModel
@using FridgeManagementSystem.ViewModels
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Employee Details";
}

<div class="container">
    <h2>Employee Details</h2>

    <div class="card">
        <div class="card-header">
            <h4>Employee Information</h4>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">ID</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3">Full Name</dt>
                <dd class="col-sm-9">@Model.FullName</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.Email</dd>

                <dt class="col-sm-3">Contact Number</dt>
                <dd class="col-sm-9">@Model.ContactNo</dd>

                <dt class="col-sm-3">Address</dt>
                <dd class="col-sm-9">@Model.Address</dd>

                <dt class="col-sm-3">City</dt>
                <dd class="col-sm-9">@Model.City</dd>

                <dt class="col-sm-3">Suburb</dt>
                <dd class="col-sm-9">@Model.Suburb</dd>

                <dt class="col-sm-3">Postal Code</dt>
                <dd class="col-sm-9">@Model.PostalCode</dd>

                <dt class="col-sm-3">Roles</dt>
                <dd class="col-sm-9">@string.Join(", ", Model.Roles)</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    <span class="badge @(Model.IsActive ? "bg-success" : "bg-danger")">
                        @(Model.IsActive ? "Active" : "Inactive")
                    </span>
                </dd>

                <dt class="col-sm-3">Created At</dt>
                <dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
            </dl>
        </div>
        <div class="card-footer">
            <a asp-action="EditEmployee" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
            @* <a asp-action="DeactivateAccount" asp-route-id="@Model.Id" class="btn btn-sm btn-danger">Delete</a> *@
            <a class="btn btn-danger" asp-controller="Account" asp-action="DeactivateAccount"
               asp-route-id="@Model.Id" onclick="return confirm('Are you sure you want to deactivate this employee account?')">Delete</a>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </div>
</div>