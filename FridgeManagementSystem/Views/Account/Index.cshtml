@using FridgeManagementSystem.ViewModels
@model IEnumerable<EmployeeViewModel>
@{
    Layout = "_AdminLayout";
}

@{
    ViewData["Title"] = "Active Employees";
}

<div class="container">
    <h2>Active Employees</h2>

    <div class="d-flex justify-content-between mb-3">


        <a asp-controller="Account" asp-action="EmployeeRegister" class="btn btn-primary bi bi-plus-circle me-3">Create New Employee</a>
        <a asp-action="InactiveAccounts" class="btn btn-outline-secondary">View Inactive Employees</a>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                @* <th>Employee ID</th> *@
                <th>Full Name</th>
                <th>Email</th>
                @* <th>Contact No</th> *@
                @* <th>Address</th>
                <th>City</th>
                <th>Suburb</th> *@
                <th>Role</th>
                <th>Status</th>
                <th>Created</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    @* <td>@item.Id</td> *@
                    <td>@item.FullName</td>
                    <td>@item.Email</td>
                    @* <td>@item.ContactNo</td> *@
                    @* <td>@item.Address</td>
                    <td>@item.City</td>
                    <td>@item.Suburb</td> *@
                    <td>
                        @string.Join(", ", item.Roles)

                    </td>
                    <td>
                        <span class="badge @(item.IsActive ? "bg-success" : "bg-danger")">
                            @(item.IsActive ? "Active" : "Inactive")
                        </span>
                    </td>
                    @* <td>@item.CreatedAt.ToString("yyyy-MM-dd")</td> *@
                    <td>@(item.CreatedAt.ToString("yyyy-MM-dd") ?? "Not set")</td>
                    <td>
                        <a asp-action="EditEmployee" asp-route-id="@item.Id" class="btn btn-sm btn-warning bi bi-pencil-square">Edit</a>
                       
                        <a asp-action="EmployeeDetails" asp-route-id="@item.Id" class="btn btn-sm btn-info bi bi-eye">Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
