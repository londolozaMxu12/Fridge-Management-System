@using FridgeManagementSystem.ViewModels
@model EmployeeViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Reactivate Employee";
}

<div class="container">
    <h2 class="text-center mb-3">Reactivate Employee</h2>

    <div class="alert alert-success">
        <h4>Are you sure you want to reactivate this employee?</h4>
        <p class="mb-0">
            Reactivating will allow this employee to log in again and access the system with their existing credentials and permissions.
        </p>
    </div>

    <div class="card">
        <div class="card-header">
            <h4>Employee Information</h4>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">ID</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3">Full Name</dt>
                <dd class="col-sm-9">@Model.FullName</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.Email</dd>

                <dt class="col-sm-3">Contact Number</dt>
                <dd class="col-sm-9">@Model.ContactNo</dd>

                <dt class="col-sm-3">Roles</dt>
                <dd class="col-sm-9">@string.Join(", ", Model.Roles)</dd>

                <dt class="col-sm-3">Current Status</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-danger">Inactive</span>
                </dd>

                <dt class="col-sm-3">Status After Reactivation</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-success">Active</span>
                </dd>

                <dt class="col-sm-3">Created At</dt>
                <dd class="col-sm-9">@(Model.CreatedAt.ToString("yyyy-MM-dd HH:mm") ?? "Not set")</dd>
            </dl>
        </div>
        <div class="card-footer">
            <!-- FIX: Change asp-action to match your POST method -->
            <form asp-action="ReactivateEmployeeAccount" method="post">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-success">Reactivate Employee</button>
                <a asp-action="InactiveAccounts" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>