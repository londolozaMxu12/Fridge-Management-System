@model IEnumerable<FridgeManagementSystem.Models.Allocation>
@{
    ViewData["Title"] = "Allocation History";
    Layout = "_CustomerLiaisonLayout";
}

<h3 class="text-center mb-4">Allocation History</h3>

@if (!Model.Any())
{
    <div class="alert alert-info text-center">
        <i class="bi bi-info-circle"></i> No allocation history found.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-primary">
                <tr>
                    <th>Allocation Date</th>
                    <th>Order ID</th>
                    <th>Customer</th>
                    <th>Fridge</th>
                    <th>Serial Number</th>
                    <th>Allocated By</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var allocation in Model)
                {
                    <tr>
                        <td>@allocation.AllocationDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            @if (allocation.OrderId.HasValue)
                            {
                                <a asp-controller="LiaisonOrders" asp-action="Details" asp-route-id="@allocation.OrderId"
                                   class="text-decoration-none">
                                    #@allocation.OrderId
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">N/A</span>
                            }
                        </td>
                        <td>@allocation.Customer?.User?.FullName</td>
                        <td>@allocation.Fridge?.FridgeType?.Name</td>
                        <td>@allocation.Fridge?.SerialNumber</td>
                        <td>@allocation.AllocatedBy?.FullName</td>
                        <td>
                            @if (allocation.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Back to Allocations
    </a>
</div>