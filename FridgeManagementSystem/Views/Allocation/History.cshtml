@model IEnumerable<FridgeManagementSystem.Models.Allocation>
@{
    ViewData["Title"] = "Allocation History";
    Layout = "_CustomerLiaisonLayout";
}

<h3 class="text-center mb-4">📊 Allocation History</h3>

@if (!Model.Any())
{
    <div class="alert alert-info text-center">
        <i class="bi bi-info-circle"></i> No allocation history found.
    </div>
}
else
{
    <!-- Statistics Summary -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <h6 class="card-title">Allocation Summary</h6>
                    <div class="row text-center">
                        <div class="col">
                            <h4>@Model.Count()</h4>
                            <small class="text-muted">Total Allocations</small>
                        </div>
                        <div class="col">
                            <h4>@Model.Count(a => a.IsActive)</h4>
                            <small class="text-muted">Active Allocations</small>
                        </div>
                        <div class="col">
                            <h4>@Model.Count(a => !a.IsActive)</h4>
                            <small class="text-muted">Inactive Allocations</small>
                        </div>
                        <div class="col">
                            <h4>@Model.Select(a => a.CustomerId).Distinct().Count()</h4>
                            <small class="text-muted">Unique Customers</small>
                        </div>
                        <div class="col">
                            <h4>@Model.Select(a => a.FridgeId).Distinct().Count()</h4>
                            <small class="text-muted">Unique Fridges</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover" id="allocationTable">
            <thead class="table-primary">
                <tr>
                    <th>Allocation Date</th>
                    <th>Order ID</th>
                    <th>Customer</th>
                    <th>Business</th>
                    <th>Fridge Details</th>
                    <th>Allocated By</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var allocation in Model)
                {
                    <tr>
                        <td>
                            @allocation.AllocationDate.ToString("MM/dd/yyyy")
                            <br />
                            <small class="text-muted">@allocation.AllocationDate.ToString("HH:mm")</small>
                        </td>
                        <td>
                            @if (allocation.OrderId.HasValue)
                            {
                                <a asp-controller="LiaisonOrders" asp-action="Details" asp-route-id="@allocation.OrderId"
                                   class="text-decoration-none fw-bold" title="View Order Details">
                                    #@allocation.OrderId
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">N/A</span>
                            }
                        </td>
                        <td>
                            @(allocation.Customer?.User?.FullName ?? "N/A")
                            @if (!string.IsNullOrEmpty(allocation.Customer?.User?.Email))
                            {
                                <br />
                                <small class="text-muted">@allocation.Customer.User.Email</small>
                            }
                        </td>
                        <td>
                            @(allocation.Customer?.BusinessName ?? "N/A")
                            @if (!string.IsNullOrEmpty(allocation.Customer?.CustomerType))
                            {
                                <br />
                                <small class="text-muted">@allocation.Customer.CustomerType</small>
                            }
                        </td>
                        <td>
                            <div class="fw-bold">@(allocation.Fridge?.FridgeType?.Name ?? "N/A")</div>
                            <small class="text-muted">
                                @(allocation.Fridge?.FridgeType?.Brand ?? "N/A") - @(allocation.Fridge?.FridgeType?.Model ?? "N/A")
                                @if (!string.IsNullOrEmpty(allocation.Fridge?.SerialNumber))
                                {
                                    <br />
                                    <strong>Serial:</strong>
 
                                    @allocation.Fridge.SerialNumber
                                }
                                <br />
                                <strong>Fridge ID:</strong> @allocation.FridgeId
                            </small>
                        </td>
                        <td>
                            @(allocation.AllocatedBy?.FullName ?? "System")
                            @if (!string.IsNullOrEmpty(allocation.AllocatedBy?.Email))
                            {
                                <br />
                                <small class="text-muted">@allocation.AllocatedBy.Email</small>
                            }
                        </td>
                        <td>
                            @if (allocation.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                                <br />
                                <small class="text-muted">@((DateTime.Now - allocation.AllocationDate).Days) day@((DateTime.Now - allocation.AllocationDate).Days != 1 ? "s" : "") ago</small>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group-vertical btn-group-sm">
                                @if (allocation.OrderId.HasValue)
                                {
                                    <a asp-controller="LiaisonOrders" asp-action="Details" asp-route-id="@allocation.OrderId"
                                       class="btn btn-outline-primary btn-sm" title="View Order">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                }
                                @if (allocation.FridgeId > 0)
                                {
                                    <a href="@Url.Action("Details", "Fridge", new { id = allocation.FridgeId })"
                                       class="btn btn-outline-info btn-sm mt-1" title="View Fridge">
                                        <i class="bi bi-box"></i>
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Export Options -->
    <div class="mt-3 d-flex justify-content-between align-items-center">
        <div>
            <span class="text-muted">
                Showing @Model.Count() allocation@(Model.Count() != 1 ? "s" : "")
                @if (Model.Any())
                {
                    <text>from @Model.Min(a => a.AllocationDate).ToString("MMM dd, yyyy") to @Model.Max(a => a.AllocationDate).ToString("MMM dd, yyyy")</text>
                }
            </span>
        </div>
        <div class="export-buttons">
            <a asp-action="ExportAllocationHistoryPdf" class="btn btn-outline-danger btn-sm">
                <i class="bi bi-file-pdf me-1"></i> Export PDF
            </a>
        </div>
    </div>
}

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back to Allocations
    </a>
</div>

<!-- Hidden div for PDF content -->
<div id="pdfContent" style="display: none;">
    <div id="pdfHeader">
        <h2 style="text-align: center; color: #2c3e50; margin-bottom: 10px;">Allocation History Report</h2>
        <p style="text-align: center; color: #7f8c8d; margin-bottom: 20px;">
            Generated on: @DateTime.Now.ToString("MMMM dd, yyyy 'at' hh:mm tt")
        </p>
        <hr style="border-top: 2px solid #3498db; margin-bottom: 20px;">
    </div>
    <table id="pdfTable" style="width: 100%; border-collapse: collapse;">
        <thead>
            <tr style="background-color: #3498db; color: white;">
                <th style="border: 1px solid #2980b9; padding: 8px; text-align: left;">Allocation Date</th>
                <th style="border: 1px solid #2980b9; padding: 8px; text-align: left;">Order ID</th>
                <th style="border: 1px solid #2980b9; padding: 8px; text-align: left;">Customer</th>
                <th style="border: 1px solid #2980b9; padding: 8px; text-align: left;">Business</th>
                <th style="border: 1px solid #2980b9; padding: 8px; text-align: left;">Fridge Details</th>
                <th style="border: 1px solid #2980b9; padding: 8px; text-align: left;">Allocated By</th>
                <th style="border: 1px solid #2980b9; padding: 8px; text-align: left;">Status</th>
            </tr>
        </thead>
        <tbody>
            <!-- Table rows will be populated by JavaScript -->
        </tbody>
    </table>
</div>

@section Scripts {
    <!-- Include jsPDF library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

    <script>
        // Add interactive features
        $(document).ready(function() {
            // Add row hover effects
            $('table tbody tr').hover(
                function() {
                    $(this).addClass('table-active');
                },
                function() {
                    $(this).removeClass('table-active');
                }
            );

            // Initialize tooltips
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[title]'))
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl)
            });
        });

        // PDF Export function
        function exportToPDF() {
            // Show loading state
            const exportBtn = event.target;
            const originalText = exportBtn.innerHTML;
            exportBtn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i> Generating PDF...';
            exportBtn.disabled = true;

            try {
                // Initialize jsPDF
                const { jsPDF } = window.jspdf;
                const doc = new jsPDF('landscape');

                // Add title and date
                doc.setFontSize(18);
                doc.setTextColor(44, 62, 80);
                doc.text('Allocation History Report', 14, 22);

                doc.setFontSize(10);
                doc.setTextColor(127, 140, 141);
                doc.text(`Generated on: ${new Date().toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit'
                })}`, 14, 30);

                // Add summary statistics
                const totalAllocations = @Model.Count();
                const activeAllocations = @Model.Count(a => a.IsActive);
                const uniqueCustomers = @Model.Select(a => a.CustomerId).Distinct().Count();
                const uniqueFridges = @Model.Select(a => a.FridgeId).Distinct().Count();

                doc.setFontSize(11);
                doc.setTextColor(0, 0, 0);
                doc.text(`Total Allocations: ${totalAllocations} | Active: ${activeAllocations} | Unique Customers: ${uniqueCustomers} | Unique Fridges: ${uniqueFridges}`, 14, 40);

                // Prepare table data
                const tableData = [];

                // Add headers
                tableData.push([
                    'Allocation Date',
                    'Order ID',
                    'Customer',
                    'Business',
                    'Fridge Details',
                    'Allocated By',
                    'Status'
                ]);

                // Add data rows
                @foreach (var allocation in Model)
                {
                        <text>
                        tableData.push([
                            '@allocation.AllocationDate.ToString("MM/dd/yyyy HH:mm")',
                            '@(allocation.OrderId?.ToString() ?? "N/A")',
                            '@(allocation.Customer?.User?.FullName?.Replace("'", "''") ?? "N/A")',
                            '@(allocation.Customer?.BusinessName?.Replace("'", "''") ?? "N/A")',
                            '@(allocation.Fridge?.FridgeType?.Name?.Replace("'", "''") ?? "N/A") - @(allocation.Fridge?.FridgeType?.Brand?.Replace("'", "''") ?? "N/A") (@(allocation.Fridge?.SerialNumber?.Replace("'", "''") ?? "N/A"))',
                            '@(allocation.AllocatedBy?.FullName?.Replace("'", "''") ?? "System")',
                            '@(allocation.IsActive ? "Active" : "Inactive")'
                        ]);
                        </text>
                }

                // Add table to PDF
                doc.autoTable({
                    startY: 45,
                    head: [tableData[0]],
                    body: tableData.slice(1),
                    theme: 'grid',
                    styles: {
                        fontSize: 8,
                        cellPadding: 3,
                        overflow: 'linebreak'
                    },
                    headStyles: {
                        fillColor: [52, 152, 219],
                        textColor: 255,
                        fontStyle: 'bold'
                    },
                    alternateRowStyles: {
                        fillColor: [245, 245, 245]
                    },
                    columnStyles: {
                        0: { cellWidth: 25 },
                        1: { cellWidth: 15 },
                        2: { cellWidth: 25 },
                        3: { cellWidth: 25 },
                        4: { cellWidth: 35 },
                        5: { cellWidth: 25 },
                        6: { cellWidth: 15 }
                    },
                    margin: { top: 45 }
                });

                // Add page numbers
                const pageCount = doc.internal.getNumberOfPages();
                for (let i = 1; i <= pageCount; i++) {
                    doc.setPage(i);
                    doc.setFontSize(8);
                    doc.setTextColor(100);
                    doc.text(`Page ${i} of ${pageCount}`, doc.internal.pageSize.width - 30, doc.internal.pageSize.height - 10);
                }

                // Save the PDF
                const fileName = `Allocation_History_${new Date().toISOString().split('T')[0]}.pdf`;
                doc.save(fileName);

            } catch (error) {
                console.error('Error generating PDF:', error);
                alert('Error generating PDF. Please try again.');
            } finally {
                // Restore button state
                exportBtn.innerHTML = originalText;
                exportBtn.disabled = false;
            }
        }

        // Alternative method using html2canvas (commented out but available)
        function exportToPDFWithScreenshot() {
            const { jsPDF } = window.jspdf;

            // Capture the table as an image
            html2canvas(document.getElementById('allocationTable')).then(canvas => {
                const imgData = canvas.toDataURL('image/png');
                const pdf = new jsPDF('landscape');
                const imgProps = pdf.getImageProperties(imgData);
                const pdfWidth = pdf.internal.pageSize.getWidth();
                const pdfHeight = (imgProps.height * pdfWidth) / imgProps.width;

                pdf.addImage(imgData, 'PNG', 0, 0, pdfWidth, pdfHeight);
                pdf.save('allocation_history_screenshot.pdf');
            });
        }
    </script>

    <style>
        /* Print styles for better PDF output */
        @@media print {
            .btn, .alert, .card-header, .mt-3

        {
            display: none !important;
        }

        .table {
            border-collapse: collapse !important;
        }

            .table th,
            .table td {
                border: 1px solid #dee2e6 !important;
                padding: 8px !important;
            }

        }
    </style>
}