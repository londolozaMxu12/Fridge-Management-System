@model IEnumerable<FridgeManagementSystem.Models.Order>
@{
    ViewData["Title"] = "Orders Needing Allocation";
    Layout = "_CustomerLiaisonLayout";
}

<h3 class="text-center mb-4">📋 Orders Ready for Allocation</h3>

@if (!Model.Any())
{
    <div class="alert alert-info text-center">
        <i class="bi bi-check-circle"></i> No orders currently need allocation. All accepted orders have been allocated.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-primary">
                <tr>
                    <th>Order ID</th>
                    <th>Customer</th>
                    <th>Business</th>
                    <th>Items</th>
                    <th>Reserved Fridges</th>
                    <th>Order Date</th>
                    <th>Delivery Address</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    // Calculate order statistics
                    var orderItems = order.Items ?? new List<OrderItem>();
                    var totalItems = orderItems.Sum(i => i.Quantity);
                    var distinctItems = orderItems.Count;
                    var reservedFridges = orderItems.Count(i => i.Fridge?.Status == "Reserved");
                    var allocatedFridges = orderItems.Count(i => i.Fridge?.Status == "Allocated");

                    // Get item names safely
                    var itemNames = orderItems
                    .Select(i => i.Fridge?.FridgeType?.Name)
                    .Where(name => !string.IsNullOrEmpty(name))
                    .Distinct()
                    .ToList();

                    // Get customer details safely
                    var customerName = order.Customer?.User?.FullName ?? "N/A";
                    var businessName = order.Customer?.BusinessName ?? "N/A";

                    <tr>
                        <td><strong>#@order.Id</strong></td>
                        <td>
                            @customerName
                            @if (order.Customer?.User?.Email != null)
                            {
                                <br />
                                <small class="text-muted">@order.Customer.User.Email</small>
                            }
                        </td>
                        <td>
                            @businessName
                            @if (order.Customer?.CustomerType != null)
                            {
                                <br />
                                <small class="text-muted">@order.Customer.CustomerType</small>
                            }
                        </td>
                        <td>
                            <span class="badge bg-primary">@totalItems unit@(totalItems != 1 ? "s" : "")</span>
                            <br />
                            <small class="text-muted">@distinctItems item@(distinctItems != 1 ? "s" : "")</small>
                        </td>
                        <td>
                            @if (reservedFridges > 0)
                            {
                                <span class="badge bg-warning">@reservedFridges reserved</span>
                            }
                            @if (allocatedFridges > 0)
                            {
                                <span class="badge bg-success">@allocatedFridges allocated</span>
                            }
                            @if (reservedFridges == 0 && allocatedFridges == 0)
                            {
                                <span class="badge bg-secondary">No fridges</span>
                            }
                        </td>
                        <td>
                            @order.CreatedAt.ToString("MM/dd/yyyy")
                            <br />
                            <small class="text-muted">@order.CreatedAt.ToString("HH:mm")</small>
                        </td>
                        <td>
                            <div class="text-truncate" style="max-width: 200px;" title="@order.DeliveryAddress">
                                @order.DeliveryAddress
                            </div>
                        </td>
                        <td>
                            <div class="btn-group-vertical" role="group">
                                <a class="btn btn-primary btn-sm" asp-action="Details" asp-route-orderId="@order.Id"
                                   title="Allocate fridges for this order">
                                    <i class="bi bi-gear me-1"></i> Allocate
                                    @if (reservedFridges > 0)
                                    {
                                        <span class="badge bg-light text-dark">@reservedFridges</span>
                                    }
                                </a>
                                <a class="btn btn-outline-secondary btn-sm" asp-controller="LiaisonOrders" asp-action="Details" asp-route-id="@order.Id"
                                   title="View order details">
                                    <i class="bi bi-eye me-1"></i> View
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Order Summary -->
    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <h6 class="card-title">Allocation Summary</h6>
                    <div class="row text-center">
                        <div class="col">
                            <h4>@Model.Count()</h4>
                            <small class="text-muted">Orders Pending</small>
                        </div>
                        <div class="col">
                            <h4>@Model.Sum(o => o.Items?.Count(i => i.Fridge?.Status == "Reserved") ?? 0)</h4>
                            <small class="text-muted">Reserved Fridges</small>
                        </div>
                        <div class="col">
                            <h4>@Model.Sum(o => o.Items?.Count(i => i.Fridge?.Status == "Allocated") ?? 0)</h4>
                            <small class="text-muted">Allocated Fridges</small>
                        </div>
                        <div class="col">
                            <h4>@Model.Sum(o => o.Items?.Sum(i => i.Quantity) ?? 0)</h4>
                            <small class="text-muted">Total Units</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<div class="mt-3 pb-4">
    <a asp-action="History" class="btn btn-outline-secondary me-2">
        <i class="bi bi-clock-history me-1"></i> View Allocation History
    </a>
    <a asp-controller="LiaisonOrders" asp-action="Index" class="btn btn-outline-primary">
        <i class="bi bi-list-ul me-1"></i> Back to All Orders
    </a>
</div>

@section Scripts {
    <script>
        // Add tooltips for truncated addresses and buttons
        $(document).ready(function() {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[title]'))
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl)
            });

            // Add row hover effects
            $('table tbody tr').hover(
                function() {
                    $(this).addClass('table-active');
                },
                function() {
                    $(this).removeClass('table-active');
                }
            );
        });
    </script>
}