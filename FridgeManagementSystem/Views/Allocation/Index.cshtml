@model IEnumerable<Order>
@{
    ViewData["Title"] = "Orders Needing Allocation";
    Layout = "_CustomerLiaisonLayout";
}

<h3 class="text-center mb-4">📋 Orders Ready for Allocation</h3>

@if (!Model.Any())
{
    <div class="alert alert-info text-center">
        <i class="bi bi-check-circle"></i> No orders currently need allocation. All accepted orders have been allocated.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-primary">
                <tr>
                    <th>Order ID</th>
                    <th>Customer</th>
                    <th>Items</th>
                    <th>Order Date</th>
                    <th>Delivery Address</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    var totalItems = order.Items?.Sum(i => i.Quantity) ?? 0;
                    var itemNames = order.Items?
                    .Select(i => i.Fridge?.FridgeType?.Name)
                    .Where(name => !string.IsNullOrEmpty(name))
                    .ToList() ?? new List<string>();

                    <tr>
                        <td><strong>#@order.Id</strong></td>
                        <td>@order.Customer?.FullName</td>
                        <td>
                            @totalItems item(s)<br>
                            <small class="text-muted">@string.Join(", ", itemNames.Distinct())</small>
                        </td>
                        <td>@order.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td>@order.DeliveryAddress</td>
                        <td>
                            <a class="btn btn-primary btn-sm" asp-action="Details" asp-route-orderId="@order.Id">
                                <i class="bi bi-gear"></i> Allocate
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="mt-3">
    <a asp-action="History" class="btn btn-outline-secondary">
        <i class="bi bi-clock-history"></i> View Allocation History
    </a>
</div>