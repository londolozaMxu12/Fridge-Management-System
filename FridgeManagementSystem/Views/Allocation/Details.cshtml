@model Order
@{
    ViewData["Title"] = "Allocate Fridge to Order";
    Layout = "_CustomerLiaisonLayout";
    var reservedFridges = ViewBag.ReservedFridges as List<Fridge> ?? new List<Fridge>();
}

<h3 class="text-center mb-4">Allocate Fridge to Order #@Model.Id</h3>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Order Details</h5>
            </div>
            <div class="card-body">
                <p><strong>Customer:</strong> @Model.Customer?.FullName</p>
                <p><strong>Delivery Address:</strong> @Model.DeliveryAddress</p>
                <p><strong>Order Date:</strong> @Model.CreatedAt.ToString("dd/MM/yyyy")</p>
                <p><strong>Status:</strong> <span class="badge bg-warning">@Model.OrderStatus</span></p>

                <h6>Ordered Items:</h6>
                <ul>
                    @foreach (var item in Model.Items)
                    {
                        <li>
                            @item.Fridge?.FridgeType?.Name -
                            @item.Fridge?.FridgeType?.Brand @item.Fridge?.FridgeType?.Model
                            <span class="badge bg-@(item.Fridge?.Status == "Reserved" ? "warning" : "secondary")">
                                @item.Fridge?.Status
                            </span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">Reserved Fridges Ready for Allocation</h5>
            </div>
            <div class="card-body">
                @if (reservedFridges.Any())
                {
                    @foreach (var fridge in reservedFridges)
                    {
                        <div class="border rounded p-3 mb-3">
                            <h6>@fridge.FridgeType?.Name</h6>
                            <p class="mb-1"><strong>Serial:</strong> @fridge.SerialNumber</p>
                            <p class="mb-1"><strong>Brand:</strong> @fridge.FridgeType?.Brand</p>
                            <p class="mb-1"><strong>Model:</strong> @fridge.FridgeType?.Model</p>
                            <p class="mb-2">
                                <strong>Status:</strong>
                                <span class="badge bg-warning">@fridge.Status</span>
                                
                            </p>

                            <form method="post" asp-action="Allocate">
                                <input type="hidden" name="orderId" value="@Model.Id" />
                                <input type="hidden" name="fridgeId" value="@fridge.FridgeId" />
                                <button type="submit" class="btn btn-success btn-sm">
                                    <i class="bi bi-check-lg"></i> Allocate This Fridge
                                </button>
                            </form>
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle"></i>
                        No reserved fridges found for this order. The fridges may have been already allocated or are not reserved.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Back to Allocation List</a>
</div>