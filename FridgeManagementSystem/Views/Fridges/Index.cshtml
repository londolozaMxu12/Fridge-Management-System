@{
    ViewData["Title"] = "Home Page";
}



<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fridge Store</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body{
            background-color:skyblue;
        }
    </style>
</head>
<body>
    <!-- Navigation Bar -->

    <div>
        <h1 style="font-size: 4rem; font-weight: bold; color:black; text-align:center; margin-top: 2rem; text-shadow: 2px
                    2px 4px rgba(0,0,0,0.2); ">
            PLACE YOUR SUITABLE ORDER NOW
        </h1>
    </div> <!-- Products Section -->





    <div id="productCarousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
            <div class="carousel-item active">
                <div class="row">
                    <!-- Product 1 -->
                    <div class="col-md-4">
                        <div class="card">
                            <img src="~/js/photos/picture1.jpg" class="card-img-top" alt="Product 1">
                            <div class="card-body">
                                <h5 class="card-title">Hisense Bar Fridge</h5>
                                <p class="card-text">R4,999</p> <a href="/Identity/Account/Register" class="btn text-center btn-success">Buy Now</a>
                            </div>
                        </div>
                    </div>
                    <!-- Product 2 -->
                    <div class="col-md-4">
                        <div class="card">
                            "<img src="~/js/photos/picture2.jpg" class="card-img-top" alt="Product 2">
                            <div class="card-body">
                                <h5 class="card-title">Hisense 231LT Refrigerator</h5>
                                <p class="card-text">R5,999</p> <a href="/Identity/Account/Register" class="btn text-center btn-success">Buy Now</a>
                            </div>
                        </div>
                    </div>
                    <!-- Product 3 -->
                    <div class="col-md-4">
                        <div class="card">
                            <img src="~/js/photos/picture3.png" class="card-img-top" alt="Product 3">
                            <div class="card-body">
                                <h5 class="card-title">Defy 80LT Bar Fridge</h5>
                                <p class="card-text">R3,799</p> <a href="/Identity/Account/Register" class="btn text-center btn-success">Buy Now</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Add more carousel items for more products -->
            <div class="carousel-item">
                <div class="row">
                    <!-- Product 4 -->
                    <div class="col-md-4">
                        <div class="card">
                            <img src="~/js/photos/picture4.gif" class="card-img-top" alt="Product 4">
                            <div class="card-body">
                                <h5 class="card-title">Samsung Silver Combi</h5>
                                <p class="card-text">R7,999</p> <a href="/Identity/Account/Register" class="btn text-center btn-success">Buy Now</a>
                            </div>
                        </div>
                    </div>
                    <!-- Product 5 -->
                    <div class="col-md-4">
                        <div class="card">
                            <img src="~/js/photos/picture5.jpg" class="card-img-top" alt="Product 5">
                            <div class="card-body">
                                <h5 class="card-title">Samsung 231LT Refrigerator</h5>
                                <p class="card-text">R6,999</p> <a href="/Identity/Account/Register" class="btn text-center btn-success">Buy Now</a>
                            </div>
                        </div>
                    </div>
                    <!-- Product 6 -->
                    <div class="col-md-4">
                        <div class="card">
                            <img src="~/js/photos/picture6.jpg" class="card-img-top" alt="Product 6">
                            <div class="card-body">
                                <h5 class="card-title">Defy 80LT Bar Fridge</h5>
                                <p class="card-text">R4,599</p> <a href="/Identity/Account/Register" class="btn text-center btn-success">Buy Now</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Carousel controls -->
        <button class="carousel-control-prev" type="button" data-bs-target="#productCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true" style="background-color:black"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#productCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true" style="background-color:black"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div> <!-- Contact and Login Section -->
    <div class="container mt-5">
        <div class="row">
            <div class="col-md-4">
                <button style="border-radius: 50%; animation: flash 5s infinite;"
                        class="btn btn-danger  w-100 h-100  py-3" onclick=" window.location.href='/Identity/Account/Register'">
                    CLICK HERE TO SIGN-UP AND BROWSE MORE
                </button>
            </div>
           @*  <div class="col-md-4">
                <div class="bg-light p-4 border">
                    <h4>Sign Up</h4>
                    <form>
                        <div class="mb-3">
                            <label for="username" class="form-label">Username:</label>
                            <input type="text" class="form-control" id="username" placeholder="Enter username">
                        </div> <div class="mb-3">
                            <label for="password" class="form-label">Password:</label>
                            <input type="password" class="form-control" id="password" placeholder="Enter password">
                        </div>
                        <button type="submit" class="btn btn-primary w-100">
                            Login

                        </button>
                    </form>
                </div>
            </div> *@
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>



