@model Order
@{
    Layout = "_CustomerLiaisonLayout";

    string paymentBadgeColor = "bg-danger";
    if (Model.PaymentStatus == "pending")
    {
        paymentBadgeColor = "bg-warning text-dark";
    }
    else if (Model.PaymentStatus == "accepted")
    {
        paymentBadgeColor = "bg-success";
    }
    else if (Model.PaymentStatus == "canceled")
    {
        paymentBadgeColor = "bg-secondary";
    }

    string orderBadgeColor = "bg-danger";
    if (Model.OrderStatus == "Received")
    {
        orderBadgeColor = "bg-warning text-dark";
    }
    else if (Model.OrderStatus == "accepted")
    {
        orderBadgeColor = "bg-success";
    }
    else if (Model.OrderStatus == "canceled")
    {
        orderBadgeColor = "bg-secondary";
    }
    else if (Model.OrderStatus == "shipped")
    {
        orderBadgeColor = "bg-primary";
    }
    else if (Model.OrderStatus == "delivered")
    {
        orderBadgeColor = "bg-success";
    }
    else if (Model.OrderStatus == "returned")
    {
        orderBadgeColor = "bg-info text-dark";
    }

    // Calculate totals
    decimal subtotal = Model.Items?.Sum(i => i.Quantity * i.UnitPrice) ?? 0;
    decimal totalAmount = subtotal + Model.ShippingFee;
}

<h3 class="text-center mb-4">Order Details</h3>

<a class="btn btn-link" asp-controller="LiaisonOrders" asp-action="Index">Orders</a>

<div class="row text-black mb-4">
    <div class="col-lg-6">
        <div class="border rounded py-3 px-4 h-100">
            <h3 class="mb-4">Order</h3>

            <div class="row mb-2 pb-2 border-bottom">
                <div class="col">Order ID</div>
                <div class="col">@Model.Id</div>
            </div>

            <div class="row mb-2 pb-2 border-bottom">
                <div class="col">Delivery Address</div>
                <div class="col">@Model.DeliveryAddress</div>
            </div>

            <div class="row mb-2 pb-2 border-bottom">
                <div class="col">Payment Method</div>
                <div class="col">@Model.PaymentMethod</div>
            </div>

            <div class="row mb-2 pb-2 border-bottom">
                <div class="col">Payment Status</div>
                <div class="col">
                    <span class="badge rounded-pill @paymentBadgeColor">@Model.PaymentStatus</span>
                    <a href="#" class="mx-2" data-bs-toggle="modal" data-bs-target="#paymentStatusModal">
                        Edit
                    </a>
                    @* <a href="#" data-bs-toggle="modal" data-bs-target="#paymentDetailsModal">
                        Details
                    </a> *@
                </div>
            </div>

            <div class="row mb-2 pb-2 border-bottom">
                <div class="col">Order Status</div>
                <div class="col">
                    <span class="badge rounded-pill @orderBadgeColor">@Model.OrderStatus</span>

                    <!-- Status guidance -->
                    @if (Model.OrderStatus?.ToLower() != "accepted" && Model.OrderStatus?.ToLower() != "processing" &&
                                        (Model.OrderStatus?.ToLower() != "shipped" && Model.OrderStatus?.ToLower() != "delivered") &&
                                        Model.OrderStatus?.ToLower() != "cancelled" && Model.OrderStatus?.ToLower() != "returned")
                    {
                        <small class="d-block text-warning mt-1">
                            <i class="bi bi-info-circle"></i> Accept payment first to accept order
                        </small>
                    }
                    else if ((Model.OrderStatus?.ToLower() == "accepted" || Model.OrderStatus?.ToLower() == "processing") &&
                    Model.OrderStatus?.ToLower() != "shipped" && Model.OrderStatus?.ToLower() != "delivered")
                    {
                        <small class="d-block text-info mt-1">
                            <i class="bi bi-truck"></i> Ready to be shipped
                        </small>
                    }
                    else if (Model.OrderStatus?.ToLower() == "shipped" && Model.OrderStatus?.ToLower() != "delivered")
                    {
                        <small class="d-block text-success mt-1">
                            <i class="bi bi-check-circle"></i> Ready to be marked as delivered
                        </small>
                    }

                    <a href="#" class="ms-2" data-bs-toggle="modal" data-bs-target="#orderStatusModal">
                        Edit
                    </a>
                </div>
            </div>

            <div class="row mb-2">
                <div class="col">Order Date</div>
                <div class="col">@Model.CreatedAt</div>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="border rounded py-3 px-4 h-100">
            <h3 class="mb-4">Customer</h3>

            <div class="row mb-2 pb-2 border-bottom">
                <div class="col">Name</div>
                <div class="col">
                    @(Model.Customer?.FullName ?? "N/A")
                </div>
            </div>

            <div class="row mb-2 pb-2 border-bottom">
                <div class="col">N° Orders</div>
                <div class="col">
                    @ViewBag.NumOrders
                </div>
            </div>

            <div class="row mb-2 pb-2 border-bottom">
                <div class="col">Email</div>
                <div class="col">@(Model.Customer?.Email ?? "N/A")</div>
            </div>

            <div class="row mb-2 pb-2 border-bottom">
                <div class="col">Phone</div>
                <div class="col">@(Model.Customer?.ContactNo ?? "N/A")</div>
            </div>

            <div class="row mb-2 pb-2 border-bottom">
                <div class="col">Address</div>
                <div class="col">
                    @if (Model.Customer != null)
                    {
                        var addressParts = new List<string>();
                        if (!string.IsNullOrEmpty(Model.Customer.Address))
                            addressParts.Add(Model.Customer.Address);
                        if (!string.IsNullOrEmpty(Model.Customer.Suburb))
                            addressParts.Add(Model.Customer.Suburb);
                        if (!string.IsNullOrEmpty(Model.Customer.City))
                            addressParts.Add(Model.Customer.City);

                        @string.Join(", ", addressParts)
                    }
                    else
                    {
                        @:N/A
                    }
                </div>
            </div>

            <div class="row mb-2">
                <div class="col">Registered At</div>
                <div class="col">@(Model.Customer?.CreatedAt.ToString() ?? "N/A")</div>
            </div>
        </div>
    </div>
</div>

<table class="table">
    <thead>
        <tr>
            <th style="width: 100px">Description</th>
            <th></th>
            <th style="width:100px">Units</th>
            <th style="width:100px">Amount</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrEmpty(item.Fridge?.ImageFileName))
                    {
                        <img src="/Images/Fridges/@item.Fridge.ImageFileName" width="100" alt="@item.Fridge.FridgeType?.Name" />
                    }
                    else
                    {
                        <img src="/Images/Fridges/default-fridge.jpg" width="100" alt="Default Fridge" />
                    }
                </td>
                <td>
                    <h3>
                        @(item.Fridge?.FridgeType?.Name ?? "N/A")
                    </h3>
                    @(item.Fridge?.FridgeType?.Brand ?? "N/A") - @(item.Fridge?.FridgeType?.Model ?? "N/A")<br>
                    @(item.Fridge?.SerialNumber ?? "N/A")<br>
                    R @(item.UnitPrice)
                </td>
                <td>@item.Quantity</td>
                <td>R @(item.UnitPrice* item.Quantity)</td>
            </tr>
        }
    </tbody>
</table>

<div class="ms-auto mb-3" style="width: 250px">
    <div class="row">
        <div class="col fw-bold">Subtotal:</div>
        <div class="col text-end">R @(subtotal.ToString("F2"))</div>
    </div>
    <div class="row">
        <div class="col fw-bold">Shipping Fee:</div>
        <div class="col text-end">R @(Model.ShippingFee.ToString("F2"))</div>
    </div>
    <div class="row">
        <div class="col fw-bold">Total:</div>
        <div class="col text-end">R @(totalAmount.ToString("F2"))</div>
    </div>
</div>

<!-- Allocated Fridge Section -->
@if (Model.FridgeId != null)
{
    <div class="border rounded py-3 px-4 mb-4">
        <h3 class="mb-4">Allocated Fridge</h3>
        <div class="row">
            <div class="col-md-6">
                <div class="row mb-2">
                    <div class="col-sm-4"><strong>Fridge ID:</strong></div>
                    <div class="col-sm-8">@Model.FridgeId</div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-4"><strong>Serial Number:</strong></div>
                    <div class="col-sm-8">@(Model.Fridge?.SerialNumber ?? "N/A")</div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-4"><strong>Name:</strong></div>
                    <div class="col-sm-8">@(Model.Fridge?.FridgeType?.Name ?? "N/A")</div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-4"><strong>Brand:</strong></div>
                    <div class="col-sm-8">@(Model.Fridge?.FridgeType?.Brand ?? "N/A")</div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-4"><strong>Model:</strong></div>
                    <div class="col-sm-8">@(Model.Fridge?.FridgeType?.Model ?? "N/A")</div>
                </div>
            </div>
            <div class="col-md-6">
                @if (!string.IsNullOrEmpty(Model.Fridge?.ImageFileName))
                {
                    <img src="/Images/Fridges/@Model.Fridge.ImageFileName"
                         alt="@Model.Fridge.FridgeType?.Name"
                         class="img-fluid rounded"
                         style="max-height: 200px;">
                }
            </div>
        </div>
    </div>
}

<!-- Payment Status Modal -->
<div class="modal fade" id="paymentStatusModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5">Update Payment Status</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form method="get" asp-controller="LiaisonOrders" asp-action="Edit">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <label>Payment Status</label>
                    <select class="form-select mb-2" name="payment_status" asp-for="PaymentStatus">
                        <option value="pending">pending</option>
                        <option value="accepted">accepted</option>
                        <option value="canceled">canceled</option>
                    </select>
                    <button type="submit" class="btn btn-primary">Save</button>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Order Status Modal -->
<div class="modal fade" id="orderStatusModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5">Update Order Status</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form method="get" asp-controller="LiaisonOrders" asp-action="Edit">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <label>Order Status</label>

                    <!-- Payment status warning -->
                    @if (Model.PaymentStatus?.ToLower() != "accepted" && (Model.OrderStatus?.ToLower() != "cancelled" && Model.OrderStatus?.ToLower() != "returned"))
                    {
                        <div class="alert alert-warning mb-3">
                            <i class="bi bi-exclamation-triangle"></i>
                            Payment must be accepted before you can accept this order.
                        </div>
                    }

                    <!-- Order flow warning -->
                    @if ((Model.OrderStatus?.ToLower() != "accepted" && Model.OrderStatus?.ToLower() != "processing") &&
                                        (Model.OrderStatus?.ToLower() != "cancelled" && Model.OrderStatus?.ToLower() != "returned"))
                    {
                        <div class="alert alert-info mb-3">
                            <i class="bi bi-info-circle"></i>
                            Order must be accepted before it can be shipped or delivered.
                        </div>
                    }

                    <select class="form-select mb-2" name="order_status" asp-for="OrderStatus"
                            id="orderStatusSelect">
                        <option value="Received"
                                disabled="@(Model.OrderStatus != "Received")">
                            Received
                        </option>

                        <option value="Accepted"
                                disabled="@(Model.PaymentStatus?.ToLower() != "accepted" || (Model.OrderStatus != "Received" && Model.OrderStatus != "Accepted"))">
                            Accepted
                            @(Model.PaymentStatus?.ToLower() != "accepted" ? " " :
                                                        (Model.OrderStatus != "Received" && Model.OrderStatus != "Accepted") ? "(Invalid transition)" : "")
                        </option>

                        <option value="Processing"
                                disabled="@(Model.OrderStatus != "Accepted" && Model.OrderStatus != "Processing")">
                            Processing
                            @(Model.OrderStatus != "Accepted" && Model.OrderStatus != "Processing" ? " " : "")
                        </option>

                        <option value="Shipped"
                                disabled="@(Model.OrderStatus != "Accepted" && Model.OrderStatus != "Processing" && Model.OrderStatus != "Shipped")">
                            Shipped
                            @(Model.OrderStatus != "Accepted" && Model.OrderStatus != "Processing" && Model.OrderStatus != "Shipped" ? " " : "")
                        </option>

                        <option value="Delivered"
                                disabled="@(Model.OrderStatus != "Shipped" && Model.OrderStatus != "Delivered")">
                            Delivered
                            @(Model.OrderStatus != "Shipped" && Model.OrderStatus != "Delivered" ? " " : "")
                        </option>

                        <option value="Cancelled"
                                disabled="@(Model.OrderStatus == "Delivered" || Model.OrderStatus == "Returned" || Model.OrderStatus == "Cancelled")">
                            Cancelled
                            @(Model.OrderStatus == "Delivered" || Model.OrderStatus == "Returned" || Model.OrderStatus == "Cancelled" ? " " : "")
                        </option>

                        <option value="Returned"
                                disabled="@(Model.OrderStatus != "Shipped" && Model.OrderStatus != "Delivered" && Model.OrderStatus != "Returned")">
                            Returned
                            @(Model.OrderStatus != "Shipped" && Model.OrderStatus != "Delivered" && Model.OrderStatus != "Returned" ? " " : "")
                        </option>
                    </select>

                    <div class="form-text">
                        Current Status:
                        <span class="badge @GetOrderStatusBadgeClass(Model.OrderStatus)">@Model.OrderStatus</span> |
                        Payment:
                        <span class="badge @(Model.PaymentStatus?.ToLower() == "accepted" ? "bg-success" : "bg-warning")">
                            @Model.PaymentStatus
                        </span>
                    </div>

                    <button type="submit" class="btn btn-primary mt-2" id="saveOrderStatusBtn">Save</button>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@functions {
    private string GetOrderStatusBadgeClass(string status)
    {
        return status?.ToLower() switch
        {
            "received" => "bg-secondary",
            "accepted" => "bg-success",
            "processing" => "bg-info",
            "shipped" => "bg-primary",
            "delivered" => "bg-success",
            "cancelled" => "bg-danger",
            "returned" => "bg-warning",
            _ => "bg-secondary"
        };
    }
}

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const orderStatusSelect = document.getElementById('orderStatusSelect');
        const saveButton = document.getElementById('saveOrderStatusBtn');
        const currentOrderStatus = '@Model.OrderStatus';
        const paymentStatus = '@Model.PaymentStatus'.toLowerCase();

        function updateSaveButton() {
            const selectedOption = orderStatusSelect.options[orderStatusSelect.selectedIndex];
            const isDisabled = selectedOption.disabled;

            saveButton.disabled = isDisabled;
            if (isDisabled) {
                saveButton.title = 'This status transition is not allowed';
            } else {
                saveButton.title = '';
            }
        }

        // Initial update
        updateSaveButton();

        // Update on change
        orderStatusSelect.addEventListener('change', updateSaveButton);

        // Show tooltips for disabled options
        $(orderStatusSelect).tooltip({
            selector: 'option[disabled]',
            title: function() {
                return this.textContent;
            }
        });
    });
</script>

