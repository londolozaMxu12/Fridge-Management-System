@model FridgeManagementSystem.Models.Order
@{
    Layout = "_CustomerLiaisonLayout";

    string paymentBadgeColor = "bg-danger";
    if (Model.PaymentStatus?.ToLower() == "pending")
    {
        paymentBadgeColor = "bg-warning text-dark";
    }
    else if (Model.PaymentStatus?.ToLower() == "accepted" || Model.PaymentStatus?.ToLower() == "completed")
    {
        paymentBadgeColor = "bg-success";
    }
    else if (Model.PaymentStatus?.ToLower() == "canceled" || Model.PaymentStatus?.ToLower() == "cancelled")
    {
        paymentBadgeColor = "bg-secondary";
    }
    else if (Model.PaymentStatus?.ToLower() == "failed")
    {
        paymentBadgeColor = "bg-danger";
    }

    string orderBadgeColor = "bg-secondary";
    switch (Model.OrderStatus?.ToLower())
    {
        case "received":
            orderBadgeColor = "bg-warning text-dark";
            break;
        case "accepted":
            orderBadgeColor = "bg-primary";
            break;
        case "processing":
            orderBadgeColor = "bg-info";
            break;
        case "shipped":
            orderBadgeColor = "bg-info text-dark";
            break;
        case "delivered":
            orderBadgeColor = "bg-success";
            break;
        case "cancelled":
        case "canceled":
            orderBadgeColor = "bg-danger";
            break;
        case "returned":
            orderBadgeColor = "bg-dark";
            break;
    }

    // Calculate totals
    decimal subtotal = Model.Items?.Sum(i => i.Quantity * i.UnitPrice) ?? 0;
    decimal totalAmount = subtotal + Model.ShippingFee;

    // Customer details from ViewBag (set in controller)
    string customerName = ViewBag.CustomerName ?? "N/A";
    string customerEmail = ViewBag.CustomerEmail ?? "N/A";
    string customerPhone = ViewBag.CustomerPhone ?? "N/A";
}

<h3 class="text-center mb-4">Order Details</h3>

<!-- Display success/error messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<a class="btn btn-outline-secondary rounded-pill px-4 mb-3" asp-controller="LiaisonOrders" asp-action="Index">
    <i class="bi bi-arrow-left me-2"></i>Back to Orders
</a>

<div class="row text-black mb-4">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">
                <h5 class="card-title mb-0"><i class="bi bi-receipt me-2"></i>Order Information</h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-sm-4 fw-bold">Order ID</div>
                    <div class="col-sm-8">#@Model.Id</div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-4 fw-bold">Delivery Address</div>
                    <div class="col-sm-8">@Model.DeliveryAddress</div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-4 fw-bold">Payment Method</div>
                    <div class="col-sm-8">
                        @{
                            var paymentMethod = Model.PaymentMethod ?? "Unknown";
                            var formattedPaymentMethod = paymentMethod.Replace("OnDelivery", " on Delivery").Replace("Cash", "Cash");
                        }
                        <span class="badge bg-light text-dark">@formattedPaymentMethod</span>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-4 fw-bold">Payment Status</div>
                    <div class="col-sm-8">
                        <span class="badge rounded-pill @paymentBadgeColor me-2">@Model.PaymentStatus</span>
                        <button class="btn btn-outline-success btn-sm rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#paymentStatusModal">
                            <i class="bi bi-cash-coin me-1"></i>Update
                        </button>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-4 fw-bold">Order Status</div>
                    <div class="col-sm-8">
                        <span class="badge rounded-pill @orderBadgeColor me-2">@Model.OrderStatus</span>
                        <button class="btn btn-outline-primary btn-sm rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#orderStatusModal">
                            <i class="bi bi-clipboard-check me-1"></i>Update
                        </button>

                        <!-- Status guidance -->
                        @if (Model.OrderStatus?.ToLower() != "accepted" && Model.OrderStatus?.ToLower() != "processing" &&
                                                (Model.OrderStatus?.ToLower() != "shipped" && Model.OrderStatus?.ToLower() != "delivered") &&
                                                Model.OrderStatus?.ToLower() != "cancelled" && Model.OrderStatus?.ToLower() != "returned")
                        {
                            <small class="d-block text-info mt-1">
                                <i class="bi bi-info-circle"></i> Accept payment first to accept order
                            </small>
                        }
                        else if ((Model.OrderStatus?.ToLower() == "accepted" || Model.OrderStatus?.ToLower() == "processing") &&
                        Model.OrderStatus?.ToLower() != "shipped" && Model.OrderStatus?.ToLower() != "delivered")
                        {
                            <small class="d-block text-info mt-1">
                                <i class="bi bi-truck"></i> Ready to be shipped
                            </small>
                        }
                        else if (Model.OrderStatus?.ToLower() == "shipped" && Model.OrderStatus?.ToLower() != "delivered")
                        {
                            <small class="d-block text-success mt-1">
                                <i class="bi bi-check-circle"></i> Ready to be marked as delivered
                            </small>
                        }
                    </div>
                </div>

                <div class="row">
                    <div class="col-sm-4 fw-bold">Order Date</div>
                    <div class="col-sm-8">
                        @Model.CreatedAt.ToString("MMM dd, yyyy")
                        <small class="text-muted d-block">@Model.CreatedAt.ToString("hh:mm tt")</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">
                <h5 class="card-title mb-0"><i class="bi bi-person me-2"></i>Customer Information</h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-sm-4 fw-bold">Name</div>
                    <div class="col-sm-8">@customerName</div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-4 fw-bold">Business</div>
                    <div class="col-sm-8">
                        @(Model.Customer?.BusinessName ?? "N/A")
                        @if (Model.Customer?.CustomerType != null)
                        {
                            <small class="text-muted d-block">@Model.Customer.CustomerType</small>
                        }
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-4 fw-bold">Total Orders</div>
                    <div class="col-sm-8">
                        <span class="badge bg-primary">@ViewBag.NumOrders</span>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-4 fw-bold">Email</div>
                    <div class="col-sm-8">
                        <a href="mailto:@customerEmail">@customerEmail</a>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-4 fw-bold">Phone</div>
                    <div class="col-sm-8">
                        <a href="tel:@customerPhone">@customerPhone</a>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-4 fw-bold">Address</div>
                    <div class="col-sm-8">
                        @if (Model.Customer?.User != null)
                        {
                            var addressParts = new List<string>();
                            if (!string.IsNullOrEmpty(Model.Customer.User.Address))
                                addressParts.Add(Model.Customer.User.Address);
                            if (!string.IsNullOrEmpty(Model.Customer.User.Suburb))
                                addressParts.Add(Model.Customer.User.Suburb);
                            if (!string.IsNullOrEmpty(Model.Customer.User.City))
                                addressParts.Add(Model.Customer.User.City);
                            if (!string.IsNullOrEmpty(Model.Customer.User.PostalCode))
                                addressParts.Add(Model.Customer.User.PostalCode);

                            if (addressParts.Any())
                            {
                                @string.Join(", ", addressParts)
                            }
                            else
                            {
                                <span class="text-muted">No address provided</span>
                            }
                        }
                        else
                        {
                            <span class="text-muted">N/A</span>
                        }
                    </div>
                </div>

                <div class="row">
                    <div class="col-sm-4 fw-bold">Registered</div>
                    <div class="col-sm-8">
                        @(Model.Customer?.CreatedAt.ToString("MMM dd, yyyy") ?? "N/A")
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Order Items Section -->
<div class="card mb-4">
    <div class="card-header">
        <h5 class="card-title mb-0"><i class="bi bi-cart me-2"></i>Order Items</h5>
    </div>
    <div class="card-body">
        @if (Model.Items != null && Model.Items.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 120px">Image</th>
                            <th>Product Details</th>
                            <th style="width: 100px" class="text-center">Quantity</th>
                            <th style="width: 120px" class="text-end">Unit Price</th>
                            <th style="width: 120px" class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.Fridge?.ImageFileName))
                                    {
                                        <img src="@Url.Content($"~/Images/Fridges/{item.Fridge.ImageFileName}")"
                                             width="100"
                                             alt="@item.Fridge.FridgeType?.Name"
                                             class="img-thumbnail"
                                             onerror="this.onerror=null; this.src='@Url.Content("~/Images/default-fridge.jpg")'" />
                                    }
                                    else
                                    {
                                        <img src="@Url.Content("~/Images/default-fridge.jpg")"
                                             width="100"
                                             alt="Default Fridge"
                                             class="img-thumbnail" />
                                    }
                                </td>
                                <td>
                                    <h6 class="mb-1">@(item.Fridge?.FridgeType?.Name ?? "N/A")</h6>
                                    <small class="text-muted">
                                        @(item.Fridge?.FridgeType?.Brand ?? "N/A") - @(item.Fridge?.FridgeType?.Model ?? "N/A")
                                        @if (!string.IsNullOrEmpty(item.Fridge?.SerialNumber))
                                        {
                                            <br />
                                            <strong>Serial:</strong>
 
                                            @item.Fridge.SerialNumber
                                        }
                                    </small>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-primary rounded-pill">@item.Quantity</span>
                                </td>
                                <td class="text-end">R @item.UnitPrice.ToString("N2")</td>
                                <td class="text-end fw-bold">R @((item.UnitPrice * item.Quantity).ToString("N2"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Order Summary -->
            <div class="row justify-content-end">
                <div class="col-md-4">
                    <div class="card border-0 bg-light">
                        <div class="card-body">
                            <h6 class="card-title">Order Summary</h6>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Subtotal:</span>
                                <span>R @subtotal.ToString("N2")</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Shipping Fee:</span>
                                <span>R @Model.ShippingFee.ToString("N2")</span>
                            </div>
                            <hr>
                            <div class="d-flex justify-content-between fw-bold fs-5">
                                <span>Total Amount:</span>
                                <span class="text-primary">R @totalAmount.ToString("N2")</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-4">
                <i class="bi bi-cart-x text-muted" style="font-size: 3rem;"></i>
                <p class="text-muted mt-2">No items found in this order</p>
            </div>
        }
    </div>
</div>

<!-- Allocated Fridge Section -->
@if (Model.FridgeId != null)
{
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="card-title mb-0"><i class="bi bi-box-seam me-2"></i>Allocated Fridge</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-8">
                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Fridge ID:</div>
                        <div class="col-sm-8">@Model.FridgeId</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Serial Number:</div>
                        <div class="col-sm-8">@(Model.Fridge?.SerialNumber ?? "N/A")</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Name:</div>
                        <div class="col-sm-8">@(Model.Fridge?.FridgeType?.Name ?? "N/A")</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Brand:</div>
                        <div class="col-sm-8">@(Model.Fridge?.FridgeType?.Brand ?? "N/A")</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Model:</div>
                        <div class="col-sm-8">@(Model.Fridge?.FridgeType?.Model ?? "N/A")</div>
                    </div>
                    <div class="row">
                        <div class="col-sm-4 fw-bold">Status:</div>
                        <div class="col-sm-8">
                            <span class="badge bg-success">Allocated</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 text-center">
                    @if (!string.IsNullOrEmpty(Model.Fridge?.ImageFileName))
                    {
                        <img src="@Url.Content($"~/Images/Fridges/{Model.Fridge.ImageFileName}")"
                             alt="@Model.Fridge.FridgeType?.Name"
                             class="img-fluid rounded shadow"
                             style="max-height: 200px;"
                             onerror="this.onerror=null; this.src='@Url.Content("~/Images/default-fridge.jpg")'">
                    }
                    else
                    {
                        <img src="@Url.Content("~/Images/default-fridge.jpg")"
                             alt="Default Fridge Image"
                             class="img-fluid rounded shadow"
                             style="max-height: 200px;">
                    }
                </div>
            </div>
        </div>
    </div>
}

<!-- Payment Status Modal -->
<div class="modal fade" id="paymentStatusModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Update Payment Status</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form method="get" asp-controller="LiaisonOrders" asp-action="Edit">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="mb-3">
                        <label class="form-label fw-bold">Payment Status</label>
                        <select class="form-select" name="payment_status">
                            <option value="pending" selected="@(Model.PaymentStatus?.ToLower() == "pending")">Pending</option>
                            <option value="accepted" selected="@(Model.PaymentStatus?.ToLower() == "accepted")">Accepted</option>
                            <option value="failed" selected="@(Model.PaymentStatus?.ToLower() == "failed")">Failed</option>
                            <option value="canceled" selected="@(Model.PaymentStatus?.ToLower() == "canceled" || Model.PaymentStatus?.ToLower() == "cancelled")">Cancelled</option>
                        </select>
                    </div>
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">Update Payment Status</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Order Status Modal -->
<div class="modal fade" id="orderStatusModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Update Order Status</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form method="get" asp-controller="LiaisonOrders" asp-action="Edit">
                    <input type="hidden" name="id" value="@Model.Id" />

                    <!-- Payment status warning -->
                    @if (Model.PaymentStatus?.ToLower() != "accepted" && (Model.OrderStatus?.ToLower() != "cancelled" && Model.OrderStatus?.ToLower() != "returned"))
                    {
                        <div class="alert alert-warning mb-3">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            Payment must be accepted before you can accept this order.
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-bold">Order Status</label>
                        <select class="form-select" name="order_status" id="orderStatusSelect">
                            <option value="Received" selected="@(Model.OrderStatus == "Received")"
                                    data-valid="@(Model.OrderStatus == "Received")">Received</option>

                            <option value="Accepted" selected="@(Model.OrderStatus == "Accepted")"
                                    data-valid="@(Model.PaymentStatus?.ToLower() == "accepted" && (Model.OrderStatus == "Received" || Model.OrderStatus == "Accepted"))">
                                Accepted
                            </option>

                            <option value="Processing" selected="@(Model.OrderStatus == "Processing")"
                                    data-valid="@(Model.OrderStatus == "Accepted" || Model.OrderStatus == "Processing")">Processing</option>

                            <option value="Shipped" selected="@(Model.OrderStatus == "Shipped")"
                                    data-valid="@(Model.OrderStatus == "Accepted" || Model.OrderStatus == "Processing" || Model.OrderStatus == "Shipped")">Shipped</option>

                            <option value="Delivered" selected="@(Model.OrderStatus == "Delivered")"
                                    data-valid="@(Model.OrderStatus == "Shipped" || Model.OrderStatus == "Delivered")">Delivered</option>

                            <option value="Cancelled" selected="@(Model.OrderStatus == "Cancelled" || Model.OrderStatus == "Canceled")"
                                    data-valid="@(Model.OrderStatus != "Delivered" && Model.OrderStatus != "Returned" && Model.OrderStatus != "Cancelled" && Model.OrderStatus != "Canceled")">Cancelled</option>

                            <option value="Returned" selected="@(Model.OrderStatus == "Returned")"
                                    data-valid="@(Model.OrderStatus == "Shipped" || Model.OrderStatus == "Delivered" || Model.OrderStatus == "Returned")">Returned</option>
                        </select>

                        <div class="form-text mt-2">
                            Current: <span class="badge @orderBadgeColor">@Model.OrderStatus</span> |
                            Payment: <span class="badge @paymentBadgeColor">@Model.PaymentStatus</span>
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary" id="saveOrderStatusBtn">Update Order Status</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Auto-dismiss alerts
            setTimeout(function() {
                $('.alert').alert('close');
            }, 3000);

            // Order status validation
            const orderStatusSelect = document.getElementById('orderStatusSelect');
            const saveButton = document.getElementById('saveOrderStatusBtn');

            function updateSaveButton() {
                if (!orderStatusSelect || !saveButton) return;

                const selectedOption = orderStatusSelect.options[orderStatusSelect.selectedIndex];
                const isValid = selectedOption.getAttribute('data-valid') === 'true';

                saveButton.disabled = !isValid;
                if (!isValid) {
                    saveButton.title = 'This status transition is not allowed based on current order state';
                } else {
                    saveButton.title = '';
                }
            }

            if (orderStatusSelect && saveButton) {
                // Initial update
                updateSaveButton();

                // Update on change
                orderStatusSelect.addEventListener('change', updateSaveButton);
            }

            // Tooltip initialization
            $('[title]').tooltip();
        });
    </script>
}