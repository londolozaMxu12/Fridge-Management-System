@model Order
@{
    string paymentBadgeColor = "bg-danger";
    if (Model.PaymentStatus == "pending")
    {
        paymentBadgeColor = "bg-warning text-dark";
    }
    else if (Model.PaymentStatus == "accepted")
    {
        paymentBadgeColor = "bg-success";
    }
    else if (Model.PaymentStatus == "canceled")
    {
        paymentBadgeColor = "bg-secondary";
    }

    string orderBadgeColor = "bg-danger";
    if (Model.OrderStatus == "Received")
    {
        orderBadgeColor = "bg-warning text-dark";
    }
    else if (Model.OrderStatus == "accepted")
    {
        orderBadgeColor = "bg-success";
    }
    else if (Model.OrderStatus == "canceled")
    {
        orderBadgeColor = "bg-secondary";
    }
    else if (Model.OrderStatus == "shipped")
    {
        orderBadgeColor = "bg-primary";
    }
    else if (Model.OrderStatus == "delivered")
    {
        orderBadgeColor = "bg-success";
    }
    else if (Model.OrderStatus == "returned")
    {
        orderBadgeColor = "bg-info text-dark";
    }

    // Calculate totals
    decimal subtotal = Model.Items?.Sum(i => i.Quantity * i.UnitPrice) ?? 0;
    decimal totalAmount = subtotal + Model.ShippingFee;
}

<h3 class="text-center mb-4">Order Details</h3>

<a class="btn btn-link" asp-controller="LiaisonOrders" asp-action="Index">Orders</a>

<div class="row mb-4">
    <div class="col-lg-6">
        <div class="border rounded py-3 px-4 h-100">
            <h3 class="mb-4">Order</h3>

            <div class="row mb-2 pb-2 border-bottom">
                <div class="col">Order ID</div>
                <div class="col">@Model.Id</div>
            </div>

            <div class="row mb-2 pb-2 border-bottom">
                <div class="col">Delivery Address</div>
                <div class="col">@Model.DeliveryAddress</div>
            </div>

            <div class="row mb-2 pb-2 border-bottom">
                <div class="col">Payment Method</div>
                <div class="col">@Model.PaymentMethod</div>
            </div>

            <div class="row mb-2 pb-2 border-bottom">
                <div class="col">Payment Status</div>
                <div class="col">
                    <span class="badge rounded-pill @paymentBadgeColor">@Model.PaymentStatus</span>
                    <a href="#" class="mx-2" data-bs-toggle="modal" data-bs-target="#paymentStatusModal">
                        Edit
                    </a>
                    <a href="#" data-bs-toggle="modal" data-bs-target="#paymentDetailsModal">
                        Details
                    </a>
                </div>
            </div>

            <div class="row mb-2 pb-2 border-bottom">
                <div class="col">Order Status</div>
                <div class="col">
                    <span class="badge rounded-pill @orderBadgeColor">@Model.OrderStatus</span>
                    <a href="#" class="ms-2" data-bs-toggle="modal" data-bs-target="#orderStatusModal">
                        Edit
                    </a>
                </div>
            </div>

            <div class="row mb-2">
                <div class="col">Order Date</div>
                <div class="col">@Model.CreatedAt</div>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="border rounded py-3 px-4 h-100">
            <h3 class="mb-4">Customer</h3>

            <div class="row mb-2 pb-2 border-bottom">
                <div class="col">Name</div>
                <div class="col">
                    @(Model.Customer?.FullName ?? "N/A")
                </div>
            </div>

            <div class="row mb-2 pb-2 border-bottom">
                <div class="col">N° Orders</div>
                <div class="col">
                    @ViewBag.NumOrders
                </div>
            </div>

            <div class="row mb-2 pb-2 border-bottom">
                <div class="col">Email</div>
                <div class="col">@(Model.Customer?.Email ?? "N/A")</div>
            </div>

            <div class="row mb-2 pb-2 border-bottom">
                <div class="col">Phone</div>
                <div class="col">@(Model.Customer?.ContactNo ?? "N/A")</div>
            </div>

            <div class="row mb-2 pb-2 border-bottom">
                <div class="col">Address</div>
                <div class="col">@(Model.Customer?.Address ?? ", " + Model.Customer?.Suburb ?? ", " + Model.Customer?.City ?? "N/A")</div>
            </div>

            <div class="row mb-2">
                <div class="col">Registered At</div>
                <div class="col">@(Model.Customer?.CreatedAt.ToString() ?? "N/A")</div>
            </div>
        </div>
    </div>
</div>

<table class="table">
    <thead>
        <tr>
            <th style="width: 100px">Description</th>
            <th></th>
            <th style="width:100px">Units</th>
            <th style="width:100px">Amount</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrEmpty(item.Fridge?.ImageFileName))
                    {
                        <img src="/Images/Fridges/@item.Fridge.ImageFileName" width="100" alt="@item.Fridge.FridgeType?.Name" />
                    }
                    else
                    {
                        <img src="/Images/Fridges/default-fridge.jpg" width="100" alt="Default Fridge" />
                    }
                </td>
                <td>
                    <h4>
                        <a style="text-decoration: none; color: inherit;" asp-controller="Store"
                           asp-action="Details" asp-route-id="@item.FridgeId">
                            @(item.Fridge?.FridgeType?.Name ?? "N/A")
                        </a>
                    </h4>
                    @(item.Fridge?.FridgeType?.Brand ?? "N/A") - @(item.Fridge?.FridgeType?.Model ?? "N/A")<br>
                    @(item.Fridge?.Category ?? "N/A")<br>
                    R @(item.UnitPrice)
                </td>
                <td>@item.Quantity</td>
                <td>R @(item.UnitPrice* item.Quantity)</td>
            </tr>
        }
    </tbody>
</table>

<div class="ms-auto mb-3" style="width: 250px">
    <div class="row">
        <div class="col fw-bold">Subtotal:</div>
        <div class="col text-end">R @(subtotal.ToString("F2"))</div>
    </div>
    <div class="row">
        <div class="col fw-bold">Shipping Fee:</div>
        <div class="col text-end">R @(Model.ShippingFee.ToString("F2"))</div>
    </div>
    <div class="row">
        <div class="col fw-bold">Total:</div>
        <div class="col text-end">R @(totalAmount.ToString("F2"))</div>
    </div>
</div>

<!-- Allocated Fridge Section -->
@if (Model.FridgeId != null)
{
    <div class="border rounded py-3 px-4 mb-4">
        <h3 class="mb-4">Allocated Fridge</h3>
        <div class="row">
            <div class="col-md-6">
                <div class="row mb-2">
                    <div class="col-sm-4"><strong>Fridge ID:</strong></div>
                    <div class="col-sm-8">@Model.FridgeId</div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-4"><strong>Serial Number:</strong></div>
                    <div class="col-sm-8">@(Model.Fridge?.SerialNumber ?? "N/A")</div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-4"><strong>Name:</strong></div>
                    <div class="col-sm-8">@(Model.Fridge?.FridgeType?.Name ?? "N/A")</div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-4"><strong>Brand:</strong></div>
                    <div class="col-sm-8">@(Model.Fridge?.FridgeType?.Brand ?? "N/A")</div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-4"><strong>Model:</strong></div>
                    <div class="col-sm-8">@(Model.Fridge?.FridgeType?.Model ?? "N/A")</div>
                </div>
            </div>
            <div class="col-md-6">
                @if (!string.IsNullOrEmpty(Model.Fridge?.ImageFileName))
                {
                    <img src="/Images/Fridges/@Model.Fridge.ImageFileName"
                         alt="@Model.Fridge.FridgeType?.Name"
                         class="img-fluid rounded"
                         style="max-height: 200px;">
                }
            </div>
        </div>
    </div>
}

<!-- Payment Status Modal -->
<div class="modal fade" id="paymentStatusModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5">Update Payment Status</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form method="get" asp-controller="LiaisonOrders" asp-action="Edit">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <label>Payment Status</label>
                    <select class="form-select mb-2" name="payment_status" asp-for="PaymentStatus">
                        <option value="pending">pending</option>
                        <option value="accepted">accepted</option>
                        <option value="canceled">canceled</option>
                    </select>
                    <button type="submit" class="btn btn-primary">Save</button>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Order Status Modal -->
<div class="modal fade" id="orderStatusModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5">Update Order Status</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form method="get" asp-controller="LiaisonOrders" asp-action="Edit">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <label>Order Status</label>
                    <select class="form-select mb-2" name="order_status" asp-for="OrderStatus">
                        <option value="Received">Received</option>
                        <option value="accepted">accepted</option>
                        <option value="canceled">canceled</option>
                        <option value="shipped">shipped</option>
                        <option value="delivered">delivered</option>
                        <option value="returned">returned</option>
                    </select>
                    <button type="submit" class="btn btn-primary">Save</button>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Payment Details Modal -->
<div class="modal fade" id="paymentDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5">Payment Details</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p style="white-space: pre-wrap; font-family: monospace">@Html.Raw(Model.PaymentDetails)</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>