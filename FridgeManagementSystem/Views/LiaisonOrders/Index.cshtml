@model IEnumerable<FridgeManagementSystem.Models.Order>
@{
    ViewData["Title"] = "Orders Management";
    Layout = "_CustomerLiaisonLayout";
}

<h3 class="text-center mb-4">List of Orders</h3>

<!-- Display success/error messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model == null || !Model.Any())
{
    <div class="text-center py-5">
        <h4>No orders found</h4>
        <p class="text-muted">There are currently no orders to display.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Order #</th>
                    <th>Customer</th>
                    <th>Business</th>
                    <th>Items</th>
                    <th>Total</th>
                    <th>Payment Method</th>
                    <th>Payment Status</th>
                    <th>Order Status</th>
                    <th>Date</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var order in Model)
                {
                    // Calculate order totals from OrderItems
                    var orderItems = order.Items ?? new List<OrderItem>();
                    int unitCount = orderItems.Sum(item => item.Quantity);
                    decimal itemsTotal = orderItems.Sum(item => item.Quantity * item.UnitPrice);
                    decimal orderTotal = itemsTotal + order.ShippingFee;

                    // Payment status badge colors
                    string paymentBadgeColor = order.PaymentStatus?.ToLower() switch
                    {
                        "pending" => "bg-warning text-dark",
                        "accepted" or "completed" => "bg-success",
                        "failed" or "canceled" => "bg-danger",
                        "refunded" => "bg-info text-dark",
                        _ => "bg-secondary"
                    };

                    // Order status badge colors
                    string orderBadgeColor = order.OrderStatus?.ToLower() switch
                    {
                        "received" => "bg-warning text-dark",
                        "accepted" => "bg-primary",
                        "processing" => "bg-info",
                        "shipped" => "bg-info text-dark",
                        "delivered" => "bg-success",
                        "cancelled" or "canceled" => "bg-danger",
                        "returned" => "bg-dark",
                        _ => "bg-secondary"
                    };

                    // Format payment method
                    var paymentMethod = order.PaymentMethod ?? "Unknown";
                    var formattedPaymentMethod = paymentMethod switch
                    {
                        "CreditCard" => "Credit Card",
                        "CashOnDelivery" => "Cash on Delivery",
                        "PayPal" => "PayPal",
                        _ => paymentMethod
                    };

                    <tr>
                        <td>
                            <strong>#@order.Id</strong>
                        </td>
                        <td>
                            @if (order.Customer?.User != null)
                            {
                                <div>
                                    <strong>@(order.Customer.User.FullName ?? "N/A")</strong>
                                    <br />
                                    <small class="text-muted">@(order.Customer.User.Email ?? "No email")</small>
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">Customer not found</span>
                            }
                        </td>
                        <td>
                            @if (order.Customer != null)
                            {
                                <span>@(order.Customer.BusinessName ?? "N/A")</span>
                                <br />
                                <small class="text-muted">@order.Customer.CustomerType</small>
                            }
                            else
                            {
                                <span class="text-muted">N/A</span>
                            }
                        </td>
                        <td>
                            <span class="badge bg-light text-dark" title="@orderItems.Count distinct items">
                                @unitCount unit@(unitCount != 1 ? "s" : "")
                                @if (orderItems.Count > 1)
                                {
                                    <small>(@orderItems.Count types)</small>
                                }
                            </span>
                        </td>
                        <td>
                            <strong>R @orderTotal.ToString("N2")</strong>
                            <br />
                            <small class="text-muted">Items: R @itemsTotal.ToString("N2")</small>
                            <br />
                            <small class="text-muted">Shipping: R @order.ShippingFee.ToString("N2")</small>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark">@formattedPaymentMethod</span>
                        </td>
                        <td>
                            <span class="badge rounded-pill @paymentBadgeColor">
                                @order.PaymentStatus?.ToUpper()
                            </span>
                        </td>
                        <td>
                            <span class="badge rounded-pill @orderBadgeColor">
                                @order.OrderStatus?.ToUpper()
                            </span>
                        </td>
                        <td>
                            @order.CreatedAt.ToString("MM/dd/yyyy")
                            <br />
                            <small class="text-muted">@order.CreatedAt.ToString("HH:mm")</small>
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                <a class="btn btn-primary btn-sm" asp-controller="LiaisonOrders" asp-action="Details"
                                   asp-route-id="@order.Id" title="View Details">
                                    <i class="fas fa-eye"></i> Details
                                </a>
                                
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (ViewBag.TotalPages > 1)
    {
        <nav aria-label="Order pagination">
            <ul class="pagination justify-content-center">
                <!-- Previous page -->
                @if (ViewBag.PageIndex > 1)
                {
                    <li class="page-item">
                        <a class="page-link" asp-route-pageIndex="@(ViewBag.PageIndex - 1)" aria-label="Previous">
                            <span aria-hidden="true">&laquo;</span>
                        </a>
                    </li>
                }
                else
                {
                    <li class="page-item disabled">
                        <span class="page-link" aria-hidden="true">&laquo;</span>
                    </li>
                }

                <!-- Page numbers -->
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    string active = i == ViewBag.PageIndex ? "active" : "";
                    <li class="page-item @active">
                        <a class="page-link" asp-route-pageIndex="@i">@i</a>
                    </li>
                }

                <!-- Next page -->
                @if (ViewBag.PageIndex < ViewBag.TotalPages)
                {
                    <li class="page-item">
                        <a class="page-link" asp-route-pageIndex="@(ViewBag.PageIndex + 1)" aria-label="Next">
                            <span aria-hidden="true">&raquo;</span>
                        </a>
                    </li>
                }
                else
                {
                    <li class="page-item disabled">
                        <span class="page-link" aria-hidden="true">&raquo;</span>
                    </li>
                }
            </ul>
        </nav>
    }

    <!-- Order statistics -->
    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <h6 class="card-title">Order Summary</h6>
                    <div class="row text-center">
                        <div class="col">
                            <h4>@ViewBag.TotalCount</h4>
                            <small class="text-muted">Total Orders</small>
                        </div>
                        <div class="col">
                            <h4>@Model.Count(o => o.OrderStatus?.ToLower() == "received")</h4>
                            <small class="text-muted">Received</small>
                        </div>
                        <div class="col">
                            <h4>@Model.Count(o => o.OrderStatus?.ToLower() == "accepted")</h4>
                            <small class="text-muted">Accepted</small>
                        </div>
                        <div class="col">
                            <h4>@Model.Count(o => o.OrderStatus?.ToLower() == "processing")</h4>
                            <small class="text-muted">Processing</small>
                        </div>
                        <div class="col">
                            <h4>@Model.Count(o => o.OrderStatus?.ToLower() == "shipped")</h4>
                            <small class="text-muted">Shipped</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        // Auto-dismiss alerts after 3 seconds
        setTimeout(function () {
            $('.alert').alert('close');
        }, 3000);

        // Add some interactive features
        $(document).ready(function () {
            // Add hover effects to table rows
            $('table tbody tr').hover(
                function () {
                    $(this).addClass('table-active');
                },
                function () {
                    $(this).removeClass('table-active');
                }
            );

            // Tooltip initialization
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[title]'))
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl)
            });
        });
    </script>
}