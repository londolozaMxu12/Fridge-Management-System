@model IEnumerable<Order>

@{
    ViewData["Title"] = "My Orders";
    Layout = "_CustomerLayout";

}


<h3 class="text-center text-light mb-4">
    <i class="bi bi-bag-check text-light fs-2 me-2"></i> List of Orders
</h3>

@if (Model == null || !Model.Any())
{
    <div class="text-center text-light py-5">
        <i class="bi bi-bag-x display-4 text-muted mb-3 empty-icon"></i>
        <h4 class="fw-semibold">You have no orders yet</h4>
        <p class="text-secondary">Looks like you haven’t bought anything yet.</p>
        <a asp-controller="Store" asp-action="Index" class="btn btn-primary mt-3">
            Start Shopping
        </a>
    </div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Units</th>
                <th>Total</th>
                <th>Payment Method</th>
                <th>Payment Status</th>
                <th>Order Status</th>
                <th>Date</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var order in Model)
            {
                int count = 0;
                decimal total = order.ShippingFee;
                foreach (OrderItem item in order.Items)
                {
                    count += item.Quantity;
                    total += item.Quantity * item.UnitPrice;
                }

                string paymentBadgeColor = "bg-danger";
                if (order.PaymentStatus == "pending")
                {
                    paymentBadgeColor = "bg-warning text-dark";
                }
                else if (order.PaymentStatus == "accepted")
                {
                    paymentBadgeColor = "bg-success";
                }
                else if (order.PaymentStatus == "canceled")
                {
                    paymentBadgeColor = "bg-secondary";
                }

                string orderBadgeColor = "bg-danger";
                if (order.OrderStatus == "Received")
                {
                    orderBadgeColor = "bg-warning text-dark";
                }
                else if (order.OrderStatus == "Accepted")
                {
                    orderBadgeColor = "bg-success";
                }
                else if (order.OrderStatus == "Canceled")
                {
                    orderBadgeColor = "bg-secondary";
                }
                else if (order.OrderStatus == "Shipped")
                {
                    orderBadgeColor = "bg-primary";
                }
                else if (order.OrderStatus == "Delivered")
                {
                    orderBadgeColor = "bg-success";
                }
                else if (order.OrderStatus == "Returned")
                {
                    orderBadgeColor = "bg-info text-dark";
                }

                <tr>
                    <td>@count</td>
                    <td>R @(total)</td>
                    <td>@order.PaymentMethod</td>
                    <td><span class="badge rounded-pill @paymentBadgeColor">@order.PaymentStatus</span></td>
                    <td><span class="badge rounded-pill @orderBadgeColor">@order.OrderStatus</span></td>
                    <td>@order.CreatedAt.ToString("dd/MM/yyyy")</td>
                    <td>
                        <a class="btn btn-primary btn-sm" asp-controller="CustomerOrders" asp-action="Details"
                           asp-route-id="@order.Id">Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <nav>
        <ul class="pagination">
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                string active = "";
                if (i == ViewBag.PageIndex) active = "active";

                <li class="page-item @active">
                    <a class="page-link" asp-route-pageIndex=@i>@i</a>
                </li>
            }
        </ul>
    </nav>
}