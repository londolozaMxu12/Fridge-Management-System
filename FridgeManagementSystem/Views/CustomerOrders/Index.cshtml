@model IEnumerable<Order>

@{
    ViewData["Title"] = "My Orders";
    Layout = "_CustomerLayout";
}
<style>
    .timeline {
        position: relative;
        padding-left: 30px;
    }

    .timeline-item {
        position: relative;
        margin-bottom: 20px;
    }

        .timeline-item:last-child {
            margin-bottom: 0;
        }

    .timeline-marker {
        position: absolute;
        left: -30px;
        top: 0;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: #dee2e6;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 10px;
    }

    .timeline-item.completed .timeline-marker {
        background: #28a745;
    }

    .timeline-item.current .timeline-marker {
        background: #007bff;
        animation: pulse 2s infinite;
    }

    .timeline-content {
        padding-bottom: 10px;
    }

    .timeline-item:not(:last-child)::after {
        content: '';
        position: absolute;
        left: -21px;
        top: 20px;
        bottom: -20px;
        width: 2px;
        background: #dee2e6;
    }

    .timeline-item.completed:not(:last-child)::after {
        background: #28a745;
    }

    @@keyframes pulse {
        0% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.1);
        }

        100% {
            transform: scale(1);
        }
    }
</style>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 text-light">
            <i class="fas fa-shopping-bag me-2"></i>My Orders
        </h1>
        <a asp-controller="Store" asp-action="Index" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i> Continue Shopping
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="text-center text-light py-5">
            <i class="fas fa-shopping-bag fa-4x text-muted mb-4"></i>
            <h3 class="fw-semibold mb-3">You have no orders yet</h3>
            <p class="text-secondary mb-4">Start shopping to see your orders here.</p>
            <a asp-controller="Store" asp-action="Index" class="btn btn-primary btn-lg">
                <i class="fas fa-shopping-cart me-2"></i>Start Shopping
            </a>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="fas fa-list me-2"></i>Order History
                    <span class="badge bg-light text-dark ms-2">@Model.Count() orders</span>
                </h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-primary">
                            <tr>
                                <th>Order #</th>
                                <th>Items</th>
                                <th>Total Amount</th>
                                <th>Payment Status</th>
                                <th>Order Status</th>
                                <th>Order Date</th>
                                <th>Invoice</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                var orderItems = order.Items ?? new List<OrderItem>();
                                int totalUnits = orderItems.Sum(item => item.Quantity);
                                int distinctItems = orderItems.Count;
                                decimal subtotal = orderItems.Sum(item => item.Quantity * item.UnitPrice);
                                decimal totalAmount = subtotal + order.ShippingFee;

                                string paymentBadgeColor = GetPaymentBadgeColor(order.PaymentStatus);
                                string orderBadgeColor = GetOrderBadgeColor(order.OrderStatus);

                                <tr>
                                    <td>
                                        <strong>#@order.Id</strong>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary" title="@distinctItems distinct item@(distinctItems != 1 ? "s" : "")">
                                            @totalUnits unit@(totalUnits != 1 ? "s" : "")
                                        </span>
                                        @if (distinctItems > 1)
                                        {
                                            <br />
                                            <small class="text-muted">@distinctItems items</small>
                                        }
                                    </td>
                                    <td>
                                        <strong>R @totalAmount.ToString("N2")</strong>
                                        @if (order.ShippingFee > 0)
                                        {
                                            <br />
                                            <small class="text-muted">Includes R @order.ShippingFee.ToString("N2") shipping</small>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge @paymentBadgeColor">@GetPaymentStatusDisplay(order.PaymentStatus)</span>
                                    </td>
                                    <td>
                                        <span class="badge @orderBadgeColor">@order.OrderStatus</span>
                                    </td>
                                    <td>
                                        @order.CreatedAt.ToString("MMM dd, yyyy")
                                        <br />
                                        <small class="text-muted">@order.CreatedAt.ToString("hh:mm tt")</small>
                                    </td>
                                    <td>
                                        @if (order.Invoices?.Any() == true)
                                        {
                                            <span class="badge bg-success">Available</span>
                                            <br />
                                            <small>
                                                <a href="@Url.Action("DownloadInvoice", "CustomerOrders", new { id = order.Id })"
                                                   class="text-decoration-none">Download</a>
                                            </small>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Not Generated</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group-vertical btn-group-sm">
                                            <a class="btn btn-outline-primary"
                                               asp-controller="CustomerOrders"
                                               asp-action="Details"
                                               asp-route-id="@order.Id"
                                               title="View Order Details">
                                                <i class="fas fa-eye"></i> View
                                            </a>
                                            <button class="btn btn-outline-info track-order-btn mt-1"
                                                    data-order-id="@order.Id"
                                                    title="Track Order">
                                                <i class="fas fa-shipping-fast"></i> Track
                                            </button>
                                            <a class="btn btn-outline-success mt-1 download-invoice-btn"
                                               href="@Url.Action("DownloadInvoice", "CustomerOrders", new { id = order.Id })"
                                               title="Download Invoice"
                                               data-order-id="@order.Id">
                                                <i class="fas fa-file-invoice"></i> Invoice
                                            </a>
                                            @{
                                                var cancellableStatuses = new[] { "Received", "Pending", "Processing" };
                                                var canCancel = cancellableStatuses.Contains(order.OrderStatus);
                                            }
                                            @if (canCancel)
                                            {
                                                <button class="btn btn-outline-danger mt-1"
                                                        title="Cancel Order"
                                                        onclick="confirmCancel(@order.Id, '@order.OrderStatus')">
                                                    <i class="fas fa-times"></i> Cancel
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Order Statistics -->
                <div class="row mt-4">
                    <div class="col-md-12">
                        <div class="card bg-light">
                            <div class="card-body py-3">
                                <div class="row text-center">
                                    <div class="col">
                                        <h5 class="mb-1 text-primary">@Model.Count()</h5>
                                        <small class="text-muted">Total Orders</small>
                                    </div>
                                    <div class="col">
                                        <h5 class="mb-1 text-success">@Model.Count(o => o.OrderStatus == "Delivered")</h5>
                                        <small class="text-muted">Delivered</small>
                                    </div>
                                    <div class="col">
                                        <h5 class="mb-1 text-warning">@Model.Count(o => o.OrderStatus == "Processing" || o.OrderStatus == "Shipped")</h5>
                                        <small class="text-muted">In Progress</small>
                                    </div>
                                    <div class="col">
                                        <h5 class="mb-1 text-info">@Model.Sum(o => o.Items?.Sum(i => i.Quantity) ?? 0)</h5>
                                        <small class="text-muted">Total Units</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Pagination -->
                @if (ViewBag.TotalPages > 1)
                {
                    <nav aria-label="Order pagination">
                        <ul class="pagination justify-content-center mt-4">
                            @if (ViewBag.PageIndex > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-route-pageIndex="@(ViewBag.PageIndex - 1)">
                                        <i class="fas fa-chevron-left"></i> Previous
                                    </a>
                                </li>
                            }

                            @for (int i = 1; i <= ViewBag.TotalPages; i++)
                            {
                                <li class="page-item @(i == ViewBag.PageIndex ? "active" : "")">
                                    <a class="page-link" asp-route-pageIndex="@i">@i</a>
                                </li>
                            }

                            @if (ViewBag.PageIndex < ViewBag.TotalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-route-pageIndex="@(ViewBag.PageIndex + 1)">
                                        Next <i class="fas fa-chevron-right"></i>
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>
                }

                @if (ViewBag.TotalCount > 0)
                {
                    <div class="text-center text-muted mt-3">
                        <small>
                            Showing @((ViewBag.PageIndex - 1) * 5 + 1) to
                            @Math.Min(ViewBag.PageIndex * 5, ViewBag.TotalCount) of
                            @ViewBag.TotalCount orders
                        </small>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- Tracking Modal -->
<div class="modal fade" id="trackingModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="fas fa-shipping-fast me-2"></i>
                    Order Tracking - #<span id="trackingOrderId"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="trackingContent">
                    <!-- Tracking content will be loaded here -->
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <a id="viewDetailsBtn" href="#" class="btn btn-primary">
                    <i class="fas fa-eye me-1"></i> View Full Details
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Track Order functionality
        document.addEventListener('DOMContentLoaded', function() {
            // Add event listeners to track buttons
            document.querySelectorAll('.track-order-btn').forEach(button => {
                button.addEventListener('click', function() {
                    const orderId = this.getAttribute('data-order-id');
                    showTrackingModal(orderId);
                });
            });

            // Auto-dismiss alerts after 3 seconds
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(alert => {
                setTimeout(() => {
                    const bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                }, 3000);
            });

            // Add row hover effects
            const tableRows = document.querySelectorAll('table tbody tr');
            tableRows.forEach(row => {
                row.addEventListener('mouseenter', function() {
                    this.style.transform = 'translateY(-2px)';
                    this.style.transition = 'transform 0.2s ease';
                    this.style.boxShadow = '0 4px 8px rgba(0,0,0,0.1)';
                });
                row.addEventListener('mouseleave', function() {
                    this.style.transform = '';
                    this.style.boxShadow = '';
                });
            });
        });

        function showTrackingModal(orderId) {
            // Show loading state
            const trackingContent = document.getElementById('trackingContent');
            trackingContent.innerHTML = `
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">Loading tracking information...</p>
                </div>
            `;

            // Set order ID in modal header
            document.getElementById('trackingOrderId').textContent = orderId;

            // Update view details link
            document.getElementById('viewDetailsBtn').href = `/CustomerOrders/Details/${orderId}`;

            // Show modal
            const trackingModal = new bootstrap.Modal(document.getElementById('trackingModal'));
            trackingModal.show();

            // Load tracking data
            fetch(`/CustomerOrders/TrackOrder?id=${orderId}`)
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    }
                    return response.json();
                })
                .then(data => {
                    if (data.success) {
                        displayTrackingInfo(data.data);
                    } else {
                        throw new Error(data.message || 'Failed to load tracking information');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    trackingContent.innerHTML = `
                        <div class="alert alert-danger">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            Error loading tracking information: ${error.message}
                        </div>
                    `;
                });
        }

        function displayTrackingInfo(trackingData) {
            const trackingContent = document.getElementById('trackingContent');

            // Create status timeline
            const statusTimeline = createStatusTimeline(trackingData.Status);

            // Create items list
            const itemsList = trackingData.Items?.map(item => `
                <div class="border-bottom pb-2 mb-2">
                    <strong>${item.Name}</strong><br>
                    <small class="text-muted">
                        ${item.Brand} ${item.Model} • Qty: ${item.Quantity} • Status: ${item.Status}
                    </small>
                </div>
            `).join('') || '<p class="text-muted">No items found</p>';

            // Create allocations info
            const allocationsInfo = trackingData.Allocations?.length > 0 ?
                `<p><i class="fas fa-check text-success me-2"></i>${trackingData.Allocations.length} fridge(s) allocated</p>` :
                '<p><i class="fas fa-clock text-warning me-2"></i>Awaiting allocation</p>';

            const html = `
                <div class="row">
                    <div class="col-md-6">
                        <div class="card mb-3">
                            <div class="card-body">
                                <h6 class="card-title">Order Information</h6>
                                <p><strong>Status:</strong> <span class="badge ${getOrderBadgeColor(trackingData.Status)}">${trackingData.Status}</span></p>
                                <p><strong>Payment:</strong> <span class="badge ${getPaymentBadgeColor(trackingData.PaymentStatus)}">${trackingData.PaymentStatus}</span></p>
                                <p><strong>Order Date:</strong> ${new Date(trackingData.CreatedAt).toLocaleDateString()}</p>
                                <p><strong>Estimated Delivery:</strong> ${new Date(trackingData.EstimatedDelivery).toLocaleDateString()}</p>
                                ${allocationsInfo}
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-body">
                                <h6 class="card-title">Progress</h6>
                                ${statusTimeline}
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mt-3">
                    <div class="card-header">
                        <h6 class="card-title mb-0">Order Items</h6>
                    </div>
                    <div class="card-body">
                        ${itemsList}
                    </div>
                </div>
            `;

            trackingContent.innerHTML = html;
        }

        function createStatusTimeline(currentStatus) {
            const statuses = [
                { status: 'Received', label: 'Order Received', description: 'Order placed and confirmed' },
                { status: 'Accepted', label: 'Payment Accepted', description: 'Payment processed successfully' },
                { status: 'Processing', label: 'Processing', description: 'Preparing your order for shipment' },
                { status: 'Shipped', label: 'Shipped', description: 'Order is on its way to you' },
                { status: 'Delivered', label: 'Delivered', description: 'Order delivered successfully' }
            ];

            const currentIndex = statuses.findIndex(s => s.status === currentStatus);

            return `
                <div class="timeline">
                    ${statuses.map((status, index) => `
                        <div class="timeline-item ${index <= currentIndex ? 'completed' : ''} ${index === currentIndex ? 'current' : ''}">
                            <div class="timeline-marker">
                                <i class="fas ${index < currentIndex ? 'fa-check' : index === currentIndex ? 'fa-shipping-fast' : 'fa-clock'}"></i>
                            </div>
                            <div class="timeline-content">
                                <strong>${status.label}</strong>
                                <small class="d-block text-muted">${status.description}</small>
                            </div>
                        </div>
                    `).join('')}
                </div>
            `;
        }

        function getOrderBadgeColor(status) {
            const colors = {
                'Received': 'bg-warning text-dark',
                'Accepted': 'bg-primary',
                'Processing': 'bg-info',
                'Shipped': 'bg-info text-dark',
                'Delivered': 'bg-success',
                'Cancelled': 'bg-danger'
            };
            return colors[status] || 'bg-secondary';
        }

        function getPaymentBadgeColor(status) {
            const colors = {
                'pending': 'bg-warning text-dark',
                'accepted': 'bg-success',
                'paid': 'bg-success',
                'failed': 'bg-danger',
                'cancelled': 'bg-secondary'
            };
            return colors[status] || 'bg-secondary';
        }

        // Cancel order functions (existing)
        function confirmCancel(orderId, currentStatus) {
            const statusText = currentStatus === 'Received' ? 'Received' : currentStatus;

            Swal.fire({
                title: 'Confirm Cancellation',
                html: `Are you sure you want to cancel this <strong>${statusText}</strong> order?<br><br>
                      <small class="text-muted">This action cannot be undone.</small>`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, Cancel Order',
                cancelButtonText: 'No, Keep Order',
                reverseButtons: true,
                backdrop: true,
                allowOutsideClick: false
            }).then((result) => {
                if (result.isConfirmed) {
                    cancelOrder(orderId);
                }
            });
        }

        function cancelOrder(orderId) {
            // ... existing cancelOrder implementation ...
            Swal.fire({
                title: 'Cancelling Order...',
                text: 'Please wait while we process your request',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            fetch(`/CustomerOrders/CancelOrder?id=${orderId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({ id: orderId })
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }
                return response.json();
            })
            .then(data => {
                if (data.success) {
                    Swal.fire({
                        title: 'Order Cancelled!',
                        text: data.message || 'Your order has been cancelled successfully.',
                        icon: 'success',
                        confirmButtonColor: '#3085d6',
                        timer: 2000,
                        timerProgressBar: true
                    }).then(() => {
                        location.reload();
                    });
                } else {
                    throw new Error(data.message || 'Failed to cancel order');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                Swal.fire({
                    title: 'Error!',
                    text: error.message || 'An error occurred while cancelling the order. Please try again.',
                    icon: 'error',
                    confirmButtonColor: '#d33'
                });
            });
        }
    </script>

    </div>
}

@functions {
    string GetPaymentBadgeColor(string paymentStatus)
    {
        return paymentStatus?.ToLower() switch
        {
            "pending" => "bg-warning text-dark",
            "accepted" or "paid" or "completed" => "bg-success",
            "canceled" or "cancelled" or "failed" => "bg-danger",
            "refunded" => "bg-info text-dark",
            _ => "bg-secondary"
        };
    }

    string GetOrderBadgeColor(string orderStatus)
    {
        return orderStatus?.ToLower() switch
        {
            "received" or "pending" => "bg-warning text-dark",
            "accepted" or "processing" => "bg-primary",
            "shipped" => "bg-info text-dark",
            "delivered" or "completed" => "bg-success",
            "canceled" or "cancelled" => "bg-danger",
            "returned" => "bg-secondary",
            _ => "bg-secondary"
        };
    }

    string GetPaymentStatusDisplay(string paymentStatus)
    {
        return paymentStatus?.ToLower() switch
        {
            "pending" => "Pending",
            "accepted" => "Paid",
            "paid" => "Paid",
            "canceled" => "Cancelled",
            "cancelled" => "Cancelled",
            "failed" => "Failed",
            "refunded" => "Refunded",
            _ => paymentStatus
        };
    }

    string GetPaymentMethodDisplay(string paymentMethod)
    {
        return paymentMethod?.ToLower() switch
        {
            "creditcard" or "credit card" => "Credit Card",
            "debitcard" or "debit card" => "Debit Card",
            "cash" => "Cash",
            "banktransfer" or "bank transfer" => "Bank Transfer",
            "eft" => "EFT",
            "paypal" => "PayPal",
            "cashondelivery" or "cash on delivery" => "Cash on Delivery",
            _ => paymentMethod
        };
    }
}