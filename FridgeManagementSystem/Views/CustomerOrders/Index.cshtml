@model IEnumerable<Order>

@{
    ViewData["Title"] = "My Orders";
    Layout = "_CustomerLayout";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 text-light">
            <i class="fas fa-shopping-bag me-2"></i>My Orders
        </h1>
        <a asp-controller="Store" asp-action="Index" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i> Continue Shopping
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="text-center text-light py-5">
            <i class="fas fa-shopping-bag fa-4x text-muted mb-4"></i>
            <h3 class="fw-semibold mb-3">You have no orders yet</h3>
            <p class="text-secondary mb-4">Start shopping to see your orders here.</p>
            <a asp-controller="Store" asp-action="Index" class="btn btn-primary btn-lg">
                <i class="fas fa-shopping-cart me-2"></i>Start Shopping
            </a>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="fas fa-list me-2"></i>Order History
                    <span class="badge bg-light text-dark ms-2">@Model.Count() orders</span>
                </h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-primary">
                            <tr>
                                <th>Order #</th>
                                <th>Items</th>
                                <th>Total Amount</th>
                                <th>Payment Method</th>
                                <th>Payment Status</th>
                                <th>Order Status</th>
                                <th>Order Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                int itemCount = 0;
                                decimal totalAmount = order.ShippingFee;

                                foreach (OrderItem item in order.Items)
                                {
                                    itemCount += item.Quantity;
                                    totalAmount += item.Quantity * item.UnitPrice;
                                }

                                string paymentBadgeColor = GetPaymentBadgeColor(order.PaymentStatus);
                                string orderBadgeColor = GetOrderBadgeColor(order.OrderStatus);

                                <tr>
                                    <td>
                                        <strong>#@order.Id</strong>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@itemCount item(s)</span>
                                    </td>
                                    <td>
                                        <strong>R @totalAmount.ToString("N2")</strong>
                                        @if (order.ShippingFee > 0)
                                        {
                                            <br />
                                            <small class="text-muted">Includes R @order.ShippingFee.ToString("N2") shipping</small>
                                        }
                                    </td>
                                    <td>
                                        @GetPaymentMethodDisplay(order.PaymentMethod)
                                    </td>
                                    <td>
                                        <span class="badge @paymentBadgeColor">@GetPaymentStatusDisplay(order.PaymentStatus)</span>
                                    </td>
                                    <td>
                                        <span class="badge @orderBadgeColor">@order.OrderStatus</span>
                                    </td>
                                    <td>
                                        @order.CreatedAt.ToString("MMM dd, yyyy")
                                        <br />
                                        <small class="text-muted">@order.CreatedAt.ToString("hh:mm tt")</small>
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <a class="btn btn-outline-primary"
                                               asp-controller="CustomerOrders"
                                               asp-action="Details"
                                               asp-route-id="@order.Id"
                                               title="View Order Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            @if (order.OrderStatus == "Received" || order.OrderStatus == "Pending")
                                            {
                                                <button class="btn btn-outline-warning"
                                                        title="Cancel Order"
                                                        onclick="confirmCancel(@order.Id, '@order.OrderStatus')">
                                                    <i class="fas fa-times"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (ViewBag.TotalPages > 1)
                {
                    <nav aria-label="Order pagination">
                        <ul class="pagination justify-content-center mt-4">
                            @if (ViewBag.PageIndex > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-route-pageIndex="@(ViewBag.PageIndex - 1)">
                                        <i class="fas fa-chevron-left"></i> Previous
                                    </a>
                                </li>
                            }

                            @for (int i = 1; i <= ViewBag.TotalPages; i++)
                            {
                                <li class="page-item @(i == ViewBag.PageIndex ? "active" : "")">
                                    <a class="page-link" asp-route-pageIndex="@i">@i</a>
                                </li>
                            }

                            @if (ViewBag.PageIndex < ViewBag.TotalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-route-pageIndex="@(ViewBag.PageIndex + 1)">
                                        Next <i class="fas fa-chevron-right"></i>
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>
                }

                @if (ViewBag.TotalCount > 0)
                {
                    <div class="text-center text-muted mt-3">
                        <small>
                            Showing @((ViewBag.PageIndex - 1) * 5 + 1) to
                            @Math.Min(ViewBag.PageIndex * 5, ViewBag.TotalCount) of
                            @ViewBag.TotalCount orders
                        </small>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function confirmCancel(orderId, orderStatus) {
            if (confirm(`Are you sure you want to cancel order #${orderId}?`)) {
                // You would typically call a CancelOrder action here
                alert('Cancel order functionality would be implemented here.');
                // window.location.href = '/CustomerOrders/CancelOrder?id=' + orderId;
            }
        }

        // Auto-dismiss alerts after 5 seconds
        document.addEventListener('DOMContentLoaded', function() {
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(alert => {
                setTimeout(() => {
                    const bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                }, 3000);
            });
        });
    </script>
}

@functions {
    string GetPaymentBadgeColor(string paymentStatus)
    {
        return paymentStatus?.ToLower() switch
        {
            "pending" => "bg-warning text-dark",
            "accepted" or "paid" or "completed" => "bg-success",
            "canceled" or "cancelled" or "failed" => "bg-danger",
            "refunded" => "bg-info text-dark",
            _ => "bg-secondary"
        };
    }

    string GetOrderBadgeColor(string orderStatus)
    {
        return orderStatus?.ToLower() switch
        {
            "received" or "pending" => "bg-warning text-dark",
            "accepted" or "processing" => "bg-primary",
            "shipped" => "bg-info",
            "delivered" or "completed" => "bg-success",
            "canceled" or "cancelled" => "bg-danger",
            "returned" => "bg-secondary",
            _ => "bg-secondary"
        };
    }

    string GetPaymentStatusDisplay(string paymentStatus)
    {
        return paymentStatus?.ToLower() switch
        {
            "pending" => "Pending",
            "accepted" => "Paid",
            "paid" => "Paid",
            "canceled" => "Cancelled",
            "cancelled" => "Cancelled",
            "failed" => "Failed",
            "refunded" => "Refunded",
            _ => paymentStatus
        };
    }

    string GetPaymentMethodDisplay(string paymentMethod)
    {
        return paymentMethod?.ToLower() switch
        {
            "creditcard" or "credit card" => "Credit Card",
            "debitcard" or "debit card" => "Debit Card",
            "cash" => "Cash",
            "banktransfer" or "bank transfer" => "Bank Transfer",
            "eft" => "EFT",
            _ => paymentMethod
        };
    }
}