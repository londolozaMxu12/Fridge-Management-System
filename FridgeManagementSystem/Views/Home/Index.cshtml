@* @using Microsoft.AspNetCore.Identity
@using FidgeSystem.Areas.Identity.Pages.Account *@
@{
    ViewData["Title"] = "Home Page";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <title>ViewData["Title"]</title>
    <style>
        body {
            background-image: url('images/faded_gallery-OfdOEdGYiuk-unsplash.jpg');
            background-size: cover;
            background-position: center;
        }

        h1 {
            text-align: center;
            margin-top: 110px;
            font-weight: bold;
            font-size: 50px;
        }

        .btn-container {
            display: flex;
            align-content: center;
            justify-content: center;
            margin-top: 60px;
            margin-bottom: 290px;
        }

        .btn-group button {
            background-color: black; /* Green background */
            border: 4px solid white; /* Green border */
            color: white; /* White text */
            padding: 10px 24px; /* Some padding */
            cursor: pointer; /* Pointer/hand icon */
            /*float: right;*/
            border-radius: 6px;
            align-items: center;
        }

        button {
            width: 220px;
            height: 70px;
            font-weight: bold;
            font-size: 20px;
            margin-left: 40px;
            background-color: black;
        }
    </style>
</head>
<body>
    <h1>Welcome to our incredeble deals <br>New customer? View Our Deals</h1>
    <div class="btn-container">
        <div class="btn-group">
            <button type="button" onclick="location.href='@Url.Action("Index", "Fridges")'">
                View Our Offers
            </button>
            <button type="button" onclick="location.href='/Identity/Account/Login'">
                Login
            </button>
        </div>
    </div>


</body>

</html>
