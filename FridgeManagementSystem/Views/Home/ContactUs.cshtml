@{
    ViewData["Title"] = "Home Page";
}





<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background-color: skyblue;
            color: black;
        }

        h4 i {
            color: #007bff; /* Icon color */
            margin-right: 10px; /* Spacing between icon and text */
        }

        .container {
            margin-top: 50px;
        }

        .form-section {
            background-color: darkgray;
            padding: 20px;
            border-radius: 5px;
        }
    </style>
</head>
<body>

    <div class="container mt-5" style="background-color: lightgray;">
        <div class="row">
            <div class="col-12">
                <h2 class="text-primary text-center">Contact Us</h2>
            </div>
        </div>
        <form>
            <div class="row mt-4 style="background-color: lightgray">
                <!-- Left Column: Contact Information -->
                <div class="col-md-6">
                    <h4><i class="fas fa-map-marker-alt"></i> Our Address</h4>
                    <p>123 Main Street<br>rdp chesa mpama</p>

                    <h4><i class="fas fa-phone-alt"></i> Phone Number</h4>
                    <p>(+27) 722 783 987</p>

                    <h4><i class="fas fa-envelope"></i> Email Address</h4>
                    <p>nmdesignhub@gmail.com</p>
                </div>

                <!-- Right Column: Contact Form -->
                <div class="col-md-6 form-section">
                    <h4><i class="fas fa-paper-plane"></i> Get In Touch</h4>
                    <form>
                        <div class="form-group">
                            <label for="name">Name</label>
                            <input type="text" class="form-control" id="name" placeholder="Your Name">
                        </div>

                        <div class="form-group">
                            <label for="email">Email address</label>
                            <input type="email" class="form-control" id="email" placeholder="Enter email">
                        </div>


                        <div class="row mt-4">
                            <div class="col-md-12 text-center">
                                <button type="submit" class="btn btn-primary">
                                    Submit
                                </button>
                                <button type="button" class="btn btn-danger" onclick="window.location.href='Index';">
                                    Back
                                </button>

                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


</body>
</html>

