<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>About Us</title> <!-- Bootstrap CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: skyblue;
        }
    </style>
</head>
<body>
    <div class="row">
        <div class="col-12">
            <h2 class="text-primary text-center">
                About Us
            </h2>
        </div>
    </div>
    <div class="container mt-5" style="background-color: lightgray; ">
        <div class="row">
            <!-- Left side with statistics -->
            <div class="col-md-6">

                <div class="row mt-4">
                    <div class="col-md-12 text-center mt-3">
                        <img src="~/js/photos/fix.svg" alt="Fridge" style="width:100px; filter: brightness(50%);">
                        <p>
                            <strong>20000</strong><br>Fridges Fixed a Year
                        </p>
                    </div>
                    <div class="col-md-12 text-center mt-3">
                        <img src="~/js/photos/truck.svg" alt="Truck" style="width:100px; filter: brightness(50%);">
                        <p>
                            <strong>50000</strong><br>Fridges Delivered a Year
                        </p>
                    </div>
                    <div class="col-md-12 text-center mt-3">
                        <img src="~/js/photos/fidge.jpg" alt="Fridge" style="width:100px; filter: brightness(50%);">
                        <p>
                            <strong>60000</strong><br>Fridges Sold a Year
                        </p>
                    </div>
                </div>
            </div>
            <!-- Right side with About Us content -->

            <div class="col-md-6">
                <div class="row mt-4">
                    <div class="col-md-12">
                        <h5 class="text-primary">
                            About Us
                        </h5>
                        <p>
                            We are making improvements to operate on a system that involves manual handling and documentation for various aspects related to providing fridges to customers. The entire process, from customer management to fridge purchases, relies heavily on traditional paper-based methods
                            .
                        </p>
                        <h5 class="text-primary">
                            Customer Service
                        </h5>
                        <p>
                            Our customer service team is dedicated to assisting with fridge-related queries, ensuring a smooth experience for all our customers.
                        </p>
                    </div>
                </div>
            </div>
        </div>

    </div> <!-- Bootstrap JS CDN -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>