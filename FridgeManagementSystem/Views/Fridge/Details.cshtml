@model FridgeManagementSystem.Models.Fridge

@{
    ViewData["Title"] = "Fridge Details";
    Layout = ViewData["Layout"]?.ToString() ?? "_Layout";

    // Safe variables for customer data
    var customerName = Model.Customer?.User?.FullName ?? "N/A";
    var businessName = Model.Customer?.BusinessName ?? "N/A";
    var customerType = Model.Customer?.CustomerType ?? "N/A";
    var hasCustomer = Model.Customer != null;
}

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header text-white" style="background-color: #003366;">
                <h5 class="card-title mb-0">
                    <i class="fas fa-refrigerator m-1"></i> Fridge Details - @Model.SerialNumber
                </h5>
            </div>
            <div class="card-body">
                <div class="row mb-4">
                    <div class="col-md-6 text-center">
                        @if (!string.IsNullOrEmpty(Model.ImageFileName))
                        {
                            <img src="@Url.Content($"~/Images/Fridges/{Model.ImageFileName}")"
                                 alt="Fridge Image"
                                 class="img-fluid rounded"
                                 style="max-height: 300px;"
                                 onerror="this.onerror=null; this.src='@Url.Content("~/Images/default-fridge.jpg")'" />
                        }
                        else
                        {
                            <div class="text-muted">
                                <img src="@Url.Content("~/Images/default-fridge.jpg")"
                                     alt="Default Fridge Image"
                                     class="img-fluid rounded"
                                     style="max-height: 300px;" />
                                <p>Default Image</p>
                            </div>
                        }
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="fw-bold text-primary">Serial Number:</label>
                            <p class="fs-5">@Model.SerialNumber</p>
                        </div>
                        <div class="mb-3">
                            <label class="fw-bold text-primary">Description:</label>
                            <p>@Model.Description</p>
                        </div>
                        <div class="mb-3">
                            <label class="fw-bold text-primary">Status:</label>
                            <span class="badge @GetStatusBadgeClass(Model.Status) fs-6">@Model.Status</span>
                        </div>
                        <div class="mb-3">
                            <label class="fw-bold text-primary">Price:</label>
                            <p class="fs-5 text-success">R@(Model.Price.ToString("F2"))</p>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <h6 class="border-bottom pb-2">Fridge Information</h6>
                        <dl class="row">
                            <dt class="col-sm-5">Fridge Type:</dt>
                            <dd class="col-sm-7">
                                @if (Model.FridgeType != null)
                                {
                                    <div>
                                        <strong>@Model.FridgeType.Name</strong><br />
                                        <small class="text-muted">@Model.FridgeType.Brand - @Model.FridgeType.Model</small>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-danger">Not set</span>
                                }
                            </dd>

                            <dt class="col-sm-5">Category:</dt>
                            <dd class="col-sm-7">
                                @if (Model.Category != null)
                                {
                                    @Model.Category
                                }
                                else
                                {
                                    <span class="text-muted">N/A</span>
                                }
                            </dd>

                            <dt class="col-sm-5">Supplier:</dt>
                            <dd class="col-sm-7">
                                @if (Model.Supplier?.User != null)
                                {
                                    @Model.Supplier.User.FullName
                                    @if (!string.IsNullOrEmpty(Model.Supplier.CompanyName))
                                    {
                                        <br />
                                
                                        <small class="text-muted">@Model.Supplier.CompanyName</small>
                                    }
                                }
                                else if (Model.Supplier?.CompanyName != null)
                                {
                                    @Model.Supplier.CompanyName
                                }
                                else
                                {
                                    <span class="text-muted">N/A</span>
                                }
                            </dd>

                            <dt class="col-sm-5">Acquisition Date:</dt>
                            <dd class="col-sm-7">@Model.AcquisitionDate.ToString("yyyy-MM-dd")</dd>
                        </dl>
                    </div>
                    <div class="col-md-6">
                        <h6 class="border-bottom pb-2">Service Information</h6>
                        <dl class="row">
                            <dt class="col-sm-5">Next Service Date:</dt>
                            <dd class="col-sm-7">
                                @if (Model.NextServiceDate.HasValue)
                                {
                                    @Model.NextServiceDate.Value.ToString("yyyy-MM-dd")
                                }
                                else
                                {
                                    <span class="text-muted">Not scheduled</span>
                                }
                            </dd>

                            <dt class="col-sm-5">Allocation Date:</dt>
                            <dd class="col-sm-7">
                                @if (Model.AllocationDate.HasValue)
                                {
                                    @Model.AllocationDate.Value.ToString("yyyy-MM-dd")
                                }
                                else
                                {
                                    <span class="text-muted">Not allocated</span>
                                }
                            </dd>

                            <dt class="col-sm-5">Active Status:</dt>
                            <dd class="col-sm-7">
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </dd>

                            <dt class="col-sm-5">Created Date:</dt>
                            <dd class="col-sm-7">@Model.CreatedAt.ToString("yyyy-MM-dd")</dd>
                        </dl>
                    </div>
                </div>

                @if (hasCustomer)
                {
                    <div class="row mt-3">
                        <div class="col-12">
                            <h6 class="border-bottom pb-2">Customer Information</h6>
                            <dl class="row">
                                <dt class="col-sm-3">Customer:</dt>
                                <dd class="col-sm-9">@customerName</dd>

                                <dt class="col-sm-3">Business Name:</dt>
                                <dd class="col-sm-9">@businessName</dd>

                                <dt class="col-sm-3">Customer Type:</dt>
                                <dd class="col-sm-9">@customerType</dd>
                            </dl>
                        </div>
                    </div>
                }

                <div class="row mt-4">
                    <div class="col-12">
                        <div class="btn-group">
                            <a asp-action="Edit" asp-route-id="@Model.FridgeId" class="btn btn-warning">
                                <i class="fas fa-edit m-1"></i> Edit
                            </a>
                            <a asp-action="Delete" asp-route-id="@Model.FridgeId" class="btn btn-danger">
                                <i class="fas fa-trash m-1"></i> Delete
                            </a>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left m-1"></i> Back to List
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    public string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Available" => "bg-success",
            "Allocated" => "bg-primary",
            "UnderRepair" => "bg-warning",
            "Scrapped" => "bg-danger",

            "Shipped" => "bg-info",
            "Delivered" => "bg-success",
            "Reserved" => "bg-warning text-dark",
            _ => "bg-secondary"
        };
    }
}