@model FridgeManagementSystem.ViewModels.EditFridgeViewModel

@{
    ViewData["Title"] = "Edit Fridge";
    Layout = "_AdminLayout";
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="card">
            <div class="card-header bg-warning text-dark">
                <h5 class="card-title mb-0">
                    <i class="fas fa-edit me-1"></i> @ViewData["Title"]
                </h5>
            </div>
            <div class="card-body">
                <!-- Display success/error messages from TempData -->
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fas fa-check-circle"></i> @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.SelectedFridgeTypeDisplay))
                {
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="alert alert-info">
                                <h6 class="alert-heading">
                                    <i class="fas fa-info-circle"></i> Current Fridge Type
                                </h6>
                                <p class="mb-0">@Model.SelectedFridgeTypeDisplay</p>
                            </div>
                        </div>
                    </div>
                }

                <form asp-action="Edit" enctype="multipart/form-data" id="editForm">
                    <input type="hidden" asp-for="FridgeId" />
                    <input type="hidden" asp-for="ExistingImagePath" id="existingImagePath" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="FridgeTypeId" class="form-label fw-bold"></label>
                                <select asp-for="FridgeTypeId" class="form-select" asp-items="ViewBag.FridgeTypeId" required>
                                    <option value="">-- Select Fridge Type --</option>
                                </select>
                                <span asp-validation-for="FridgeTypeId" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="SupplierId" class="form-label fw-bold"></label>
                                <select asp-for="SupplierId" class="form-select" asp-items="ViewBag.SupplierId" required>
                                    <option value="">-- Select Supplier --</option>
                                </select>
                                <span asp-validation-for="SupplierId" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group mb-3">
                                <label asp-for="Price" class="form-label fw-bold"></label>
                                <div class="input-group">
                                    <span class="input-group-text">R</span>
                                    <input asp-for="Price" class="form-control" type="number" step="0.01" min="0.01" required />
                                </div>
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mb-3">
                                <label asp-for="SerialNumber" class="form-label fw-bold"></label>
                                <input asp-for="SerialNumber" class="form-control" required />
                                <span asp-validation-for="SerialNumber" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mb-3">
                                <label asp-for="Status" class="form-label fw-bold"></label>
                                <select asp-for="Status" class="form-select" asp-items="ViewBag.StatusList" required></select>
                                <span asp-validation-for="Status" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="Category" class="form-label fw-bold"></label>
                                <select asp-for="Category" class="form-select" asp-items="ViewBag.Categories" required>
                                    <option value="">-- Select Category --</option>
                                </select>
                                <span asp-validation-for="Category" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="AcquisitionDate" class="form-label fw-bold"></label>
                                <input asp-for="AcquisitionDate" class="form-control" type="date" required />
                                <span asp-validation-for="AcquisitionDate" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Description" class="form-label fw-bold"></label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Enter fridge description..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                        <div class="form-text">Describe the fridge features, condition, and specifications</div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="NextServiceDate" class="form-label fw-bold"></label>
                                <input asp-for="NextServiceDate" class="form-control" type="date" />
                                <span asp-validation-for="NextServiceDate" class="text-danger small"></span>
                                <div class="form-text">Optional: Next scheduled maintenance date</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="form-label fw-bold">Image Preview</label>
                                <div id="newImagePreview" class="border rounded p-2 text-center bg-light" style="min-height: 120px; display: none;">
                                    <img id="previewImage" src="#" alt="New Image Preview" class="img-fluid" style="max-height: 100px;" />
                                    <div id="imageInfo" class="small text-muted mt-1"></div>
                                    <div class="small text-warning mt-1">
                                        <i class="fas fa-exclamation-triangle"></i> This will replace the current image
                                    </div>
                                </div>
                                <div id="noNewImagePreview" class="border rounded p-3 text-center bg-light">
                                    <i class="fas fa-image fa-2x text-muted mb-2"></i>
                                    <div class="small text-muted">No new image selected</div>
                                    <div class="small text-info">Current image will be kept</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Current Image Display -->
                    @if (!string.IsNullOrEmpty(Model.ExistingImagePath) && Model.ExistingImagePath != "default-fridge.jpg")
                    {
                        <div class="form-group mb-4">
                            <label class="form-label fw-bold">Current Image</label>
                            <div class="border rounded p-3 bg-light">
                                <div class="row align-items-center">
                                    <div class="col-md-4 text-center">
                                        <img src="@Url.Content($"~/Images/Fridges/{Model.ExistingImagePath}")"
                                             alt="Current Fridge Image"
                                             class="img-thumbnail"
                                             style="max-height: 150px;"
                                             onerror="this.src='@Url.Content("~/Images/default-fridge.jpg")'" />
                                    </div>
                                    <div class="col-md-8">
                                        <div class="small text-muted mb-2">
                                            <strong>Current Image:</strong> @Model.ExistingImagePath
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="removeImageCheckbox" name="removeImage" value="true">
                                            <label class="form-check-label text-danger" for="removeImageCheckbox">
                                                <i class="fas fa-trash-alt"></i> Remove current image and use default
                                            </label>
                                        </div>
                                        <small class="form-text text-muted">Check this if you want to remove the current image</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="form-group mb-4">
                            <label class="form-label fw-bold">Current Image</label>
                            <div class="border rounded p-3 bg-light text-center">
                                <img src="@Url.Content("~/Images/default-fridge.jpg")"
                                     alt="Default Fridge Image"
                                     class="img-thumbnail"
                                     style="max-height: 150px;" />
                                <div class="small text-muted mt-2">Using default image</div>
                            </div>
                        </div>
                    }

                    <div class="form-group mb-4">
                        <label asp-for="ImageFile" class="form-label fw-bold">Upload New Image</label>
                        <input asp-for="ImageFile" class="form-control" type="file" accept=".jpg,.jpeg,.png" id="imageInput" />
                        <span asp-validation-for="ImageFile" class="text-danger small"></span>
                        <div class="form-text">
                            Supported formats: JPG, JPEG, PNG | Maximum size: 5MB
                            <span id="fileSizeWarning" class="text-warning" style="display: none;"></span>
                        </div>
                    </div>

                    <!-- Loading indicator -->
                    <div id="loadingIndicator" class="alert alert-info text-center" style="display: none;">
                        <div class="spinner-border spinner-border-sm me-2" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <span id="loadingText">Updating fridge...</span>
                    </div>

                    <!-- Form submission feedback -->
                    <div id="formFeedback" class="alert" style="display: none;"></div>

                    <div class="form-group">
                        <button type="submit" class="btn btn-warning me-2" id="submitButton">
                            <i class="fas fa-save me-1"></i> Save Changes
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.FridgeId" class="btn btn-info me-2">
                            <i class="fas fa-eye me-1"></i> View Details
                        </a>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-1"></i> Back to List
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {
            // Enhanced image preview functionality for new image
            $('#imageInput').change(function() {
                const file = this.files[0];
                const maxSize = 5 * 1024 * 1024; // 5MB in bytes
                const fileSizeWarning = $('#fileSizeWarning');
                const removeImageCheckbox = $('#removeImageCheckbox');

                if (file) {
                    // Check file size
                    if (file.size > maxSize) {
                        fileSizeWarning.text(' File size exceeds 5MB limit!').show();
                        this.value = ''; // Clear the file input
                        $('#newImagePreview').hide();
                        $('#noNewImagePreview').show();
                        return;
                    } else {
                        fileSizeWarning.hide();
                    }

                    // Check file type
                    const validTypes = ['image/jpeg', 'image/jpg', 'image/png'];
                    if (!validTypes.includes(file.type)) {
                        fileSizeWarning.text(' Only JPG, JPEG, and PNG files are allowed!').show();
                        this.value = ''; // Clear the file input
                        $('#newImagePreview').hide();
                        $('#noNewImagePreview').show();
                        return;
                    }

                    const reader = new FileReader();
                    reader.onload = function(e) {
                        $('#previewImage').attr('src', e.target.result);
                        $('#imageInfo').html(`<strong>${file.name}</strong> (${formatFileSize(file.size)})`);
                        $('#newImagePreview').show();
                        $('#noNewImagePreview').hide();

                        // Uncheck remove image checkbox when new image is selected
                        if (removeImageCheckbox.length) {
                            removeImageCheckbox.prop('checked', false);
                        }
                    }
                    reader.onerror = function() {
                        fileSizeWarning.text(' Error reading file!').show();
                        $('#newImagePreview').hide();
                        $('#noNewImagePreview').show();
                    }
                    reader.readAsDataURL(file);
                } else {
                    $('#newImagePreview').hide();
                    $('#noNewImagePreview').show();
                    fileSizeWarning.hide();
                }
            });

            // Handle remove image checkbox
            $('#removeImageCheckbox').change(function() {
                if ($(this).is(':checked')) {
                    // Clear file input when remove is checked
                    $('#imageInput').val('');
                    $('#newImagePreview').hide();
                    $('#noNewImagePreview').show();
                    fileSizeWarning.hide();
                }
            });

            // Clear file input when remove image is checked
            $('#imageInput').click(function() {
                $('#removeImageCheckbox').prop('checked', false);
            });

            // Form submission handling
            $('#editForm').on('submit', function() {
                const submitButton = $('#submitButton');
                const loadingIndicator = $('#loadingIndicator');
                const loadingText = $('#loadingText');

                // Disable submit button and show loading
                submitButton.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Updating...');
                loadingIndicator.show();

                const hasNewImage = $('#imageInput')[0].files.length > 0;
                const removeImage = $('#removeImageCheckbox').is(':checked');

                if (hasNewImage) {
                    loadingText.text('Updating fridge and processing new image...');
                } else if (removeImage) {
                    loadingText.text('Updating fridge and removing current image...');
                } else {
                    loadingText.text('Updating fridge details...');
                }
            });

            // Handle form validation errors
            $('input, select, textarea').on('input change', function() {
                const field = $(this);
                const errorSpan = field.siblings('.text-danger');

                if (field.hasClass('input-validation-error')) {
                    field.addClass('is-invalid');
                } else {
                    field.removeClass('is-invalid');
                    errorSpan.text('');
                }
            });

            // Price validation
            $('#Price').on('blur', function() {
                const price = parseFloat($(this).val());
                if (price <= 0) {
                    $(this).addClass('is-invalid');
                    $(this).siblings('.text-danger').text('Price must be greater than 0');
                }
            });

            // Serial number validation
            $('#SerialNumber').on('blur', function() {
                const serialNumber = $(this).val().trim();
                if (!serialNumber) {
                    $(this).addClass('is-invalid');
                    $(this).siblings('.text-danger').text('Serial number is required');
                }
            });

            // Helper function to format file size
            function formatFileSize(bytes) {
                if (bytes === 0) return '0 Bytes';
                const k = 1024;
                const sizes = ['Bytes', 'KB', 'MB', 'GB'];
                const i = Math.floor(Math.log(bytes) / Math.log(k));
                return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
            }

            // Confirmation before leaving page if form has changes
            let formChanged = false;
            $('#editForm').on('change keyup', function() {
                formChanged = true;
            });

            $('a.btn').on('click', function(e) {
                if (formChanged) {
                    const response = confirm('You have unsaved changes. Are you sure you want to leave?');
                    if (!response) {
                        e.preventDefault();
                    }
                }
            });

            // Auto-focus on first field with error
            const firstError = $('.input-validation-error').first();
            if (firstError.length) {
                firstError.focus();
            }
        });
    </script>

    <style>
        .is-invalid {
            border-color: #dc3545;
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' width='12' height='12' fill='none' stroke='%23dc3545'%3e%3ccircle cx='6' cy='6' r='4.5'/%3e%3cpath d='m5.8 3.6.4.4.4-.4'/%3e%3cpath d='M6 7v1'/%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: right calc(0.375em + 0.1875rem) center;
            background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem);
        }

        .form-text {
            font-size: 0.875rem;
        }

        #newImagePreview, #noNewImagePreview {
            transition: all 0.3s ease;
        }

        #previewImage {
            max-width: 100%;
            height: auto;
        }

        .card {
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        }

        .form-label {
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .img-thumbnail {
            border: 1px solid #dee2e6;
            border-radius: 0.375rem;
        }
    </style>
}