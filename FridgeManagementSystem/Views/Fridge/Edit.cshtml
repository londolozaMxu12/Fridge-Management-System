@model FridgeManagementSystem.ViewModels.EditFridgeViewModel

@{
    ViewData["Title"] = "Edit Fridge";
    Layout = "_AdminLayout";
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="card">
            <div class="card-header bg-warning text-dark">
                <h5 class="card-title mb-0">
                    <i class="fas fa-edit m-1"></i> @ViewData["Title"]
                </h5>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.SelectedFridgeTypeDisplay))
                {
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="alert alert-info">
                                <h6 class="alert-heading">
                                    <i class="fas fa-info-circle"></i> Current Fridge Type
                                </h6>
                                <p class="mb-0">@Model.SelectedFridgeTypeDisplay</p>
                            </div>
                        </div>
                    </div>
                }
                <form asp-action="Edit" enctype="multipart/form-data" id="editForm">
                    <input type="hidden" asp-for="FridgeId" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="FridgeTypeId" class="form-label fw-bold"></label>
                                <select asp-for="FridgeTypeId" class="form-select" asp-items="ViewBag.FridgeTypeId" required>
                                    <option value="">-- Select Fridge Type --</option>
                                </select>
                                <span asp-validation-for="FridgeTypeId" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="SupplierId" class="form-label fw-bold"></label>
                                <select asp-for="SupplierId" class="form-select" asp-items="ViewBag.SupplierId" required>
                                    <option value="">-- Select Supplier --</option>
                                </select>
                                <span asp-validation-for="SupplierId" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group mb-3">
                                <label asp-for="Price" class="form-label fw-bold"></label>
                                <div class="input-group">
                                    <span class="input-group-text">R</span>
                                    <input asp-for="Price" class="form-control" type="number" step="0.01" min="0.01" />
                                </div>
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mb-3">
                                <label asp-for="SerialNumber" class="form-label fw-bold"></label>
                                <input asp-for="SerialNumber" class="form-control" />
                                <span asp-validation-for="SerialNumber" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mb-3">
                                <label asp-for="Status" class="form-label fw-bold"></label>
                                <select asp-for="Status" class="form-select" asp-items="ViewBag.StatusList"></select>
                                <span asp-validation-for="Status" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="Category" class="form-label fw-bold"></label>
                                <select asp-for="Category" class="form-select" asp-items="ViewBag.Categories"></select>
                                <span asp-validation-for="Category" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="AcquisitionDate" class="form-label fw-bold"></label>
                                <input asp-for="AcquisitionDate" class="form-control" type="date" />
                                <span asp-validation-for="AcquisitionDate" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Description" class="form-label fw-bold"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="NextServiceDate" class="form-label fw-bold"></label>
                                <input asp-for="NextServiceDate" class="form-control" type="date" />
                                <span asp-validation-for="NextServiceDate" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="ImageFile" class="form-label fw-bold"></label>
                        <input asp-for="ImageFile" class="form-control" type="file" accept="image/*" id="imageInput" />
                        <span asp-validation-for="ImageFile" class="text-danger small"></span>
                        <div class="form-text">Upload a new image to replace the current one</div>

                        @if (!string.IsNullOrEmpty(Model.ExistingImagePath))
                        {
                            <div class="form-group mb-3">
                                <label class="form-label fw-bold">Current Image:</label>
                                <div>
                                    <img src="/Images/Fridges/@Model.ExistingImagePath" alt="Current Fridge Image"
                                         class="img-thumbnail" style="max-height: 200px;"
                                         onerror="this.style.display='none'" />
                                </div>
                            </div>
                        }
                    </div>

                    <div class="form-group">
                        <button type="submit" class="btn btn-warning me-2">
                            <i class="fas fa-save m-1"></i> Save Changes
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.FridgeId" class="btn btn-info me-2">
                            <i class="fas fa-eye m-1"></i> View Details
                        </a>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left m-1"></i> Back to List
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {
            $('#editForm').on('submit', function() {
                $('button[type="submit"]').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Updating...');
            });
        });
    </script>
}