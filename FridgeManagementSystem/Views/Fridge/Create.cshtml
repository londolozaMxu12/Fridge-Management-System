@model FridgeManagementSystem.ViewModels.CreateFridgeViewModel

@{
    ViewData["Title"] = "Create New Fridge";
    Layout = "_AdminLayout";
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="card-title mb-0">
                    <i class="fas fa-plus-circle"></i> @ViewData["Title"]
                </h5>
            </div>
            <div class="card-body">
                <form asp-action="Create" enctype="multipart/form-data" id="createForm">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="FridgeTypeId" class="form-label fw-bold"></label>
                                <select asp-for="FridgeTypeId" class="form-select" asp-items="ViewBag.FridgeTypeId" required>
                                    <option value="">-- Select Fridge Type --</option>
                                </select>
                                <span asp-validation-for="FridgeTypeId" class="text-danger small"></span>
                                <div class="form-text">Select from available fridge types (Brand - Name - Model)</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="SupplierId" class="form-label fw-bold"></label>
                                <select asp-for="SupplierId" class="form-select" asp-items="ViewBag.SupplierId" required>
                                    <option value="">-- Select Supplier --</option>
                                </select>
                                <span asp-validation-for="SupplierId" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group mb-3">
                                <label asp-for="Price" class="form-label fw-bold"></label>
                                <div class="input-group">
                                    <span class="input-group-text">R</span>
                                    <input asp-for="Price" class="form-control" type="number" step="0.01" min="0.01" />
                                </div>
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mb-3">
                                <label asp-for="SerialNumber" class="form-label fw-bold"></label>
                                <input asp-for="SerialNumber" class="form-control" placeholder="Leave blank to auto-generate" />
                                <span asp-validation-for="SerialNumber" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mb-3">
                                <label asp-for="Status" class="form-label fw-bold"></label>
                                <select asp-for="Status" class="form-select" asp-items="ViewBag.StatusList"></select>
                                <span asp-validation-for="Status" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="Category" class="form-label fw-bold"></label>
                                <select asp-for="Category" class="form-select" asp-items="ViewBag.Categories"></select>
                                <span asp-validation-for="Category" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="AcquisitionDate" class="form-label fw-bold"></label>
                                <input asp-for="AcquisitionDate" class="form-control" type="date" />
                                <span asp-validation-for="AcquisitionDate" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Description" class="form-label fw-bold"></label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Enter fridge description..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                        <div class="form-text">Describe the fridge features, condition, and specifications</div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="NextServiceDate" class="form-label fw-bold"></label>
                                <input asp-for="NextServiceDate" class="form-control" type="date" />
                                <span asp-validation-for="NextServiceDate" class="text-danger small"></span>
                                <div class="form-text">Optional: Next scheduled maintenance date</div>
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="ImageFile" class="form-label fw-bold"></label>
                        <input asp-for="ImageFile" class="form-control" type="file" accept="image/*" id="imageInput" />
                        <span asp-validation-for="ImageFile" class="text-danger small"></span>
                        <div class="form-text">Upload a clear image of the fridge (JPEG, PNG - Max 5MB)</div>
                        <div id="imagePreview" class="mt-2 text-center" style="display: none;">
                            <img id="previewImage" src="#" alt="Preview" class="img-thumbnail" style="max-height: 200px;" />
                        </div>
                    </div>

                    <div class="form-group">
                        <button type="submit" class="btn btn-primary me-2">
                            <i class="fas fa-save m-1"></i> Create Fridge
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left m-1"></i> Back to List
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {
            // Set acquisition date to today if not set
            var acquisitionDate = $('#AcquisitionDate');
            if (!acquisitionDate.val()) {
                var today = new Date().toISOString().split('T')[0];
                acquisitionDate.val(today);
            }

            // Image preview functionality
            $('#imageInput').change(function() {
                const file = this.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        $('#previewImage').attr('src', e.target.result);
                        $('#imagePreview').show();
                    }
                    reader.readAsDataURL(file);
                } else {
                    $('#imagePreview').hide();
                }
            });

        });
    </script>
}