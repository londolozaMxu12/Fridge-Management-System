@model IEnumerable<FridgeManagementSystem.Models.Fridge>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Inactive Fridges";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>List Of Inactive Fridges</h1>
    <div>
        <a asp-action="Index" class="btn btn-outline-primary">View Active Fridges</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="card">
    <div class="card-body">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Serial Number</th>
                    <th>Description</th>
                    <th>Type</th>
                    <th>Price</th>
                    <th>Status</th>
                    <th>Supplier</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.SerialNumber</td>
                        <td>@item.Description</td>
                        <td>@item.FridgeType?.Name</td>
                        <td>@item.Price.ToString("C")</td>
                        <td>
                            <span class="badge bg-secondary">@item.Status</span>
                        </td>
                        <td>@item.Supplier?.User?.FullName</td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <form asp-action="Restore" method="post">
                                    <input type="hidden" name="id" value="@item.FridgeId" />
                                    <button type="submit" class="btn btn-success"
                                            onclick="return confirm('Are you sure you want to restore this fridge?')">
                                        Restore
                                    </button>
                                </form>
                                
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
