@model FridgeManagementSystem.ViewModels.FridgeViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Add New Fridge";
}

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title">@ViewData["Title"]</h5>
            </div>
            <div class="card-body">
                <form asp-action="AddFridge" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="FridgeTypeId" class="control-label"></label>
                                <select asp-for="FridgeTypeId" class="form-control" asp-items="ViewBag.FridgeTypeId">
                                    <option value="">-- Select Fridge Type --</option>
                                </select>
                                <span asp-validation-for="FridgeTypeId" class="text-danger"></span>
                                <small class="form-text text-muted">Select from available fridge types (Brand - Name - Model)</small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="SupplierId" class="control-label"></label>
                                <select asp-for="SupplierId" class="form-control" asp-items="ViewBag.SupplierId">
                                    <option value="">-- Select Supplier --</option>
                                </select>
                                <span asp-validation-for="SupplierId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="Price" class="control-label"></label>
                                <input asp-for="Price" class="form-control" type="number" step="0.01" />
                                <span asp-validation-for="Price" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="SerialNumber" class="control-label"></label>
                                <input asp-for="SerialNumber" class="form-control" />
                                <span asp-validation-for="SerialNumber" class="text-danger"></span>
                                @* <small class="form-text text-muted">Leave blank to auto-generate</small> *@
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Description" class="control-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="AcquisitionDate" class="control-label"></label>
                                <input asp-for="AcquisitionDate" class="form-control" type="date" />
                                <span asp-validation-for="AcquisitionDate" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="NextServiceDate" class="control-label"></label>
                                <input asp-for="NextServiceDate" class="form-control" type="date" />
                                <span asp-validation-for="NextServiceDate" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="ImageFileName" class="control-label"></label>
                        <input asp-for="ImageFileName" class="form-control" type="file"/>
                        <span asp-validation-for="ImageFileName" class="text-danger"></span>
                        <small class="form-text text-muted">Upload a clear image of the fridge</small>
                    </div>

                    <div class="form-group">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save m-1"></i>Add New Fridge
                           
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left m-1"></i> Back to List
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

