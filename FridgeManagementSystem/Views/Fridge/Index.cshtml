@model IEnumerable<FridgeManagementSystem.Models.Fridge>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Fridges";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Fridge Management</h1>
    <div>
        <a asp-action="AddFridge" class="btn btn-primary">
            <i class="fas fa-plus m-1"></i>Add New Fridge
            
        </a>
        <a asp-action="Inactive" class="btn btn-outline-secondary">View Inactive Fridges</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0"><i class="fas fa-list"></i> List Of Active Fridges</h5>
    </div>
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle"></i> No Active Fridges found.
                <a asp-action="AddFridge" class="alert-link">Add the first Fridge</a>.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-primary">
                        <tr>
                            <th>Image</th>
                            <th>Serial Number</th>
                            <th>Description</th>
                            <th>Type</th>
                            <th>Price</th>
                            <th>Status</th>
                            <th>Supplier</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.ImageFile))
                                    {
                                        <img src="@item.ImageFile" alt="Fridge Image" style="width: 60px; height: 60px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <span class="text-muted">No Image</span>
                                    }
                                </td>
                                <td>@item.SerialNumber</td>
                                <td>@item.Description</td>
                                <td>@item.FridgeType?.Name</td>
                                <td>@item.Price.ToString("C")</td>
                                <td>
                                    <span class="badge @GetStatusBadgeClass(item.Status)">@item.Status</span>
                                </td>
                                <td>@item.Supplier?.User?.FullName</td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="FridgeDetails" asp-route-id="@item.FridgeId" class="btn btn-info m-1">Details</a>
                                        <a asp-action="EditFridge" asp-route-id="@item.FridgeId" class="btn btn-warning m-1">Edit</a>
                                        <a asp-action="DeleteFridge" asp-route-id="@item.FridgeId" class="btn btn-danger m-1">Delete</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
       
</div>

@functions {
    public string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Available" => "bg-success",
            "Allocated" => "bg-primary",
            "InService" => "bg-warning",
            "Scrapped" => "bg-danger",
            "Maintenance" => "bg-info",
            _ => "bg-secondary"
        };
    }
}