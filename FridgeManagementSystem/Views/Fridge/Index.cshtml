@using FridgeManagementSystem.ViewModels
@model FridgeManagementViewModel
@{
    ViewData["Title"] = "Fridges Management";
    Layout = "_AdminLayout";

    // Calculate pagination variables
    var totalPages = (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize);
    var prevDisabled = Model.PageNumber <= 1 ? "disabled" : "";
    var nextDisabled = Model.PageNumber >= totalPages ? "disabled" : "";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Fridges Management</h1>
    <div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus m-1"></i> Create New
        </a>
        <a asp-action="Inactive" class="btn btn-outline-secondary">
            <i class="fas fa-archive m-1"></i> View Inactive
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Filter Section -->
<div class="card mb-4">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="fas fa-filter"></i> Filters & Search</h5>
    </div>
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-3">
                <label for="SearchString" class="form-label">Search</label>
                <input type="text" class="form-control" id="SearchString" name="searchString"
                       value="@Model.SearchString" placeholder="Search serial, description, brand...">
            </div>
            <div class="col-md-2">
                <label for="StatusFilter" class="form-label">Status</label>
                <select class="form-select" id="StatusFilter" name="statusFilter">
                    <option value="">All Status</option>
                    @foreach (var status in ViewBag.Statuses)
                    {
                        <option value="@status" selected="@(Model.StatusFilter == status)">@status</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label for="BrandFilter" class="form-label">Brand</label>
                <select class="form-select" id="BrandFilter" name="brandFilter">
                    <option value="">All Brands</option>
                    @foreach (var brand in ViewBag.Brands)
                    {
                        <option value="@brand" selected="@(Model.BrandFilter == brand)">@brand</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label for="SupplierFilter" class="form-label">Supplier</label>
                <select class="form-select" id="SupplierFilter" name="supplierFilter">
                    <option value="">All Suppliers</option>
                    @foreach (var supplier in ViewBag.Suppliers)
                    {
                        <option value="@supplier" selected="@(Model.SupplierFilter == supplier)">@supplier</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Price Range</label>
                <div class="input-group">
                    <input type="number" class="form-control" name="minPrice" value="@Model.MinPrice" placeholder="Min" step="0.01">
                    <span class="input-group-text">-</span>
                    <input type="number" class="form-control" name="maxPrice" value="@Model.MaxPrice" placeholder="Max" step="0.01">
                </div>
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-search"></i> Search...
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Clear Filters</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="fas fa-list m-1"></i>List Of Active Fridges</h5>
        <span class="badge bg-light text-dark">Total: @Model.TotalCount</span>
    </div>
    <div class="card-body">
        @if (!Model.Fridges.Any())
        {
            <div class="text-center py-4">
                <i class="fas fa-refrigerator fa-3x text-muted mb-3"></i>
                <h5>No active fridges found</h5>
                <p class="text-muted">Add first fridge.</p>
                <a asp-action="Create" class="btn btn-primary">Create First Fridge</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-primary">
                        <tr>
                            <th>Image</th>
                            <th>
                                <a asp-action="Index"
                                   asp-route-sortBy="SerialNumber"
                                   asp-route-sortOrder="@(Model.SortBy == "SerialNumber" && Model.SortOrder == "asc" ? "desc" : "asc")"
                                   asp-route-searchString="@Model.SearchString"
                                   asp-route-statusFilter="@Model.StatusFilter"
                                   asp-route-brandFilter="@Model.BrandFilter"
                                   asp-route-supplierFilter="@Model.SupplierFilter"
                                   asp-route-minPrice="@Model.MinPrice"
                                   asp-route-maxPrice="@Model.MaxPrice"
                                   class="text-decoration-none text-dark">
                                    Serial Number
                                    @if (Model.SortBy == "SerialNumber")
                                    {
                                        <i class="fas fa-sort-@(Model.SortOrder == "asc" ? "up" : "down")"></i>
                                    }
                                    else
                                    {
                                        <i class="fas fa-sort"></i>
                                    }
                                </a>
                            </th>
                            <th>
                                <a asp-action="Index"
                                   asp-route-sortBy="Brand"
                                   asp-route-sortOrder="@(Model.SortBy == "Brand" && Model.SortOrder == "asc" ? "desc" : "asc")"
                                   asp-route-searchString="@Model.SearchString"
                                   asp-route-statusFilter="@Model.StatusFilter"
                                   asp-route-brandFilter="@Model.BrandFilter"
                                   asp-route-supplierFilter="@Model.SupplierFilter"
                                   asp-route-minPrice="@Model.MinPrice"
                                   asp-route-maxPrice="@Model.MaxPrice"
                                   class="text-decoration-none text-dark">
                                    Type/Brand
                                    @if (Model.SortBy == "Brand")
                                    {
                                        <i class="fas fa-sort-@(Model.SortOrder == "asc" ? "up" : "down")"></i>
                                    }
                                    else
                                    {
                                        <i class="fas fa-sort"></i>
                                    }
                                </a>
                            </th>
                            <th>
                                <a asp-action="Index"
                                   asp-route-sortBy="Price"
                                   asp-route-sortOrder="@(Model.SortBy == "Price" && Model.SortOrder == "asc" ? "desc" : "asc")"
                                   asp-route-searchString="@Model.SearchString"
                                   asp-route-statusFilter="@Model.StatusFilter"
                                   asp-route-brandFilter="@Model.BrandFilter"
                                   asp-route-supplierFilter="@Model.SupplierFilter"
                                   asp-route-minPrice="@Model.MinPrice"
                                   asp-route-maxPrice="@Model.MaxPrice"
                                   class="text-decoration-none text-dark">
                                    Price
                                    @if (Model.SortBy == "Price")
                                    {
                                        <i class="fas fa-sort-@(Model.SortOrder == "asc" ? "up" : "down")"></i>
                                    }
                                    else
                                    {
                                        <i class="fas fa-sort"></i>
                                    }
                                </a>
                            </th>
                            <th>
                                <a asp-action="Index"
                                   asp-route-sortBy="Status"
                                   asp-route-sortOrder="@(Model.SortBy == "Status" && Model.SortOrder == "asc" ? "desc" : "asc")"
                                   asp-route-searchString="@Model.SearchString"
                                   asp-route-statusFilter="@Model.StatusFilter"
                                   asp-route-brandFilter="@Model.BrandFilter"
                                   asp-route-supplierFilter="@Model.SupplierFilter"
                                   asp-route-minPrice="@Model.MinPrice"
                                   asp-route-maxPrice="@Model.MaxPrice"
                                   class="text-decoration-none text-dark">
                                    Status
                                    @if (Model.SortBy == "Status")
                                    {
                                        <i class="fas fa-sort-@(Model.SortOrder == "asc" ? "up" : "down")"></i>
                                    }
                                    else
                                    {
                                        <i class="fas fa-sort"></i>
                                    }
                                </a>
                            </th>
                            <th>
                                <a asp-action="Index"
                                   asp-route-sortBy="Supplier"
                                   asp-route-sortOrder="@(Model.SortBy == "Supplier" && Model.SortOrder == "asc" ? "desc" : "asc")"
                                   asp-route-searchString="@Model.SearchString"
                                   asp-route-statusFilter="@Model.StatusFilter"
                                   asp-route-brandFilter="@Model.BrandFilter"
                                   asp-route-supplierFilter="@Model.SupplierFilter"
                                   asp-route-minPrice="@Model.MinPrice"
                                   asp-route-maxPrice="@Model.MaxPrice"
                                   class="text-decoration-none text-dark">
                                    Supplier
                                    @if (Model.SortBy == "Supplier")
                                    {
                                        <i class="fas fa-sort-@(Model.SortOrder == "asc" ? "up" : "down")"></i>
                                    }
                                    else
                                    {
                                        <i class="fas fa-sort"></i>
                                    }
                                </a>
                            </th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Fridges)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.ImageFileName))
                                    {
                                        <img src="/Images/Fridges/@item.ImageFileName" alt="Fridge Image"
                                             style="width: 60px; height: 60px; object-fit: cover;"
                                             class="rounded border"
                                             data-bs-toggle="tooltip"
                                             data-bs-title="View larger image"
                                             onclick="showImageModal('/Images/Fridges/@item.ImageFileName', '@item.SerialNumber')"
                                             style="cursor: pointer" />
                                    }
                                    else
                                    {
                                        <div class="text-center text-muted">
                                            <i class="fas fa-image fa-2x"></i>
                                            <div class="small">No Image</div>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <strong>@item.SerialNumber</strong>
                                </td>
                                <td>
                                    @if (item.FridgeType != null)
                                    {
                                        <strong>@item.FridgeType.Name</strong>
                                        
                                        <br />
                                        <small class="text-muted">@item.FridgeType.Brand</small>
                                        <br />
                                        <small class="text-muted">@item.FridgeType.Model</small>
                                    }
                                    else
                                    {
                                        <span class="text-danger">Not set</span>
                                    }
                                </td>
                                <td>
                                    <strong class="text-success">R@(item.Price.ToString("F2"))</strong>
                                </td>
                                <td>
                                    <span class="badge @GetStatusBadgeClass(item.Status)">@item.Status</span>
                                </td>
                                <td>
                                    @if (item.Supplier?.User != null)
                                    {
                                        @item.Supplier.User.FullName
                                    }
                                    else
                                    {
                                        <span class="text-muted">N/A</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.FridgeId"
                                           class="btn btn-info" data-bs-toggle="tooltip" title="View Details">
                                            <i class="fas fa-eye m-1"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.FridgeId"
                                           class="btn btn-warning" data-bs-toggle="tooltip" title="Edit">
                                            <i class="fas fa-edit m-1"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.FridgeId"
                                           class="btn btn-danger" data-bs-toggle="tooltip" title="Delete">
                                            <i class="fas fa-trash m-1"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (totalPages > 1)
            {
                <nav aria-label="Fridge pagination">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @prevDisabled">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pageNumber="@(Model.PageNumber - 1)"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-sortBy="@Model.SortBy"
                               asp-route-sortOrder="@Model.SortOrder"
                               asp-route-searchString="@Model.SearchString"
                               asp-route-statusFilter="@Model.StatusFilter"
                               asp-route-brandFilter="@Model.BrandFilter"
                               asp-route-supplierFilter="@Model.SupplierFilter"
                               asp-route-minPrice="@Model.MinPrice"
                               asp-route-maxPrice="@Model.MaxPrice">
                                Previous
                            </a>
                        </li>

                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-pageNumber="@i"
                                   asp-route-pageSize="@Model.PageSize"
                                   asp-route-sortBy="@Model.SortBy"
                                   asp-route-sortOrder="@Model.SortOrder"
                                   asp-route-searchString="@Model.SearchString"
                                   asp-route-statusFilter="@Model.StatusFilter"
                                   asp-route-brandFilter="@Model.BrandFilter"
                                   asp-route-supplierFilter="@Model.SupplierFilter"
                                   asp-route-minPrice="@Model.MinPrice"
                                   asp-route-maxPrice="@Model.MaxPrice">
                                    @i
                                </a>
                            </li>
                        }

                        <li class="page-item @nextDisabled">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pageNumber="@(Model.PageNumber + 1)"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-sortBy="@Model.SortBy"
                               asp-route-sortOrder="@Model.SortOrder"
                               asp-route-searchString="@Model.SearchString"
                               asp-route-statusFilter="@Model.StatusFilter"
                               asp-route-brandFilter="@Model.BrandFilter"
                               asp-route-supplierFilter="@Model.SupplierFilter"
                               asp-route-minPrice="@Model.MinPrice"
                               asp-route-maxPrice="@Model.MaxPrice">
                                Next
                            </a>
                        </li>
                    </ul>
                </nav>
            }

            <div class="row align-items-center mt-3">
                <div class="col-md-6">
                    <span class="text-muted">
                        Showing @((Model.PageNumber - 1) * Model.PageSize + 1) to
                        @Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount) of @Model.TotalCount entries
                    </span>
                </div>
                <div class="col-md-6 text-end">
                    <div class="btn-group">
                        <span class="me-2">Page size:</span>
                        @foreach (var size in new[] { 5, 10, 20, 50 })
                        {
                            <a class="btn btn-outline-secondary btn-sm @(Model.PageSize == size ? "active" : "")"
                               asp-action="Index"
                               asp-route-pageNumber="1"
                               asp-route-pageSize="@size"
                               asp-route-sortBy="@Model.SortBy"
                               asp-route-sortOrder="@Model.SortOrder"
                               asp-route-searchString="@Model.SearchString"
                               asp-route-statusFilter="@Model.StatusFilter"
                               asp-route-brandFilter="@Model.BrandFilter"
                               asp-route-supplierFilter="@Model.SupplierFilter"
                               asp-route-minPrice="@Model.MinPrice"
                               asp-route-maxPrice="@Model.MaxPrice">
                                @size
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Image Modal -->
<div class="modal fade" id="imageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="imageModalTitle">Fridge Image</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <img id="modalImage" src="" alt="Fridge Image" class="img-fluid rounded" style="max-height: 70vh;" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showImageModal(imageSrc, serialNumber) {
            document.getElementById('modalImage').src = imageSrc;
            document.getElementById('imageModalTitle').textContent = 'Fridge Image - ' + serialNumber;
            new bootstrap.Modal(document.getElementById('imageModal')).show();
        }

        // Initialize tooltips
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl)
        });
    </script>
}

@functions {
    public string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Available" => "bg-success",
            "Allocated" => "bg-primary",
            "InService" => "bg-warning",
            "Scrapped" => "bg-danger",
            "Maintenance" => "bg-info",
            _ => "bg-secondary"
        };
    }
}