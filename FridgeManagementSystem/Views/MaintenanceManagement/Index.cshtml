<!DOCTYPE html>
<html>
<head>
    <style>
        body {
            background-image: url('images/broken-fridge-repair-by-african-260nw-2299218251.jpg');
            margin: 0; /* remove default spacing */
            padding: 0;
            height: 100vh;
            background-size: cover;

        }

            body::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-color: rgba(0, 123, 255, 0.5); /* dark overlay */

                z-index: -2;
            }

        .button-list {
            display: flex;
            flex-direction: column;
            gap: 20px;
            width: 300px;
            padding-top: 80px;
        }

            .button-list button {
                padding: 20px;
                border: none;
                border-radius: 6px;
                background-color: darkslategray;
                color: white;
                font-size: 20px;
                cursor: pointer;
                transition: 0.3s;
                font-weight: bold;
            }

                .button-list button:hover {
                    background-color: lightgrey;
                }

        h2 {
            font-weight: bold;
            font-size: 30px;
        }
    </style>
</head>
<body>

    <h2>MAINTENANCE</h2>
    <div></div>
    <div class="button-list">
        <button type="button" onclick="location.href='@Url.Action("Index", "Home")'">HOME</button>
        <button type="button" onclick="location.href='@Url.Action("CustomerList", "MaintenanceManagement")'">VIEW CUSTOMERS</button>
        <button>VIEW VISITS</button>
        <button>CREATE REPORT</button>
    </div>





</body>
</html>
