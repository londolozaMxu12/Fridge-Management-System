@* @using FridgeManagementSystem.Areas.Identity.Data
@using Microsoft.AspNetCore.Identity
@using FridgeManagementSystem.Models *@
@model IEnumerable<FridgeManagementSystem.Models.Customer> 
@* @model IEnumerable<ApplicationUser> *@
@* @using System.Linq *@

<!DOCTYPE html>
<html>
<head>
    <style>
        body {
            font-family: Arial, Helvetica, sans-serif;
            color:black;
            background-color: rgba(0, 123, 255, 0.5);
        }
        a {
            color: purple;
            font-weight: bold;
        }


        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
            font-size: 16px;
            text-align: left;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            border-radius: 8px;
            overflow: hidden;

        }

        thead {
            background-color: #4CAF50;
            color: white;
        }

        th, td {
            padding: 12px 15px;
            border-bottom: 1px solid #ddd;
        }
        h1{
            align-content:center;
        }


    </style>
</head>
<body>


    <div class="btn">
        <a onclick="location.href='@Url.Action("Index")'" style="float: left   " class="btn btn-primary">BACK</a>
       
    </div>
    <div></div>
    


     <h2>CUSTOMERS</h2>
    <div></div>
    <div class="row">
        <div class="col-md-3">
            <form class="d-flex" asp-action="CustomerList" asp-controller="MaintenanceManagement">
                <input name="searchString" class="form-control ne-1" type="search" placeholder="Search by name" aria-label="Search" />
                <button class="btn btn-dark" type="submit">Search</button>
            </form>
        </div>
        <div class="col-md-6">
            <a asp-action="CustomerList" class="text-dark">Back to full List</a>
        </div>
    </div>
    <table id="customerTable">
        <thead>
            <tr>


                <th width="600px">
                    Business Name
                </th>

                <th width="600px">
                    Business Type
                </th>
                <th width="600px">
                    Allocated Fridge
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>


                    <td>
                        @item.BusinessName
                    </td>
                    
                    <td width="600px">
                        @item.CustomerType
                    </td>
                    
                    <td width="600px">
                    @if (item.Fridges != null && item.Fridges.Any())
                {
                    <ul class="mb-0">
                            @foreach (var fridge in item.Fridges)
                        {
                            <li>
                                        <strong>@fridge.FridgeType.Name</strong> (@fridge.FridgeType.Brand) — Serial: @fridge.SerialNumber <br />
                                <small class="text-muted">
                                    Allocated on: @fridge.AllocationDate.ToString()
                                </small>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <span class="text-muted">No fridges allocated</span>
                }
           
                  </td>
                    <td width="800px">

                       @*  <a asp-action="EditUser" asp-route-Id="@item.Id" class="btn btn-primary">View History</a> *@


                        <a asp-controller="ScheduleMaintenance"
                           asp-action="Create"
                           asp-route-customerId="@item.Id"
                           class="btn btn-primary">Create Schedule</a>


                    </td>

                </tr>




            }
        </tbody>
    </table>

</body>
</html>