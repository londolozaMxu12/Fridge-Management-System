@using Microsoft.AspNetCore.Identity
@model IEnumerable<IdentityRole>

@{
    ViewData["Title"] = "Role";
}
<!DOCTYPE html>
<html>
<head>
    <title>ViewData["Title"]</title>
    <style>
        body {
            color: black;
            background-color:deepskyblue;
        }

        .table {
            color: black;
            background-color:coral;
        }

        a {
            font-size: 25px;
        }

        .role_h1 {
            align-items: center;
            align-content: center;
        }

    </style>
</head>
<body>
    <a onclick="location.href='@Url.Action("Index","Admin")'" style="float: left  , background-color:lime " class="btn btn-primary">BACK</a>
    <div>
        <h3 style="font-size: 3rem; font-weight: bold; color:white; text-align:center; margin-top: 2rem; text-shadow: 2px
                    2px 4px rgba(0,0,0,0.2); ">
            APPLICATION ROLES
        </h3>
    </div>

    <p>
        <a asp-action="Create" class="btn btn-primary border" style="background-color:grey">Create New Role</a>
    </p>


    <table class="table table-bordered">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Id)</th>
                <th>@Html.DisplayNameFor(model => model.Name)</th>
                @* <th>@Html.DisplayNameFor(model => model.NormalizedName)</th> *@
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelitem => item.Id)</td>
                    <td>@Html.DisplayFor(modelitem => item.Name)</td>
                    @* <td>@Html.DisplayFor(modelitem => item.NormalizedName)</td> *@
                </tr>
            }
        </tbody>
    </table>
</body>


</html>
