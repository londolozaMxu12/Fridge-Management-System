@model FridgeManagementSystem.ViewModels.EmployeeEditViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Edit Employee";
}

<div class="row">
    <h2 class="text-center mb-3">Edit Employee</h2>

    <div class="col-lg-8 mx-auto rounded border p-4">
        <h2 class="text-center mb-3">Account Details:</h2>
        <hr />

        <form asp-action="EditEmployee" method="post">
            <input type="hidden" asp-for="IsActive" />
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="EmployeeNo" />
            @* <input type="hidden" asp-for="SelectedRole" /> *@

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Id</label>
                <div class="col-sm-8">
                    <input class="form-control-plaintext" readonly value="@ViewData["EmployeeId"]">
                </div>
            </div>
            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Full Name</label>
                <div class="col-sm-8">
                    <input class="form-control" asp-for="FullName">
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Email</label>
                <div class="col-sm-8">
                    <input class="form-control" asp-for="Email">
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
            </div>

            <h2 class="text-center mb-3">Contact Details:</h2>
            <hr />

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Contact No</label>
                <div class="col-sm-8">

                    <input type="tel" class="form-control" asp-for="ContactNo">
                    <span asp-validation-for="ContactNo" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <label asp-for="EmployeeRole" class="col-sm-4 col-form-label">Role</label>
                <div class="col-sm-8">
                    
                    <select asp-for="EmployeeRole" class="form-control" asp-items="ViewBag.Roles">
                        <option value="">-- Select Role --</option>
                    </select>
                    <span asp-validation-for="EmployeeRole" class="text-danger"></span>
                    <small class="form-text text-muted">Current role: @ViewBag.CurrentRole</small>
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Address</label>
                <div class="col-sm-8">
                    <input class="form-control" asp-for="Address">
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">City</label>
                <div class="col-sm-8">
                    <input class="form-control" asp-for="City">
                    <span asp-validation-for="City" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Suburb</label>
                <div class="col-sm-8">
                    <input class="form-control" asp-for="Suburb">
                    <span asp-validation-for="Suburb" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Postal Code</label>
                <div class="col-sm-8">
                    <input class="form-control" asp-for="PostalCode">
                    <span asp-validation-for="PostalCode" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Created At</label>
                <div class="col-sm-8">
                    <input class="form-control-plaintext" readonly value="@ViewData["CreatedAt"]">
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Status</label>
                <div class="col-sm-8">
                    <span class="badge @(Model.IsActive ? "bg-success" : "bg-danger") form-control-plaintext">
                        @(Model.IsActive ? "Active" : "Inactive")
                    </span>
                    <small class="form-text text-muted">Status cannot be changed here. Use Deactivate/Reactivate actions.</small>
                </div>
            </div>

            <h2 class="text-center mb-3">Employment Details:</h2>
            <hr />

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Employee No</label>
                <div class="col-sm-8">
                    <input class="form-control-plaintext" readonly value="@ViewData["EmployeeNo"]">
                </div>
            </div>
           
            <div class="row mb-3">
                <label asp-for="EmployeeTypeId" class="col-sm-4 col-form-label">Employee Type</label>
                <div class="col-sm-8">
                    
                    <select asp-for="EmployeeTypeId" class="form-control" asp-items="ViewBag.EmployeeTypes">
                        <option value="">-- Select Employee Type --</option>
                    </select>
                    <span asp-validation-for="EmployeeTypeId" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Job Title</label>
                <div class="col-sm-8">
                    <input class="form-control" asp-for="JobTitle">
                    <span asp-validation-for="JobTitle" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <label asp-for="DateEmployed" class="col-sm-4 col-form-label">Date Employed</label>
                <div class="col-sm-8">
                    
                    <input asp-for="DateEmployed" class="form-control" type="date" />
                    <span asp-validation-for="DateEmployed" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="offset-sm-4 col-sm-4 d-grid">
                    <button type="submit" class="btn btn-primary">Save Changes</button>

                </div>
                <div class="col-sm-4 d-grid">
                    <a class="btn btn-outline-secondary" asp-controller="Admin" asp-action="EmployeeManagement" role="button">
                        <i class="fas fa-arrow-left me-2"></i>Back to List
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}


