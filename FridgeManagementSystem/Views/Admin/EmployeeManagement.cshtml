@using FridgeManagementSystem.Areas.Identity.Data

@model IEnumerable<ApplicationUser>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Employee Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-users"></i> @ViewData["Title"]</h1>
    <a asp-area="Identity" asp-page="/Account/RegisterEmployee" class="btn btn-primary">
        <i class="fas fa-user-plus"></i> Register New Employee
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0"><i class="fas fa-user-check"></i>List Of Active Employees</h5>
    </div>
    <div class="card-body">
        
        @if (!Model.Any(u => u.IsActive && u.Employees != null))
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle"></i> No active employees found.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-primary">
                        <tr>
                            <th>Employee No</th>
                            <th>Name</th>
                            <th>Email</th>
                            @* <th>Job Title</th> *@
                            <th>Contact Number</th>
                            <th>Employee Type</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var employee in Model.Where(u => u.IsActive && u.Employees != null))
                        {
                            <tr>
                                <td>@employee.Employees.EmployeeNo</td>
                                <td>@employee.FullName</td>
                                <td>@employee.Email</td>
                                @* <td>@employee.Employees.JobTitle</td> *@
                                <td>@employee.ContactNo</td>
                                <td>@employee.Employees.EmployeeType.Name</td>
                                <td>
                                    <span class="badge bg-success">@employee.ApprovalStatus</span>
                                </td>
                                <td>
                                    <a asp-action="EmployeeDetails" asp-route-id="@employee.Id" class="btn btn-info btn-sm">
                                        <i class="fas fa-eye"></i> View Details
                                    </a>
                                    <a asp-action="EditEmployee" asp-route-id="@employee.Id" class="btn btn-warning btn-sm">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>
                                    <a asp-action="DeactivateEmployee" asp-route-id="@employee.Id" class="btn btn-danger btn-sm">
                                        <i class="fas fa-user-slash"></i> Deactivate
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@{
    var inactiveEmployees = Model.Where(u => !u.IsActive && u.Employees != null).ToList();
    if (inactiveEmployees.Any())
    {
        <div class="card mt-4">
            <div class="card-header bg-secondary text-white">
                <h5 class="mb-0"><i class="fas fa-user-times"></i> Inactive Employees</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-secondary">
                            <tr>
                                <th>Employee No</th>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Job Title</th>
                                <th>Employee Type</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var employee in inactiveEmployees)
                            {
                                <tr>
                                    <td>@employee.Employees.EmployeeNo</td>
                                    <td>@employee.FullName</td>
                                    <td>@employee.Email</td>
                                    <td>@employee.Employees.JobTitle</td>
                                    <td>@employee.Employees.EmployeeType.Name</td>
                                    <td>
                                        <a asp-action="ActivateEmployee" asp-route-id="@employee.Id" class="btn btn-success btn-sm">
                                            <i class="fas fa-user-check"></i> Activate
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}