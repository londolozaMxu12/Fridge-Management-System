@using FridgeManagementSystem.ViewModels
@model EmployeeManagementViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Employee Management";

    <!-- For Pagination -->
    var totalPages = (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize);
    var prevDisabled = Model.PageNumber <= 1 ? "disabled" : "";
    var nextDisabled = Model.PageNumber >= totalPages ? "disabled" : "";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-users"></i> @ViewData["Title"]</h1>
    <a asp-area="Identity" asp-page="/Account/RegisterEmployee" class="btn btn-primary">
        <i class="fas fa-user-plus"></i> Register New Employee
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Filter Section -->
<div class="card mb-4">
    <div class="card-header bg-light">
        <h5 class="mb-0"><i class="fas fa-filter"></i> Filters & Search</h5>
    </div>
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-4">
                <label for="SearchString" class="form-label">Search</label>
                <input type="text" class="form-control" id="SearchString" name="searchString" 
                       value="@Model.SearchString" placeholder="Search by name, email, employee no...">
            </div>
            <div class="col-md-3">
                <label for="EmployeeTypeFilter" class="form-label">Employee Type</label>
                <select class="form-select" id="EmployeeTypeFilter" name="employeeTypeFilter">
                    <option value="">All Types</option>
                    @foreach (var type in ViewBag.EmployeeTypes)
                    {
                        <option value="@type" selected="@(Model.EmployeeTypeFilter == type)">@type</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label for="StatusFilter" class="form-label">Status</label>
                <select class="form-select" id="StatusFilter" name="statusFilter">
                    <option value="active" selected="@(Model.StatusFilter == "active")">Active</option>
                    <option value="inactive" selected="@(Model.StatusFilter == "inactive")">Inactive</option>
                    <option value="all" selected="@(Model.StatusFilter == "all")">All</option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-search"></i> Apply
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="fas fa-user-check"></i> Employees</h5>
        <span class="badge bg-light text-dark">Total: @Model.TotalCount</span>
    </div>
    <div class="card-body">
        
        @if (!Model.Employees.Any())
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle"></i> No employees found matching your criteria.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-primary">
                        <tr>
                            <th>
                                <a asp-action="EmployeeManagement" 
                                   asp-route-sortBy="EmployeeNo" 
                                   asp-route-sortOrder="@(Model.SortBy == "EmployeeNo" && Model.SortOrder == "asc" ? "desc" : "asc")"
                                   asp-route-searchString="@Model.SearchString"
                                   asp-route-employeeTypeFilter="@Model.EmployeeTypeFilter"
                                   asp-route-statusFilter="@Model.StatusFilter"
                                   class="text-decoration-none text-dark">
                                    Employee No
                                    @if (Model.SortBy == "EmployeeNo")
                                    {
                                        <i class="fas fa-sort-@(Model.SortOrder == "asc" ? "up" : "down")"></i>
                                    }
                                    else
                                    {
                                        <i class="fas fa-sort"></i>
                                    }
                                </a>
                            </th>
                            <th>
                                <a asp-action="EmployeeManagement" 
                                   asp-route-sortBy="Name" 
                                   asp-route-sortOrder="@(Model.SortBy == "Name" && Model.SortOrder == "asc" ? "desc" : "asc")"
                                   asp-route-searchString="@Model.SearchString"
                                   asp-route-employeeTypeFilter="@Model.EmployeeTypeFilter"
                                   asp-route-statusFilter="@Model.StatusFilter"
                                   class="text-decoration-none text-dark">
                                    Name
                                    @if (Model.SortBy == "Name")
                                    {
                                        <i class="fas fa-sort-@(Model.SortOrder == "asc" ? "up" : "down")"></i>
                                    }
                                    else
                                    {
                                        <i class="fas fa-sort"></i>
                                    }
                                </a>
                            </th>
                            <th>Contact Number</th>
                            <th>
                                <a asp-action="EmployeeManagement" 
                                   asp-route-sortBy="EmployeeType" 
                                   asp-route-sortOrder="@(Model.SortBy == "EmployeeType" && Model.SortOrder == "asc" ? "desc" : "asc")"
                                   asp-route-searchString="@Model.SearchString"
                                   asp-route-employeeTypeFilter="@Model.EmployeeTypeFilter"
                                   asp-route-statusFilter="@Model.StatusFilter"
                                   class="text-decoration-none text-dark">
                                    Employee Type
                                    @if (Model.SortBy == "EmployeeType")
                                    {
                                        <i class="fas fa-sort-@(Model.SortOrder == "asc" ? "up" : "down")"></i>
                                    }
                                    else
                                    {
                                        <i class="fas fa-sort"></i>
                                    }
                                </a>
                            </th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var employee in Model.Employees)
                        {
                            <tr>
                                <td>@employee.Employees.EmployeeNo</td>
                                <td>@employee.FullName</td>
                                <td>@employee.ContactNo</td>
                                <td>@employee.Employees.EmployeeType.Name</td>
                                <td>
                                    @if (employee.IsActive)
                                    {
                                        <span class="badge bg-success">@employee.ApprovalStatus</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="EmployeeDetails" asp-route-id="@employee.Id" class="btn btn-info btn-sm">
                                        <i class="fas fa-eye"></i> View
                                    </a>
                                    <a asp-action="EditEmployee" asp-route-id="@employee.Id" class="btn btn-warning btn-sm">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>
                                    @if (employee.IsActive)
                                    {
                                        <a asp-action="DeactivateEmployee" asp-route-id="@employee.Id" class="btn btn-danger btn-sm">
                                            <i class="fas fa-user-slash"></i> Deactivate
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-action="ActivateEmployee" asp-route-id="@employee.Id" class="btn btn-success btn-sm">
                                            <i class="fas fa-user-check"></i> Activate
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
          
            @if (totalPages > 1)
            {
                <nav aria-label="Employee pagination">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @prevDisabled">
                            <a class="page-link" 
                               asp-action="EmployeeManagement"
                               asp-route-pageNumber="@(Model.PageNumber - 1)"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-sortBy="@Model.SortBy"
                               asp-route-sortOrder="@Model.SortOrder"
                               asp-route-searchString="@Model.SearchString"
                               asp-route-employeeTypeFilter="@Model.EmployeeTypeFilter"
                               asp-route-statusFilter="@Model.StatusFilter">
                                Previous
                            </a>
                        </li>

                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                <a class="page-link" 
                                   asp-action="EmployeeManagement"
                                   asp-route-pageNumber="@i"
                                   asp-route-pageSize="@Model.PageSize"
                                   asp-route-sortBy="@Model.SortBy"
                                   asp-route-sortOrder="@Model.SortOrder"
                                   asp-route-searchString="@Model.SearchString"
                                   asp-route-employeeTypeFilter="@Model.EmployeeTypeFilter"
                                   asp-route-statusFilter="@Model.StatusFilter">
                                    @i
                                </a>
                            </li>
                        }

                        <li class="page-item @nextDisabled">
                            <a class="page-link" 
                               asp-action="EmployeeManagement"
                               asp-route-pageNumber="@(Model.PageNumber + 1)"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-sortBy="@Model.SortBy"
                               asp-route-sortOrder="@Model.SortOrder"
                               asp-route-searchString="@Model.SearchString"
                               asp-route-employeeTypeFilter="@Model.EmployeeTypeFilter"
                               asp-route-statusFilter="@Model.StatusFilter">
                                Next
                            </a>
                        </li>
                    </ul>
                </nav>
            }

            <div class="row align-items-center mt-3">
                <div class="col-md-6">
                    <span class="text-muted">
                        Showing @((Model.PageNumber - 1) * Model.PageSize + 1) to 
                        @Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount) of @Model.TotalCount entries
                    </span>
                </div>
                <div class="col-md-6 text-end">
                    <div class="btn-group">
                        <span class="me-2">Page size:</span>
                        @foreach (var size in new[] { 5, 10, 20, 50 })
                        {
                            <a class="btn btn-outline-secondary btn-sm @(Model.PageSize == size ? "active" : "")"
                               asp-action="EmployeeManagement"
                               asp-route-pageNumber="1"
                               asp-route-pageSize="@size"
                               asp-route-sortBy="@Model.SortBy"
                               asp-route-sortOrder="@Model.SortOrder"
                               asp-route-searchString="@Model.SearchString"
                               asp-route-employeeTypeFilter="@Model.EmployeeTypeFilter"
                               asp-route-statusFilter="@Model.StatusFilter">
                                @size
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>