@using FridgeManagementSystem.Areas.Identity.Data

@model ApplicationUser
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Employee Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
<h3><i class="fas fa-user-tie"></i> @ViewData["Title"]</h3>
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <a asp-action="EditEmployee" asp-route-id="@Model.Id" class="btn btn-warning">
                <i class="fas fa-edit"></i> Edit
            </a>
            <a asp-action="EmployeeManagement" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to List
            </a>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="fas fa-id-card"></i> Personal Information</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Employee ID:</dt>
                    <dd class="col-sm-8"><strong>@Model.Employees.Id</strong></dd>

                    <dt class="col-sm-4">Full Name:</dt>
                    <dd class="col-sm-8">@Model.FullName</dd>

                    <dt class="col-sm-4">Email:</dt>
                    <dd class="col-sm-8">@Model.Email</dd>

                    <dt class="col-sm-4">Contact Number:</dt>
                    <dd class="col-sm-8">@Model.ContactNo</dd>
                    
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="fas fa-briefcase"></i> Employment Information</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Employee No:</dt>
                    <dd class="col-sm-8"><strong>@Model.Employees.EmployeeNo</strong></dd>

                    <dt class="col-sm-4">Job Title:</dt>
                    <dd class="col-sm-8">@Model.Employees.JobTitle</dd>

                    <dt class="col-sm-4">Employee Type:</dt>
                    <dd class="col-sm-8">@Model.Employees.EmployeeType?.Name</dd>

                </dl>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0"><i class="fas fa-address-book"></i> Address Information</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Address:</dt>
                    <dd class="col-sm-8">@Model.Address</dd>

                    <dt class="col-sm-4">Suburb:</dt>
                    <dd class="col-sm-8">@Model.Suburb</dd>

                    <dt class="col-sm-4">City:</dt>
                    <dd class="col-sm-8">@Model.City</dd>

                    <dt class="col-sm-4">Postal Code:</dt>
                    <dd class="col-sm-8">@Model.PostalCode</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header bg-warning text-white">
                <h5 class="mb-0"><i class="fas fa-cogs"></i> System Information</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Account Status:</dt>
                    <dd class="col-sm-8">
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactive</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Approval Status:</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-@(Model.ApprovalStatus == "Approved" ? "success" : "warning")">
                            @Model.ApprovalStatus
                        </span>
                    </dd>

                    <dt class="col-sm-4">User Roles:</dt>
                    <dd class="col-sm-8">
                        @if (ViewBag.UserRoles != null)
                        {
                            foreach (var role in ViewBag.UserRoles)
                            {
                                <span class="badge bg-primary me-1">@role</span>
                            }
                        }
                    </dd>

                    <dt class="col-sm-4">Approved By:</dt>
                    <dd class="col-sm-8">@(Model.ApprovedBy?.FullName ?? "System")</dd>

                    <dt class="col-sm-4">Approved On:</dt>
                    <dd class="col-sm-8">@(Model.ApprovedAt?.ToString("yyyy-MM-dd HH:mm") ?? "N/A")</dd>

                    <dt class="col-sm-4">Registered On:</dt>
                    <dd class="col-sm-8">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>





