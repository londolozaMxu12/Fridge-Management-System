@using FridgeManagementSystem.Areas.Identity.Data

@model IEnumerable<ApplicationUser>
@{
    // Use ViewBag set in controller to determine layout
    if (ViewBag.IsCustomerLiaison)
    {
        Layout = "_CustomerLiaisonLayout";
        ViewData["Title"] = "Pending Customer Approvals - Liaison View";
    }
    else
    {
        Layout = "_AdminLayout";
        ViewData["Title"] = "Pending Customer Approvals - Admin View";
    }
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-user-clock"></i> @ViewData["Title"]</h1>
    @if (ViewBag.IsCustomerLiaison)
    {
        <span class="badge bg-info">Customer Liaison</span>
    }
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-success">
        <h4><i class="fas fa-check-circle"></i> No Pending Approvals</h4>
        <p>There are no customers waiting for approval.</p>
    </div>
}
else
{
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-primary">
                        <tr>
                            <th>Business Name</th>
                            <th>Email</th>
                            <th>Contact Number</th>
                            <th>City</th>
                            <th>Registered On</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>@user.Customers.BusinessName</td>
                                <td>@user.Email</td>
                                <td>@user.ContactNo</td>
                                <td>@user.City</td>
                                <td>@user.CreatedAt.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <a asp-action="ApproveCustomer" asp-route-id="@user.Id" class="btn btn-success btn-sm">
                                        <i class="fas fa-check"></i> Approve
                                    </a>
                                    <button class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#rejectModal-@user.Id">
                                        <i class="fas fa-times"></i> Reject
                                    </button>

                                    <!-- Reject Modal -->
                                    <div class="modal fade" id="rejectModal-@user.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title">Reject Customer Registration</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">&times;</button>
                                                </div>
                                                <form asp-action="RejectCustomer" method="post">
                                                    <div class="modal-body">
                                                        <input type="hidden" name="id" value="@user.Id" />
                                                        <div class="form-group mb-3">
                                                            <label for="reason-@user.Id" class="form-label">Reason for rejection:</label>
                                                            <textarea id="reason-@user.Id" name="reason" class="form-control" rows="3" required placeholder="Please provide a reason for rejecting this registration"></textarea>
                                                        </div>
                                                        <div class="alert alert-warning">
                                                            <i class="fas fa-exclamation-triangle"></i> This action cannot be undone. The customer will be notified of the rejection.
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-danger">Reject Registration</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}