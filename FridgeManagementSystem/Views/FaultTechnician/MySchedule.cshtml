@using Microsoft.AspNetCore.Html
@model IEnumerable<FridgeManagementSystem.Models.RepairSchedule>

<style>
    .form-select {
        min-width: 150px;
    }

    .input-group {
        min-width: 300px;
    }

    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .row-cols-auto > .col-auto {
            margin-bottom: 10px;
        }

        .input-group {
            min-width: 100%;
        }
    }
</style>

@{
    ViewData["Title"] = "My Repair Schedule";
    Layout = "_FaultTechnicianLayout";

    string search = ViewBag.Search ?? "";
    string column = ViewBag.Column ?? "ScheduledDate";
    string orderBy = ViewBag.OrderBy ?? "asc";

    HtmlString getArrow(string tableColumn)
    {
        if (tableColumn != column) return new HtmlString("");

        if (orderBy == "desc")
        {
            return new HtmlString("<i class='bi bi-arrow-down'></i>");
        }

        return new HtmlString("<i class='bi bi-arrow-up'></i>");
    }
}

<div class="d-flex justify-content-between align-items-center text-white mb-4">
    <h1>
        <i class="fas fa-calendar"></i> My Repair Schedule
    </h1>
    <div>
        
        <a asp-action="Index" class="btn btn-outline-primary text-white">
            <i class="fas fa-tools"></i> Back to Faults
        </a>
    </div>
</div>


<div class="card mb-4">
    <div class="card-body">
        <form class="row row-cols-auto g-3 align-items-center" method="get">

            <!-- Status Filter -->
            <div class="col-auto">
                <select class="form-select" name="status" onchange="this.form.submit()">
                    <option value="all" selected="@(ViewBag.CurrentStatus == "all")">All Statuses</option>
                    <option value="Scheduled" selected="@(ViewBag.CurrentStatus == "Scheduled")">Scheduled</option>
                    <option value="InProgress" selected="@(ViewBag.CurrentStatus == "InProgress")">In Progress</option>
                    <option value="Completed" selected="@(ViewBag.CurrentStatus == "Completed")">Completed</option>
                    <option value="Cancelled" selected="@(ViewBag.CurrentStatus == "Cancelled")">Cancelled</option>
                    <option value="Rescheduled" selected="@(ViewBag.CurrentStatus == "Rescheduled")">Rescheduled</option>
                </select>
            </div>

            <div class="col-lg-6 col-md-8 ms-auto">
                <div class="input-group">
                    <input class="form-control" name="search" value="@ViewBag.Search" placeholder="Search by Fault Title or Customer Name">
                    <button class="btn btn-outline-primary" type="submit">
                        <i class="fas fa-search"></i> Search
                    </button>

                    @if (!string.IsNullOrEmpty(ViewBag.Search) || (ViewBag.CurrentStatus != "all" && ViewBag.CurrentStatus != null) || !string.IsNullOrEmpty(ViewBag.Column) || !string.IsNullOrEmpty(ViewBag.OrderBy))
                    {
                        <a asp-action="MySchedule" class="btn btn-outline-secondary">
                            <i class="fas fa-times"></i> Clear
                        </a>
                    }
                </div>
            </div>
        </form>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="text-center text-light py-4">
        <i class="fas fa-times-circle fa-3x text-capitalize mb-3"></i>
        <h5>No schedules found</h5>
        <p class="text-white">You don't have any repair schedules for today or future dates.</p>
        <p class="text-light">
            @if (!string.IsNullOrEmpty(ViewBag.Search) || (ViewBag.CurrentStatus != "all" && ViewBag.CurrentStatus != null))
            {
                <span>No schedules match your current filters.</span>
            }
          
        </p>
        @if (!string.IsNullOrEmpty(ViewBag.Search) || (ViewBag.CurrentStatus != "all" && ViewBag.CurrentStatus != null))
        {
            <a asp-action="MySchedule" class="btn btn-primary mt-2">
                <i class="fas fa-undo"></i> Show All Schedules
            </a>
        }
    </div>
}

else
{
    <div class="card">
        <div class="card-header">
            <h5 class="card-title mb-0">
                <i class="fas fa-list me-2"></i>Upcoming Repair Schedules
            </h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-primary">
                        <tr>                            
                            <th style="cursor: pointer;" onclick="sortTable('RepairScheduleId')"># @getArrow("RepairScheduleId")</th>
                            
                            <th style="cursor: pointer;" onclick="sortTable('ScheduledDate')">Scheduled Date @getArrow("ScheduledDate")</th>
                            <th>Fault Title</th>
                            <th>Customer</th>
                            <th>Fridge</th>
                            <th>Estimated Hours</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var schedule in Model)
                        {
                            <tr>
                                <td>
                                    @schedule.RepairScheduleId
                                </td>
                                <td>
                                    <strong>@schedule.ScheduledDate.ToString("dd/MM/yyyy")</strong>
                                    <br />
                                    <small class="text-muted">@schedule.ScheduledDate.ToString("HH:mm")</small>
                                </td>
                                <td>
                                    <strong>@schedule.Fault?.Title</strong>
                                    @if (!string.IsNullOrEmpty(schedule.Notes))
                                    {
                                        <br />
                                        <small class="text-muted">@schedule.Notes</small>
                                    }
                                </td>
                                <td>
                                    @if (schedule.Fault?.ReportedBy?.User != null)
                                    {
                                        <div>
                                            <strong>@schedule.Fault.ReportedBy.User.FullName</strong>
                                            <br />
                                            <small class="text-muted">
                                                <i class="fas fa-envelope"></i> @schedule.Fault.ReportedBy.User.Email
                                            </small>
                                            <br />
                                            <small class="text-muted">
                                                <i class="fas fa-phone"></i> @schedule.Fault.ReportedBy.User.ContactNo
                                            </small>
                                            <br />
                                            <small class="text-muted">
                                                <i class="fas fa-map-marker-alt me-2"></i>@schedule.Fault.ReportedBy.User.Address, 
                                                @schedule.Fault.ReportedBy.User.City, @schedule.Fault.ReportedBy.User.Suburb
                                            </small>
                                            
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">N/A</span>
                                    }
                                </td>
                                <td>
                                    @if (schedule.Fault?.Fridge != null)
                                    {
                                        <div>
                                            <strong>@schedule.Fault.Fridge.FridgeType?.Name</strong>
                                            <br />
                                            <small class="text-muted">Model: @schedule.Fault.Fridge.FridgeType?.Model</small>
                                            <br />
                                            <small class="text-muted">Model: @schedule.Fault.Fridge.FridgeType?.Brand</small>
                                            <br />
                                            <small class="text-muted">SN: @schedule.Fault.Fridge.SerialNumber</small>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">N/A</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-info fs-6">@schedule.EstimatedHours hour(s)</span>
                                </td>
                                <td>
                                    @{
                                        var statusClass = schedule.Status.ToString() switch
                                        {
                                            "Scheduled" => "bg-primary",
                                            "InProgress" => "bg-warning",
                                            "Completed" => "bg-success",
                                            "Cancelled" => "bg-danger",
                                            "Rescheduled" => "bg-info",
                                            _ => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @statusClass">@schedule.Status</span>
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="UpdateSchedule" asp-route-id="@schedule.RepairScheduleId" 
                                           class="btn btn-outline-primary btn-sm" title="Edit Schedule">
                                            <i class="fas fa-edit m-1"></i>
                                        </a>
                                        
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer text-muted">
            <small>Showing @Model.Count() upcoming repair schedules</small>
        </div>
    </div>

}

<!-- Hidden form for status updates -->
<form id="statusUpdateForm" asp-action="UpdateScheduleStatus" method="post">
    <input type="hidden" id="scheduleId" name="id" />
    <input type="hidden" id="scheduleStatus" name="status" />
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script>
            function sortTable(column) {
            let orderBy = "desc";
            let currentColumn = "@ViewBag.Column";
            let currentOrder = "@ViewBag.OrderBy";

            // If clicking the same column, toggle the order
            if (column === currentColumn) {
                orderBy = currentOrder === "asc" ? "desc" : "asc";
            }

            // Build URL with all current parameters
            let url = "MySchedule?";

            // Add search parameter if exists
            let search = "@ViewBag.Search";
            if (search && search !== "") {
                url += "search=" + encodeURIComponent(search) + "&";
            }

            // Add status parameter if exists and not "all"
            let status = "@ViewBag.CurrentStatus";
            if (status && status !== "all") {
                url += "status=" + encodeURIComponent(status) + "&";
            }

            // Add sorting parameters
            url += "column=" + column + "&orderBy=" + orderBy;

            window.location.href = url;
        }

        function updateScheduleStatus(scheduleId, status) {
            if (confirm('Are you sure you want to update the status of this repair schedule?')) {
                document.getElementById('scheduleId').value = scheduleId;
                document.getElementById('scheduleStatus').value = status;
                document.getElementById('statusUpdateForm').submit();
            }
        }

        // Auto-dismiss alerts after 5 seconds
        setTimeout(function() {
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(alert => {
                const bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            });
        }, 5000);

        // Add hover effects to table rows
        document.addEventListener('DOMContentLoaded', function() {
            const tableRows = document.querySelectorAll('tbody tr');
            tableRows.forEach(row => {
                row.addEventListener('mouseenter', function() {
                    this.style.backgroundColor = 'rgba(0, 0, 0, 0.025)';
                });
                row.addEventListener('mouseleave', function() {
                    this.style.backgroundColor = '';
                });
            });
        });
    </script>
}

