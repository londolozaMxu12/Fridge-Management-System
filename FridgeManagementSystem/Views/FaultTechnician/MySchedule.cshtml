@model IEnumerable<FridgeManagementSystem.Models.RepairSchedule>

@{
    ViewData["Title"] = "My Repair Schedule";
    Layout = "_FaultTechnicianLayout";

}

<div class="d-flex justify-content-between align-items-center text-white mb-4">
    <h1>
        <i class="fas fa-calendar"></i> My Repair Schedule
    </h1>
    <div>
        <a asp-action="Index" class="btn btn-outline-primary text-white">
            <i class="fas fa-tools"></i> Back to Faults
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="text-center text-white py-4">
        <i class="fas fa-calendar-times fa-3x text-light mb-3"></i>
        <h5>No scheduled repairs</h5>
        <p class="text-white">You don't have any repair schedules for today or future dates.</p>
    </div>
}
else
{
    <div class="card">
        <div class="card-header">
            <h5 class="card-title mb-0">
                <i class="fas fa-list me-2"></i>Upcoming Repair Schedules
            </h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-primary">
                        <tr>
                            <th>Scheduled Date</th>
                            <th>Fault Title</th>
                            <th>Customer</th>
                            <th>Fridge</th>
                            <th>Estimated Hours</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var schedule in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@schedule.ScheduledDate.ToString("yyyy-MM-dd")</strong>
                                    <br />
                                    <small class="text-muted">@schedule.ScheduledDate.ToString("HH:mm")</small>
                                </td>
                                <td>
                                    <strong>@schedule.Fault?.Title</strong>
                                    @if (!string.IsNullOrEmpty(schedule.Notes))
                                    {
                                        <br />
                                        <small class="text-muted">@schedule.Notes</small>
                                    }
                                </td>
                                <td>
                                    @if (schedule.Fault?.ReportedBy?.User != null)
                                    {
                                        <div>
                                            <strong>@schedule.Fault.ReportedBy.User.FullName</strong>
                                            <br />
                                            <small class="text-muted">
                                                <i class="fas fa-envelope"></i> @schedule.Fault.ReportedBy.User.Email
                                            </small>
                                            <br />
                                            <small class="text-muted">
                                                <i class="fas fa-phone"></i> @schedule.Fault.ReportedBy.User.ContactNo
                                            </small>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">N/A</span>
                                    }
                                </td>
                                <td>
                                    @if (schedule.Fault?.Fridge != null)
                                    {
                                        <div>
                                            <strong>@schedule.Fault.Fridge.FridgeType?.Name</strong>
                                            <br />
                                            <small class="text-muted">Model: @schedule.Fault.Fridge.FridgeType?.Model</small>
                                            <br />
                                            <small class="text-muted">Model: @schedule.Fault.Fridge.FridgeType?.Brand</small>
                                            <br />
                                            <small class="text-muted">Serial: @schedule.Fault.Fridge.SerialNumber</small>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">N/A</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-info fs-6">@schedule.EstimatedHours hour(s)</span>
                                </td>
                                <td>
                                    @{
                                        var statusClass = schedule.Status.ToString() switch
                                        {
                                            "Scheduled" => "bg-primary",
                                            "InProgress" => "bg-warning",
                                            "Completed" => "bg-success",
                                            "Cancelled" => "bg-danger",
                                            "Rescheduled" => "bg-info",
                                            _ => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @statusClass">@schedule.Status</span>
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="UpdateSchedule" asp-route-id="@schedule.RepairScheduleId" 
                                           class="btn btn-outline-primary btn-sm" title="Edit Schedule">
                                            <i class="fas fa-edit m-1"></i>
                                        </a>
                                        
                                        <div class="btn-group" role="group">
                                            <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle" 
                                                    data-bs-toggle="dropdown" aria-expanded="false">
                                                <i class="fas fa-cog m-1"></i>
                                            </button>
                                            <ul class="dropdown-menu">
                                                <li>
                                                    <a class="dropdown-item text-warning" href="#" 
                                                       onclick="updateScheduleStatus(@schedule.RepairScheduleId, 'InProgress')">
                                                        <i class="fas fa-play me-2"></i>Mark In Progress
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item text-success" href="#" 
                                                       onclick="updateScheduleStatus(@schedule.RepairScheduleId, 'Completed')">
                                                        <i class="fas fa-check me-2"></i>Mark Completed
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item text-info" href="#" 
                                                       onclick="updateScheduleStatus(@schedule.RepairScheduleId, 'Rescheduled')">
                                                        <i class="fas fa-calendar-alt me-2"></i>Mark Rescheduled
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item text-danger" href="#" 
                                                       onclick="updateScheduleStatus(@schedule.RepairScheduleId, 'Cancelled')">
                                                        <i class="fas fa-times me-2"></i>Mark Cancelled
                                                    </a>
                                                </li>
                                                <li><hr class="dropdown-divider"></li>
                                                <li>
                                                    <a class="dropdown-item" 
                                                       asp-controller="FaultTechnician" 
                                                       asp-action="Details" 
                                                       asp-route-id="@schedule.FaultId">
                                                        <i class="fas fa-info-circle me-2"></i>View Fault Details
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer text-muted">
            <small>Showing @Model.Count() upcoming repair schedules</small>
        </div>
    </div>
