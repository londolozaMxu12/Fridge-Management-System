@model FridgeManagementSystem.ViewModels.FaultSearchViewModel

@{
    ViewData["Title"] = "Reported Faults";
    Layout = "_FaultTechnicianLayout";

    <!-- For Pagination -->
    var totalPages = (int)Math.Ceiling((double) @ViewBag.TotalFaultsCount / Model.PageSize);
    var prevDisabled = Model.PageNumber <= 1 ? "disabled" : "";
    var nextDisabled = Model.PageNumber >= totalPages ? "disabled" : "";
}

<div class="d-flex justify-content-between align-items-center text-light mb-4">
    <h2>
        <i class="bi bi-exclamation-triangle text-warning me-2"></i>List Of Reported Faults
    </h2>
    <div class="text-light">
        <a asp-action="MySchedule" class="btn btn-outline-primary text-light">
            <i class="fas fa-calendar m-1"></i> My Schedule
        </a>
        @*<span class="badge bg-light text-dark">Total: @ViewBag.TotalFaultsCount</span>*@
    </div>

</div>

<!-- Status and Sort Filters - Inline -->
<div class="d-flex flex-wrap gap-2 align-items-center mb-4 p-3 bg-light rounded">
    <!-- Status Filter -->
    <div class="btn-group" role="group">
        <a asp-action="Index"
           asp-route-status="all"
           asp-route-search="@Model.Search"
           asp-route-priority="@Model.Priority"
           asp-route-sort="@Model.Sort"
           asp-route-pageNumber="1"
           asp-route-pageSize="@Model.PageSize"
           class="btn @(ViewBag.CurrentStatus == "all" ? "btn-primary" : "btn-outline-primary")">
            All Faults (@ViewBag.TotalFaultsCount)
        </a>
        <a asp-action="Index"
           asp-route-status="Reported"
           asp-route-search="@Model.Search"
           asp-route-priority="@Model.Priority"
           asp-route-sort="@Model.Sort"
           asp-route-pageNumber="1"
           asp-route-pageSize="@Model.PageSize"
           class="btn @(ViewBag.CurrentStatus == "Reported" ? "btn-warning" : "btn-outline-warning")">
            Reported (@ViewBag.PendingFaultsCount)
        </a>
        <a asp-action="Index"
           asp-route-status="InProgress"
           asp-route-search="@Model.Search"
           asp-route-priority="@Model.Priority"
           asp-route-sort="@Model.Sort"
           asp-route-pageNumber="1"
           asp-route-pageSize="@Model.PageSize"
           class="btn @(ViewBag.CurrentStatus == "InProgress" ? "btn-info" : "btn-outline-info")">
            In Progress (@ViewBag.InProgressFaultsCount)
        </a>
        <a asp-action="Index"
           asp-route-status="Completed"
           asp-route-search="@Model.Search"
           asp-route-priority="@Model.Priority"
           asp-route-sort="@Model.Sort"
           asp-route-pageNumber="1"
           asp-route-pageSize="@Model.PageSize"
           class="btn @(ViewBag.CurrentStatus == "Completed" ? "btn-success" : "btn-outline-success")">
            Completed (@ViewBag.CompletedFaultsCount)
        </a>
    </div>

</div>

<div class="card mb-4">
    <div class="card-body">
        <form class="row row-cols-auto g-3 align-items-center" method="get">

            <input type="hidden" name="pageNumber" value="1" />
            <input type="hidden" name="pageSize" value="@Model.PageSize" />

            <!-- Priority Filter -->
            <div class="col-auto">
                <select class="form-select" name="priority" asp-for="Priority" onchange="this.form.submit()">
                    <option value="">All Priorities</option>
                    <option value="Critical">Critical</option>
                    <option value="High">High</option>
                    <option value="Medium">Medium</option>
                    <option value="Low">Low</option>
                </select>
            </div>

            <!-- Sort Options -->
            <div class="col-auto">
                <select class="form-select" name="sort" asp-for="Sort" onchange="this.form.submit()">
                    <option value="">Order By Highest/Newest</option>
                    <option value="priority_desc">Priority: High to Low</option>
                    <option value="priority_asc">Priority: Low to High</option>
                    <option value="date_desc">Date: Newest First</option>
                    <option value="date_asc">Date: Oldest First</option>
                </select>
            </div>

            <div class="col-lg-4 col-md-6 ms-auto">
                <div class="input-group">
                    <input class="form-control" name="search" asp-for="Search" placeholder="Search by Title or Description">
                    <button class="btn btn-outline-primary" type="submit">
                        <i class="fas fa-search"></i> Search
                    </button>
                    @if (!string.IsNullOrEmpty(Model.Search) || !string.IsNullOrEmpty(Model.Priority) || !string.IsNullOrEmpty(Model.Sort))
                    {
                        <a asp-action="Index" asp-route-status="@Model.Status" class="btn btn-outline-secondary">
                            <i class="fas fa-times"></i> Clear
                        </a>
                    }
                </div>
            </div>
        </form>
    </div>

</div>

@if (TempData["Info"] != null)
{
    <div class="alert alert-primary alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle"></i> @TempData["Info"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.Faults.Any())
{
    <div class="text-center text-light py-4">
        <i class="fas fa-times-circle fa-3x text-capitalize mb-3"></i>
        <h5>No faults found</h5>
        <p class="text-light">
            @if (!string.IsNullOrEmpty(Model.Search) || !string.IsNullOrEmpty(Model.Priority))
            {
                <span>No faults match your current filters.</span>
            }
            else
            {
                <span>All faults are currently processed or no faults match your filter.</span>
            }
        </p>
        @if (!string.IsNullOrEmpty(Model.Search) || !string.IsNullOrEmpty(Model.Priority))
        {
            <a asp-action="Index" asp-route-status="@Model.Status" class="btn btn-primary mt-2">
                <i class="fas fa-undo"></i> Show All Faults
            </a>
        }
    </div>
}
else
{
    <div class="row">

        @foreach (var fault in Model.Faults)
        {
            <div class="col-md-6 mb-4">
                <div class="card h-100 @(fault.FaultTechnicianId == null ? "border-warning" : fault.FaultTechnicianId == ViewBag.CurrentTechnicianId ? "border-primary" : "border-secondary")">
                    <div class="card-header @GetFaultHeaderClass(fault) text-light">
                        <h5 class="card-title mb-0">
                            @fault.Title
                            @if (fault.FaultTechnicianId == null)
                            {
                                <span class="badge bg-primary float-end">Un Attended</span>
                            }
                            else if (fault.FaultTechnicianId == ViewBag.CurrentTechnicianId)
                            {
                                <span class="badge bg-success float-end">Attended by you</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary float-end">Attended by @fault.FaultTechnician?.User?.FullName</span>
                            }
                        </h5>
                    </div>
                    <div class="card-body">
                        <p class="card-text">@fault.Description</p>

                        <div class="mb-2">
                            <strong>Priority:</strong>
                            <span class="badge @GetPriorityBadgeClass(fault.Priority)">@fault.Priority</span>
                        </div>

                        <div class="mb-2">
                            <strong>Status:</strong>
                            <span class="badge @GetStatusBadgeClass(fault.Status)">@fault.Status</span>
                        </div>

                        @if (fault.Fridge != null)
                        {
                            <div class="mb-2">
                                <strong>Fridge:</strong>
                                @fault.Fridge.FridgeType.Name, @fault.Fridge.FridgeType.Model, @fault.Fridge.FridgeType.Brand -SN: @fault.Fridge.SerialNumber
                            </div>
                        }

                        <div class="mb-2">
                            <strong>Reported By:</strong>
                            @fault.ReportedBy.User.FullName (@fault.ReportedBy.BusinessName)
                        </div>

                        <div class="mb-2">
                            <strong>Reported Date:</strong>
                            @fault.ReportedDate.ToString("yyyy-MM-dd HH:mm")
                        </div>

                        @if (fault.FaultTechnicianId != null)
                        {
                            <div class="mb-2">
                                <strong>Assigned Technician:</strong>
                                @fault.FaultTechnician?.User?.FullName
                            </div>
                        }
                    </div>
                    <div class="card-footer">
                        <div class="btn-group btn-group-sm w-100">
                            <a asp-action="Details" asp-route-id="@fault.FaultId"
                               class="btn btn-info" title="View Details">
                                <i class="fas fa-eye"></i> Details
                            </a>

                            @if (fault.FaultTechnicianId == null && ViewBag.IsFaultTechnician == true)
                            {
                                <form asp-action="AttendFault" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@fault.FaultId" />
                                    <button type="submit" class="btn btn-success"
                                            title="Attend this fault"
                                            onclick="return confirm('Are you sure you want to attend this fault? Other technicians will be notified.')">
                                        <i class="fas fa-user-check"></i> Attend
                                    </button>
                                </form>
                            }
                            else if (fault.FaultTechnicianId == ViewBag.CurrentTechnicianId)
                            {
                                <a asp-action="Update" asp-route-id="@fault.FaultId"
                                   class="btn btn-warning" title="Update Fault">
                                    <i class="fas fa-edit"></i> Update
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <nav aria-label="Faults pagination">
            <ul class="pagination justify-content-center">
                <li class="page-item @prevDisabled">
                    <a class="page-link text-light"
                       asp-action="Index"
                       asp-route-pageNumber="@(Model.PageNumber - 1)"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-sort="@Model.Sort"
                       asp-route-search="@Model.Search"
                       asp-route-priority="@Model.Priority"
                       asp-route-status="@Model.Status">
                        Prev
                    </a>
                </li>

                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-pageNumber="@i"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-sort="@Model.Sort"
                           asp-route-search="@Model.Search"
                           asp-route-priority="@Model.Priority"
                           asp-route-status="@Model.Status">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @nextDisabled">
                    <a class="page-link text-light"
                       asp-action="Index"
                       asp-route-pageNumber="@(Model.PageNumber + 1)"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-sort="@Model.Sort"
                       asp-route-search="@Model.Search"
                       asp-route-priority="@Model.Priority"
                       asp-route-status="@Model.Status">
                        Next
                    </a>
                </li>
            </ul>
        </nav>
    }

    <div class="row align-items-center mt-3">
        <div class="col-md-6">
            <span class="text-light">
                Showing @((Model.PageNumber - 1) * Model.PageSize + 1) to
                @Math.Min(Model.PageNumber * Model.PageSize, ViewBag.TotalFaultsCount) of @ViewBag.TotalFaultsCount entries
            </span>
        </div>
        <div class="col-md-6 text-end">
            <div class="btn-group">
                <span class="me-2 text-light">Page size:</span>
                @foreach (var size in new[] { 5, 10, 20, 50 })
                {
                    <a class="btn btn-outline-secondary btn-sm @(Model.PageSize == size ? "active" : "")"
                       asp-action="Index"
                       asp-route-pageNumber="1"
                       asp-route-pageSize="@size"
                       asp-route-sort="@Model.Sort"
                       asp-route-search="@Model.Search"
                       asp-route-priority="@Model.Priority"
                       asp-route-status="@Model.Status">
                        @size
                    </a>
                }
            </div>
        </div>
    </div>
    
    
}

@functions {
    public string GetFaultHeaderClass(Fault fault)
    {
        return fault.Priority switch
        {
            FaultPriority.Critical => "bg-danger",
            FaultPriority.High => "bg-danger",
            FaultPriority.Medium => "bg-warning",
            FaultPriority.Low => "bg-info",
            _ => "bg-secondary"
        };
    }

    public string GetPriorityBadgeClass(FaultPriority priority)
    {
        return priority switch
        {
            FaultPriority.Critical => "bg-danger",
            FaultPriority.High => "bg-danger",
            FaultPriority.Medium => "bg-warning",
            FaultPriority.Low => "bg-info",
            _ => "bg-secondary"
        };
    }

    public string GetStatusBadgeClass(FaultStatus status)
    {
        return status switch
        {
            FaultStatus.Reported => "bg-warning",
            FaultStatus.Scheduled => "bg-info",
            FaultStatus.InProgress => "bg-primary",
            FaultStatus.Completed => "bg-success",
            FaultStatus.Cancelled => "bg-danger",
            _ => "bg-secondary"
        };
    }

    public string GetSortDisplayName(string sort)
    {
        return sort switch
        {
            "priority_desc" => "Priority: High to Low",
            "priority_asc" => "Priority: Low to High",
            "date_desc" => "Date: Newest First",
            "date_asc" => "Date: Oldest First",
            _ => "Default"
        };
    }
}