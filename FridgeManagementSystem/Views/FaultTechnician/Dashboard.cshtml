@using FridgeManagementSystem.ViewModels
@model TechnicianDashboardViewModel
@{
    ViewData["Title"] = "Fault Technician Dashboard";
    Layout = "_FaultTechnicianLayout";
}

<div class="container-fluid">
    <!-- Welcome Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h2 class="card-title mb-1">
                                <i class="fas fa-tools me-2"></i>Welcome, @(Model.TechnicianName ?? "Technician")!
                            </h2>
                            <p class="card-text mb-0">Here is your repair dashboard overview</p>
                        </div>
                        <div class="col-md-4 text-end">
                            <div class="btn-group">
                                <a asp-action="Index" class="btn btn-light">
                                    <i class="fas fa-list me-1"></i>All Faults
                                </a>
                                <a asp-action="MySchedule" class="btn btn-outline-light">
                                    <i class="fas fa-calendar me-1"></i>My Schedule
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <!-- Total Faults -->
        <div class="col-xl-2 col-md-4 col-sm-6 mb-3">
            <div class="card bg-secondary text-white h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="card-title text-white-50">Total Reported Faults</h6>
                            <h3 class="mb-0">@Model.TotalFaults</h3>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-exclamation-triangle fa-2x text-white-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Unattended Faults -->
        <div class="col-xl-2 col-md-4 col-sm-6 mb-3">
            <div class="card bg-warning text-dark h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="card-title text-dark-50">Unattended Faults</h6>
                            <h3 class="mb-0">@Model.UnattendedFaults</h3>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-user-clock fa-2x text-dark-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Urgent Faults -->
        <div class="col-xl-2 col-md-4 col-sm-6 mb-3">
            <div class="card bg-danger text-white h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="card-title text-white-50">Urgent Faults</h6>
                            <h3 class="mb-0">@Model.UrgentFaults</h3>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-ambulance fa-2x text-white-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- My Active Faults -->
        <div class="col-xl-2 col-md-4 col-sm-6 mb-3">
            <div class="card bg-info text-white h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="card-title text-white-50">My Active Faults</h6>
                            <h3 class="mb-0">@Model.MyActiveFaults</h3>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-tasks fa-2x text-white-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- My Completed -->
        <div class="col-xl-2 col-md-4 col-sm-6 mb-3">
            <div class="card bg-success text-white h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="card-title text-white-50">Completed Faults</h6>
                            <h3 class="mb-0">@Model.MyCompletedFaults</h3>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-check-circle fa-2x text-white-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Completion Rate -->
        <div class="col-xl-2 col-md-4 col-sm-6 mb-3">
            <div class="card bg-primary text-white h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="card-title text-white-50">Completion Rate</h6>
                            <h3 class="mb-0">@Model.CompletionRate.ToString("0.0")%</h3>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-chart-line fa-2x text-white-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Quick Actions & Unattended Faults -->
        <div class="col-lg-6 mb-4">
            <div class="card h-100">
                <div class="card-header bg-warning text-dark">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-bolt me-2"></i>Quick Actions & Unattended Faults
                    </h5>
                </div>
                <div class="card-body">
                    <!-- Quick Action Buttons -->
                    <div class="row mb-4">
                        <div class="col-md-6 mb-2">
                            <a asp-action="Index" class="btn btn-outline-primary w-100">
                                <i class="fas fa-list me-1"></i>View All Faults
                            </a>
                        </div>
                        <div class="col-md-6 mb-2">
                            <a asp-action="MySchedule" class="btn btn-outline-success w-100">
                                <i class="fas fa-calendar me-1"></i>My Schedule
                            </a>
                        </div>
                        <div class="col-md-6 mb-2">
                            <a asp-action="RepairHistory" class="btn btn-outline-info w-100">
                                <i class="fas fa-history me-1"></i>Repair History
                            </a>
                        </div>
                        <div class="col-md-6 mb-2">
                            <a href="@Url.Action("Index", new { status = "Reported" })" class="btn btn-outline-warning w-100">
                                <i class="fas fa-clock me-1"></i>Pending Faults
                            </a>
                        </div>
                    </div>

                    <!-- Recent Unattended Faults -->
                    @if (Model.RecentUnattendedFaults.Any())
                    {
                        <h6 class="border-bottom pb-2">Recent Unattended Faults</h6>
                        <div class="list-group list-group-flush">
                            @foreach (var fault in Model.RecentUnattendedFaults)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-1">@fault.Title</h6>
                                        <small class="text-muted">
                                            <span class="badge @GetPriorityBadgeClass(fault.Priority)">@fault.Priority</span>
                                            • @fault.Fridge?.FridgeType?.Name
                                        </small>
                                    </div>
                                    <a asp-action="Details" asp-route-id="@fault.FaultId" class="btn btn-sm btn-success">
                                        <i class="fas fa-eye"></i> View
                                    </a>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <i class="fas fa-times-circle fa-2x mb-2"></i>
                            <p>No unattended faults at the moment</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Upcoming Schedules -->
        <div class="col-lg-6 mb-4">
            <div class="card h-100">
                <div class="card-header bg-info text-white">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-calendar-alt me-2"></i>Upcoming Schedules (Next 7 Days)
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.UpcomingSchedules.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var schedule in Model.UpcomingSchedules)
                            {
                                <div class="list-group-item">
                                    <div class="d-flex w-100 justify-content-between">
                                        <h6 class="mb-1">@schedule.Fault?.Title</h6>
                                        <small class="text-muted">@schedule.ScheduledDate.ToString("MMM dd")</small>
                                    </div>
                                    <p class="mb-1">@schedule.Fault?.Fridge?.FridgeType?.Name - @schedule.Fault?.ReportedBy?.User?.FullName</p>
                                    <small>
                                        <span class="badge @GetScheduleStatusBadgeClass(schedule.Status)">@schedule.Status</span>
                                        • @schedule.EstimatedHours hours
                                    </small>
                                    <div class="mt-2">
                                        <a asp-action="UpdateSchedule" asp-route-id="@schedule.RepairScheduleId" class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-edit"></i> Update
                                        </a>
                                        <a asp-action="Details" asp-route-id="@schedule.FaultId" class="btn btn-sm btn-outline-info">
                                            <i class="fas fa-info-circle"></i> Details
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <i class="fas fa-calendar-times fa-2x mb-2"></i>
                            <p>No upcoming schedules</p>
                            <a asp-action="Index" class="btn btn-primary btn-sm">
                                <i class="fas fa-plus me-1"></i>Find Faults to Schedule
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- My Recent Faults -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-history me-2"></i>My Recent Faults
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.MyRecentFaults.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover mb-0">
                                <thead class="table-primary">
                                    <tr>
                                        <th>Fault Title</th>
                                        <th>Fridge</th>
                                        <th>Status</th>
                                        <th>Priority</th>
                                        <th>Last Updated</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var fault in Model.MyRecentFaults)
                                    {
                                        <tr>
                                            <td>@fault.Title</td>
                                            <td>
                                                @if (fault.Fridge != null && fault.Fridge.FridgeType != null)
                                                {
                                                    <div>
                                                        <strong class="d-block">@fault.Fridge.FridgeType.Name</strong>
                                                        <small class="text-muted">
                                                            @fault.Fridge.FridgeType.Brand • @fault.Fridge.FridgeType.Model
                                                        </small>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">N/A</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge @GetStatusBadgeClass(fault.Status)">@fault.Status</span>
                                            </td>
                                            <td>
                                                <span class="badge @GetPriorityBadgeClass(fault.Priority)">@fault.Priority</span>
                                            </td>
                                            <td>@fault.UpdatedAt?.ToString("MMM dd, yyyy")</td>
                                            <td>
                                                <a asp-action="Details" asp-route-id="@fault.FaultId" class="btn btn-sm btn-info">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                @if (fault.Status != FaultStatus.Completed)
                                                {
                                                    <a asp-action="Update" asp-route-id="@fault.FaultId" class="btn btn-sm btn-warning">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <i class="fas fa-tools fa-2x mb-2"></i>
                            <p>You haven not attended any faults yet</p>
                            <a asp-action="Index" class="btn btn-primary">
                                <i class="fas fa-plus me-1"></i>Attend Faults
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    public string GetPriorityBadgeClass(FaultPriority priority)
    {
        return priority switch
        {
            FaultPriority.Critical => "bg-danger",
            FaultPriority.High => "bg-danger",
            FaultPriority.Medium => "bg-warning",
            FaultPriority.Low => "bg-info",
            _ => "bg-secondary"
        };
    }

    public string GetStatusBadgeClass(FaultStatus status)
    {
        return status switch
        {
            FaultStatus.Reported => "bg-warning",
            FaultStatus.Scheduled => "bg-info",
            FaultStatus.InProgress => "bg-primary",
            FaultStatus.Completed => "bg-success",
            FaultStatus.Cancelled => "bg-danger",
            _ => "bg-secondary"
        };
    }

    public string GetScheduleStatusBadgeClass(ScheduleStatus status)
    {
        return status switch
        {
            ScheduleStatus.Scheduled => "bg-info",
            ScheduleStatus.InProgress => "bg-primary",
            ScheduleStatus.Completed => "bg-success",
            ScheduleStatus.Cancelled => "bg-danger",
            ScheduleStatus.Rescheduled => "bg-warning",
            _ => "bg-secondary"
        };
    }
}