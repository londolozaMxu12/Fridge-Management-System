@model FridgeManagementSystem.ViewModels.TechnicianDashboardViewModel

@{
    ViewData["Title"] = "Faults Dashboard";
    Layout = "_FaultTechnicianLayout";
}

<div class="d-flex justify-content-center align-items-center text-light mb-4">
    <h2>
        <i class="fas fa-tools me-2"></i> Highest Priority/Newest Reported Faults
    </h2>
</div>

@if (Model.IsFaultTechnician == true)
{
    <div class="row">
        @foreach (var fault in Model.Faults) 
        {
            <div class="col-md-6 mb-4">
                <div class="card h-100 @(fault.FaultTechnicianId == null ? "border-warning" : fault.FaultTechnicianId == ViewBag.CurrentTechnicianId ? "border-primary" : "border-secondary")">
                    <div class="card-header @GetFaultHeaderClass(fault) text-light">
                        <h5 class="card-title mb-0">
                            @fault.Title
                            @if (fault.FaultTechnicianId == null)
                            {
                                <span class="badge bg-primary float-end">Un Attended</span>
                            }
                        </h5>
                    </div>
                    <div class="card-body">
                        <p class="card-text">@fault.Description</p>

                        <div class="mb-2">
                            <strong>Priority:</strong>
                            <span class="badge @GetPriorityBadgeClass(fault.Priority)">@fault.Priority</span>
                        </div>

                        <div class="mb-2">
                            <strong>Status:</strong>
                            <span class="badge @GetStatusBadgeClass(fault.Status)">@fault.Status</span>
                        </div>

                        @if (fault.Fridge != null)
                        {
                            <div class="mb-2">
                                <strong>Fridge:</strong>
                                @fault.Fridge.FridgeType.Name, @fault.Fridge.FridgeType.Model, @fault.Fridge.FridgeType.Brand -SN: @fault.Fridge.SerialNumber
                            </div>
                        }

                        <div class="mb-2">
                            <strong>Reported By:</strong>
                            @fault.ReportedBy.User.FullName (@fault.ReportedBy.BusinessName)
                        </div>

                        <div class="mb-2">
                            <strong>Reported Date:</strong>
                            @fault.ReportedDate.ToString("yyyy-MM-dd HH:mm")
                        </div>

                        @if (fault.FaultTechnicianId != null)
                        {
                            <div class="mb-2">
                                <strong>Assigned Technician:</strong>
                                @fault.FaultTechnician?.User?.FullName
                            </div>
                        }
                    </div>
                    <div class="card-footer">
                        <div class="btn-group btn-group-sm w-100">
                            
                            <a href="#" class="btn btn-info view-fault-details" data-fault-id="@fault.FaultId" data-bs-toggle="modal"
                               data-bs-target="#faultDetailsModal">
                                <i class="fas fa-eye"></i>View Details
                               
                            </a>
                            
                            <form asp-controller="FaultTechnician" asp-action="AttendFault" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@fault.FaultId" />
                                <button type="submit" class="btn btn-success"
                                        title="Attend this fault"
                                        onclick="return confirm('Are you sure you want to attend this fault? Other technicians will be notified.')">
                                    <i class="fas fa-user-check"></i> Attend
                                </button>
                            </form>

                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-warning">
        <i class="fas fa-exclamation-triangle"></i> You are not authorized as one of our Fault Technician.
    </div>
}

<div class="d-flex justify-content-center align-items-center text-light mb-4">
    <h2>
        <i class="bi bi-calendar-event me-2 text-light"></i>My Schedules
    </h2>
</div>


<!-- Quick Stats -->
<div class="row mt-4">
    <div class="col-md-3">
        <div class="card bg-primary text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h4 class="mb-0">@Model.Schedules.Count(s => s.Status == FridgeManagementSystem.Models.ScheduleStatus.Scheduled)</h4>
                        <small>Scheduled</small>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-calendar fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-warning text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h4 class="mb-0">@Model.Schedules.Count(s => s.Status == FridgeManagementSystem.Models.ScheduleStatus.InProgress)</h4>
                        <small>In Progress</small>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-play fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-success text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h4 class="mb-0">@Model.Schedules.Count(s => s.Status == FridgeManagementSystem.Models.ScheduleStatus.Completed)</h4>
                        <small>Completed</small>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-check fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-info text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h4 class="mb-0">@Model.Schedules.Count(s => s.Status == FridgeManagementSystem.Models.ScheduleStatus.Rescheduled)</h4>
                        <small>Rescheduled</small>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-calendar-alt fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
</div>

<!-- Fault Details Modal -->
<div class="modal fade" id="faultDetailsModal" tabindex="-1" aria-labelledby="faultDetailsModalLabel" aria-hidden="true"
     data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-light text-dark">
                <h3 class="modal-title" id="faultDetailsModalLabel">
                    Fault Details
                </h3>
                <button type="button" class="btn-close btn-close-dark" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="faultDetailsModalBody">
                <!-- Content will be loaded here dynamically -->
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p>Loading fault details...</p>
                </div>
            </div>

        </div>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script src="~/js/site.js" asp-append-version="true"></script>


<script>
    document.addEventListener('DOMContentLoaded', function() {
        console.log('Layout loaded');

        // Check if navigation links are working
        document.querySelectorAll('a.nav-link, a.dropdown-item').forEach(link => {
            link.addEventListener('click', function(e) {
                console.log('Navigation link clicked:', this.href);
            });
        });
    });
</script>

<script>
    document.addEventListener('DOMContentLoaded', function() {

        // Handle modal show event
        const faultDetailsModal = document.getElementById('faultDetailsModal');
        if (faultDetailsModal) {
            faultDetailsModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget; // Button that triggered the modal
                const faultId = button.getAttribute('data-fault-id');

                if (faultId) {
                    loadFaultDetails(faultId);
                }
            });

            // Clear modal content when hidden
            faultDetailsModal.addEventListener('hidden.bs.modal', function () {
                document.getElementById('faultDetailsModalBody').innerHTML =
                    '<div class="text-center py-4"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div><p>Loading fault details...</p></div>';
            });
        }

        // Function to load fault details via AJAX
        function loadFaultDetails(faultId) {
            fetch(`/FaultTechnician/GetFaultDetailsPartial?id=${faultId}`)
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    }
                    return response.text();
                })
                .then(data => {
                    document.getElementById('faultDetailsModalBody').innerHTML = data;
                })
                .catch(error => {
                    console.error('Error loading fault details:', error);
                    document.getElementById('faultDetailsModalBody').innerHTML =
                        '<div class="alert alert-danger">Error loading fault details. Please try again.</div>';
                });
        }
    });
</script>

@functions {
  
    public string GetFaultHeaderClass(Fault fault)
    {
        return fault.Priority switch
        {
            FaultPriority.Critical => "bg-danger",
            FaultPriority.High => "bg-danger",
            FaultPriority.Medium => "bg-warning",
            FaultPriority.Low => "bg-info",
            _ => "bg-secondary"
        };
    }

    public string GetPriorityBadgeClass(FaultPriority priority)
    {
        return priority switch
        {
            FaultPriority.Critical => "bg-danger",
            FaultPriority.High => "bg-danger",
            FaultPriority.Medium => "bg-warning",
            FaultPriority.Low => "bg-info",
            _ => "bg-secondary"
        };
    }

    public string GetStatusBadgeClass(FaultStatus status)
    {
        return status switch
        {
            FaultStatus.Reported => "bg-warning",
            FaultStatus.Scheduled => "bg-info",
            FaultStatus.InProgress => "bg-primary",
            FaultStatus.Completed => "bg-success",
            FaultStatus.Cancelled => "bg-danger",
            _ => "bg-secondary"
        };
    }
}