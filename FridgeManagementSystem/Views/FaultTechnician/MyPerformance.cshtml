<div class="report-header">
    <div class="row align-items-center">
        <div class="col-md-8">
            <h1 class="display-5 fw-bold">
                <i class="bi bi-graph-up-arrow me-2"></i>@Model.ReportTitle
            </h1>
            <p class="lead mb-0">Comprehensive Performance Analytics & Insights</p>
            <small>Generated on @Model.GeneratedOn | Period: @Model.ReportPeriod</small>
        </div>
        <div class="col-md-4 text-end">
            <div class="btn-group">
                <button class="btn btn-light dropdown-toggle" type="button" data-bs-toggle="dropdown">
                    <i class="bi bi-download me-2"></i>Export Report
                </button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" href="#" onclick="exportReport('pdf')"><i class="bi bi-file-pdf me-2"></i>PDF Format</a></li>
                    <li><a class="dropdown-item" href="#" onclick="exportReport('excel')"><i class="bi bi-file-spreadsheet me-2"></i>Excel Format</a></li>
                </ul>
            </div>
        </div>
    </div>
</div>

<!-- Report Filters -->
<div class="card mb-4">
    <div class="card-header bg-light">
        <h5 class="card-title mb-0"><i class="bi bi-filter me-2"></i>Report Filters</h5>
    </div>
    <div class="card-body">
        <form id="performanceFilterForm" class="row g-3" method="get">
            <div class="col-md-3">
                <label class="form-label">Date From</label>
                <input type="date" class="form-control" name="dateFrom" value="@ViewBag.DateFrom">
            </div>
            <div class="col-md-3">
                <label class="form-label">Date To</label>
                <input type="date" class="form-control" name="dateTo" value="@ViewBag.DateTo">
            </div>
            <div class="col-md-3">
                <label class="form-label">Report Type</label>
                <select class="form-select" name="reportType">
                    <option value="detailed" selected="@(ViewBag.ReportType == "detailed")">Detailed Analysis</option>
                    <option value="executive" selected="@(ViewBag.ReportType == "executive")">Executive Summary</option>
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-filter me-2"></i>Apply Filters
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Performance Summary Cards -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card metric-card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title text-muted mb-2">Completion Rate</h6>
                        <h2 class="mb-0">@Model.CompletionRate.ToString("F1")%</h2>
                        <small class="text-muted">@Model.CompletedFaults of @Model.TotalFaultsAssigned faults</small>
                    </div>
                    <div class="text-primary">
                        <i class="bi bi-check-circle-fill fs-1"></i>
                    </div>
                </div>
                <div class="mt-3">
                    @if (Model.CompletionRate >= 85)
                    {
                        <span class="badge bg-success"><i class="bi bi-arrow-up me-1"></i>On Target</span>
                    }
                    else
                    {
                        <span class="badge bg-warning"><i class="bi bi-arrow-down me-1"></i>Needs Improvement</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card metric-card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title text-muted mb-2">Efficiency Score</h6>
                        <h2 class="mb-0">@Model.EfficiencyScore.ToString("F1")</h2>
                        <small class="text-muted">Out of 100 points</small>
                    </div>
                    <div class="text-info">
                        <i class="bi bi-speedometer2 fs-1"></i>
                    </div>
                </div>
                <div class="mt-3">
                    @if (Model.EfficiencyScore >= 80)
                    {
                        <span class="badge bg-success">Excellent</span>
                    }
                    else if (Model.EfficiencyScore >= 60)
                    {
                        <span class="badge bg-warning">Good</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Needs Work</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card metric-card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title text-muted mb-2">Avg. Resolution Time</h6>
                        <h2 class="mb-0">@Model.AverageCompletionTimeHours.ToString("F1")h</h2>
                        <small class="text-muted">Per fault</small>
                    </div>
                    <div class="text-success">
                        <i class="bi bi-clock-fill fs-1"></i>
                    </div>
                </div>
                <div class="mt-3">
                    @if (Model.AverageCompletionTimeHours <= 24)
                    {
                        <span class="badge bg-success">Fast</span>
                    }
                    else
                    {
                        <span class="badge bg-warning">Slow</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card metric-card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title text-muted mb-2">Active Faults</h6>
                        <h2 class="mb-0">@Model.InProgressFaults</h2>
                        <small class="text-muted">In progress</small>
                    </div>
                    <div class="text-warning">
                        <i class="bi bi-tools fs-1"></i>
                    </div>
                </div>
                <div class="mt-3">
                    @if (Model.OverdueFaults > 0)
                    {
                        <span class="badge bg-danger">@Model.OverdueFaults overdue</span>
                    }
                    else
                    {
                        <span class="badge bg-success">On Track</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Left Column - Charts -->
    <div class="col-md-8">
        <!-- Performance Trends Chart -->
        <div class="chart-container">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0"><i class="bi bi-bar-chart me-2"></i>Performance Trends</h5>
                <div class="btn-group btn-group-sm">
                    <button type="button" class="btn btn-outline-secondary active" data-chart-type="completion">
                        <i class="bi bi-check-circle me-1"></i>Completion Rate
                    </button>
                    <button type="button" class="btn btn-outline-secondary" data-chart-type="efficiency">
                        <i class="bi bi-speedometer me-1"></i>Efficiency
                    </button>
                </div>
            </div>
            <div id="performanceTrendsChart" style="height: 300px;">
                <div class="chart-loading">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading chart...</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Priority Distribution -->
        <div class="chart-container">
            <h5 class="mb-3"><i class="bi bi-pie-chart me-2"></i>Priority Distribution</h5>
            <div class="row">
                <div class="col-md-6">
                    <div id="priorityDistributionChart" style="height: 250px;">
                        <div class="chart-loading">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading chart...</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Priority</th>
                                    <th>Attended</th>
                                    <th>Completed</th>
                                    <th>Success Rate</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var priority in Model.PriorityMetrics)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge
                                                        @(priority.Priority == 4 ? "bg-danger" :
                                                                                                        priority.Priority == 3 ? "bg-warning" :
                                                                                                        priority.Priority == 2 ? "bg-info" : "bg-success")">
                                                @(priority.Priority == 4 ? "Critical" :
                                                                                            priority.Priority == 3 ? "High" :
                                                                                            priority.Priority == 2 ? "Medium" : "Low")
                                        </span>
                                    </td>
                                    <td>@priority.Attended</td>
                                    <td>@priority.Completed</td>
                                    <td>
                                        <span class="@(priority.SuccessRate >= 75 ? "text-success" : "text-warning") fw-bold">
                                            @priority.SuccessRate.ToString("F1")%
                                        </span>
                                    </td>
                                </tr>
                                                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column - Insights and Details -->
    <div class="col-md-4">
        <!-- Performance Insights -->
        <div class="chart-container">
            <h5 class="mb-3"><i class="bi bi-lightbulb me-2"></i>Performance Insights</h5>

            @if (Model.CompletionRate >= 85)
            {
                <div class="alert alert-success">
                    <h6><i class="bi bi-trophy me-2"></i>Excellent Performance</h6>
                    <small class="mb-0">Your completion rate exceeds the target of 85%. Keep up the great work!</small>
                </div>
            }
            else if (Model.CompletionRate >= 70)
            {
                <div class="alert alert-info">
                    <h6><i class="bi bi-check-circle me-2"></i>Good Performance</h6>
                    <small class="mb-0">You're close to the target. Focus on completing pending faults.</small>
                </div>
            }
            else
            {
                <div class="alert alert-warning">
                    <h6><i class="bi bi-exclamation-triangle me-2"></i>Needs Improvement</h6>
                    <small class="mb-0">Your completion rate is below target. Consider prioritizing critical faults.</small>
                </div>
            }

            @if (Model.OverdueFaults > 0)
            {
                <div class="alert alert-danger">
                    <h6><i class="bi bi-clock me-2"></i>Overdue Faults</h6>
                    <small class="mb-0">You have @Model.OverdueFaults overdue faults requiring immediate attention.</small>
                </div>
            }

            <!-- Quick Stats -->
            <div class="mt-3">
                <h6 class="text-muted">Quick Stats</h6>
                <div class="row text-center">
                    <div class="col-6">
                        <div class="border rounded p-2">
                            <div class="fw-bold text-primary">@Model.InProgressFaults</div>
                            <small class="text-muted">In Progress</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="border rounded p-2">
                            <div class="fw-bold text-warning">@Model.OverdueFaults</div>
                            <small class="text-muted">Overdue</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Performance -->
        <div class="chart-container">
            <h5 class="mb-3"><i class="bi bi-speedometer2 me-2"></i>Recent Performance</h5>
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Month</th>
                            <th>Completed</th>
                            <th>Rate</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var month in Model.MonthlyPerformance.Take(6))
                        {
                            var rate = month.TotalFaults > 0 ? (double)month.CompletedFaults / month.TotalFaults * 100 : 0;
                            <tr>
                                <td>@month.Month</td>
                                <td>@month.CompletedFaults/@month.TotalFaults</td>
                                <td>
                                    <span class="@(rate >= 75 ? "text-success" : "text-warning") fw-bold">
                                        @rate.ToString("F1")%
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Detailed Performance Table -->
<div class="card mt-4">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">
            <i class="bi bi-table me-2"></i>Detailed Performance Metrics
        </h5>
        <button class="btn btn-sm btn-outline-primary" onclick="toggleDetailedView()">
            <i class="bi bi-arrows-expand me-1"></i><span>Toggle View</span>
        </button>
    </div>
    <div class="card-body">
        <div class="table-responsive" id="detailedTableView">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Metric</th>
                        <th>Value</th>
                        <th>Target</th>
                        <th>Status</th>
                        <th>Trend</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Overall Completion Rate</td>
                        <td>@Model.CompletionRate.ToString("F1")%</td>
                        <td>85%</td>
                        <td>
                            <span class="badge @(Model.CompletionRate >= 85 ? "bg-success" : "bg-warning")">
                                @(Model.CompletionRate >= 85 ? "Excellent" : "Needs Improvement")
                            </span>
                        </td>
                        <td>
                            @if (Model.CompletionRate >= 85)
                            {
                                <i class="bi bi-arrow-up-circle-fill text-success"></i>
                            }
                            else
                            {
                                <i class="bi bi-arrow-down-circle-fill text-warning"></i>
                            }
                        </td>
                    </tr>
                    <tr>
                        <td>Efficiency Score</td>
                        <td>@Model.EfficiencyScore.ToString("F1")/100</td>
                        <td>80</td>
                        <td>
                            <span class="badge @(Model.EfficiencyScore >= 80 ? "bg-success" : Model.EfficiencyScore >= 60 ? "bg-warning" : "bg-danger")">
                                @(Model.EfficiencyScore >= 80 ? "Excellent" : Model.EfficiencyScore >= 60 ? "Good" : "Needs Work")
                            </span>
                        </td>
                        <td>
                            @if (Model.EfficiencyScore >= 80)
                            {
                                <i class="bi bi-arrow-up-circle-fill text-success"></i>
                            }
                            else if (Model.EfficiencyScore >= 60)
                            {
                                <i class="bi bi-dash-circle-fill text-warning"></i>
                            }
                            else
                            {
                                <i class="bi bi-arrow-down-circle-fill text-danger"></i>
                            }
                        </td>
                    </tr>
                    <tr>
                        <td>Average Resolution Time</td>
                        <td>@Model.AverageCompletionTimeHours.ToString("F1") hours</td>
                        <td>24 hours</td>
                        <td>
                            <span class="badge @(Model.AverageCompletionTimeHours <= 24 ? "bg-success" : "bg-warning")">
                                @(Model.AverageCompletionTimeHours <= 24 ? "Fast" : "Slow")
                            </span>
                        </td>
                        <td>
                            @if (Model.AverageCompletionTimeHours <= 24)
                            {
                                <i class="bi bi-arrow-down-circle-fill text-success"></i>
                            }
                            else
                            {
                                <i class="bi bi-arrow-up-circle-fill text-warning"></i>
                            }
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Global chart references
        window.trendsChart = null;
        window.priorityChart = null;
        window.chartData = null;

        // Initialize charts when page loads with server-side data
        document.addEventListener('DOMContentLoaded', function() {
            console.log('DOM loaded, initializing charts...');
            initializeChartsWithServerData();

            // Add event listeners for chart type toggles
            document.querySelectorAll('[data-chart-type]').forEach(button => {
                button.addEventListener('click', function() {
                    // Remove active class from all buttons
                    document.querySelectorAll('[data-chart-type]').forEach(btn => {
                        btn.classList.remove('active');
                    });
                    // Add active class to clicked button
                    this.classList.add('active');

                    // Switch chart type
                    const chartType = this.getAttribute('data-chart-type');
                    switchChartType(chartType);
                });
            });
        });

        // Use server-side data directly
        function initializeChartsWithServerData() {
            try {
                // Get data from server-side model
                const monthlyData = @Html.Raw(Json.Serialize(Model.MonthlyPerformance ?? new List<MonthlyPerformance>()));
                const priorityData = @Html.Raw(Json.Serialize(Model.PriorityMetrics ?? new List<PriorityMetrics>()));

                console.log('Monthly Data for Trends:', monthlyData);
                console.log('Priority Data for Chart:', priorityData);

                // Store data globally for chart switching
                window.chartData = {
                    monthly: monthlyData,
                    priority: priorityData
                };

                // Initialize charts only if we have data
                if (monthlyData && monthlyData.length > 0) {
                    initializeTrendsChart(monthlyData);
                } else {
                    showNoDataMessage('performanceTrendsChart', 'No monthly performance data available');
                }

                if (priorityData && priorityData.length > 0) {
                    initializePriorityChart(priorityData);
                } else {
                    showNoDataMessage('priorityDistributionChart', 'No priority distribution data available');
                }

            } catch (error) {
                console.error('Error initializing charts:', error);
                showNoDataMessage('performanceTrendsChart', 'Error loading chart data');
                showNoDataMessage('priorityDistributionChart', 'Error loading chart data');
            }
        }

        function initializeTrendsChart(monthlyData) {
            const container = document.getElementById('performanceTrendsChart');
            if (!container) {
                console.error('Trends chart element not found');
                return;
            }

            try {
                // Clear loading state first
                container.innerHTML = '<canvas></canvas>';
                const canvas = container.querySelector('canvas');

                // Destroy existing chart if it exists
                if (window.trendsChart) {
                    window.trendsChart.destroy();
                }

                // Check if we have valid data
                if (!monthlyData || monthlyData.length === 0) {
                    showNoDataMessage('performanceTrendsChart', 'No monthly performance data available');
                    return;
                }

                const completionRates = monthlyData.map(m => {
                    if (m.TotalFaults > 0) {
                        return (m.CompletedFaults / m.TotalFaults * 100);
                    }
                    return 0;
                });

                console.log('Completion Rates:', completionRates);
                console.log('Monthly Labels:', monthlyData.map(m => m.Month));

                window.trendsChart = new Chart(canvas, {
                    type: 'line',
                    data: {
                        labels: monthlyData.map(m => m.Month),
                        datasets: [{
                            label: 'Completion Rate %',
                            data: completionRates,
                            borderColor: '#3498db',
                            backgroundColor: 'rgba(52, 152, 219, 0.1)',
                            borderWidth: 3,
                            fill: true,
                            tension: 0.4,
                            pointBackgroundColor: '#3498db',
                            pointBorderColor: '#ffffff',
                            pointBorderWidth: 2,
                            pointRadius: 5,
                            pointHoverRadius: 7
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                display: true,
                                position: 'top',
                                labels: {
                                    usePointStyle: true,
                                    padding: 20
                                }
                            },
                            tooltip: {
                                backgroundColor: 'rgba(0, 0, 0, 0.8)',
                                titleColor: '#ffffff',
                                bodyColor: '#ffffff',
                                borderColor: '#3498db',
                                borderWidth: 1,
                                callbacks: {
                                    label: function(context) {
                                        return `Completion Rate: ${context.parsed.y.toFixed(1)}%`;
                                    }
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                max: 100,
                                title: {
                                    display: true,
                                    text: 'Completion Rate (%)',
                                    font: {
                                        weight: 'bold'
                                    }
                                },
                                ticks: {
                                    callback: value => value + '%',
                                    stepSize: 20
                                },
                                grid: {
                                    color: 'rgba(0, 0, 0, 0.1)'
                                }
                            },
                            x: {
                                title: {
                                    display: true,
                                    text: 'Month',
                                    font: {
                                        weight: 'bold'
                                    }
                                },
                                grid: {
                                    display: false
                                }
                            }
                        },
                        interaction: {
                            intersect: false,
                            mode: 'index'
                        },
                        animations: {
                            tension: {
                                duration: 1000,
                                easing: 'linear'
                            }
                        }
                    }
                });
                console.log('Trends chart created successfully');
            } catch (error) {
                console.error('Error creating trends chart:', error);
                showNoDataMessage('performanceTrendsChart', 'Error creating chart');
            }
        }

        function initializeEfficiencyChart(monthlyData) {
            const container = document.getElementById('performanceTrendsChart');
            if (!container) return;

            try {
                // Clear loading state first
                container.innerHTML = '<canvas></canvas>';
                const canvas = container.querySelector('canvas');

                // Destroy existing chart if it exists
                if (window.trendsChart) {
                    window.trendsChart.destroy();
                }

                // Check if we have valid data
                if (!monthlyData || monthlyData.length === 0) {
                    showNoDataMessage('performanceTrendsChart', 'No monthly performance data available');
                    return;
                }

                // Calculate efficiency scores (simplified - you might want to use actual efficiency data)
                const efficiencyScores = monthlyData.map(m => {
                    if (m.TotalFaults > 0) {
                        const completionRate = (m.CompletedFaults / m.TotalFaults * 100);
                        // Simulate efficiency score based on completion rate and time
                        return Math.min(100, completionRate * 0.8 + (Math.random() * 20));
                    }
                    return 0;
                });

                console.log('Efficiency Scores:', efficiencyScores);

                window.trendsChart = new Chart(canvas, {
                    type: 'bar',
                    data: {
                        labels: monthlyData.map(m => m.Month),
                        datasets: [{
                            label: 'Efficiency Score',
                            data: efficiencyScores,
                            backgroundColor: 'rgba(46, 204, 113, 0.8)',
                            borderColor: 'rgba(46, 204, 113, 1)',
                            borderWidth: 2,
                            borderRadius: 5,
                            borderSkipped: false,
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                display: true,
                                position: 'top',
                                labels: {
                                    usePointStyle: true,
                                    padding: 20
                                }
                            },
                            tooltip: {
                                backgroundColor: 'rgba(0, 0, 0, 0.8)',
                                titleColor: '#ffffff',
                                bodyColor: '#ffffff',
                                borderColor: '#2ecc71',
                                borderWidth: 1,
                                callbacks: {
                                    label: function(context) {
                                        return `Efficiency: ${context.parsed.y.toFixed(1)}/100`;
                                    }
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                max: 100,
                                title: {
                                    display: true,
                                    text: 'Efficiency Score',
                                    font: {
                                        weight: 'bold'
                                    }
                                },
                                ticks: {
                                    stepSize: 20
                                },
                                grid: {
                                    color: 'rgba(0, 0, 0, 0.1)'
                                }
                            },
                            x: {
                                title: {
                                    display: true,
                                    text: 'Month',
                                    font: {
                                        weight: 'bold'
                                    }
                                },
                                grid: {
                                    display: false
                                }
                            }
                        },
                        interaction: {
                            intersect: false,
                            mode: 'index'
                        }
                    }
                });
                console.log('Efficiency chart created successfully');
            } catch (error) {
                console.error('Error creating efficiency chart:', error);
                showNoDataMessage('performanceTrendsChart', 'Error creating chart');
            }
        }

        function initializePriorityChart(priorityData) {
            const container = document.getElementById('priorityDistributionChart');
            if (!container) {
                console.error('Priority chart element not found');
                return;
            }

            try {
                // Clear loading state first
                container.innerHTML = '<canvas></canvas>';
                const canvas = container.querySelector('canvas');

                // Destroy existing chart if it exists
                if (window.priorityChart) {
                    window.priorityChart.destroy();
                }

                // Check if we have valid data
                if (!priorityData || priorityData.length === 0) {
                    showNoDataMessage('priorityDistributionChart', 'No priority distribution data available');
                    return;
                }

                const priorityNames = {
                    1: 'Low',
                    2: 'Medium',
                    3: 'High',
                    4: 'Critical'
                };

                // DON'T filter out zero values - show all priorities
                // This ensures the chart shows all priority levels even if some have zero faults
                const chartData = priorityData.map(p => ({
                    ...p,
                    priorityName: priorityNames[p.Priority] || `Priority ${p.Priority}`
                }));

                console.log('Priority Chart Data:', chartData);

                // Define colors for each priority
                const priorityColors = {
                    1: '#2ecc71', // Green for Low
                    2: '#3498db', // Blue for Medium
                    3: '#e67e22', // Orange for High
                    4: '#e74c3c'  // Red for Critical
                };

                window.priorityChart = new Chart(canvas, {
                    type: 'doughnut',
                    data: {
                        labels: chartData.map(p => p.priorityName),
                        datasets: [{
                            data: chartData.map(p => p.Attended),
                            backgroundColor: chartData.map(p => priorityColors[p.Priority] || '#95a5a6'),
                            borderColor: '#ffffff',
                            borderWidth: 3,
                            hoverBorderWidth: 4,
                            hoverOffset: 8
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    padding: 20,
                                    usePointStyle: true,
                                    font: {
                                        size: 12,
                                        family: "'Segoe UI', Tahoma, Geneva, Verdana, sans-serif"
                                    },
                                    color: '#2c3e50'
                                }
                            },
                            tooltip: {
                                backgroundColor: 'rgba(0, 0, 0, 0.8)',
                                titleColor: '#ffffff',
                                bodyColor: '#ffffff',
                                borderColor: '#34495e',
                                borderWidth: 1,
                                callbacks: {
                                    label: function(context) {
                                        const label = context.label || '';
                                        const value = context.parsed;
                                        const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                        const percentage = total > 0 ? Math.round((value / total) * 100) : 0;
                                        return `${label}: ${value} fault${value !== 1 ? 's' : ''} (${percentage}%)`;
                                    }
                                }
                            }
                        },
                        cutout: '50%',
                        animation: {
                            animateScale: true,
                            animateRotate: true
                        }
                    }
                });
                console.log('Priority distribution chart created successfully');
            } catch (error) {
                console.error('Error creating priority chart:', error);
                showNoDataMessage('priorityDistributionChart', 'Error creating chart');
            }
        }

        function switchChartType(chartType) {
            if (!window.chartData || !window.chartData.monthly) {
                console.warn('No chart data available for switching');
                return;
            }

            switch(chartType) {
                case 'completion':
                    initializeTrendsChart(window.chartData.monthly);
                    break;
                case 'efficiency':
                    initializeEfficiencyChart(window.chartData.monthly);
                    break;
                default:
                    initializeTrendsChart(window.chartData.monthly);
            }
        }

        function showNoDataMessage(chartId, message) {
            const element = document.getElementById(chartId);
            if (element) {
                element.innerHTML = `
                    <div class="no-data-message">
                        <i class="bi bi-exclamation-triangle display-4 d-block mb-3"></i>
                        <h6>${message}</h6>
                        <small class="text-muted">Try adjusting your date filters or check back later</small>
                    </div>
                `;
            }
        }

        // Export report function
               // Export report function
        function exportPerformanceReport(format) {
            const form = document.getElementById('performanceFilterForm');
            const formData = new FormData(form);

            // Show loading indicator
            const exportBtn = document.querySelector('.dropdown-toggle');
            const originalHtml = exportBtn?.innerHTML || 'Export Report';
            if (exportBtn) {
                exportBtn.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Generating...';
                exportBtn.disabled = true;
            }

            // Add anti-forgery token
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            if (token) {
                formData.append('__RequestVerificationToken', token);
            }

            fetch(`/FaultTechnician/ExportPerformanceReport?format=${format}`, {
                method: 'POST',
                body: formData,
                headers: {
                    'RequestVerificationToken': token
                }
            })
            .then(response => {
                if (response.ok) return response.blob();
                throw new Error(`Export failed: ${response.status} ${response.statusText}`);
            })
            .then(blob => {
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.style.display = 'none';
                a.href = url;

                // Generate filename with correct extension
                const currentDate = new Date().toISOString().split('T')[0];
                const technicianName = '@Model.Technician?.User?.FullName'?.replace(/\s+/g, '_') || 'Technician';

                // FIX: Use correct file extensions
                const fileExtension = format === 'excel' ? 'xlsx' : format;
                a.download = `${technicianName}_Performance_Report_${currentDate}.${fileExtension}`;

                document.body.appendChild(a);
                a.click();
                window.URL.revokeObjectURL(url);
                document.body.removeChild(a);

                showAlert('Report exported successfully!', 'success');
            })
            .catch(error => {
                console.error('Export error:', error);
                showAlert('Failed to export report. Please try again.', 'danger');
            })
            .finally(() => {
                if (exportBtn) {
                    exportBtn.innerHTML = originalHtml;
                    exportBtn.disabled = false;
                }
            });
        }

        // Show alert message
        function showAlert(message, type) {
            // Remove any existing alerts first
            const existingAlerts = document.querySelectorAll('.alert-dismissible');
            existingAlerts.forEach(alert => {
                if (alert.parentElement) {
                    alert.remove();
                }
            });

            const alertDiv = document.createElement('div');
            alertDiv.className = `alert alert-${type} alert-dismissible fade show mt-3`;
            alertDiv.innerHTML = `
                <div class="d-flex align-items-center">
                    <i class="bi ${type === 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-triangle-fill'} me-2"></i>
                    <span>${message}</span>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            `;

            // Insert after the report header
            const reportHeader = document.querySelector('.report-header');
            if (reportHeader && reportHeader.parentElement) {
                reportHeader.parentElement.insertBefore(alertDiv, reportHeader.nextSibling);
            } else {
                // Fallback: insert at the top of the content
                document.querySelector('.container')?.prepend(alertDiv);
            }

            // Auto-dismiss after 5 seconds
            setTimeout(() => {
                if (alertDiv.parentElement) {
                    const bsAlert = new bootstrap.Alert(alertDiv);
                    bsAlert.close();
                }
            }, 5000);
        }

        // Toggle detailed table view
        function toggleDetailedView() {
            const tableView = document.getElementById('detailedTableView');
            const toggleBtn = document.querySelector('[onclick="toggleDetailedView()"]');

            if (tableView) {
                tableView.classList.toggle('table-sm');

                // Update button text
                if (toggleBtn) {
                    const icon = toggleBtn.querySelector('i');
                    const text = toggleBtn.querySelector('span');

                    if (tableView.classList.contains('table-sm')) {
                        if (icon) icon.className = 'bi bi-arrows-collapse me-1';
                        if (text) text.textContent = ' Expand View';
                    } else {
                        if (icon) icon.className = 'bi bi-arrows-expand me-1';
                        if (text) text.textContent = ' Collapse View';
                    }
                }
            }
        }

        // Enhanced filter form handling
        document.addEventListener('DOMContentLoaded', function() {
            const filterForm = document.getElementById('performanceFilterForm');
            if (filterForm) {
                filterForm.addEventListener('submit', function(e) {
                    // Show loading state
                    const submitBtn = this.querySelector('button[type="submit"]');
                    if (submitBtn) {
                        const originalText = submitBtn.innerHTML;
                        submitBtn.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Loading...';
                        submitBtn.disabled = true;

                        // Revert after 3 seconds (in case of error)
                        setTimeout(() => {
                            submitBtn.innerHTML = originalText;
                            submitBtn.disabled = false;
                        }, 3000);
                    }
                });
            }

            // Add date validation
            const dateFromInput = document.querySelector('input[name="dateFrom"]');
            const dateToInput = document.querySelector('input[name="dateTo"]');

            if (dateFromInput && dateToInput) {
                dateFromInput.addEventListener('change', validateDates);
                dateToInput.addEventListener('change', validateDates);
            }

            function validateDates() {
                const fromDate = new Date(dateFromInput.value);
                const toDate = new Date(dateToInput.value);

                if (dateFromInput.value && dateToInput.value && fromDate > toDate) {
                    showAlert('End date cannot be before start date. Please adjust your dates.', 'warning');
                    dateToInput.value = '';
                }

                // Validate date range (max 1 year)
                const maxRange = 365 * 24 * 60 * 60 * 1000; // 1 year in milliseconds
                if (dateFromInput.value && dateToInput.value && (toDate - fromDate) > maxRange) {
                    showAlert('Date range cannot exceed 1 year. Please adjust your filters.', 'warning');
                    dateToInput.value = '';
                }
            }
        });

        // Responsive chart adjustments
        window.addEventListener('resize', function() {
            // Re-render charts on window resize for better responsiveness
            if (window.trendsChart) {
                window.trendsChart.resize();
            }
            if (window.priorityChart) {
                window.priorityChart.resize();
            }
        });

        // Print functionality
        function printPerformanceReport() {
            window.print();
        }

        // Add keyboard shortcuts
        document.addEventListener('keydown', function(e) {
            // Ctrl+P for print
            if ((e.ctrlKey || e.metaKey) && e.key === 'p') {
                e.preventDefault();
                printPerformanceReport();
            }

            // Ctrl+E for export (opens dropdown)
            if ((e.ctrlKey || e.metaKey) && e.key === 'e') {
                e.preventDefault();
                const exportDropdown = document.querySelector('.dropdown-toggle');
                if (exportDropdown) {
                    exportDropdown.click();
                }
            }
        });

        // Initialize tooltips if Bootstrap is available
        if (typeof bootstrap !== 'undefined') {
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            const tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        }

        console.log('Performance report JavaScript loaded successfully');
    </script>
}