@model Order
@{
    ViewData["Title"] = "Order Confirmed";
}

<div class="text-center py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="alert alert-success" role="alert">
                    <h4 class="alert-heading"><i class="bi bi-check-circle-fill"></i> Order Confirmed!</h4>
                    <p>Your order has been successfully placed and is being processed.</p>
                    <hr>
                    <p class="mb-0">Order ID: <strong>#@Model.Id</strong></p>
                    <p class="mb-0">Total Amount: <strong>@(Model.Items.Sum(i => i.Quantity * i.UnitPrice) + Model.ShippingFee)$</strong></p>
                    <p class="mb-0">Order Status: <span class="badge bg-warning">@Model.OrderStatus</span></p>
                </div>

                <div class="card mt-4">
                    <div class="card-header">
                        <h5>Order Details</h5>
                    </div>
                    <div class="card-body">
                        @foreach (var item in Model.Items)
                        {
                            <div class="row mb-3">
                                <div class="col-2">
                                    <img src="/products/@item.Fridge.ImageFileName" width="50" alt="@item.Fridge.FridgeType.Name" />
                                </div>
                                <div class="col-6">
                                    <h6>@item.Fridge.FridgeType.Name</h6>
                                    <small>@item.Fridge.FridgeType.Brand - @item.Fridge.FridgeType.Model</small>
                                </div>
                                <div class="col-2 text-end">
                                    <small>@item.Quantity x @(item.UnitPrice)$</small>
                                </div>
                                <div class="col-2 text-end">
                                    <strong>@(item.Quantity* item.UnitPrice)$</strong>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="mt-4">
                    <a asp-controller="ClientOrders" asp-action="Index" class="btn btn-primary">View My Orders</a>
                    <a asp-controller="Store" asp-action="Index" class="btn btn-outline-secondary">Continue Shopping</a>
                </div>
            </div>
        </div>
    </div>
</div>
