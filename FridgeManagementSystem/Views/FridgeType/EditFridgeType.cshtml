@model FridgeManagementSystem.Models.FridgeType

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Edit Fridge Type";
}

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title">@ViewData["Title"]</h5>
            </div>
            <div class="card-body">
                <form asp-action="EditFridgeType">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="FridgeTypeId" />

                    <div class="form-group mb-3">
                        <label asp-for="FridgeTypeId" class="control-label"></label>
                        <input asp-for="FridgeTypeId" class="form-control" readonly />
                        
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="Brand" class="control-label"></label>
                        <input asp-for="Brand" class="form-control" />
                        <span asp-validation-for="Brand" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Name" class="control-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Model" class="control-label"></label>
                        <input asp-for="Model" class="form-control" />
                        <span asp-validation-for="Model" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save m-1"></i>Save Changes

                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left m-1"></i>Back to List
                            
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
