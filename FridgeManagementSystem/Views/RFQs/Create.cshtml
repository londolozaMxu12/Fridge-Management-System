@* @model CreateRFQViewModel
@{
    ViewData["Title"] = "Create Request for Quotation";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Create Request for Quotation</h1>
        <a href="@Url.Action("Index", "RFQs")" class="d-none d-sm-inline-block btn btn-sm btn-secondary shadow-sm">
            <i class="fas fa-arrow-left fa-sm text-white-50"></i> Back to List
        </a>
    </div>

    <form asp-action="Create" method="post" id="rfqForm">
        <div class="row">
            <div class="col-lg-8">
                <!-- RFQ Basic Information -->
                <div class="card shadow mb-4">
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary">RFQ Information</h6>
                    </div>
                    <div class="card-body">
                        <div class="form-group">
                            <label asp-for="Title">RFQ Title *</label>
                            <input asp-for="Title" class="form-control" placeholder="Enter RFQ title" required>
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Description">Description *</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Describe the requirements..." required></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="DueDate">Due Date *</label>
                                    <input asp-for="DueDate" type="datetime-local" class="form-control" required>
                                    <span asp-validation-for="DueDate" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="RFQStatus">RFQ Status *</label>
                                    <select asp-for="RFQStatus" asp-items="Model.StatusOptions" class="form-control" required>
                                        <option value="">-- Select Status --</option>
                                    </select>
                                    <span asp-validation-for="RFQStatus" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Department">Department</label>
                                    <input asp-for="Department" class="form-control" placeholder="e.g., IT, Operations">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="BudgetCode">Budget Code</label>
                                    <input asp-for="BudgetCode" class="form-control" placeholder="Budget code if applicable">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- RFQ Items -->
                <div class="card shadow mb-4">
                    <div class="card-header py-3 d-flex justify-content-between align-items-center">
                        <h6 class="m-0 font-weight-bold text-primary">RFQ Items</h6>
                        <button type="button" class="btn btn-sm btn-primary" id="addItem">
                            <i class="fas fa-plus"></i> Add Item
                        </button>
                    </div>
                    <div class="card-body">
                        <div id="itemsContainer">
                            @for (int i = 0; i < Model.Items.Count; i++)
                            {
                                <div class="item-row row mb-3 border-bottom pb-3">
                                    <div class="col-md-4">
                                        <label>Item Description *</label>
                                        <input asp-for="Items[i].Description" class="form-control" placeholder="Item description" required>
                                        <span asp-validation-for="Items[i].Description" class="text-danger"></span>
                                    </div>
                                    <div class="col-md-2">
                                        <label>Item Code</label>
                                        <input asp-for="Items[i].ItemCode" class="form-control" placeholder="Code">
                                    </div>
                                    <div class="col-md-2">
                                        <label>Quantity *</label>
                                        <input asp-for="Items[i].Quantity" type="number" class="form-control" min="1" required>
                                        <span asp-validation-for="Items[i].Quantity" class="text-danger"></span>
                                    </div>
                                    <div class="col-md-2">
                                        <label>Unit</label>
                                        <input asp-for="Items[i].UnitOfMeasure" class="form-control" placeholder="Each, Box, etc.">
                                    </div>
                                    <div class="col-md-2">
                                        <label>Actions</label>
                                        <div>
                                            <button type="button" class="btn btn-sm btn-danger remove-item" @(Model.Items.Count == 1 ? "disabled" : "")>
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="col-12 mt-2">
                                        <label>Specifications</label>
                                        <textarea asp-for="Items[i].Specifications" class="form-control" rows="2" placeholder="Technical specifications..."></textarea>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Terms and Conditions -->
                <div class="card shadow mb-4">
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary">Terms & Conditions</h6>
                    </div>
                    <div class="card-body">
                        <div class="form-group">
                            <label asp-for="DeliveryRequirements">Delivery Requirements</label>
                            <textarea asp-for="DeliveryRequirements" class="form-control" rows="3" placeholder="Delivery timeline, location, etc."></textarea>
                        </div>
                        <div class="form-group">
                            <label asp-for="TermsAndConditions">Additional Terms & Conditions</label>
                            <textarea asp-for="TermsAndConditions" class="form-control" rows="4" placeholder="Payment terms, warranty, etc."></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <!-- Supplier Selection -->
                <div class="card shadow mb-4">
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary">Select Suppliers</h6>
                    </div>
                    <div class="card-body">
                        <div class="form-group">
                            <label>Available Suppliers</label>
                            <div style="max-height: 300px; overflow-y: auto;">
                                @if (Model.AvailableSuppliers != null && Model.AvailableSuppliers.Any())
                                {
                                    @foreach (var supplier in Model.AvailableSuppliers)
                                    {
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="SelectedSupplierIds" value="@supplier.Value" id="supplier_@supplier.Value"
                                                   @(Model.SelectedSupplierIds.Contains(int.Parse(supplier.Value)) ? "checked" : "")>
                                            <label class="form-check-label" for="supplier_@supplier.Value">
                                                @supplier.Text
                                            </label>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <p class="text-muted">No suppliers available. <a href="@Url.Action("Create", "Suppliers")">Add suppliers first</a>.</p>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Actions -->
                <div class="card shadow">
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary">Actions</h6>
                    </div>
                    <div class="card-body">
                        <button type="submit" name="action" value="save" class="btn btn-primary btn-block mb-2">
                            <i class="fas fa-save"></i> Save as Draft
                        </button>
                        <button type="submit" name="action" value="publish" class="btn btn-success btn-block mb-2">
                            <i class="fas fa-paper-plane"></i> Publish RFQ
                        </button>
                        <a href="@Url.Action("Index", "RFQs")" class="btn btn-secondary btn-block">
                            <i class="fas fa-times"></i> Cancel
                        </a>
                    </div>
                </div>

                <!-- Help Information -->
                <div class="card shadow mt-4">
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary">Help</h6>
                    </div>
                    <div class="card-body">
                        <small class="text-muted">
                            <strong>Draft:</strong> RFQ is saved but not sent to suppliers<br>
                            <strong>Published:</strong> RFQ is sent to selected suppliers<br>
                            <strong>Closed:</strong> RFQ is no longer accepting quotations
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            let itemCount = @Model.Items.Count;

            // Add new item row
            $('#addItem').click(function() {
                const newRow = `
                    <div class="item-row row mb-3 border-bottom pb-3">
                        <div class="col-md-4">
                            <label>Item Description *</label>
                            <input name="Items[${itemCount}].Description" class="form-control" placeholder="Item description" required>
                        </div>
                        <div class="col-md-2">
                            <label>Item Code</label>
                            <input name="Items[${itemCount}].ItemCode" class="form-control" placeholder="Code">
                        </div>
                        <div class="col-md-2">
                            <label>Quantity *</label>
                            <input name="Items[${itemCount}].Quantity" type="number" class="form-control" min="1" required>
                        </div>
                        <div class="col-md-2">
                            <label>Unit</label>
                            <input name="Items[${itemCount}].UnitOfMeasure" class="form-control" placeholder="Each, Box, etc.">
                        </div>
                        <div class="col-md-2">
                            <label>Actions</label>
                            <div>
                                <button type="button" class="btn btn-sm btn-danger remove-item">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-12 mt-2">
                            <label>Specifications</label>
                            <textarea name="Items[${itemCount}].Specifications" class="form-control" rows="2" placeholder="Technical specifications..."></textarea>
                        </div>
                    </div>`;
                $('#itemsContainer').append(newRow);
                itemCount++;

                // Enable remove buttons if there's more than one item
                if ($('.item-row').length > 1) {
                    $('.remove-item').prop('disabled', false);
                }
            });

            // Remove item row
            $(document).on('click', '.remove-item', function() {
                if ($('.item-row').length > 1) {
                    $(this).closest('.item-row').remove();
                    updateItemIndexes();
                }

                // Disable remove button if only one item left
                if ($('.item-row').length === 1) {
                    $('.remove-item').prop('disabled', true);
                }
            });

            function updateItemIndexes() {
                $('.item-row').each(function(index) {
                    $(this).find('input, textarea, select').each(function() {
                        const name = $(this).attr('name');
                        if (name) {
                            const newName = name.replace(/Items\[\d+\]/, `Items[${index}]`);
                            $(this).attr('name', newName);
                        }
                    });
                });
            }
        });
    </script>
}
 *@