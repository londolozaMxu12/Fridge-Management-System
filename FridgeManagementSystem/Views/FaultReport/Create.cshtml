@model FridgeManagementSystem.Models.FaultReport

@{
    ViewData["Title"] = "Create Fault Report";
}

<h2>Create Fault Report</h2>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="FridgeId"></label>
        <select asp-for="FridgeId" class="form-control" asp-items="ViewBag.FridgeId"></select>
        <span asp-validation-for="FridgeId" class="text-danger"></span>
    </div>

    @* If admin or technician can choose a customer *@
    @if (ViewBag.CustomerId != null)
    {
        <div class="form-group">
            <label asp-for="CustomerId"></label>
            <select asp-for="CustomerId" class="form-control" asp-items="ViewBag.CustomerId"></select>
            <span asp-validation-for="CustomerId" class="text-danger"></span>
        </div>
    }

    <div class="form-group">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary mt-3">Submit Report</button>
</form>

