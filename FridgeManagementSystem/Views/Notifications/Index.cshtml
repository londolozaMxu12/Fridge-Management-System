
@model IEnumerable<Notification>
@{
    //Layout = "_AdminLayout";
    
    ViewData["Title"] = "Notifications";
}
<style>
    body {
       /*  color: black; */
        background-color: skyblue;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-bell m-2"></i> @ViewData["Title"]</h1>
    @if (Model.Any(n => !n.IsRead))
    {
        <form asp-action="MarkAllAsRead" method="post">
            <button type="submit" class="btn btn-outline-primary">
                <i class="fas fa-check-double"></i> Mark All as Read
            </button>
        </form>
    }
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        <h4><i class="fas fa-bell-slash"></i> No Notifications</h4>
        <p>You don't have any notifications at the moment.</p>
    </div>
}
else
{
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">
            <i class="fas fa-list"></i> Notifications
            <span class="badge bg-light text-primary ms-2">@Model.Count() total</span>
            @if (Model.Count(n => !n.IsRead) > 0)
            {
                <span class="badge bg-warning ms-1">@Model.Count(n => !n.IsRead) unread</span>
            }
        </h5>
    </div>

    <div class="list-group list-group-flush">
        @foreach (var notification in Model.OrderByDescending(n => n.CreatedAt))
        {
            <div class="list-group-item list-group-item-action @(!notification.IsRead ? "list-group-item-primary" : "")">
                <div class="d-flex w-100 justify-content-between">
                    <h5 class="mb-1">
                        @if (!notification.IsRead)
                        {
                            <span class="badge bg-primary me-2">NEW</span>
                        }
                        @notification.Title
                    </h5>
                    <small>@notification.CreatedAt.ToString("yyyy-MM-dd HH:mm")</small>
                </div>
                <p class="mb-1">@notification.Message</p>
                <div class="d-flex justify-content-between align-items-center">
                    <small>
                        @if (!notification.IsRead)
                        {
                            <form asp-action="MarkAsRead" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@notification.Id" />
                                <button type="submit" class="btn btn-link p-0 text-decoration-none">
                                    <i class="fas fa-check"></i> Mark as read
                                </button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted"><i class="fas fa-check"></i> Read</span>
                        }
                    </small>
                    @if (!string.IsNullOrEmpty(notification.Link))
                    {
                        <a href="@notification.Link" class="btn btn-sm btn-outline-primary">
                            <i class="fas fa-eye"></i> 
                            
                        </a>
                    }
                    
                </div>
                <form asp-action="Delete" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@notification.Id" />
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to delete this notification?');">
                        <i class="fas fa-trash"></i> 
                    </button>
                </form>
            </div>
        }
    </div>
}
