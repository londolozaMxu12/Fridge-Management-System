<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fridge Management System | Purchasing Manager</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/purchasing-manager.css" asp-append-version="true" />

    <style>
        /* Fixed footer styles */
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
        }

        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        main {
            flex: 1 0 auto;
            padding-bottom: 60px;
        }

        .fixed-footer {
            flex-shrink: 0;
            background-color: #212529;
            color: white;
            padding: 1rem 0;
            margin-top: auto;
            position: relative;
            width: 100%;
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Header -->
    <header class="navbar navbar-expand-lg navbar-dark bg-info sticky-top">
        <div class="container-fluid">
            <!-- Brand -->
            <img src="~/Images/WhatsApp Image 2025-05-27 at 18.37.15_1c44df4a.jpg" height="60" width="120"
                 style="border-top-right-radius: 50rem; border-bottom-right-radius: 50rem;" />

            <!-- Mobile Toggle -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#purchasingNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Navigation -->
            <div class="collapse navbar-collapse" id="purchasingNavbar">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link active" asp-controller="Dashboard" asp-action="Index">
                            <i class="bi bi-speedometer2 me-1"></i>Dashboard
                        </a>
                    </li>

                    <!-- Purchase Requests -->
                    <li class="nav-item dropdown">
                        <a class="nav-link active dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-cart me-1"></i>Purchase Requests
                        </a>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item" asp-controller="PurchaseRequests" asp-action="Index">
                                    <i class="bi bi-list-ul me-2"></i>All Requests
                                    <span class="badge bg-primary ms-2" id="allRequestsCount">0</span>
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="PurchaseRequests" asp-action="Pending">
                                    <i class="bi bi-clock me-2"></i>Pending Requests
                                    <span class="badge bg-warning ms-2" id="pendingRequestsCount">0</span>
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="PurchaseRequests" asp-action="Approved">
                                    <i class="bi bi-check-circle me-2"></i>Approved Requests
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="PurchaseRequests" asp-action="Rejected">
                                    <i class="bi bi-x-circle me-2"></i>Rejected Requests
                                </a>
                            </li>
                        </ul>
                    </li>

                    <!-- RFQ Management -->
                    <li class="nav-item dropdown">
                        <a class="nav-link active dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-file-text me-1"></i>RFQ Management
                        </a>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item" asp-controller="RFQs" asp-action="Index">
                                    <i class="bi bi-list-ul me-2"></i>All RFQs
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="RFQs" asp-action="Create">
                                    <i class="bi bi-plus-circle me-2"></i>Create New RFQ
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item" asp-controller="RFQs" asp-action="Active">
                                    <i class="bi bi-send me-2"></i>Active RFQs
                                    <span class="badge bg-info ms-2" id="activeRFQsCount">0</span>
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="RFQs" asp-action="Expired">
                                    <i class="bi bi-clock-history me-2"></i>Expired RFQs
                                </a>
                            </li>
                        </ul>
                    </li>

                    <!-- Quotations -->
                    <li class="nav-item dropdown">
                        <a class="nav-link active dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-file-earmark-text me-1"></i>Quotations
                        </a>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item" asp-controller="Quotations" asp-action="Index">
                                    <i class="bi bi-inbox me-2"></i>Received Quotations
                                    <span class="badge bg-success ms-2" id="receivedQuotationsCount">0</span>
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="Quotations" asp-action="PendingReview">
                                    <i class="bi bi-clock me-2"></i>Pending Review
                                    <span class="badge bg-warning ms-2" id="pendingReviewCount">0</span>
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="Quotations" asp-action="Approved">
                                    <i class="bi bi-check-circle me-2"></i>Approved Quotations
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="Quotations" asp-action="Rejected">
                                    <i class="bi bi-x-circle me-2"></i>Rejected Quotations
                                </a>
                            </li>
                        </ul>
                    </li>

                    <!-- Purchase Orders -->
                    <li class="nav-item dropdown">
                        <a class="nav-link active dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-file-earmark-check me-1"></i>Purchase Orders
                        </a>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item" asp-controller="PurchaseOrders" asp-action="Index">
                                    <i class="bi bi-list-ul me-2"></i>All Purchase Orders
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="PurchaseOrders" asp-action="Create">
                                    <i class="bi bi-plus-circle me-2"></i>Create Purchase Order
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item" asp-controller="PurchaseOrders" asp-action="Pending">
                                    <i class="bi bi-clock me-2"></i>Pending Orders
                                    <span class="badge bg-warning ms-2" id="pendingOrdersCount">0</span>
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="PurchaseOrders" asp-action="Confirmed">
                                    <i class="bi bi-check-circle me-2"></i>Confirmed Orders
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="PurchaseOrders" asp-action="Delivered">
                                    <i class="bi bi-truck me-2"></i>Delivered Orders
                                </a>
                            </li>
                        </ul>
                    </li>

                    <!-- Supplier Management -->
                    <li class="nav-item dropdown">
                        <a class="nav-link active dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-people me-1"></i>Suppliers
                        </a>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item"  asp-controller="Suppliers" asp-action="Index">
                                    <i class="bi bi-list-ul me-2"></i>All Suppliers
                                </a>
                            </li>
                            @* <li>
                                <a class="dropdown-item"  asp-controller="Suppliers" asp-action="Create">
                                    <i class="bi bi-person-plus me-2"></i>Add New Supplier
                                </a>
                            </li> *@
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item" asp-controller="Suppliers" asp-action="Active">
                                    <i class="bi bi-check-circle me-2"></i>Active Suppliers
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="Suppliers" asp-action="Suspended">
                                    <i class="bi bi-pause-circle me-2"></i>Suspended Suppliers
                                </a>
                            </li>
                        </ul>
                    </li>

                    <!-- Reports -->
                    <li class="nav-item dropdown">
                        <a class="nav-link active dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-graph-up me-1"></i>Reports
                        </a>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item" asp-controller="Reports" asp-action="Procurement">
                                    <i class="bi bi-bar-chart me-2"></i>Procurement Analytics
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="Reports" asp-action="SupplierPerformance">
                                    <i class="bi bi-star me-2"></i>Supplier Performance
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="Reports" asp-action="PurchaseHistory">
                                    <i class="bi bi-clock-history me-2"></i>Purchase History
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="Reports" asp-action="CostAnalysis">
                                    <i class="bi bi-currency-dollar me-2"></i>Cost Analysis
                                </a>
                            </li>
                        </ul>
                    </li>
                </ul>

                <!-- User Menu -->
                <ul class="navbar-nav">
                    <partial name="_LoginPartial" />
                </ul>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="container-fluid px-0">
        <!-- Alert Container -->
        <div id="alertContainer" class="position-fixed top-0 end-0 p-3" style="z-index: 1050; margin-top: 80px;">
            <!-- Alerts will be inserted here dynamically -->
        </div>

        <!-- Notifications Panel -->
        <div id="notificationsPanel" class="position-fixed end-0 top-0 mt-5 me-3" style="z-index: 1045; display: none; width: 400px;">
            <div class="card shadow-lg">
                <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                    <h6 class="mb-0"><i class="bi bi-bell-fill me-2"></i>Purchasing Notifications</h6>
                    <button type="button" class="btn-close btn-close-white" id="closeNotifications"></button>
                </div>
                <div class="card-body p-0">
                    <div id="notificationList" style="max-height: 400px; overflow-y: auto;">
                        <!-- Notifications will be loaded here -->
                    </div>
                </div>
                <div class="card-footer text-center">
                    <a href="#" class="btn btn-sm btn-outline-info">View All Notifications</a>
                </div>
            </div>
        </div>

        <!-- Page Header -->
        <div class="bg-light border-bottom py-3 mb-4">
            <div class="container-fluid">
                <div class="row align-items-center">
                    <div class="col">
                        
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb mb-0">
                                <li class="breadcrumb-item"><a asp-area="PurchasingManager" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                                @if (ViewData["Breadcrumb"] != null)
                                {
                                    @Html.Raw(ViewData["Breadcrumb"])
                                }
                                <li class="breadcrumb-item active">@ViewData["Title"]</li>
                            </ol>
                        </nav>
                    </div>
                    <div class="col-auto">
                        @RenderSection("HeaderActions", required: false)
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Stats Bar -->
        <div class="container-fluid mb-4">
            <div class="row g-3" id="quickStats">
                <!-- Quick stats will be loaded dynamically -->
            </div>
        </div>

        <!-- Content -->
        <div class="container-fluid">
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-dark text-light mt-5">
        <div class="container-fluid py-3">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h6 class="fw-bold mb-0">
                        <i class="bi bi-cart-check me-2"></i>Purchasing Management
                    </h6>
                    <p class="mb-0 small text-muted">Streamlining procurement operations and supplier communications</p>
                </div>
                <div class="col-md-4 text-md-end">
                    <p class="mb-0 small">
                        <i class="bi bi-circle-fill text-success me-1"></i> System Online |
                        <span id="totalSuppliers">0</span> Active Suppliers
                    </p>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/purchasing-manager.js" asp-append-version="true"></script>

    <!-- Purchasing Manager JavaScript -->
    <script>
        // Theme Toggle
        document.getElementById('themeToggle')?.addEventListener('click', function() {
            const currentTheme = document.documentElement.getAttribute('data-bs-theme');
            const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-bs-theme', newTheme);
            localStorage.setItem('purchasingTheme', newTheme);
        });

        // Notifications Toggle
        document.getElementById('notificationsToggle')?.addEventListener('click', function(e) {
            e.preventDefault();
            const panel = document.getElementById('notificationsPanel');
            panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
        });

        document.getElementById('closeNotifications')?.addEventListener('click', function() {
            document.getElementById('notificationsPanel').style.display = 'none';
        });

        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            

            // Load quick stats
            loadQuickStats();

            // Load notifications
            loadNotifications();

            // Load counts
            loadCounts();

            // Start real-time updates
            startRealTimeUpdates();
        });

        async function loadUserData() {
            try {
                const user = {
                    name: 'Purchasing Manager',
                    fullName: '@User.Identity?.Name' || 'Purchasing Officer',
                    managerId: 'PM-' + Math.floor(1000 + Math.random() * 9000)
                };

                document.getElementById('userName').textContent = user.name;
                document.getElementById('userFullName').textContent = user.fullName;
                document.getElementById('managerId').textContent = 'Manager ID: ' + user.managerId;
            } catch (error) {
                console.error('Failed to load user data:', error);
            }
        }

        async function loadQuickStats() {
            try {
                const response = await fetch('/PurchasingManager/Dashboard/GetQuickStats');
                if (response.ok) {
                    const stats = await response.json();
                    updateQuickStats(stats);
                }
            } catch (error) {
                console.error('Failed to load quick stats:', error);
            }
        }

        function updateQuickStats(stats) {
            const quickStatsHTML = `
                <div class="col-xl-2 col-md-4 col-sm-6">
                    <div class="card quick-stat-card bg-warning text-dark">
                        <div class="card-body py-3">
                            <div class="d-flex align-items-center">
                                <div class="flex-grow-1">
                                    <h4 class="mb-0">${stats.pendingRequests || 0}</h4>
                                    <small>Pending Requests</small>
                                </div>
                                <div class="flex-shrink-0">
                                    <i class="bi bi-cart fs-2 opacity-50"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-2 col-md-4 col-sm-6">
                    <div class="card quick-stat-card bg-info text-white">
                        <div class="card-body py-3">
                            <div class="d-flex align-items-center">
                                <div class="flex-grow-1">
                                    <h4 class="mb-0">${stats.activeRFQs || 0}</h4>
                                    <small>Active RFQs</small>
                                </div>
                                <div class="flex-shrink-0">
                                    <i class="bi bi-file-text fs-2 opacity-50"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-2 col-md-4 col-sm-6">
                    <div class="card quick-stat-card bg-success text-white">
                        <div class="card-body py-3">
                            <div class="d-flex align-items-center">
                                <div class="flex-grow-1">
                                    <h4 class="mb-0">${stats.pendingQuotations || 0}</h4>
                                    <small>Pending Quotes</small>
                                </div>
                                <div class="flex-shrink-0">
                                    <i class="bi bi-file-earmark-text fs-2 opacity-50"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-2 col-md-4 col-sm-6">
                    <div class="card quick-stat-card bg-primary text-white">
                        <div class="card-body py-3">
                            <div class="d-flex align-items-center">
                                <div class="flex-grow-1">
                                    <h4 class="mb-0">${stats.pendingOrders || 0}</h4>
                                    <small>Pending Orders</small>
                                </div>
                                <div class="flex-shrink-0">
                                    <i class="bi bi-file-earmark-check fs-2 opacity-50"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-2 col-md-4 col-sm-6">
                    <div class="card quick-stat-card bg-secondary text-white">
                        <div class="card-body py-3">
                            <div class="d-flex align-items-center">
                                <div class="flex-grow-1">
                                    <h4 class="mb-0">${stats.totalSuppliers || 0}</h4>
                                    <small>Total Suppliers</small>
                                </div>
                                <div class="flex-shrink-0">
                                    <i class="bi bi-people fs-2 opacity-50"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-2 col-md-4 col-sm-6">
                    <div class="card quick-stat-card bg-danger text-white">
                        <div class="card-body py-3">
                            <div class="d-flex align-items-center">
                                <div class="flex-grow-1">
                                    <h4 class="mb-0">${stats.urgentRequests || 0}</h4>
                                    <small>Urgent Requests</small>
                                </div>
                                <div class="flex-shrink-0">
                                    <i class="bi bi-exclamation-triangle fs-2 opacity-50"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            `;

            document.getElementById('quickStats').innerHTML = quickStatsHTML;
        }

        async function loadCounts() {
            try {
                const response = await fetch('/PurchasingManager/Dashboard/GetCounts');
                if (response.ok) {
                    const counts = await response.json();
                    updateCounts(counts);
                }
            } catch (error) {
                console.error('Failed to load counts:', error);
            }
        }

        function updateCounts(counts) {
            document.getElementById('pendingRequestsCount').textContent = counts.pendingRequests || 0;
            document.getElementById('activeRFQsCount').textContent = counts.activeRFQs || 0;
            document.getElementById('receivedQuotationsCount').textContent = counts.receivedQuotations || 0;
            document.getElementById('pendingReviewCount').textContent = counts.pendingReview || 0;
            document.getElementById('pendingOrdersCount').textContent = counts.pendingOrders || 0;
            document.getElementById('totalSuppliers').textContent = counts.totalSuppliers || 0;
        }

        function startRealTimeUpdates() {
            setInterval(() => {
                loadCounts();
                loadNotifications();
            }, 30000);
        }

        // Global function to show alerts
        function showAlert(message, type = 'info') {
            const alertContainer = document.getElementById('alertContainer');
            const alertId = 'alert-' + Date.now();

            const alertHTML = `
                <div id="${alertId}" class="alert alert-${type} alert-dismissible fade show" role="alert">
                    <i class="bi bi-${getAlertIcon(type)} me-2"></i>
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `;

            alertContainer.insertAdjacentHTML('beforeend', alertHTML);

            setTimeout(() => {
                const alert = document.getElementById(alertId);
                if (alert) {
                    alert.remove();
                }
            }, 5000);
        }

        function getAlertIcon(type) {
            const icons = {
                'success': 'check-circle-fill',
                'danger': 'exclamation-triangle-fill',
                'warning': 'exclamation-triangle-fill',
                'info': 'info-circle-fill'
            };
            return icons[type] || 'info-circle-fill';
        }

        
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>