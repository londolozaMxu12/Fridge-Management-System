<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fridge Management System | Fault Technician</title>

    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.css">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/fault-technician.css" asp-append-version="true" />

    <style>
        /* Fixed footer styles */
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
        }

        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        main {
            flex: 1 0 auto;
            padding-bottom: 60px; /* Space for footer */
        }

        .fixed-footer {
            flex-shrink: 0;
            background-color: #212529;
            color: white;
            padding: 1rem 0;
            margin-top: auto;
            position: relative;
            width: 100%;
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Header -->
    <header class="navbar navbar-expand-lg navbar-dark bg-secondary sticky-top">
        <div class="container-fluid">
            <!-- Brand -->
            
            <a class="navbar-brand d-flex align-items-center" asp-area="FaultTechnician" asp-controller="Dashboard" asp-action="Index">
                <div class="d-flex flex-column align-items-center">
                    <img src="~/Images/WhatsApp Image 2025-05-27 at 18.37.15_1c44df4a.jpg" height="50" width="100" />
                    <span class="fw-bold mt-1" style="color: #001f3f; font-size: 0.9rem;">NM DESIGN HUB</span>
                </div>
            </a>
            

            <!-- Mobile Toggle -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#faultTechNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Navigation -->
            <div class="collapse navbar-collapse" id="faultTechNavbar">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="FaultTechnician" asp-controller="Dashboard" asp-action="Index">
                            <i class="bi bi-speedometer2 me-1"></i>Dashboard
                        </a>
                    </li>

                    <!-- Fault Management -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-exclamation-triangle me-1"></i>Fault Management
                        </a>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item" asp-area="FaultTechnician" asp-controller="Faults" asp-action="Index">
                                    <i class="bi bi-list-ul me-2"></i>All Fault Reports
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-area="FaultTechnician" asp-controller="Faults" asp-action="Pending">
                                    <i class="bi bi-clock me-2"></i>Pending Faults
                                    <span class="badge bg-danger ms-2" id="pendingFaultsCount">0</span>
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-area="FaultTechnician" asp-controller="Faults" asp-action="Assigned">
                                    <i class="bi bi-person-check me-2"></i>My Assigned Faults
                                    <span class="badge bg-primary ms-2" id="assignedFaultsCount">0</span>
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item" asp-area="FaultTechnician" asp-controller="Faults" asp-action="Urgent">
                                    <i class="bi bi-exclamation-circle me-2"></i>Urgent Faults
                                    <span class="badge bg-danger ms-2" id="urgentFaultsCount">0</span>
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-area="FaultTechnician" asp-controller="Faults" asp-action="InProgress">
                                    <i class="bi bi-gear me-2"></i>Repairs in Progress
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-area="FaultTechnician" asp-controller="Faults" asp-action="Completed">
                                    <i class="bi bi-check-circle me-2"></i>Completed Faults
                                </a>
                            </li>
                        </ul>
                    </li>

                    <!-- Repair Scheduling -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-calendar-event me-1"></i>Repair Schedule
                        </a>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item" asp-area="FaultTechnician" asp-controller="Repairs" asp-action="Schedule">
                                    <i class="bi bi-calendar-week me-2"></i>My Schedule
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-area="FaultTechnician" asp-controller="Repairs" asp-action="Calendar">
                                    <i class="bi bi-calendar-date me-2"></i>Calendar View
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item" asp-area="FaultTechnician" asp-controller="Repairs" asp-action="Today">
                                    <i class="bi bi-calendar-day me-2"></i>Today's Repairs
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-area="FaultTechnician" asp-controller="Repairs" asp-action="Upcoming">
                                    <i class="bi bi-calendar-plus me-2"></i>Upcoming Repairs
                                </a>
                            </li>
                        </ul>
                    </li>

                    <!-- Reports -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-graph-up me-1"></i>Reports
                        </a>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item" asp-area="FaultTechnician" asp-controller="Reports" asp-action="Performance">
                                    <i class="bi bi-speedometer me-2"></i>My Performance
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-area="FaultTechnician" asp-controller="Reports" asp-action="FaultAnalysis">
                                    <i class="bi bi-bar-chart me-2"></i>Fault Analysis
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-area="FaultTechnician" asp-controller="Reports" asp-action="RepairHistory">
                                    <i class="bi bi-clock-history me-2"></i>Repair History
                                </a>
                            </li>
                        </ul>
                    </li>

                    <!-- Customer Communication -->
                    <li class="nav-item">
                        <a class="nav-link" asp-area="FaultTechnician" asp-controller="Communication" asp-action="Index">
                            <i class="bi bi-chat-dots me-1"></i>Customer Comms
                            <span class="badge bg-success ms-1" id="unreadMessagesCount">0</span>
                        </a>
                    </li>
                </ul>


                <!-- User Menu -->
                <ul class="navbar-nav">
                    <partial name="_LoginPartial" />
                </ul>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="container-fluid px-0">
        <!-- Alert Container -->
        <div id="alertContainer" class="position-fixed top-0 end-0 p-3" style="z-index: 1050; margin-top: 80px;">
            <!-- Alerts will be inserted here dynamically -->
        </div>

        <!-- Notifications Panel -->
        <div id="notificationsPanel" class="position-fixed end-0 top-0 mt-5 me-3" style="z-index: 1045; display: none; width: 400px;">
            <div class="card shadow-lg">
                <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
                    <h6 class="mb-0"><i class="bi bi-bell-fill me-2"></i>Technician Notifications</h6>
                    <button type="button" class="btn-close" id="closeNotifications"></button>
                </div>
                <div class="card-body p-0">
                    <div id="notificationList" style="max-height: 400px; overflow-y: auto;">
                        <!-- Notifications will be loaded here -->
                    </div>
                </div>
                <div class="card-footer text-center">
                    <a href="#" class="btn btn-sm btn-outline-warning">View All Notifications</a>
                </div>
            </div>
        </div>

        <!-- Page Header -->
        <div class="bg-light border-bottom py-3 mb-4">
            <div class="container-fluid">
                <div class="row align-items-center">
                    <div class="col">
                        <h1 class="h3 mb-0">
                            <i class="bi @ViewData["PageIcon"] me-2 text-warning"></i>@ViewData["Title"]
                        </h1>
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb mb-0">
                                <li class="breadcrumb-item"><a asp-area="FaultTechnician" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                                @if (ViewData["Breadcrumb"] != null)
                                {
                                    @Html.Raw(ViewData["Breadcrumb"])
                                }
                                <li class="breadcrumb-item active">@ViewData["Title"]</li>
                            </ol>
                        </nav>
                    </div>
                    <div class="col-auto">
                        @RenderSection("HeaderActions", required: false)

                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Stats Bar -->
        <div class="container-fluid mb-4">
            <div class="row g-3" id="quickStats">
                <!-- Quick stats will be loaded dynamically -->
            </div>
        </div>

        <!-- Content -->
        <div class="container-fluid">
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-dark text-light mt-5">
        <div class="container-fluid py-3">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h6 class="fw-bold mb-0">
                        <i class="bi bi-tools me-2"></i>Fridge Fault System - Technician Portal
                    </h6>
                    <p class="mb-0 small text-muted">Efficient fault resolution and fridge repairs</p>
                </div>
                <div class="col-md-4 text-md-end">
                    <p class="mb-0 small">
                        <i class="bi bi-circle-fill text-success me-1"></i> System Online |
                        <span id="activeFaults">0</span> Active Faults
                    </p>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/fault-technician.js" asp-append-version="true"></script>

    <!-- Fault Technician JavaScript -->
    <script>
        // Theme Toggle
        document.getElementById('themeToggle')?.addEventListener('click', function() {
            const currentTheme = document.documentElement.getAttribute('data-bs-theme');
            const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-bs-theme', newTheme);
            localStorage.setItem('faultTechTheme', newTheme);
        });

        // Notifications Toggle
        document.getElementById('notificationsToggle')?.addEventListener('click', function(e) {
            e.preventDefault();
            const panel = document.getElementById('notificationsPanel');
            panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
        });

        document.getElementById('closeNotifications')?.addEventListener('click', function() {
            document.getElementById('notificationsPanel').style.display = 'none';
        });

        // Status Management
        document.querySelectorAll('[data-status]').forEach(item => {
            item.addEventListener('click', function(e) {
                e.preventDefault();
                const status = this.getAttribute('data-status');
                updateTechnicianStatus(status);
            });
        });

        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            // Load theme
            const savedTheme = localStorage.getItem('faultTechTheme') || 'light';
            document.documentElement.setAttribute('data-bs-theme', savedTheme);

            // Load user data
            loadUserData();

            // Load quick stats
            loadQuickStats();

            // Load notifications
            loadNotifications();

            // Load counts
            loadCounts();

            // Initialize status
            loadTechnicianStatus();

            // Start real-time updates
            startRealTimeUpdates();
        });

        async function loadUserData() {
            try {
                // This would typically come from your backend
                const user = {
                    name: 'Fault Technician',
                    fullName: '@User.Identity?.Name' || 'Technician Officer',
                    technicianId: 'FT-' + Math.floor(1000 + Math.random() * 9000)
                };

                document.getElementById('userName').textContent = user.name;
                document.getElementById('userFullName').textContent = user.fullName;
                document.getElementById('technicianId').textContent = 'Technician ID: ' + user.technicianId;
            } catch (error) {
                console.error('Failed to load user data:', error);
            }
        }

        async function loadQuickStats() {
            try {
                const response = await fetch('/FaultTechnician/Dashboard/GetQuickStats');
                if (response.ok) {
                    const stats = await response.json();
                    updateQuickStats(stats);
                }
            } catch (error) {
                console.error('Failed to load quick stats:', error);
            }
        }

        function updateQuickStats(stats) {
            const quickStatsHTML = `
                <div class="col-xl-3 col-md-6">
                    <div class="card quick-stat-card bg-warning text-dark">
                        <div class="card-body py-3">
                            <div class="d-flex align-items-center">
                                <div class="flex-grow-1">
                                    <h4 class="mb-0">${stats.assignedFaults || 0}</h4>
                                    <small>My Assigned Faults</small>
                                </div>
                                <div class="flex-shrink-0">
                                    <i class="bi bi-person-check fs-2 opacity-50"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6">
                    <div class="card quick-stat-card bg-danger text-white">
                        <div class="card-body py-3">
                            <div class="d-flex align-items-center">
                                <div class="flex-grow-1">
                                    <h4 class="mb-0">${stats.urgentFaults || 0}</h4>
                                    <small>Urgent Faults</small>
                                </div>
                                <div class="flex-shrink-0">
                                    <i class="bi bi-exclamation-triangle fs-2 opacity-50"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6">
                    <div class="card quick-stat-card bg-success text-white">
                        <div class="card-body py-3">
                            <div class="d-flex align-items-center">
                                <div class="flex-grow-1">
                                    <h4 class="mb-0">${stats.completedToday || 0}</h4>
                                    <small>Completed Today</small>
                                </div>
                                <div class="flex-shrink-0">
                                    <i class="bi bi-check-circle fs-2 opacity-50"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6">
                    <div class="card quick-stat-card bg-info text-white">
                        <div class="card-body py-3">
                            <div class="d-flex align-items-center">
                                <div class="flex-grow-1">
                                    <h4 class="mb-0">${stats.pendingRequests || 0}</h4>
                                    <small>Fridge Requests</small>
                                </div>
                                <div class="flex-shrink-0">
                                    <i class="bi bi-refrigerator fs-2 opacity-50"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            `;

            document.getElementById('quickStats').innerHTML = quickStatsHTML;
        }

        async function loadCounts() {
            try {
                const response = await fetch('/FaultTechnician/Dashboard/GetCounts');
                if (response.ok) {
                    const counts = await response.json();
                    updateCounts(counts);
                }
            } catch (error) {
                console.error('Failed to load counts:', error);
            }
        }

        function updateCounts(counts) {
            document.getElementById('pendingFaultsCount').textContent = counts.pendingFaults || 0;
            document.getElementById('assignedFaultsCount').textContent = counts.assignedFaults || 0;
            document.getElementById('urgentFaultsCount').textContent = counts.urgentFaults || 0;
            document.getElementById('pendingRequestsCount').textContent = counts.pendingRequests || 0;
            document.getElementById('activeFaults').textContent = counts.activeFaults || 0;
        }

        async function loadTechnicianStatus() {
            try {
                const response = await fetch('/FaultTechnician/Profile/GetStatus');
                if (response.ok) {
                    const status = await response.json();
                    updateStatusDisplay(status);
                }
            } catch (error) {
                console.error('Failed to load technician status:', error);
            }
        }

        function updateStatusDisplay(status) {
            const statusIcon = document.getElementById('statusIcon');
            const statusText = document.getElementById('statusText');

            const statusConfig = {
                'available': { class: 'text-success', text: 'Available' },
                'busy': { class: 'text-warning', text: 'Busy - On Repair' },
                'offline': { class: 'text-secondary', text: 'Offline' },
                'break': { class: 'text-info', text: 'On Break' }
            };

            const config = statusConfig[status] || statusConfig.available;
            statusIcon.className = `bi bi-circle-fill me-1 ${config.class}`;
            statusText.textContent = config.text;
        }

        async function updateTechnicianStatus(newStatus) {
            try {
                const response = await fetch('/FaultTechnician/Profile/UpdateStatus', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ status: newStatus })
                });

                if (response.ok) {
                    updateStatusDisplay(newStatus);
                    showAlert(`Status updated to: ${newStatus}`, 'success');
                }
            } catch (error) {
                console.error('Failed to update status:', error);
                showAlert('Failed to update status', 'danger');
            }
        }

        function startRealTimeUpdates() {
            // Set up real-time updates for faults and notifications
            setInterval(() => {
                loadCounts();
                loadNotifications();
                checkEmergencyAlerts();
            }, 15000); // Update every 15 seconds
        }

        async function checkEmergencyAlerts() {
            try {
                const response = await fetch('/FaultTechnician/Dashboard/GetEmergencyAlerts');
                if (response.ok) {
                    const alerts = await response.json();
                    if (alerts.length > 0) {
                        showEmergencyAlert(alerts[0]);
                    }
                }
            } catch (error) {
                console.error('Failed to check emergency alerts:', error);
            }
        }

        function showEmergencyAlert(alert) {
            const emergencyAlert = document.getElementById('emergencyAlert');
            const emergencyMessage = document.getElementById('emergencyMessage');
            const viewEmergencyBtn = document.getElementById('viewEmergencyBtn');

            emergencyMessage.textContent = alert.message;
            viewEmergencyBtn.href = alert.url;
            emergencyAlert.classList.remove('d-none');
        }

        // Quick Actions
        document.getElementById('quickAssignFault')?.addEventListener('click', function(e) {
            e.preventDefault();
            showQuickAssignModal();
        });

        document.getElementById('startDiagnosis')?.addEventListener('click', function(e) {
            e.preventDefault();
            showStartDiagnosisModal();
        });

        document.getElementById('scheduleRepair')?.addEventListener('click', function(e) {
            e.preventDefault();
            showScheduleRepairModal();
        });

        document.getElementById('updateFridgeCondition')?.addEventListener('click', function(e) {
            e.preventDefault();
            showUpdateConditionModal();
        });

        document.getElementById('completeRepair')?.addEventListener('click', function(e) {
            e.preventDefault();
            showCompleteRepairModal();
        });

        // Global function to show alerts
        function showAlert(message, type = 'info') {
            const alertContainer = document.getElementById('alertContainer');
            const alertId = 'alert-' + Date.now();

            const alertHTML = `
                <div id="${alertId}" class="alert alert-${type} alert-dismissible fade show" role="alert">
                    <i class="bi bi-${getAlertIcon(type)} me-2"></i>
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `;

            alertContainer.insertAdjacentHTML('beforeend', alertHTML);

            // Auto remove after 5 seconds
            setTimeout(() => {
                const alert = document.getElementById(alertId);
                if (alert) {
                    alert.remove();
                }
            }, 5000);
        }

        function getAlertIcon(type) {
            const icons = {
                'success': 'check-circle-fill',
                'danger': 'exclamation-triangle-fill',
                'warning': 'exclamation-triangle-fill',
                'info': 'info-circle-fill'
            };
            return icons[type] || 'info-circle-fill';
        }

        // Modal functions for quick actions
        function showQuickAssignModal() {
            // Implementation for quick fault assignment
            window.location.href = '/FaultTechnician/Faults/Pending';
        }

        function showStartDiagnosisModal() {
            // Implementation for starting diagnosis
            const faultId = prompt('Enter Fault ID to diagnose:');
            if (faultId) {
                window.location.href = `/FaultTechnician/Faults/Diagnose/${faultId}`;
            }
        }

        function showScheduleRepairModal() {
            // Implementation for scheduling repair
            const faultId = prompt('Enter Fault ID to schedule repair:');
            if (faultId) {
                window.location.href = `/FaultTechnician/Repairs/Schedule/${faultId}`;
            }
        }

        function showUpdateConditionModal() {
            // Implementation for updating fridge condition
            const fridgeId = prompt('Enter Fridge ID to update condition:');
            if (fridgeId) {
                window.location.href = `/FaultTechnician/Fridges/UpdateCondition/${fridgeId}`;
            }
        }

        function showCompleteRepairModal() {
            // Implementation for completing repair
            const repairId = prompt('Enter Repair ID to complete:');
            if (repairId) {
                window.location.href = `/FaultTechnician/Repairs/Complete/${repairId}`;
            }
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
