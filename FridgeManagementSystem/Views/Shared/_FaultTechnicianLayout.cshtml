<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fridge Management System | Fault Technician</title>

    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/fault-technician.css" asp-append-version="true" />

    <style>
        /* Fixed footer styles */
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
        }

        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            background-color:darkslateblue;
        }

        main {
            flex: 1 0 auto;
            padding-bottom: 60px; /* Space for footer */
        }

        .fixed-footer {
            flex-shrink: 0;
            background-color: #212529;
            color: white;
            padding: 1rem 0;
            margin-top: auto;
            position: relative;
            width: 100%;
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Header -->
    <header class="navbar navbar-expand-lg navbar-dark bg-secondary sticky-top">
        <div class="container-fluid">
            <!-- Brand -->
            
            <a class="navbar-brand d-flex align-items-center" asp-area="FaultTechnician" asp-controller="FaultTechnician" asp-action="Index">
                <div class="d-flex flex-column align-items-center">
                    <img src="~/Images/WhatsApp Image 2025-05-27 at 18.37.15_1c44df4a.jpg" height="50" width="100" />
                    <span class="fw-bold mt-1" style="color: #001f3f; font-size: 0.9rem;">NM DESIGN HUB</span>
                </div>
            </a>
            

            <!-- Mobile Toggle -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#faultTechNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Navigation -->
            <div class="collapse navbar-collapse" id="faultTechNavbar">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="FaultTechnician" asp-controller="FaultTechnician" asp-action="Index">
                            <i class="bi bi-speedometer2 me-1"></i>Dashboard
                        </a>
                    </li>

                    <!-- Fault Management -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-exclamation-triangle me-1"></i>Fault Management
                        </a>

                        <ul class="dropdown-menu">
                            
                            <li>
                                <a class="dropdown-item" asp-area="FaultTechnician" asp-controller="FaultTechnician"
                                   asp-action="Index">
                                    <i class="bi bi-list-ul me-2"></i>All Fault Reports
                                    <span class="badge bg-primary">@ViewBag.TotalFaultsCount</span>
                                </a>
                            </li>
                            
                            <li>
                                <a class="dropdown-item" asp-area="FaultTechnician" asp-action="Index" asp-route-status="Reported">
                                    <i class="bi bi-clock me-2 "></i>Reported Faults
                                     <span class="badge bg-warning text-dark">@ViewBag.PendingFaultsCount</span>
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item" asp-area="FaultTechnician" asp-action="Index" asp-route-status="Urgent">
                                    <i class="bi bi-exclamation-circle me-2 "></i>Urgent Faults
                                    <span class="badge bg-danger">@ViewBag.UrgentFaultsCount</span>
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-area="FaultTechnician" asp-action="Index" asp-route-status="InProgress">
                                    <i class="bi bi-gear me-2 "></i>Repairs in Progress
                                    <span class="badge bg-info text-dark">@ViewBag.InProgressFaultsCount</span>
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-area="FaultTechnician" asp-action="Index" asp-route-status="Completed">
                                    <i class="bi bi-check-circle me-2 "></i>Completed Faults
                                    <span class="badge bg-success">@ViewBag.CompletedFaultsCount</span>
                                </a>
                            </li>
                        </ul>
                    </li>

                    <!-- Repair Scheduling -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-calendar-event me-1"></i>Repair Schedule
                        </a>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item" asp-area="FaultTechnician" asp-controller="FaultTechnician" asp-action="MySchedule">
                                    <i class="bi bi-calendar-week me-2"></i>My Schedule
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-area="FaultTechnician" asp-controller="FaultTechnician" asp-action="UpdateSchedule">
                                    <i class="bi bi-calendar-date me-2"></i>Update Schedule
                                </a>
                            </li>
                            
                        </ul>
                    </li>

                    <!-- Reports -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-graph-up me-1"></i>Reports
                        </a>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item" asp-area="FaultTechnician" asp-controller="Reports" asp-action="Performance">
                                    <i class="bi bi-speedometer me-2"></i>My Performance
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-area="FaultTechnician" asp-controller="Reports" asp-action="FaultAnalysis">
                                    <i class="bi bi-bar-chart me-2"></i>Fault Analysis
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-area="FaultTechnician" asp-controller="Reports" asp-action="RepairHistory">
                                    <i class="bi bi-clock-history me-2"></i>Repair History
                                </a>
                            </li>
                        </ul>
                    </li>

                    <!-- For Communications -->
                    <li class="nav-item">
                        <a class="nav-link" style="white-space:nowrap" href="#" data-bs-toggle="modal" data-bs-target="#notificationsModal">
                            <i class="bi bi-bell me-1"></i>
                            <span class="d-none d-sm-inline ms-2">Notifications</span>
                            @await Component.InvokeAsync("Notifications")
                        </a>
                    </li>


                </ul>


                <!-- User Menu -->
                <ul class="navbar-nav">
                    <partial name="_LoginPartial" />
                </ul>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="container-fluid px-0">
        <!-- Alert Container -->
        <div id="alertContainer" class="position-fixed top-0 end-0 p-3" style="z-index: 1050; margin-top: 80px;">
            <!-- Alerts will be inserted here dynamically -->
        </div>

        <!-- Page Header -->
        <div class="bg-light border-bottom py-3 mb-4">
            <div class="container-fluid">
                <div class="row align-items-center">
                    <div class="col">
                        
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb mb-0">
                                <li class="breadcrumb-item"><a asp-area="FaultTechnician" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                                @if (ViewData["Breadcrumb"] != null)
                                {
                                    @Html.Raw(ViewData["Breadcrumb"])
                                }
                                <li class="breadcrumb-item active">@ViewData["Title"]</li>
                            </ol>
                        </nav>
                    </div>
                    <div class="col-auto">
                        @RenderSection("HeaderActions", required: false)

                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Stats Bar -->
        <div class="container-fluid mb-4">
            <div class="row g-3" id="quickStats">
                <!-- Quick stats will be loaded dynamically -->
            </div>
        </div>

        <!-- Content -->
        <div class="container-fluid">
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-dark text-light mt-5">
        <div class="container-fluid py-3">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h6 class="fw-bold mb-0">
                        <i class="bi bi-tools me-2"></i>Fridge Fault System - Technician Portal
                    </h6>
                    <p class="mb-0 small text-muted">Efficient fault resolution and fridge repairs</p>

                </div>
                
            </div>
            <hr class="my-3">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <p class="mb-0">&copy; 2025 Fridge Management System. All rights reserved.</p>
                </div>

            </div>
        </div>
    </footer>

    <!-- Notifications Modal -->
    <div class="modal fade" id="notificationsModal" tabindex="-1"
         aria-labelledby="notificationsModalLabel" aria-hidden="true"
         data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="notificationsModalLabel">
                        <i class="fas fa-bell me-2"></i> Notifications
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="notificationsModalBody">
                    <div class="text-center py-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading notifications...</span>
                        </div>
                        <p class="mt-2 text-muted">Loading notifications...</p>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <form id="markAllAsReadForm" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-primary" id="markAllAsReadBtn" disabled>
                            <i class="fas fa-check-double me-1"></i> Mark All as Read
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/fault-technician.js" asp-append-version="true"></script>

    <script>

        document.addEventListener('DOMContentLoaded', function() {
            // Load notifications when modal is shown
            const notificationsModal = document.getElementById('notificationsModal');
            if (notificationsModal) {
                notificationsModal.addEventListener('show.bs.modal', function () {
                    console.log('Modal opened - loading notifications');
                    loadNotifications();
                });
            }

            // Initialize mark all as read form
            const markAllForm = document.getElementById('markAllAsReadForm');
            if (markAllForm) {
                markAllForm.addEventListener('submit', function (e) {
                    e.preventDefault();
                    handleMarkAllAsRead();
                });
            }
        });

        // Function to load notifications via AJAX
        function loadNotifications() {
            console.log('Loading notifications...');
            fetch('@Url.Action("GetNotificationsPartial", "Notifications")')
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    }
                    return response.text();
                })
                .then(data => {
                    console.log('Notifications loaded successfully');
                    document.getElementById('notificationsModalBody').innerHTML = data;
                    updateMarkAllButton();
                    // Re-attach event listeners for dynamic content
                    attachNotificationEventListeners();
                })
                .catch(error => {
                    console.error('Error loading notifications:', error);
                    document.getElementById('notificationsModalBody').innerHTML =
                        '<div class="alert alert-danger">Error loading notifications. Please try again.</div>';
                });
        }

        // Update Mark All as Read button state
        function updateMarkAllButton() {
            const hasUnread = document.querySelectorAll('.notification-unread').length > 0;
            const markAllBtn = document.getElementById('markAllAsReadBtn');
            if (markAllBtn) {
                markAllBtn.disabled = !hasUnread;
            }
        }

        // Handle Mark All as Read
        function handleMarkAllAsRead() {
            console.log('Marking all as read...');
            fetch('@Url.Action("MarkAllAsRead", "Notifications")', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': document.querySelector('#markAllAsReadForm input[name="__RequestVerificationToken"]').value,
                    'Content-Type': 'application/x-www-form-urlencoded',
                }
            })
            .then(response => {
                if (response.ok) {
                    console.log('All marked as read successfully');
                    loadNotifications(); // Reload notifications
                    updateNotificationBadge(0); // Update badge to zero
                }
            })
            .catch(error => console.error('Error:', error));
        }

        // Function to update notification badge
        function updateNotificationBadge(count) {
            const badge = document.querySelector('.notification-badge');
            if (badge) {
                if (count > 0) {
                    badge.textContent = count;
                    badge.style.display = 'inline';
                } else {
                    badge.style.display = 'none';
                }
            }
        }

        // Get current badge count
        function getCurrentBadgeCount() {
            const badge = document.querySelector('.notification-badge');
            return badge ? parseInt(badge.textContent) || 0 : 0;
        }

        // Attach event listeners for notification actions
        function attachNotificationEventListeners() {
            // Mark single notification as read
            document.querySelectorAll('.mark-as-read-btn').forEach(button => {
                button.addEventListener('click', function (e) {
                    e.preventDefault();
                    const form = this.closest('form');
                    const notificationId = form.querySelector('input[name="id"]').value;
                    markNotificationAsRead(notificationId);
                });
            });

            // Delete notification
            document.querySelectorAll('.delete-notification-btn').forEach(button => {
                button.addEventListener('click', function (e) {
                    e.preventDefault();
                    if (!confirm('Are you sure you want to delete this notification?')) {
                        return;
                    }
                    const form = this.closest('form');
                    const notificationId = form.querySelector('input[name="id"]').value;
                    deleteNotification(notificationId);
                });
            });
        }

        // Mark single notification as read
        function markNotificationAsRead(notificationId) {
            fetch('@Url.Action("MarkAsRead", "Notifications")', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value,
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: `id=${notificationId}`
            })
            .then(response => {
                if (response.ok) {
                    loadNotifications();
                    // Update badge count
                    const currentCount = getCurrentBadgeCount();
                    const newCount = Math.max(0, currentCount - 1);
                    updateNotificationBadge(newCount);
                }
            })
            .catch(error => console.error('Error:', error));
        }

        // Delete notification
        function deleteNotification(notificationId) {
            fetch('@Url.Action("Delete", "Notifications")', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value,
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: `id=${notificationId}`
            })
            .then(response => {
                if (response.ok) {
                    loadNotifications();
                }
            })
            .catch(error => console.error('Error:', error));
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>



