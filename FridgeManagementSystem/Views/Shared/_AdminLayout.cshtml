<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Fridge Management System</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>

    <div class="container-fluid">
        <div class="row" style="height: 100vh">
            <div class="col-2 col-sm-3 col-xl-2 bg-dark">

                <div class="sticky-top">
                    <nav class="navbar bg-dark border-bottom border-white mb-3" data-bs-theme="dark">
                        <div class="container-fluid">
                            <a class="navbar-brand" asp-controller="Admin" asp-action="Index">
                                <img src="~/Images/WhatsApp Image 2025-05-27 at 18.37.15_1c44df4a.jpg" height="50" width="100" />
                            </a>
                        </div>
                    </nav>
                    
                    <nav class="nav flex-column">
                        <a class="nav-link text-white" style="white-space:nowrap" asp-controller="Admin" asp-action="Index">
                            <i class="bi bi-speedometer2"></i> <span class="d-none d-sm-inline ms-2">Dashboard</span>
                        </a>
                        <a class="nav-link text-white" style="white-space:nowrap" asp-controller="Admin" asp-action="ListUsers">
                            <i class="bi bi-person-circle"></i> <span class="d-none d-sm-inline ms-2">Users</span>
                        </a>
                       
                        <a class="nav-link text-white" style="white-space:nowrap" href='@Url.Action("ListCustomers","Customer")'>
                            <i class="bi bi-people"></i> <span class="d-none d-sm-inline ms-2">Customers</span>
                        </a>
                        <a class="nav-link text-white" style="white-space:nowrap" asp-controller="Account" asp-action="Index">
                            <i class="bi bi-people-fill"></i> <span class="d-none d-sm-inline ms-2">Employees</span>
                        </a>
                        <a class="nav-link text-white" style="white-space:nowrap" asp-controller="Fridge" asp-action="Index">
                            <i class="bi bi-door-closed"></i> <span class="d-none d-sm-inline ms-2">Fridges</span>
                        </a>
                        <a class="nav-link text-white" style="white-space:nowrap" href='@Url.Action("Index","Role")'>
                            <i class="bi-person-workspace"></i> <span class="d-none d-sm-inline ms-2">Roles</span>
                        </a>
                        <a class="nav-link text-white" style="white-space:nowrap" href="#">
                            <i class="bi bi-person"></i> <span class="d-none d-sm-inline ms-2">Profile</span>
                        </a>
                    </nav>
                </div>

            </div>
            <div class="col-10 col-sm-9 col-xl-10 p-0 m-0">
                <nav class="navbar navbar-expand-lg bg-body-tertiary mb-3 border-bottom">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    <div class="container-fluid">
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Index", "Home")"><i class="bi bi-arrow-bar-right me-2"></i> Logout</a>
                            </li>
                        </ul>
                    </div>
                </nav>

                 <div class="px-3">
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>
   

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
