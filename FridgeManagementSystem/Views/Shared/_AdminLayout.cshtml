@using FridgeManagementSystem.Areas.Identity.Data
@using FridgeManagementSystem.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="~/Images/WhatsApp Image 2025-05-27 at 18.37.15_1c44df4a.jpg" />
    <title>@ViewData["Title"] - Fridge Management System</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>

    <div class="container-fluid">
        <div class="row" style="height: 100vh">
            <!-- Admin Sidebar -->
            <div class="col-2 col-sm-3 col-xl-2 bg-dark">
                <div class="sticky-top">
                    <ul class="navbar-nav flex-grow-1">
                        <nav class="navbar bg-dark border-bottom border-white mb-3" data-bs-theme="dark">
                            <div class="container-fluid">
                                <img src="~/Images/WhatsApp Image 2025-05-27 at 18.37.15_1c44df4a.jpg" height="60" width="120"
                                     style="border-top-right-radius: 50rem; border-bottom-right-radius: 50rem;" />
                            </div>
                        </nav>

                        <nav class="nav flex-column">

                            <a class="nav-link text-white" style="white-space:nowrap" asp-controller="Admin" asp-action="Admin">
                                <i class="bi bi-speedometer2"></i> <span class="d-none d-sm-inline ms-2">Dashboard</span>
                            </a>
                            <a class="nav-link text-white" style="white-space:nowrap" asp-controller="User" asp-action="Index">
                                <i class="bi bi-person-circle"></i> <span class="d-none d-sm-inline ms-2">Manage Users</span>
                            </a>

                            <a class="nav-link text-white" style="white-space:nowrap" asp-controller="Customer" asp-action="CustomerManagement">
                                <i class="bi bi-people"></i> <span class="d-none d-sm-inline ms-2">Manage Customers</span>
                            </a>
                            
                            <a class="nav-link text-white" style="white-space:nowrap" asp-controller="Admin" asp-action="EmployeeManagement">
                                <i class="bi bi-person-gear"></i><span class="d-none d-sm-inline ms-2">Manage Employees</span>
                            </a>
                            <a class="nav-link text-white" style="white-space:nowrap" asp-controller="EmployeeType" asp-action="Index">
                                <i class="bi bi-people-fill"></i> <span class="d-none d-sm-inline ms-2">Employee Types</span>
                            </a>
                            <a class="nav-link text-white" style="white-space:nowrap" asp-controller="Suppliers" asp-action="Index">
                                <i class="bi bi-people-fill"></i> <span class="d-none d-sm-inline ms-2">Suppliers</span>
                            </a>
                            <a class="nav-link text-white" style="white-space:nowrap" asp-controller="Fridge" asp-action="Index" asp-area="">
                                <i class="bi bi-door-closed"></i> <span class="d-none d-sm-inline ms-2">Manage Fridges</span>
                            </a>
                            <a class="nav-link text-white" style="white-space:nowrap" asp-controller="FridgeType" asp-action="Index" asp-area="">
                                <i class="bi bi-door-closed"></i> <span class="d-none d-sm-inline ms-2">Fridge Types</span>
                            </a>
                            <a class="nav-link text-white" style="white-space:nowrap" href='@Url.Action("Index", "Role")'>
                                <i class="bi-person-workspace"></i> <span class="d-none d-sm-inline ms-2">Roles</span>
                            </a>

                            <a class="nav-link text-white" style="white-space:nowrap" asp-controller="Admin" asp-action="PendingApprovals">
                                <i class="bi bi-hourglass-split"></i> <span class="d-none d-sm-inline ms-2">Pending Approvals</span>
                            </a>

                            <a class="nav-link text-white position-relative" style="white-space:nowrap" href="#" data-bs-toggle="modal" data-bs-target="#notificationsModal">
                                <i class="bi bi-bell"></i>
                                <span class="d-none d-sm-inline ms-2">Notifications</span>
                                @await Component.InvokeAsync("Notifications")
                            </a>

                            <a class="nav-link text-white position-relative collapsed" href="#managementCollapse" data-bs-toggle="collapse" aria-expanded="false">
                                <i class="bi bi-file-earmark-bar-graph"></i><span class="d-none d-sm-inline ms-2">Generate Reports</span>
                                
                            </a>
                            <div class="collapse" id="managementCollapse">
                                
                                <a class="nav-link text-white" style="white-space:nowrap" asp-controller="FaultTechnician" asp-action="TechnicianReport">
                                    <i class="bi bi-tools"></i><span class="d-none d-sm-inline ms-2">Fault Technician Reports</span>
                                </a>
                                
                           </div>
                            
                        </nav>
                    </ul>
                    @* <partial name="_LoginPartial" /> *@
                </div>

            </div>
        
            <!-- Main Content -->
            <div class="col-10 col-sm-9 col-xl-10 p-0 m-0" style="background-color: skyblue">
                <nav class="navbar navbar-expand-lg bg-body-tertiary mb-3 border-bottom">
                   
                    <div class="container-fluid">
                        <span class="navbar-brand mb-0 h6">
                            <i class="fas fa-user-shield me-2"></i>ADMIN PORTAL
                        </span>
                        <span class="navbar-brand mb-0 h6">
                            <partial name="_LoginPartial" />
                        </span>
                        
                    </div>
                    
                </nav>
                <div class="px-3">
                    @RenderBody()
                </div>
                
            </div>

        </div>

    </div>
    <!-- Notifications Modal -->
    <div class="modal fade" id="notificationsModal" tabindex="-1"
         aria-labelledby="notificationsModalLabel" aria-hidden="true"
         data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="notificationsModalLabel">
                        <i class="fas fa-bell me-2"></i> Notifications
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="notificationsModalBody">
                    <div class="text-center py-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading notifications...</span>
                        </div>
                        <p class="mt-2 text-muted">Loading notifications...</p>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <form id="markAllAsReadForm" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-primary" id="markAllAsReadBtn" disabled>
                            <i class="fas fa-check-double me-1"></i> Mark All as Read
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        
        document.addEventListener('DOMContentLoaded', function() {
            // Load notifications when modal is shown
            const notificationsModal = document.getElementById('notificationsModal');
            if (notificationsModal) {
                notificationsModal.addEventListener('show.bs.modal', function () {
                    console.log('Modal opened - loading notifications');
                    loadNotifications();
                });
            }

            // Initialize mark all as read form
            const markAllForm = document.getElementById('markAllAsReadForm');
            if (markAllForm) {
                markAllForm.addEventListener('submit', function (e) {
                    e.preventDefault();
                    handleMarkAllAsRead();
                });
            }
        });

        // Function to load notifications via AJAX
        function loadNotifications() {
            console.log('Loading notifications...');
            fetch('@Url.Action("GetNotificationsPartial", "Notifications")')
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    }
                    return response.text();
                })
                .then(data => {
                    console.log('Notifications loaded successfully');
                    document.getElementById('notificationsModalBody').innerHTML = data;
                    updateMarkAllButton();
                    // Re-attach event listeners for dynamic content
                    attachNotificationEventListeners();
                })
                .catch(error => {
                    console.error('Error loading notifications:', error);
                    document.getElementById('notificationsModalBody').innerHTML =
                        '<div class="alert alert-danger">Error loading notifications. Please try again.</div>';
                });
        }

        // Update Mark All as Read button state
        function updateMarkAllButton() {
            const hasUnread = document.querySelectorAll('.notification-unread').length > 0;
            const markAllBtn = document.getElementById('markAllAsReadBtn');
            if (markAllBtn) {
                markAllBtn.disabled = !hasUnread;
            }
        }

        // Handle Mark All as Read
        function handleMarkAllAsRead() {
            console.log('Marking all as read...');
            fetch('@Url.Action("MarkAllAsRead", "Notifications")', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': document.querySelector('#markAllAsReadForm input[name="__RequestVerificationToken"]').value,
                    'Content-Type': 'application/x-www-form-urlencoded',
                }
            })
            .then(response => {
                if (response.ok) {
                    console.log('All marked as read successfully');
                    loadNotifications(); // Reload notifications
                    updateNotificationBadge(0); // Update badge to zero
                }
            })
            .catch(error => console.error('Error:', error));
        }

        // Function to update notification badge
        function updateNotificationBadge(count) {
            const badge = document.querySelector('.notification-badge');
            if (badge) {
                if (count > 0) {
                    badge.textContent = count;
                    badge.style.display = 'inline';
                } else {
                    badge.style.display = 'none';
                }
            }
        }

        // Get current badge count
        function getCurrentBadgeCount() {
            const badge = document.querySelector('.notification-badge');
            return badge ? parseInt(badge.textContent) || 0 : 0;
        }

        // Attach event listeners for notification actions
        function attachNotificationEventListeners() {
            // Mark single notification as read
            document.querySelectorAll('.mark-as-read-btn').forEach(button => {
                button.addEventListener('click', function (e) {
                    e.preventDefault();
                    const form = this.closest('form');
                    const notificationId = form.querySelector('input[name="id"]').value;
                    markNotificationAsRead(notificationId);
                });
            });

            // Delete notification
            document.querySelectorAll('.delete-notification-btn').forEach(button => {
                button.addEventListener('click', function (e) {
                    e.preventDefault();
                    if (!confirm('Are you sure you want to delete this notification?')) {
                        return;
                    }
                    const form = this.closest('form');
                    const notificationId = form.querySelector('input[name="id"]').value;
                    deleteNotification(notificationId);
                });
            });
        }

        // Mark single notification as read
        function markNotificationAsRead(notificationId) {
            fetch('@Url.Action("MarkAsRead", "Notifications")', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value,
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: `id=${notificationId}`
            })
            .then(response => {
                if (response.ok) {
                    loadNotifications();
                    // Update badge count
                    const currentCount = getCurrentBadgeCount();
                    const newCount = Math.max(0, currentCount - 1);
                    updateNotificationBadge(newCount);
                }
            })
            .catch(error => console.error('Error:', error));
        }

        // Delete notification
        function deleteNotification(notificationId) {
            fetch('@Url.Action("Delete", "Notifications")', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value,
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: `id=${notificationId}`
            })
            .then(response => {
                if (response.ok) {
                    loadNotifications();
                }
            })
            .catch(error => console.error('Error:', error));
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
    @await RenderSectionAsync("Styles", required: false)
</body>
</html>


