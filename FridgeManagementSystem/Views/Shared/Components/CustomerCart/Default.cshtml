@model FridgeManagementSystem.ViewComponents.CartViewModel

@if (Model.ShowCart)
{
    <li class="nav-item">
        <a class="nav-link active" asp-controller="Cart" asp-action="Index">
            <i class="fas fa-shopping-cart me-1"></i>

            <span id="cartCountBadge" class="badge rounded-pill bg-info" style="vertical-align: top">@Model.Count</span>
        </a>
    </li>
}