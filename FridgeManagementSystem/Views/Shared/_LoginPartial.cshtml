                    </form>

                </li>
            }
            else if (User.IsInRole("Inventory Liaison"))
            {
                <li class="nav-item">
                    <a id="manage" class="nav-link text-white" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">@(appUser!.FullName + " (Inventory Liaison)")</a>
                </li>
                <li class="nav-item">

                    <form id="logoutForm" class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                        <button id="logout" type="submit" class="nav-link btn btn-link text-white border-0">Logout</button>
                    </form>

                </li>
