@using FridgeManagementSystem.Areas.Identity.Data
@using FridgeManagementSystem.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject UserManager<ApplicationUser> UserManager


<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fridge Management System</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/customer.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
    <style>
        #cartCount{
            color: black;
        }

        body {
            
            background-color: deepskyblue;
        }
    </style>
</head>
<body>
    <!-- Header -->
    <header class="navbar navbar-expand-lg navbar-dark bg-primary sticky-top">
        <div class="container-fluid">
            <!-- Brand -->
            <a class="navbar-brand d-flex align-items-center" asp-area="Customer" asp-controller="Customer" asp-action="Index">
                <i class="bi bi-refrigerator me-2 fs-4"></i>
                <span class="fw-bold">Fridge Management System</span>
            </a>

            <!-- Mobile Toggle -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#customerNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Navigation -->
            <div class="collapse navbar-collapse" id="customerNavbar">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Customer" asp-controller="Customer" asp-action="Home">
                            <i class="bi bi-speedometer2 me-1"></i>Home
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Customer" asp-controller="Customer" asp-action="Index">
                            <i class="bi bi-speedometer2 me-1"></i>Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Customer" asp-controller="Fridges" asp-action="Index">
                            <i class="bi bi-refrigerator me-1"></i>My Fridges
                        </a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-tools me-1"></i>Support
                        </a>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item" asp-area="Customer" asp-controller="CustomerFault" asp-action="Index">
                                    <i class="bi-clipboard-data me-2"></i>My Reported Faults
                                </a>
                            </li>
                            @* <li>
                                <a class="dropdown-item" asp-area="Customer" asp-controller="CustomerFault" asp-action="Create">
                                    <i class="bi bi-exclamation-triangle me-2"></i>Report Fault
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-area="Customer" asp-controller="FaultReports" asp-action="History">
                                    <i class="bi bi-clock-history me-2"></i>Fault History
                                </a>
                            </li> *@
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item" asp-area="Customer" asp-controller="Maintenance" asp-action="Schedule">
                                    <i class="bi bi-calendar-check me-2"></i>My Maintenance Schedule
                                </a>
                            </li>
                            
                        </ul>
                    </li>
                    
                    @* <li class="nav-item">
                        <a class="nav-link" style="white-space:nowrap" asp-controller="Notifications" asp-action="Index">
                            <i class="bi bi-bell me-1"></i><span class="d-none d-sm-inline ms-2">Notifications</span>
                            @await Component.InvokeAsync("Notifications")
                        </a>
                    </li> *@
                    <li class="nav-item">
                        <a class="nav-link" style="white-space:nowrap" href="#" data-bs-toggle="modal" data-bs-target="#notificationsModal">
                            <i class="bi bi-bell me-1"></i>Notifications
                            
                            @await Component.InvokeAsync("Notifications")
                        </a>
                    </li>
                    
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Customer" asp-controller="Requests" asp-action="Index">
                            <i class="bi bi-plus-circle me-1"></i>Request Fridge
                        </a>
                    </li>
                    <li>
                        <a class="nav-item" href="/Cart/GetUserCart">
                            <i class="bi bi-cart text-white"></i>
                            <span class="badge text-bg-info" id="cartCount">0</span>
                            
                        </a>
                    </li>
                </ul>

                <!-- User Menu -->
                <ul class="navbar-nav">
                    <partial name="_LoginPartial" />
                </ul>
              
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="container-fluid px-0">
        <!-- Alert Container -->
        <div id="alertContainer" class="position-fixed top-0 end-0 p-3" style="z-index: 1050; margin-top: 80px;">
            <!-- Alerts will be inserted here dynamically -->
        </div>

        <!-- Page Header -->
        <div class="bg-light border-bottom py-3 mb-4">
            <div class="container-fluid">
                <div class="row align-items-center">
                    <div class="col">
                        
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb mb-0">
                                <li class="breadcrumb-item"><a asp-area="Customer" asp-controller="Customer" asp-action="Index">Home</a></li>
                                @if (ViewData["Breadcrumb"] != null)
                                {
                                    @Html.Raw(ViewData["Breadcrumb"])
                                }
                                <li class="breadcrumb-item active">@ViewData["Title"]</li>
                            </ol>
                        </nav>
                    </div>
                    <div class="col-auto">
                        @RenderSection("HeaderActions", required: false)
                    </div>
                </div>
            </div>
        </div>

        <!-- Content -->
        <div class="container-fluid">
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-dark text-light mt-5">
        <div class="container py-4">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <h5 class="fw-bold">
                        <i class="bi bi-person-circle text-light me-2"></i> Customer Portal
                    </h5>
                    <p class="mb-2">Ensuring proper refrigeration for your beverages</p>
                  
                </div>
               
                <div class="col-md-3 mb-3">
                    <h6 class="fw-bold">Support</h6>
                    <ul class="list-unstyled">
                        <li><i class="bi bi-telephone me-2"></i>+27 12 345 6789</li>
                        <li><i class="bi bi-envelope me-2"></i>nmdesignhub@gmail.com</li>
                        <li><i class="bi bi-clock me-2"></i>Mon-Fri: 8:00-17:00</li>
                    </ul>
                </div>
               
            </div>
            <hr class="my-3">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <p class="mb-0">&copy; 2025 Fridge Management System. All rights reserved.</p>
                </div>
                
            </div>
        </div>
    </footer>

    <!-- Notifications Modal -->
    <div class="modal fade" id="notificationsModal" tabindex="-1"
         aria-labelledby="notificationsModalLabel" aria-hidden="true"
         data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="notificationsModalLabel">
                        <i class="fas fa-bell me-2"></i> Notifications
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="notificationsModalBody">
                    <div class="text-center py-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading notifications...</span>
                        </div>
                        <p class="mt-2 text-muted">Loading notifications...</p>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <form id="markAllAsReadForm" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-primary" id="markAllAsReadBtn" disabled>
                            <i class="fas fa-check-double me-1"></i> Mark All as Read
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/customer.js" asp-append-version="true"></script>
        
    <!-- Customer-specific JavaScript -->
    <script>
        
        document.addEventListener('DOMContentLoaded', function() {
            // Load notifications when modal is shown
            const notificationsModal = document.getElementById('notificationsModal');
            if (notificationsModal) {
                notificationsModal.addEventListener('show.bs.modal', function () {
                    console.log('Modal opened - loading notifications');
                    loadNotifications();
                });
            }

            // Initialize mark all as read form
            const markAllForm = document.getElementById('markAllAsReadForm');
            if (markAllForm) {
                markAllForm.addEventListener('submit', function (e) {
                    e.preventDefault();
                    handleMarkAllAsRead();
                });
            }
        });

        // Function to load notifications via AJAX
        function loadNotifications() {
            console.log('Loading notifications...');
            fetch('@Url.Action("GetNotificationsPartial", "Notifications")')
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    }
                    return response.text();
                })
                .then(data => {
                    console.log('Notifications loaded successfully');
                    document.getElementById('notificationsModalBody').innerHTML = data;
                    updateMarkAllButton();
                    // Re-attach event listeners for dynamic content
                    attachNotificationEventListeners();
                })
                .catch(error => {
                    console.error('Error loading notifications:', error);
                    document.getElementById('notificationsModalBody').innerHTML =
                        '<div class="alert alert-danger">Error loading notifications. Please try again.</div>';
                });
        }

        // Update Mark All as Read button state
        function updateMarkAllButton() {
            const hasUnread = document.querySelectorAll('.notification-unread').length > 0;
            const markAllBtn = document.getElementById('markAllAsReadBtn');
            if (markAllBtn) {
                markAllBtn.disabled = !hasUnread;
            }
        }

        // Handle Mark All as Read
        function handleMarkAllAsRead() {
            console.log('Marking all as read...');
            fetch('@Url.Action("MarkAllAsRead", "Notifications")', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': document.querySelector('#markAllAsReadForm input[name="__RequestVerificationToken"]').value,
                    'Content-Type': 'application/x-www-form-urlencoded',
                }
            })
            .then(response => {
                if (response.ok) {
                    console.log('All marked as read successfully');
                    loadNotifications(); // Reload notifications
                    updateNotificationBadge(0); // Update badge to zero
                }
            })
            .catch(error => console.error('Error:', error));
        }

        // Function to update notification badge
        function updateNotificationBadge(count) {
            const badge = document.querySelector('.notification-badge');
            if (badge) {
                if (count > 0) {
                    badge.textContent = count;
                    badge.style.display = 'inline';
                } else {
                    badge.style.display = 'none';
                }
            }
        }

        // Get current badge count
        function getCurrentBadgeCount() {
            const badge = document.querySelector('.notification-badge');
            return badge ? parseInt(badge.textContent) || 0 : 0;
        }

        // Attach event listeners for notification actions
        function attachNotificationEventListeners() {
            // Mark single notification as read
            document.querySelectorAll('.mark-as-read-btn').forEach(button => {
                button.addEventListener('click', function (e) {
                    e.preventDefault();
                    const form = this.closest('form');
                    const notificationId = form.querySelector('input[name="id"]').value;
                    markNotificationAsRead(notificationId);
                });
            });

            // Delete notification
            document.querySelectorAll('.delete-notification-btn').forEach(button => {
                button.addEventListener('click', function (e) {
                    e.preventDefault();
                    if (!confirm('Are you sure you want to delete this notification?')) {
                        return;
                    }
                    const form = this.closest('form');
                    const notificationId = form.querySelector('input[name="id"]').value;
                    deleteNotification(notificationId);
                });
            });
        }

        // Mark single notification as read
        function markNotificationAsRead(notificationId) {
            fetch('@Url.Action("MarkAsRead", "Notifications")', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value,
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: `id=${notificationId}`
            })
            .then(response => {
                if (response.ok) {
                    loadNotifications();
                    // Update badge count
                    const currentCount = getCurrentBadgeCount();
                    const newCount = Math.max(0, currentCount - 1);
                    updateNotificationBadge(newCount);
                }
            })
            .catch(error => console.error('Error:', error));
        }

        // Delete notification
        function deleteNotification(notificationId) {
            fetch('@Url.Action("Delete", "Notifications")', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value,
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: `id=${notificationId}`
            })
            .then(response => {
                if (response.ok) {
                    loadNotifications();
                }
            })
            .catch(error => console.error('Error:', error));
        }

        // Global function to show alerts
        function showAlert(message, type = 'info') {
            const alertContainer = document.getElementById('alertContainer');
            const alertId = 'alert-' + Date.now();

            const alertHTML = `
                <div id="${alertId}" class="alert alert-${type} alert-dismissible fade show" role="alert">
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `;

            alertContainer.insertAdjacentHTML('beforeend', alertHTML);

            // Auto remove after 5 seconds
            setTimeout(() => {
                const alert = document.getElementById(alertId);
                if (alert) {
                    alert.remove();
                }
            }, 5000);
        }

        // Handle form submissions with loading states
        document.addEventListener('submit', function(e) {
            const form = e.target;
            const submitBtn = form.querySelector('button[type="submit"]');

            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Processing...';
            }
        });

        loadCartCount();
        async function loadCartCount(){
            try{
                var response = await fetch(`/Cart/GetTotalItemsInCart`);
                if (response.status==200){
                var result = await response.json();
                var cartCountEl = document.getElementById("cartCount");
                cartCountEl.innerHTML = result;
                }
            }
            catch(err){
                console.log(err);
            }
        }
    </script>
    

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>



