@using FridgeManagementSystem.Areas.Identity.Data
@using FridgeManagementSystem.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject UserManager<ApplicationUser> UserManager


<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fridge Management System</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/customer.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Header -->
    <header class="navbar navbar-expand-lg navbar-dark bg-primary sticky-top">
        <div class="container">
            <!-- Brand -->
            <a class="navbar-brand d-flex align-items-center" asp-area="Customer" asp-controller="Customer" asp-action="Index">
                <i class="bi bi-refrigerator me-2 fs-4"></i>
                <span class="fw-bold">Fridge Management System</span>
            </a>

            <!-- Mobile Toggle -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#customerNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Navigation -->
            <div class="collapse navbar-collapse" id="customerNavbar">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Customer" asp-controller="Customer" asp-action="Index">
                            <i class="bi bi-speedometer2 me-1"></i>Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Customer" asp-controller="Fridges" asp-action="Index">
                            <i class="bi bi-refrigerator me-1"></i>My Fridges
                        </a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-tools me-1"></i>Support
                        </a>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item" asp-area="Customer" asp-controller="FaultReports" asp-action="Index">
                                    <i class="bi bi-exclamation-triangle me-2"></i>Report Fault
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-area="Customer" asp-controller="FaultReports" asp-action="History">
                                    <i class="bi bi-clock-history me-2"></i>Fault History
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item" asp-area="Customer" asp-controller="Maintenance" asp-action="Schedule">
                                    <i class="bi bi-calendar-check me-2"></i>Maintenance Schedule
                                </a>
                            </li>
                        </ul>
                    </li>
                    
                    <li class="nav-item">
                        <a class="nav-link" style="white-space:nowrap" asp-controller="Notifications" asp-action="Index">
                            <i class="bi bi-bell me-1"></i><span class="d-none d-sm-inline ms-2">Notifications</span>
                            @await Component.InvokeAsync("Notifications")
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Customer" asp-controller="Requests" asp-action="Index">
                            <i class="bi bi-plus-circle me-1"></i>Request Fridge
                        </a>
                    </li>
                </ul>

                <!-- User Menu -->
                <ul class="navbar-nav">
                    <partial name="_LoginPartial" />
                </ul>
              
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="container-fluid px-0">
        <!-- Alert Container -->
        <div id="alertContainer" class="position-fixed top-0 end-0 p-3" style="z-index: 1050; margin-top: 80px;">
            <!-- Alerts will be inserted here dynamically -->
        </div>

        <!-- Page Header -->
        <div class="bg-light border-bottom py-3 mb-4">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col">
                        <h1 class="h3 mb-0">@ViewData["Title"]</h1>
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb mb-0">
                                <li class="breadcrumb-item"><a asp-area="Customer" asp-controller="Customer" asp-action="Index">Home</a></li>
                                @if (ViewData["Breadcrumb"] != null)
                                {
                                    @Html.Raw(ViewData["Breadcrumb"])
                                }
                                <li class="breadcrumb-item active">@ViewData["Title"]</li>
                            </ol>
                        </nav>
                    </div>
                    <div class="col-auto">
                        @RenderSection("HeaderActions", required: false)
                    </div>
                </div>
            </div>
        </div>

        <!-- Content -->
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-dark text-light mt-5">
        <div class="container py-4">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <h5 class="fw-bold">
                        <i class="bi bi-refrigerator me-2"></i>Fridge Management System
                    </h5>
                    <p class="mb-2">Ensuring proper refrigeration for your beverages</p>
                  
                </div>
               
                <div class="col-md-3 mb-3">
                    <h6 class="fw-bold">Support</h6>
                    <ul class="list-unstyled">
                        <li><i class="bi bi-telephone me-2"></i>+27 12 345 6789</li>
                        <li><i class="bi bi-envelope me-2"></i>nmdesignhub@gmail.com</li>
                        <li><i class="bi bi-clock me-2"></i>Mon-Fri: 8:00-17:00</li>
                    </ul>
                </div>
               
            </div>
            <hr class="my-3">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <p class="mb-0">&copy; 2024 Fridge Management System. All rights reserved.</p>
                </div>
                
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/customer.js" asp-append-version="true"></script>

    <!-- Customer-specific JavaScript -->
    <script>
        // Theme Toggle
        document.getElementById('themeToggle')?.addEventListener('click', function() {
            const currentTheme = document.documentElement.getAttribute('data-bs-theme');
            const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-bs-theme', newTheme);
            localStorage.setItem('theme', newTheme);
        });

        // Initialize theme
        const savedTheme = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-bs-theme', savedTheme);

        // Global function to show alerts
        function showAlert(message, type = 'info') {
            const alertContainer = document.getElementById('alertContainer');
            const alertId = 'alert-' + Date.now();

            const alertHTML = `
                <div id="${alertId}" class="alert alert-${type} alert-dismissible fade show" role="alert">
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `;

            alertContainer.insertAdjacentHTML('beforeend', alertHTML);

            // Auto remove after 5 seconds
            setTimeout(() => {
                const alert = document.getElementById(alertId);
                if (alert) {
                    alert.remove();
                }
            }, 5000);
        }

        // Handle form submissions with loading states
        document.addEventListener('submit', function(e) {
            const form = e.target;
            const submitBtn = form.querySelector('button[type="submit"]');

            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Processing...';
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@functions {
    private async Task<int> GetUnreadNotificationCount()
    {
        var context = new FridgeManagementSystemContext(new Microsoft.EntityFrameworkCore.DbContextOptions<FridgeManagementSystemContext>());
        var userManager = Context.RequestServices.GetService<UserManager<ApplicationUser>>();

        if (User.Identity.IsAuthenticated)
        {
            var user = await userManager.GetUserAsync(User);
            if (user != null)
            {
                return await context.Notifications
                    .Where(n => n.UserId == user.Id && !n.IsRead)
                    .CountAsync();
            }
        }
        return 0;
    }
}


