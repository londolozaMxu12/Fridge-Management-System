<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FridgeSystem</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body{
            color:white;
            min-height:100%;
            
            flex: 1;
            overflow: auto;
            padding-bottom: 100px;
        }
        .widget{
            list-style-type: disc;
            display: flex;
            gap: 20px;
            padding: 0;
            margin: 0;
            display: flex;
            align-items: center;
            text-spacing: normal;
        }
        /* i{
            list-style-type: disc;
            display: flex;
            gap: 20px;
            padding: 0;
            margin: 0;
        } */
        /*.container {
            padding-left: 0;
            margin-left: 20px;
        }*/
        a {
            color: white;
        }
        header > a{
            color:white;
        }
        footer{
           /* background-color:black;*/
            margin-top:auto;
            margin-bottom:0;
            height:auto;

        }
        .widget {
            margin-right: 300px;
        }
        .nav-item{
            font-weight:bold;
            font-size:15px;

        }
        .nav-link{
            background-color:black;
            border:2px solid white;
            border-radius:3px;
            margin-left:20px;
        }
        
        
        #footer{
            position: absolute;
            /* height: 100%; */
            /* margin-top: -100%; */
            /* clear: both; */
            bottom: 0;
            width: 100vw;
            margin-bottom: 0px;
        }
        *{
            margin: 0;
        }
    </style>
</head>
<body>
    <header>

        <nav class="navbar navbar-expand-sm navbar-toggleable-sm  text-bg-dark p-3  py-3">
            <div class="container">
                
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/Images/WhatsApp Image 2025-05-27 at 18.37.15_1c44df4a.jpg" height="60" width="120" />
                </a>
                <button class="navbar-toggler" type="button" data-toggle="collapse" data-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="fas fa-home"></i> Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="AboutUs">About Us</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="ContactUs">Contact Us</a>
                        </li>

                        @* <div>
                            @await Html.PartialAsync("_LoginPartial")
                       </div> *@
                    </ul>

                    @using FridgeManagementSystem.Areas.Identity.Data
                    @using Microsoft.AspNetCore.Identity
                    @inject SignInManager<ApplicationUser> SignInManager
                    @inject UserManager<ApplicationUser> UserManager

                    @if (SignInManager.IsSignedIn(User))
                    {
                        var appUser = await UserManager.GetUserAsync(User);

                        if (User.IsInRole("Customer"))
                        {
                            <ul class="navbar-nav">
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-light" id="userDropdown" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="fas fa-user"></i>Welcome back, @(appUser!.FullName + " (Customer)")
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                        <li>
                                            <a class="dropdown-item" asp-area="" asp-controller="Customer" asp-action="Index">
                                                <i class="fas fa-user-cog"></i> Dashboard
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item" asp-area="" asp-controller="Customer" asp-action="MyFridges">
                                                <i class="fas fa-user-cog"></i> My Fridges
                                            </a>
                                        </li>

                                        @if (User.Identity.IsAuthenticated)
                                        {
                                            <li>
                                                <a class="dropdown-item" asp-controller="Notifications" asp-action="Index">
                                                    <i class="fas fa-user-cog"></i> Notifications
                                                    @await Component.InvokeAsync("Notifications")
                                                </a>
                                            </li>
                                            
                                        }

                                        <li>
                                            <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">
                                                <i class="fas fa-user-cog"></i> Profile
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                                                <button type="submit" class="dropdown-item">
                                                    <i class="fas fa-sign-out-alt"></i> Logout
                                                </button>
                                            </form>
                                        </li>
                                    </ul>

                                </li>
                            </ul>
                        }
                        else
                        {

                            <li class="nav-item">

                                <form id="logoutForm" class="dropdown-item" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                                    <button id="logout" type="submit" class="nav-link btn btn-link text-white border-0">Logout</button>
                                </form>
                            </li>

                        }

                    }

                    else
                    {

                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <a class="nav-link text-white" id="register" asp-area="Identity" asp-page="/Account/Register">Register</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" id="login" asp-area="Identity" asp-page="/Account/Login">Login</a>
                            </li>
                        </ul>
                    }
                </div>
                @* <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="AboutUs">About Us</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="ContactUs">Contact Us</a>
                        </li>
                       
                       
                    </ul>

                </div> *@
            </div>
        </nav>

    </header>

    @if (ViewData["HomePage"] == null)
    {
        <div class="container mt-3">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        @RenderBody()
    }
    @* <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div> *@
    <footer id="footer">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-dark ">
            <div class="container">
                <div class="row">
                    <div class="col-lg-3">
                        <div class="widget">
                            <h5 class="widgetheading">Our Contact</h5>
                            <p>
                                <i class="icon-phone"></i>016 435 7123<br>
                                <i class="icon-envelope-alt"></i>nmdesignhub@gmail.com
                            </p>
                        </div>
                    </div>
                    <div class="col-lg-3">
                        <div class="widget">
                            @* <h5 class="widgetheading">Quick Links</h5>
                            <ul class="link-list">
                                <li><a href="@Url.Action("Index", "Carrer")">Careers</a></li>
                                <li><a href="@Url.Action("ContactUs", "Home")">Contact Us</a></li>
                                <li><a href="@Url.Action("AboutUs", "Home")">About Us</a></li>
                            </ul>
                        </div> *@
                    </div>
                </div>
            </div>
        </nav>
    </footer>



    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
  
</body>
</html>
