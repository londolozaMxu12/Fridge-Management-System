    <script>
            function showToast(title, message, type) {
            const toastId = 'toast-' + Date.now();
            const bgColor = type === 'success' ? 'bg-success' : 'bg-danger';

            const toastHtml = `
                <div id="${toastId}" class="toast align-items-center text-white ${bgColor} border-0" role="alert" aria-live="assertive" aria-atomic="true">
                    <div class="d-flex">
                        <div class="toast-body">
                            <strong>${title}:</strong> ${message}
                        </div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                    </div>
                </div>
            `;

            document.querySelector('.toast-container').insertAdjacentHTML('beforeend', toastHtml);

            const toastElement = document.getElementById(toastId);
            const toast = new bootstrap.Toast(toastElement);
            toast.show();

            // Remove toast from DOM after it hides
            toastElement.addEventListener('hidden.bs.toast', function () {
                this.remove();
            });
        }

        // Global login state detection
        let previousAuthState = @User.Identity.IsAuthenticated.ToString().ToLower();

        // Check for auth state changes periodically
        setInterval(() => {
            const currentAuthState = @User.Identity.IsAuthenticated.ToString().ToLower();

            if (!previousAuthState && currentAuthState) {
                // User just logged in - transfer cart
                console.log('User logged in detected, transferring cart...');
                transferCartAfterLogin();
            }

            previousAuthState = currentAuthState;
        }, 1000);

        function transferCartAfterLogin() {
            fetch('@Url.Action("TransferCart", "Cart")', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    console.log('Cart transferred successfully');
                    updateCartCount();
                }
            })
            .catch(error => {
                console.error('Error transferring cart:', error);
            });
        }
    </script>

    <script>
        // Cart functionality for both anonymous and authenticated users
        function addToCart(button, fridgeId) {
            // Get anti-forgery token
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            // Show loading state
            const originalText = button.innerHTML;
            button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Adding...';
            button.disabled = true;

            fetch('@Url.Action("AddToCart", "Cart")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: `fridgeId=${fridgeId}&quantity=1`
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }
                return response.json();
            })
            .then(data => {
                console.log('Add to cart response:', data);
                if (data.success) {
                    updateCartCount();
                    showToast('Success', data.message, 'success');
                } else {
                    showToast('Error', data.message, 'error');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showToast('Error', 'An error occurred while adding to cart', 'error');
            })
            .finally(() => {
                // Reset button
                button.innerHTML = originalText;
                button.disabled = false;
            });
        }

        function updateCartCount() {
            fetch('@Url.Action("GetCartCount", "Cart")')
                .then(response => response.json())
                .then(data => {
                    console.log('Cart count:', data);
                    document.getElementById('cart-count').textContent = data.count;
                })
                .catch(error => {
                    console.error('Error updating cart count:', error);
                });
        }

        function showToast(title, message, type) {
            // Simple alert for now - you can enhance with Bootstrap toasts later
            alert(`${title}: ${message}`);
        }

        // Initialize cart count on page load
        document.addEventListener('DOMContentLoaded', function() {
            updateCartCount();
        });
    </script>
  
