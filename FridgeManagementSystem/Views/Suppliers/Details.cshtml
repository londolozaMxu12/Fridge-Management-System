
@model Supplier
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Supplier Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-truck"></i> @ViewData["Title"]</h1>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
            <i class="fas fa-edit"></i> Edit
        </a>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to List
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="fas fa-building"></i> Company Deatails</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Company Name:</dt>
                    <dd class="col-sm-8"><strong>@Model.CompanyName</strong></dd>

                    <dt class="col-sm-4">Supplier Type:</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-info">@Model.SupplierType</span>
                    </dd>

                </dl>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="fas fa-address-book"></i> Personal Details</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Full Name:</dt>
                    <dd class="col-sm-8">@Model.User.FullName</dd>

                    <dt class="col-sm-4">Email:</dt>
                    <dd class="col-sm-8">@Model.User.Email</dd>

                    <dt class="col-sm-4">Contact Number:</dt>
                    <dd class="col-sm-8">@Model.User.ContactNo</dd>

                    <dt class="col-sm-4">Address:</dt>
                    <dd class="col-sm-8">@Model.User.Address</dd>

                    <dt class="col-sm-4">City:</dt>
                    <dd class="col-sm-8">@Model.User.City</dd>

                    <dt class="col-sm-4">Suburb:</dt>
                    <dd class="col-sm-8">@Model.User.Suburb</dd>

                    <dt class="col-sm-4">Postal Code:</dt>
                    <dd class="col-sm-8">@Model.User.PostalCode</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        
        @* <div class="card mb-4">
            <div class="card-header bg-warning text-white">
                <h5 class="mb-0"><i class="fas fa-refrigerator"></i> Supplied Fridges</h5>
