        <div class="card">
            <div class="card-header bg-secondary text-white">
                <h5 class="mb-0"><i class="fas fa-info-circle"></i> System Information</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Registered By:</dt>
                    <dd class="col-sm-8">@Model.CreatedBy.FullName</dd>

                    <dt class="col-sm-4">Registration Date:</dt>
                    <dd class="col-sm-8">@Model.CreatedAt.ToString("yyyy-MM-dd")</dd>

                    <dt class="col-sm-4">Account Status:</dt>
                    <dd class="col-sm-8">
                        @if (Model.User.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactive</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>
</div>