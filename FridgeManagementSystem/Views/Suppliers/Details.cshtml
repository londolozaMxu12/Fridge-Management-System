@model Supplier
@{
    if (User.IsInRole("Admin"))
    {
        Layout = "_AdminLayout";
        ViewData["Title"] = "Supplier Details";
    }
    else if (ViewBag.IsPurchasingManager == true)
    {
        Layout = "_PurchasingManagerLayout";
        ViewData["Title"] = "Supplier Profile - Procurement";
    }
    else
    {
        Layout = "_Layout";
        ViewData["Title"] = "Supplier Details";
    }

    // Safe variables for null checking
    var userIsActive = Model.User?.IsActive ?? false;
    var approvalStatus = Model.User?.ApprovalStatus ?? "Unknown";
    var fullName = Model.User?.FullName ?? "N/A";
    var email = Model.User?.Email ?? "N/A";
    var contactNo = Model.User?.ContactNo ?? "N/A";
    var address = Model.User?.Address ?? "N/A";
    var city = Model.User?.City ?? "N/A";
    var suburb = Model.User?.Suburb ?? "N/A";
    var postalCode = Model.User?.PostalCode ?? "N/A";
    var approvedBy = Model.User?.ApprovedBy?.FullName ?? "N/A";
    var approvedAt = Model.User?.ApprovedAt;
    var createdBy = Model.CreatedBy?.FullName ?? "System";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-truck"></i> @ViewData["Title"]</h1>
    <div>
        <!-- Edit button available for both Admin and Purchasing Manager -->
        @if (User.IsInRole("Admin") || ViewBag.IsPurchasingManager == true)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                <i class="fas fa-edit"></i> Edit
            </a>
        }
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to List
        </a>

        <!-- Procurement-specific actions for Purchasing Manager -->
        @if (ViewBag.IsPurchasingManager == true && userIsActive && approvalStatus == "Approved")
        {
            <a href="@Url.Action("Create", "RFQ", new { supplierId = Model.Id })" class="btn btn-success">
                <i class="fas fa-file-alt"></i> Create RFQ
            </a>
        }
    </div>
</div>

<!-- Status Alert -->
@if (!userIsActive || approvalStatus != "Approved")
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-triangle"></i>
        <strong>Note:</strong> This supplier
        @if (!userIsActive)
        {
            <span>is <strong class="text-danger">Inactive</strong></span>
        }
        @if (!userIsActive && approvalStatus != "Approved")
        {
            <span> and </span>
        }
        @if (approvalStatus != "Approved")
        {
            <span>has <strong class="text-warning">@approvalStatus</strong> approval status</span>
        }
        . Procurement actions may be limited.
    </div>
}

<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="fas fa-building"></i> Company Details</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Company Name:</dt>
                    <dd class="col-sm-8"><strong>@Model.CompanyName</strong></dd>

                    <dt class="col-sm-4">Supplier Type:</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-info">@Model.SupplierType</span>
                    </dd>

                    <dt class="col-sm-4">Business Status:</dt>
                    <dd class="col-sm-8">
                        @if (userIsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactive</span>
                        }

                        @if (approvalStatus == "Approved")
                        {
                            <span class="badge bg-primary ms-1">Approved</span>
                        }
                        else if (approvalStatus == "Pending")
                        {
                            <span class="badge bg-warning ms-1">Pending Approval</span>
                        }
                        else if (approvalStatus == "Rejected")
                        {
                            <span class="badge bg-danger ms-1">Rejected</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary ms-1">@approvalStatus</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="fas fa-address-book"></i> Contact Details</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Full Name:</dt>
                    <dd class="col-sm-8">@fullName</dd>

                    <dt class="col-sm-4">Email:</dt>
                    <dd class="col-sm-8">
                        @if (!string.IsNullOrEmpty(email) && email != "N/A")
                        {
                            <a href="mailto:@email">@email</a>
                        }
                        else
                        {
                            <span>@email</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Contact Number:</dt>
                    <dd class="col-sm-8">
                        @if (!string.IsNullOrEmpty(contactNo) && contactNo != "N/A")
                        {
                            <a href="tel:@contactNo">@contactNo</a>
                        }
                        else
                        {
                            <span>@contactNo</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Address:</dt>
                    <dd class="col-sm-8">@address</dd>

                    <dt class="col-sm-4">City:</dt>
                    <dd class="col-sm-8">@city</dd>

                    <dt class="col-sm-4">Suburb:</dt>
                    <dd class="col-sm-8">@suburb</dd>

                    <dt class="col-sm-4">Postal Code:</dt>
                    <dd class="col-sm-8">@postalCode</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <!-- Procurement Information for Purchasing Manager -->
        @if (ViewBag.IsPurchasingManager == true)
        {
            <div class="card mb-4">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="fas fa-chart-line"></i> Procurement Activity</h5>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-4">
                            <div class="border rounded p-2 bg-light">
                                <h4 class="text-primary mb-0">@(ViewBag.ProcurementStats?.RFQsSent ?? 12)</h4>
                                <small class="text-muted">RFQs Sent</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="border rounded p-2 bg-light">
                                <h4 class="text-success mb-0">@(ViewBag.ProcurementStats?.QuotesReceived ?? 8)</h4>
                                <small class="text-muted">Quotes Received</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="border rounded p-2 bg-light">
                                <h4 class="text-warning mb-0">@(ViewBag.ProcurementStats?.ActiveOrders ?? 5)</h4>
                                <small class="text-muted">Active Orders</small>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        @if (userIsActive && approvalStatus == "Approved")
                        {
                            <div class="d-grid gap-2">
                                <a href="@Url.Action("Create", "RFQ", new { supplierId = Model.Id })" class="btn btn-success">
                                    <i class="fas fa-file-contract me-2"></i>Send Request for Quotation
                                </a>
                                <a href="@Url.Action("SupplierQuotations", "Quotations", new { supplierId = Model.Id })" class="btn btn-outline-primary">
                                    <i class="fas fa-receipt me-2"></i>View Quotation History
                                </a>
                                <a href="@Url.Action("SupplierOrders", "PurchaseOrders", new { supplierId = Model.Id })" class="btn btn-outline-info">
                                    <i class="fas fa-file-invoice me-2"></i>View Purchase Orders
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning text-center">
                                <i class="fas fa-info-circle me-2"></i>
                                Procurement actions are unavailable for this supplier due to their status.
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Supplied Fridges Section -->
        @* <div class="card mb-4">
            <div class="card-header bg-warning text-white">
                <h5 class="mb-0"><i class="fas fa-refrigerator"></i> Supplied Fridges</h5>
            </div>
            <div class="card-body">
                <!-- Your existing fridge table code -->
            </div>
        </div> *@

        <div class="card">
            <div class="card-header bg-secondary text-white">
                <h5 class="mb-0"><i class="fas fa-info-circle"></i> System Information</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Registered By:</dt>
                    <dd class="col-sm-8">@createdBy</dd>

                    <dt class="col-sm-4">Registration Date:</dt>
                    <dd class="col-sm-8">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>

                    <dt class="col-sm-4">Account Status:</dt>
                    <dd class="col-sm-8">
                        @if (userIsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactive</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Approval Status:</dt>
                    <dd class="col-sm-8">
                        @if (approvalStatus == "Approved")
                        {
                            <span class="badge bg-primary">Approved</span>
                            @if (approvedAt.HasValue)
                            {
                                <br />
                                <small class="text-muted">Approved on: @approvedAt.Value.ToString("yyyy-MM-dd")</small>
                            }
                        }
                        else if (approvalStatus == "Pending")
                        {
                            <span class="badge bg-warning">Pending Approval</span>
                        }
                        else if (approvalStatus == "Rejected")
                        {
                            <span class="badge bg-danger">Rejected</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@approvalStatus</span>
                        }
                    </dd>

                    <!-- Show approved by information if available -->
                    @if (Model.User?.ApprovedBy != null)
                    {
                        <dt class="col-sm-4">Approved By:</dt>
                        <dd class="col-sm-8">@approvedBy</dd>
                    }
                </dl>
            </div>
        </div>
    </div>
</div>

<!-- Additional Procurement Section for Purchasing Manager -->
@if (ViewBag.IsPurchasingManager == true && userIsActive && approvalStatus == "Approved")
{
    <div class="card mt-4">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0"><i class="fas fa-bolt"></i> Quick Procurement Actions</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    <a href="@Url.Action("Create", "RFQ", new { supplierId = Model.Id })" class="btn btn-outline-success w-100 h-100 py-3">
                        <i class="fas fa-file-contract fa-2x mb-2"></i><br />
                        Send RFQ
                    </a>
                </div>
                <div class="col-md-4">
                    <a href="@Url.Action("SupplierQuotations", "Quotations", new { supplierId = Model.Id })" class="btn btn-outline-primary w-100 h-100 py-3">
                        <i class="fas fa-receipt fa-2x mb-2"></i><br />
                        View Quotes
                    </a>
                </div>
                <div class="col-md-4">
                    <a href="@Url.Action("SupplierOrders", "PurchaseOrders", new { supplierId = Model.Id })" class="btn btn-outline-info w-100 h-100 py-3">
                        <i class="fas fa-file-invoice fa-2x mb-2"></i><br />
                        Order History
                    </a>
                </div>
            </div>
        </div>
    </div>
}
