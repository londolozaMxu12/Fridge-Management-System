@model FridgeManagementSystem.ViewModels.SupplierEditViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Edit Supplier";
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
<div class="row">
    <h2 class="text-center mb-3">Edit Supplier</h2>

    <div class="col-lg-8 mx-auto rounded border p-4">
        <h2 class="text-center mb-3">Account Details:</h2>
        <hr />

        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="IsActive" />
            <input type="hidden" asp-for="Id" />
            
            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Id</label>
                <div class="col-sm-8">
                    <input class="form-control-plaintext" readonly value="@ViewData["SupplierId"]">
                </div>
            </div>
            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Full Name</label>
                <div class="col-sm-8">
                    <input class="form-control" asp-for="FullName">
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Email</label>
                <div class="col-sm-8">
                    <input class="form-control" asp-for="Email">
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
            </div>

            <h2 class="text-center mb-3">Contact Details:</h2>
            <hr />

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Contact No</label>
                <div class="col-sm-8">

                    <input type="tel" class="form-control" asp-for="ContactNo">
                    <span asp-validation-for="ContactNo" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Address</label>
                <div class="col-sm-8">
                    <input class="form-control" asp-for="Address">
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">City</label>
                <div class="col-sm-8">
                    <input class="form-control" asp-for="City">
                    <span asp-validation-for="City" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Suburb</label>
                <div class="col-sm-8">
                    <input class="form-control" asp-for="Suburb">
                    <span asp-validation-for="Suburb" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Postal Code</label>
                <div class="col-sm-8">
                    <input class="form-control" asp-for="PostalCode">
                    <span asp-validation-for="PostalCode" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Registered On</label>
                <div class="col-sm-8">
                    <input class="form-control-plaintext" readonly value="@ViewData["CreatedAt"]">
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Status</label>
                <div class="col-sm-8">
                    <span class="badge @(Model.IsActive ? "bg-success" : "bg-danger") form-control-plaintext">
                        @(Model.IsActive ? "Active" : "Inactive")
                    </span>
                    <small class="form-text text-muted">Status cannot be changed here.</small>
                </div>
            </div>

            <h2 class="text-center mb-3">Supplier Details:</h2>
            <hr />

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Company Name*</label>
                <div class="col-sm-8">
                    <input class="form-control" asp-for="CompanyName">
                    <span asp-validation-for="CompanyName" class="text-danger small"></span>
                </div>
            </div>

            <div class="row mb-3">
                <label asp-for="SupplierType" class="col-sm-4 col-form-label">Supplier Type</label>
                <div class="col-sm-8">
                    <select asp-for="SupplierType" class="form-control">
                        <option value="">-- Select Supplier Type --</option>
                        @foreach (var type in ViewBag.SupplierTypes)
                        {
                            <option value="@type.Value">@type.Text</option>
                        }
                    </select>
                    <span asp-validation-for="SupplierType" class="text-danger small"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="offset-sm-4 col-sm-4 d-grid">
                    <button type="submit" class="btn btn-primary">Save Changes</button>

                </div>
                <div class="col-sm-4 d-grid">
                    <a class="btn btn-outline-secondary" asp-controller="Suppliers" asp-action="Index" role="button">
                        Back to List
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}


