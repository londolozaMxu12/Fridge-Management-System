@model Supplier

@{
    ViewData["Title"] = "Delete Supplier";
    Layout = "_AdminLayout";
}

<div class="row">
    <div class="col-md-8">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h3 class="card-title mb-0">
                    <i class="fas fa-exclamation-triangle me-2"></i>Delete Supplier
                </h3>
            </div>
            <div class="card-body">
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <div class="alert alert-warning">
                    <div class="d-flex">
                        <i class="fas fa-exclamation-triangle fa-2x me-3"></i>
                        <div>
                            <h5 class="alert-heading">Warning!</h5>
                            <p class="mb-0">You are about to delete this supplier. This action will deactivate their account and they will no longer be able to access the system.</p>
                        </div>
                    </div>
                </div>

                <h4 class="text-center mb-4">Supplier Details</h4>

                <div class="row">
                    <!-- Account Information -->
                    <div class="col-md-6">
                        <div class="card mb-4">
                            <div class="card-header bg-light">
                                <h6 class="card-title mb-0">
                                    <i class="fas fa-user me-2"></i>Account Details
                                </h6>
                            </div>
                            <div class="card-body">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Email:</label>
                                    <p class="form-control-plaintext">@Model.User.Email</p>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Full Name:</label>
                                    <p class="form-control-plaintext">@Model.User.FullName</p>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Contact Number:</label>
                                    <p class="form-control-plaintext">@Model.User.ContactNo</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Company Information -->
                    <div class="col-md-6">
                        <div class="card mb-4">
                            <div class="card-header bg-light">
                                <h6 class="card-title mb-0">
                                    <i class="fas fa-building me-2"></i>Company Details
                                </h6>
                            </div>
                            <div class="card-body">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Company Name:</label>
                                    <p class="form-control-plaintext">@Model.CompanyName</p>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Supplier Type:</label>
                                    <p class="form-control-plaintext">
                                        <span class="badge bg-primary">@Model.SupplierType</span>
                                    </p>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Registration Date:</label>
                                    <p class="form-control-plaintext">@Model.CreatedAt.ToString("MMM dd, yyyy")</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Address Information -->
                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h6 class="card-title mb-0">
                            <i class="fas fa-map-marker-alt me-2"></i>Address Details
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Address:</label>
                                    <p class="form-control-plaintext">@Model.User.Address</p>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold">City:</label>
                                    <p class="form-control-plaintext">@Model.User.City</p>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Suburb:</label>
                                    <p class="form-control-plaintext">@Model.User.Suburb</p>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Postal Code:</label>
                                    <p class="form-control-plaintext">@Model.User.PostalCode</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Additional Information -->
                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h6 class="card-title mb-0">
                            <i class="fas fa-info-circle me-2"></i>Additional Information
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Created By:</label>
                                    <p class="form-control-plaintext">@Model.CreatedBy?.FullName</p>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Created Date:</label>
                                    <p class="form-control-plaintext">@Model.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Delete Confirmation -->
                <div class="alert alert-danger">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-shield-alt fa-2x me-3"></i>
                        <div>
                            <h6 class="alert-heading mb-2">Delete Notice</h6>
                            <p class="mb-0">This action cannot be undone. The supplier will be deleted and removed from active listings.</p>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />

                    <div class="row">
                        <div class="col-md-6 d-grid mb-2">
                            <button type="submit" class="btn btn-danger btn-lg">
                                <i class="fas fa-trash-alt me-1"></i>Confirm Delete
                            </button>
                        </div>
                        <div class="col-md-6 d-grid">
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                                <i class="fas fa-arrow-left me-1"></i>Back to List
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {

            // Form submission confirmation
            const form = document.querySelector('form');
            form.addEventListener('submit', function(e) {
                if (!confirm('Are you sure you want to delete this supplier? They will immediately lose access to the system.')) {
                    e.preventDefault();
                }
            });
        });
    </script>
}

@section Styles {
    <style>
        .form-control-plaintext {
            padding: 0.375rem 0;
            margin-bottom: 0;
            background-color: transparent;
            border: solid transparent;
            border-width: 1px 0;
        }

        .card {
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        }

        .card-header {
            border-bottom: 1px solid rgba(0, 0, 0, 0.125);
        }

        .form-label {
            color: #6c757d;
            font-size: 0.875rem;
            margin-bottom: 0.25rem;
        }
    </style>
}