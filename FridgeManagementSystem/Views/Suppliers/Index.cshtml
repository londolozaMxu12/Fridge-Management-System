
@model IEnumerable<Supplier>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Suppliers Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-truck"></i> @ViewData["Title"]</h1>
    <a asp-area="Identity" asp-page="/Account/RegisterSupplier" class="btn btn-primary">
        <i class="fas fa-plus"></i> Register New Supplier
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0"><i class="fas fa-list"></i>List Of Active Suppliers</h5>
    </div>
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle"></i> No suppliers found.
                <a asp-area="Identity" asp-page="/Account/RegisterSupplier" class="alert-link">Register the first supplier</a>.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-primary">
                        <tr>
                            <th>Company Name</th>
                            
                            <th>Email</th>
                            <th>Supplier Type</th>
                            <th>Contact Number</th>
                            <th>City</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var supplier in Model)
                        {
                            <tr>
                                <td>@supplier.User.Suppliers.CompanyName</td>
                                <td>@supplier.User.Email</td>
                                <td>
                                    <span class="badge bg-info">@supplier.SupplierType</span>
                                </td>
                                <td>@supplier.User.ContactNo</td>
                                <td>@supplier.User.City</td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@supplier.Id" class="btn btn-info btn-sm" ">
                                            <i class="fas fa-eye"></i>View Details
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@supplier.Id" class="btn btn-warning btn-sm" ">
                                            <i class="fas fa-edit"></i>Edit
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@supplier.Id" class="btn btn-danger btn-sm" ">
                                            <i class="fas fa-trash"> </i>Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>