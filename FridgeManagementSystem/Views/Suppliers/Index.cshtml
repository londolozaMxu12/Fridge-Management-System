@model IEnumerable<Supplier>
@{
    if (User.IsInRole("Admin"))
    {
        Layout = "_AdminLayout";
        ViewData["Title"] = "Suppliers Management";
    }
    else if (ViewBag.IsPurchasingManager == true)
    {
        Layout = "_PurchasingManagerLayout";
        ViewData["Title"] = "Supplier Directory - Procurement";
    }
    else
    {
        Layout = "_Layout";
        ViewData["Title"] = "Suppliers";
    }
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-truck"></i> @ViewData["Title"]</h1>

    <!-- Role-specific actions -->
    @if (User.IsInRole("Admin"))
    {
        <a asp-area="Identity" asp-page="/Account/RegisterSupplier" class="btn btn-primary">
            <i class="fas fa-plus"></i> Register New Supplier
        </a>
    }
    else if (ViewBag.IsPurchasingManager == true)
    {
        <div class="btn-group">
            <a href="@Url.Action("Index", "PurchaseRequests")" class="btn btn-outline-primary">
                <i class="fas fa-clipboard-list"></i> View Purchase Requests
            </a>
            <a href="@Url.Action("Create", "RFQ")" class="btn btn-success">
                <i class="fas fa-file-alt"></i> Create RFQ
            </a>
        </div>
    }
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">
            <i class="fas fa-list"></i>
            @if (ViewBag.IsPurchasingManager == true)
            {
                <span>Available Suppliers for Procurement</span>
            }
            else
            {
                <span>List Of Active Suppliers</span>
            }
        </h5>
        @if (ViewBag.IsPurchasingManager == true)
        {
            <span class="badge bg-light text-primary">
                <i class="fas fa-sync-alt"></i> Updated: @DateTime.Now.ToString("MMM dd, yyyy")
            </span>
        }
    </div>
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle"></i> No suppliers found.
                @if (User.IsInRole("Admin"))
                {
                    <a asp-area="Identity" asp-page="/Account/RegisterSupplier" class="alert-link">Register the new supplier</a>
                }
                else
                {
                    <span>Contact admin to register new supplier.</span>
                }
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-primary">
                        <tr>
                            <th>Company Name</th>
                            <th>Email</th>
                            <th>Supplier Type</th>
                            <th>Contact Number</th>
                            <th>City</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var supplier in Model)
                        {
                            var userIsActive = supplier.User?.IsActive ?? false;
                            var approvalStatus = supplier.User?.ApprovalStatus ?? "Unknown";
                            var email = supplier.User?.Email ?? "N/A";
                            var contactNo = supplier.User?.ContactNo ?? "N/A";
                            var city = supplier.User?.City ?? "N/A";

                            <tr>
                                <td>
                                    <strong>@supplier.CompanyName</strong>

                                    @if (ViewBag.IsPurchasingManager == true && userIsActive)
                                    {
                                        <span class="badge bg-success ms-1" title="Active Supplier">
                                            <i class="fas fa-check-circle"></i> Active
                                        </span>
                                    }
                                </td>
                                <td>@email</td>
                                <td>
                                    <span class="badge bg-info">@supplier.SupplierType</span>
                                </td>
                                <td>@contactNo</td>
                                <td>@city</td>
                                <td>
                                    @if (userIsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactive</span>
                                    }

                                    @switch (approvalStatus.ToLower())
                                    {
                                        case "approved":
                                            <span class="badge bg-primary mt-1">Approved</span>
                                            break;
                                        case "pending":
                                            <span class="badge bg-warning mt-1">Pending Approval</span>
                                            break;
                                        case "rejected":
                                            <span class="badge bg-danger mt-1">Rejected</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary mt-1">@approvalStatus</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <!-- View Details -->
                                        <a asp-action="Details" asp-route-id="@supplier.Id" class="btn btn-info btn-sm">
                                            <i class="fas fa-eye"></i> Details
                                        </a>

                                        <!-- Procurement Actions for Purchasing Manager -->
                                        @if (ViewBag.IsPurchasingManager == true && userIsActive && approvalStatus == "Approved")
                                        {
                                            <button type="button" class="btn btn-success btn-sm"
                                                    onclick="createRFQ(@supplier.Id, '@supplier.CompanyName')"
                                                    title="Create Request for Quotation">
                                                <i class="fas fa-file-alt"></i> RFQ
                                            </button>

                                            <a href="@Url.Action("SupplierQuotations", "Quotations", new { supplierId = supplier.Id })"
                                               class="btn btn-warning btn-sm" title="View Quotations">
                                                <i class="fas fa-receipt"></i> Quotes
                                            </a>
                                        }
                                        else if (ViewBag.IsPurchasingManager == true && (!userIsActive || approvalStatus != "Approved"))
                                        {
                                            <button type="button" class="btn btn-secondary btn-sm" disabled title="Supplier not active or approved">
                                                <i class="fas fa-file-alt"></i> RFQ
                                            </button>
                                        }

                                        <!-- Edit - Available for Admin and Purchasing Manager -->
                                        @if (User.IsInRole("Admin") || ViewBag.IsPurchasingManager == true)
                                        {
                                            <a asp-action="Edit" asp-route-id="@supplier.Id" class="btn btn-outline-primary btn-sm">
                                                <i class="fas fa-edit"></i> Edit
                                            </a>
                                        }

                                        <!-- Delete - Only for Admin -->
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <a asp-action="Delete" asp-route-id="@supplier.Id" class="btn btn-danger btn-sm">
                                                <i class="fas fa-trash"></i> Delete
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Purchasing Manager Specific Tools -->
@if (ViewBag.IsPurchasingManager == true)
{
    <div class="row mt-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="fas fa-bolt"></i> Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="@Url.Action("Create", "RFQ")" class="btn btn-outline-success btn-lg">
                            <i class="fas fa-file-contract me-2"></i>Create New RFQ
                        </a>
                        <a href="@Url.Action("Index", "PurchaseRequests")" class="btn btn-outline-primary btn-lg">
                            <i class="fas fa-clipboard-check me-2"></i>Process Purchase Requests
                        </a>
                        <a href="@Url.Action("Index", "Quotations")" class="btn btn-outline-warning btn-lg">
                            <i class="fas fa-receipt me-2"></i>Review Quotations
                        </a>
                        <a href="@Url.Action("Index", "PurchaseOrders")" class="btn btn-outline-info btn-lg">
                            <i class="fas fa-file-invoice me-2"></i>Manage Purchase Orders
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="fas fa-chart-line"></i> Procurement Overview</h5>
                </div>
                <div class="card-body">
                    <div class="list-group list-group-flush">
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <span>Pending RFQ Approvals</span>
                            <span class="badge bg-warning rounded-pill">3</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <span>Quotations to Review</span>
                            <span class="badge bg-success rounded-pill">8</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <span>Purchase Orders to Process</span>
                            <span class="badge bg-primary rounded-pill">5</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <span>Delivery Notes Pending</span>
                            <span class="badge bg-secondary rounded-pill">2</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function createRFQ(supplierId, supplierName) {
            if (confirm('Create Request for Quotation for ' + supplierName + '?')) {
                window.location.href = '@Url.Action("Create", "RFQ")' + '?supplierId=' + supplierId;
            }
        }
    </script>
}