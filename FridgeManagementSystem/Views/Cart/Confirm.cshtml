@{
    ViewData["Title"] = "Order Confirmation";
    Layout = "_CustomerLayout";
}

<div class="mx-auto rounded border bg-light text-black p-4" style="width: 420px">
    <h2 class="text-centermb-3 ">Order Details</h2>
    <hr />

    @if (ViewBag.SuccessMessage != null)
    {
        <div class="alert alert-success" role="alert">@ViewBag.SuccessMessage</div>
        <a class="btn btn-outline-primary" asp-controller="CustomerOrders" asp-action="Index">Back</a>
    }
    else
    {
        <div class="row mb-3">
            <div class="col-5">Delivery Address:</div>
            <div class="col-7">@ViewBag.DeliveryAddress</div>
        </div>
        <div class="row mb-3">
            <div class="col-5">Payment Method:</div>
            <div class="col-7">@ViewBag.PaymentMethod</div>
        </div>
        <div class="row mb-3">
            <div class="col-5">Total Amount:</div>
            <div class="col-7">R @(ViewBag.Total)</div>
        </div>
        <div class="row mb-3">
            <div class="col-5">Quantity:</div>
            <div class="col-7">@(ViewBag.CartSize)</div>
        </div>

        <form method="post">
            @Html.AntiForgeryToken()
            <!-- Add hidden fields to preserve the data -->
            <input type="hidden" name="deliveryAddress" value="@ViewBag.DeliveryAddress" />
            <input type="hidden" name="paymentMethod" value="@ViewBag.PaymentMethod" />

            <div class="row">
                <div class="col-sm-6 d-grid">
                    <button type="submit" class="btn btn-primary">Confirm</button>
                </div>
                <div class="col-sm-6 d-grid">
                    <a class="btn btn-outline-primary m-1" asp-controller="Cart" asp-action="Index">Back</a>
                </div>
            </div>
        </form>
    }
</div>